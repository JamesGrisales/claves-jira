<style>
  #as-btn{
    position:fixed; right:22px; bottom:22px; z-index:700; width:54px; height:54px; border-radius:50%; border:1px solid rgba(255,255,255,0.2);
    cursor:pointer; color:#fff; background:var(--grad); box-shadow:0 10px 28px -6px rgba(var(--accent-rgb),.6), 0 0 16px rgba(var(--accent-rgb),.35);
    padding:0; display:flex; align-items:center; justify-content:center; transition:transform .2s var(--spring), box-shadow .2s ease;
  }
  #as-btn:hover{ transform:scale(1.08) translateY(-2px); box-shadow:0 14px 34px -4px rgba(var(--accent-rgb),.8), 0 0 24px rgba(var(--accent-rgb),.5); }
  #as-btn svg{ width:26px; height:26px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
  
  #as-panel{
    position:fixed; right:22px; bottom:88px; z-index:710; width:min(440px, calc(100vw - 24px)); height:min(640px, calc(100vh - 110px));
    background:var(--panel-glass, var(--panel)); backdrop-filter:blur(24px) saturate(1.4); -webkit-backdrop-filter:blur(24px) saturate(1.4);
    color:var(--text); border:1px solid var(--panel-edge); border-radius:20px; box-shadow:var(--shadow-lg), 0 0 30px rgba(0,0,0,.45);
    display:none; flex-direction:column; overflow:hidden; font-family:var(--sans); animation:panelIn .22s var(--ease);
  }
  #as-panel.on{ display:flex; }
  #as-panel.grande{ width:min(880px, calc(100vw - 24px)); height:calc(100vh - 110px); }
  :root[data-theme="oled"] #as-panel{ background:rgba(7,8,10,.94); border-color:rgba(255,255,255,0.1); }
  
  .as-h{ display:flex; align-items:center; gap:10px; padding:12px 16px; border-bottom:1px solid var(--panel-edge); background:color-mix(in srgb, var(--panel-alt) 80%, transparent); }
  .as-h-brand{ display:flex; align-items:center; gap:8px; font-weight:700; font-size:14.5px; }
  .as-h-brand svg{ width:18px; height:18px; stroke:var(--accent); }
  .as-h .mod{ font-size:11.5px; color:var(--muted); flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:flex; align-items:center; gap:5px; }
  .as-h .mod::before{ content:''; display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--ok); }
  .as-ib{ background:transparent; border:0; color:var(--muted); cursor:pointer; width:30px; height:30px; border-radius:8px; padding:0; display:flex; align-items:center; justify-content:center; box-shadow:none; transition:all .15s ease; }
  .as-ib:hover{ background:var(--accent-soft); color:var(--accent-dark); transform:none; }
  .as-ib svg{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  
  #as-msgs{ flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:12px; }
  .as-m{ max-width:88%; padding:10px 14px; font-size:13.5px; line-height:1.55; overflow-wrap:anywhere; position:relative; box-shadow:0 2px 8px rgba(0,0,0,.08); }
  .as-m.u{ align-self:flex-end; background:var(--grad); color:#fff; border-radius:16px 16px 3px 16px; white-space:pre-wrap; }
  .as-m.a{ align-self:flex-start; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:16px 16px 16px 3px; }
  .as-m.e{ align-self:flex-start; background:var(--danger-soft); color:var(--danger); border:1px solid var(--danger); border-radius:14px; }
  .as-m p{ margin:0 0 7px; } .as-m p:last-child{ margin:0; }
  .as-m ul, .as-m ol{ margin:4px 0 7px; padding-left:18px; }
  .as-m code{ font-family:var(--mono); font-size:12px; background:rgba(127,127,127,.18); padding:2px 6px; border-radius:5px; }
  .as-m pre{ background:#0c1017; color:#e2e8f0; border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:10px 12px; overflow:auto; margin:8px 0; font-size:12px; }
  .as-m pre code{ background:none; padding:0; color:inherit; }
  .as-m a{ color:var(--accent); font-weight:600; text-decoration:underline; }
  .as-cp{ position:absolute; top:6px; right:6px; opacity:0; font-size:11px; padding:3px 7px; border-radius:6px; border:1px solid var(--panel-edge); background:var(--panel); color:var(--muted); cursor:pointer; box-shadow:none; transition:opacity .15s ease; }
  .as-m:hover .as-cp{ opacity:1; }
  
  #as-est{ font-size:12px; color:var(--muted); padding:0 16px 6px; min-height:18px; font-weight:500; }
  .as-sug{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .as-sug button{ background:var(--accent-soft); color:var(--accent-dark); border:1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius:999px; padding:6px 12px; font-size:12px; font-weight:600; cursor:pointer; box-shadow:none; transition:transform .12s ease; }
  .as-sug button:hover{ transform:translateY(-1px); border-color:var(--accent); }
  
  .as-f{ border-top:1px solid var(--panel-edge); padding:12px 14px; background:var(--panel-alt); }
  .as-f textarea{ width:100%; resize:none; background:var(--panel); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13.5px; padding:10px 12px; border-radius:12px; outline:none; max-height:120px; display:block; transition:border-color .15s ease, box-shadow .15s ease; }
  :root[data-theme="oled"] .as-f textarea{ background:#020304; border-color:rgba(255,255,255,0.12); color:#f8fafc; }
  .as-f textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .as-f textarea::placeholder{ color:var(--muted); opacity:.75; font-size:13px; }
  
  .as-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:10px; }
  .as-row label{ display:flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); margin:0; text-transform:none; letter-spacing:0; font-weight:500; cursor:pointer; user-select:none; }
  .as-row label input{ width:auto; margin:0; }
  #as-send{ padding:8px 18px; font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; }
  #as-send svg{ width:14px; height:14px; }
  @media (max-width:560px){ #as-panel{ right:8px; bottom:80px; } #as-btn{ right:14px; bottom:14px; } }
</style>

<button type="button" id="as-btn" title="Asistente de IA (Alt+A)" aria-label="Abrir asistente">
  <svg viewBox="0 0 24 24"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/></svg>
</button>
<div id="as-panel" role="dialog" aria-label="Asistente de IA">
  <div class="as-h">
    <div class="as-h-brand">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/></svg>
      <span>Asistente</span>
    </div>
    <span class="mod" id="as-mod"></span>
    <button type="button" class="as-ib" id="as-nuevo" title="Nueva conversación"><svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
    <button type="button" class="as-ib" id="as-grande" title="Ampliar pantalla"><svg viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg></button>
    <button type="button" class="as-ib" id="as-cerrar" title="Cerrar (Esc)"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <div id="as-msgs"></div>
  <div id="as-est"></div>
  <div class="as-f">
    <textarea id="as-in" rows="1" placeholder="Haz una consulta o pide buscar algo…"></textarea>
    <div class="as-row">
      <label title="Envía al asistente el texto que ves en esta página (útil en Logs, Visor, SQL…)">
        <input type="checkbox" id="as-pant"> Leer contexto de pantalla
      </label>
      <button type="button" id="as-send">
        <span>Enviar</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var KEY = 'asistente_hist', hist = [], ocupado = false, cfg = null;
  try { hist = JSON.parse(localStorage.getItem('asistente_hist') || '[]') || []; } catch (e) {}
  function guardar(){ try { localStorage.setItem(KEY, JSON.stringify(hist.slice(-30))); } catch (e) {} }
  function esc(t){ return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function inline(t){
    return t.replace(/`([^`\n]+)`/g,'<code>$1</code>').replace(/\*\*([^*\n]+)\*\*/g,'<b>$1</b>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
  }
  function md(src){
    return esc(src).split('```').map(function(parte, i){
      if (i % 2) return '<pre><code>' + parte.replace(/^[\w+-]*\n/, '') + '</code></pre>';
      var out = '', lista = null;
      function cerrar(){ if (lista) { out += '</' + lista + '>'; lista = null; } }
      parte.split('\n').forEach(function(l){
        var b = l.match(/^\s*[-*•]\s+(.*)/), n = l.match(/^\s*\d+[.)]\s+(.*)/), h = l.match(/^#{1,4}\s+(.*)/);
        if (b || n) { var tipo = b ? 'ul' : 'ol'; if (lista !== tipo) { cerrar(); out += '<' + tipo + '>'; lista = tipo; } out += '<li>' + inline((b || n)[1]) + '</li>'; }
        else { cerrar(); if (h) out += '<p><b>' + inline(h[1]) + '</b></p>'; else if (l.trim()) out += '<p>' + inline(l) + '</p>'; }
      });
      cerrar(); return out;
    }).join('');
  }

  function pintar(rol, texto){
    var d = document.createElement('div');
    d.className = 'as-m ' + rol;
    if (rol === 'a') { d.innerHTML = md(texto); var c = document.createElement('button'); c.type = 'button'; c.className = 'as-cp'; c.textContent = 'Copiar';
      c.onclick = function(){ navigator.clipboard && navigator.clipboard.writeText(texto); c.textContent = '✓'; setTimeout(function(){ c.textContent = 'Copiar'; }, 1200); }; d.appendChild(c); }
    else d.textContent = texto;
    $('as-msgs').appendChild(d); $('as-msgs').scrollTop = $('as-msgs').scrollHeight; return d;
  }
  function inicio(){
    $('as-msgs').innerHTML = '';
    if (!hist.length) {
      var s = document.createElement('div'); s.className = 'as-m a';
      s.innerHTML = '<p>Hola 👋 Puedo buscar y leer tus notas, apuntes y enlaces, y también crear notas o enlaces si me lo pides.</p><div class="as-sug"></div>';
      ['Hazme un resumen de la bóveda', 'Busca mis notas sobre…', 'Explícame lo que veo en pantalla'].forEach(function(t){
        var b = document.createElement('button'); b.type = 'button'; b.textContent = t;
        b.onclick = function(){ $('as-in').value = t; if (/…$/.test(t)) $('as-in').focus(); else enviar(); }; s.querySelector('.as-sug').appendChild(b); });
      $('as-msgs').appendChild(s);
    } else hist.forEach(function(m){ pintar(m.role === 'user' ? 'u' : 'a', m.content); });
  }
  function abrir(v){
    var p = $('as-panel'), on = v === undefined ? !p.classList.contains('on') : v;
    p.classList.toggle('on', on);
    if (on) { $('as-in').focus(); $('as-msgs').scrollTop = $('as-msgs').scrollHeight; if (!cfg) fetch('/asistente/api/estado').then(function(r){ return r.json(); }).then(function(j){
      cfg = j; $('as-mod').textContent = j.configurado ? (j.nombre || 'IA') + ' · ' + j.modelo : 'Sin configurar'; $('as-mod').title = j.motivo || '';
      if (!j.configurado && j.motivo) pintar('e', j.motivo); }).catch(function(){ cfg = null; }); }
  }

  function enviar(){
    var inp = $('as-in'), txt = inp.value.trim();
    if (!txt || ocupado) return;
    if (!hist.length) $('as-msgs').innerHTML = '';
    hist.push({ role: 'user', content: txt }); pintar('u', txt); inp.value = ''; inp.style.height = 'auto';
    ocupado = true; $('as-send').disabled = true; $('as-est').textContent = 'Pensando…';
    var pant = null;
    if ($('as-pant').checked) { var w = document.querySelector('.wrap'); pant = w ? w.innerText : document.body.innerText; }
    var acum = '', fin = false;
    function termina(){ ocupado = false; $('as-send').disabled = false; $('as-est').textContent = ''; guardar(); inp.focus(); }
    fetch('/asistente/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mensajes: hist.slice(-16), pantalla: pant, ruta: location.pathname }) })
    .then(function(r){
      if (r.status === 401 || r.redirected) throw new Error('Tu sesión expiró. Recarga la página e inicia sesión.');
      if (!r.ok || !r.body) return r.json().then(function(j){ throw new Error(j.error || 'Error ' + r.status); });
      var rd = r.body.getReader(), dec = new TextDecoder(), buf = '';
      function leer(){
        return rd.read().then(function(x){
          if (x.done) return;
          buf += dec.decode(x.value, { stream: true });
          var partes = buf.split('\n\n'); buf = partes.pop();
          partes.forEach(function(p){
            if (p.indexOf('data: ') !== 0) return;
            var ev; try { ev = JSON.parse(p.slice(6)); } catch (e) { return; }
            if (ev.t === 'estado') $('as-est').textContent = ev.m;
            else if (ev.t === 'fin') { fin = true; hist.push({ role: 'assistant', content: ev.texto }); pintar('a', ev.texto); }
            else if (ev.t === 'error') { fin = true; hist.pop(); pintar('e', ev.m); }
          });
          return leer();
        });
      }
      return leer();
    })
    .catch(function(e){ hist.pop(); pintar('e', e.message || 'No se pudo conectar.'); })
    .then(function(){ if (!fin && ocupado && hist.length && hist[hist.length - 1].role === 'user') { hist.pop(); pintar('e', 'La respuesta se cortó. Intenta de nuevo.'); } termina(); });
  }

  $('as-btn').onclick = function(){ abrir(); };
  $('as-cerrar').onclick = function(){ abrir(false); };
  $('as-grande').onclick = function(){ $('as-panel').classList.toggle('grande'); };
  $('as-nuevo').onclick = function(){ if (ocupado) return; hist = []; guardar(); inicio(); };
  $('as-send').onclick = enviar;
  $('as-in').addEventListener('keydown', function(e){ if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); enviar(); } });
  $('as-in').addEventListener('input', function(){ this.style.height = 'auto'; this.style.height = Math.min(130, this.scrollHeight) + 'px'; });
  document.addEventListener('keydown', function(e){
    if (e.altKey && (e.key === 'a' || e.key === 'A')) { e.preventDefault(); abrir(); }
    else if (e.key === 'Escape' && $('as-panel').classList.contains('on') && !document.querySelector('.ed-wrap.fullscreen')) abrir(false);
  });
  try { $('as-pant').checked = localStorage.getItem('asistente_pant') === '1'; } catch (e) {}
  $('as-pant').addEventListener('change', function(){ try { localStorage.setItem('asistente_pant', this.checked ? '1' : '0'); } catch (e) {} });
  inicio();
})();
</script>
