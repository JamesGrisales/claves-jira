<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .chip{ display:inline-block; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; color:var(--accent-dark); background:var(--accent-soft); }
  .chip.bad{ color:var(--danger); background:var(--danger-soft); }
  .chip.info{ color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); font-weight:600; }

  .q-opts{ display:flex; gap:14px 18px; flex-wrap:wrap; align-items:flex-end; margin-bottom:12px; }
  .q-opt{ display:flex; flex-direction:column; gap:5px; }
  .q-opt > span{ font-size:11px; font-weight:700; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .q-opt input[type=number], .q-opt select{
    background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans);
    font-size:13px; padding:7px 10px; border-radius:8px; outline:none; height:34px;
  }
  .q-opt input[type=number]{ width:74px; }
  .q-opt input:focus, .q-opt select:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }

  /* Barra de herramientas superior a ancho completo del editor */
  .v-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    margin-bottom: 14px;
    background: var(--panel-alt);
    border: 1px solid var(--panel-edge);
    border-radius: 14px;
    padding: 6px 14px;
    box-sizing: border-box;
    position: relative;
    z-index: 60;
    flex-wrap: wrap;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
  }
  .v-tb-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .v-tb-right {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .v-tb-divider { width: 1px; height: 22px; background: var(--panel-edge); margin: 0 4px; flex-shrink: 0; }
  .v-toolbar .sp { flex: 1; }

  /* BOTÓN SPLIT: Formatear + Selector de fila pegado */
  .v-split-btn {
    display: inline-flex;
    align-items: stretch;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.28), rgba(0, 180, 216, 0.16));
    border: 1px solid var(--accent);
    box-shadow: 0 0 16px -2px rgba(var(--accent-rgb), 0.5);
    position: relative;
    transition: all .2s ease;
    flex-shrink: 0;
  }
  .v-split-btn:hover {
    box-shadow: 0 0 22px rgba(var(--accent-rgb), 0.75);
    border-color: #fff;
  }
  .v-split-btn #btnFormatear {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 9px 0 0 9px !important;
    color: #fff !important;
    font-weight: 700 !important;
    padding: 7px 14px !important;
    height: 36px !important;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    letter-spacing: 0.02em;
  }
  .v-split-btn #btnFormatear:hover {
    background: rgba(255, 255, 255, 0.12) !important;
  }
  .v-split-btn .v-split-trigger {
    background: rgba(var(--accent-rgb), 0.14) !important;
    border: none !important;
    border-left: 1px solid rgba(var(--accent-rgb), 0.5) !important;
    border-radius: 0 9px 9px 0 !important;
    color: #fff !important;
    font-weight: 700 !important;
    padding: 0 10px !important;
    height: 36px !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 12.5px;
    box-shadow: none !important;
    transition: background .15s ease;
  }
  .v-split-btn .v-split-trigger:hover,
  .v-split-btn .v-dropdown.open .v-split-trigger {
    background: rgba(var(--accent-rgb), 0.35) !important;
  }
  .v-split-btn .v-dd-menu {
    left: auto;
    right: 0;
  }

  /* Clúster de acciones estilo VS Code */
  .v-icon-cluster {
    display: inline-flex;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 10px;
    padding: 2px 3px;
    gap: 2px;
    flex-shrink: 0;
  }
  .v-icon-cluster button {
    background: transparent !important;
    border: none !important;
    border-radius: 8px !important;
    color: var(--text) !important;
    padding: 6px 11px !important;
    height: 32px !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    box-shadow: none !important;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all .15s ease;
  }
  .v-icon-cluster button:hover {
    background: var(--panel-alt) !important;
    color: var(--accent) !important;
  }
  .v-icon-cluster button svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    flex-shrink: 0;
  }
  .v-icon-cluster button#btnCopiarSQL {
    color: var(--accent) !important;
    font-weight: 600 !important;
  }
  .v-icon-cluster button#btnCopiarSQL:hover {
    background: rgba(var(--accent-rgb), 0.15) !important;
  }
  @media (max-width: 1080px) {
    .v-icon-cluster button span {
      display: none;
    }
    .v-icon-cluster button {
      padding: 6px 8px !important;
    }
  }
  .v-toolbar button, .v-toolbar label.btn {
    padding: 7px 13px;
    font-size: 12.5px;
    border-radius: 9px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  label.btn { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; margin: 0; text-transform: none; letter-spacing: 0; }
  .seg { display: inline-flex; background: var(--panel-alt); border: 1px solid var(--panel-edge); border-radius: 999px; padding: 3px; }
  .seg button { background: transparent; color: var(--muted); box-shadow: none; border: none; padding: 6px 13px; font-size: 12.5px; border-radius: 999px; transform: none; }
  .seg button:hover { color: var(--accent-dark); transform: none; box-shadow: none; filter: none; }
  .seg button.active { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #fff; }

  #entrada {
    width: 100%; min-height: 200px; max-height: 60vh; resize: vertical; background: var(--panel-alt); border: 1px solid var(--panel-edge);
    color: var(--text); font-family: var(--mono); font-size: 13px; line-height: 1.5; padding: 12px 14px; border-radius: 10px; outline: none;
    white-space: pre; overflow: auto; tab-size: 4; transition: border-color .15s ease, box-shadow .15s ease;
  }
  #entrada:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  #entrada.drag { border-color: var(--accent); background: var(--accent-soft); }
  .hint { font-size: 12px; color: var(--muted); margin-top: 6px; }

  #salida { margin-top: 18px; display: none; width: 100%; background: var(--panel-alt); border: 1px solid var(--panel-edge); border-radius: 14px; padding: 16px; box-sizing: border-box; }
  #salida.on { display: block; }
  .v-status { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-bottom: 10px; }
  .aviso { font-size: 12.5px; background: var(--danger-soft); color: var(--danger); border-radius: 8px; padding: 8px 12px; margin-bottom: 10px; }
  .aviso ul { margin: 4px 0 0; padding-left: 18px; }

  .code-block { background: var(--ed-bg, #0a1124); color: var(--ed-fg, #d6e0f5); border: 1px solid var(--panel-edge); border-radius: 10px; padding: 12px 0; font-family: var(--mono); font-size: 13px; line-height: 1.6; margin: 0; width: 100%; height: 380px; min-height: 300px; max-height: 52vh; overflow: auto; resize: vertical; tab-size: 4; box-sizing: border-box; }
  .code-line { display: flex; min-width: max-content; }
  .code-line:hover { background: rgba(255,255,255,.04); }
  .code-line .ln { position: sticky; left: 0; background: var(--ed-gut-bg, #080e1d); flex-shrink: 0; width: 52px; text-align: right; padding-right: 12px; margin-right: 12px; color: var(--ed-gut-fg, #4d6190); border-right: 1px solid var(--ed-gut-edge, #17244a); user-select: none; }
  .code-line .code-text { white-space: pre; padding-right: 16px; }

  /* Solo la herramienta activa se muestra en pantalla. Ocultas por defecto */
  .rp { display: none !important; }
  .rp.on { display: flex !important; flex-direction: column; flex: none; min-height: 0; padding: 0; border: none; background: transparent; margin-bottom: 10px; }
  .rp.on .rp-row:has(textarea) { flex: none; display: flex; min-height: 0; width: 100%; margin: 0; align-items: stretch; }
  .rp.on textarea { width: 100%; border-radius: 10px; border: 1px solid var(--panel-edge); padding: 10px 12px; background: var(--bg); font-family: var(--mono); color: var(--text); font-size: 13px; line-height: 1.5; outline: none; box-sizing: border-box; }
  .rp.on textarea:focus { border-color: var(--accent); }

  #pq.rp.on, #mx.rp.on, #ls.rp.on { flex: none; min-height: 0; margin-top: 0; margin-bottom: 12px; padding: 0; border: none; background: transparent; width: 100%; }
  #pq.rp.on .rp-row, #mx.rp.on .rp-row, #ls.rp.on .rp-row { margin: 0; width: 100%; align-items: stretch; }
  #pq.rp.on .rp-row:has(textarea), #mx.rp.on .rp-row:has(textarea), #ls.rp.on .rp-row:has(textarea) { flex: none; min-height: 0; display: flex; margin: 0; width: 100%; }

  /* Editores (Herramienta activa, Entrada SQL y Salida/Tercer editor) con la misma altura y ancho */
  #pqEntrada, #mxEntrada, #lsEntrada, #entrada, .code-block, #codigo {
    width: 100% !important;
    height: 380px !important;
    min-height: 300px;
    max-height: 52vh;
    resize: vertical;
    box-sizing: border-box;
  }
  #pqEntrada, #mxEntrada, #lsEntrada {
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    padding: 12px 14px;
    border-radius: 10px;
    outline: none;
    white-space: pre;
    overflow: auto;
    margin: 0;
  }
  .ed-layout:has(.rp.on) #entrada,
  .ed-layout:has(#salida.on) #entrada {
    min-height: 380px !important;
    height: 380px !important;
    max-height: 52vh;
  }

  /* Buscar y reemplazar no tiene editor central, debe ocultarse para no dejar un espacio gigante */
  #rp.rp.on { flex: 0; min-height: 0; height: 0; margin: 0; padding: 0; display: none !important; }

  /* Menús desplegables (.v-dropdown) */
  .v-dropdown {
    position: relative;
    display: inline-block;
  }
  .v-dropdown.open {
    z-index: 1000 !important;
  }
  .v-dd-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 99999 !important;
    min-width: 220px;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 12px;
    padding: 6px;
    display: none;
    flex-direction: column;
    gap: 3px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(16px);
    animation: vDdFade .15s ease-out;
  }
  @keyframes vDdFade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .v-dropdown.open > .v-dd-menu,
  .v-dropdown.open .v-dd-menu {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  .v-dropdown.open > button.v-dd-trigger,
  .v-dropdown.open > button.v-split-trigger {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px var(--accent-soft) !important;
  }
  .v-dd-menu button, .v-dd-menu label.btn {
    width: 100%;
    justify-content: flex-start;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    box-shadow: none;
    height: auto;
    cursor: pointer;
    box-sizing: border-box;
    transition: background .15s ease, color .15s ease;
  }
  .v-dd-menu button:hover, .v-dd-menu label.btn:hover {
    background: var(--panel-alt);
    color: var(--accent-dark);
  }
  .v-dd-menu button.active, .v-dd-menu label.btn.active {
    background: rgba(var(--accent-rgb), 0.18) !important;
    color: var(--text) !important;
    font-weight: 700 !important;
  }
  .v-dd-menu .v-dd-divider {
    height: 1px;
    background: var(--panel-edge);
    margin: 4px 6px;
  }

  /* Botones activos y alumbrados permanentemente mientras la herramienta esté abierta */
  .v-toolbar button.active, .v-tb-group button.active, .v-dd-trigger.active {
    background: rgba(var(--accent-rgb), 0.22) !important;
    border-color: var(--accent) !important;
    color: var(--text) !important;
    font-weight: 700 !important;
    box-shadow: 0 0 16px -2px rgba(var(--accent-rgb), 0.85), inset 0 0 8px rgba(var(--accent-rgb), 0.2) !important;
  }
  .v-toolbar button.active svg, .v-tb-group button.active svg, .v-dd-trigger.active svg {
    stroke: var(--accent) !important;
    filter: drop-shadow(0 0 6px var(--accent)) drop-shadow(0 0 2px rgba(255,255,255,0.7)) !important;
  }

  /* Insignia en la esquina que indica en qué opción/herramienta está el usuario */
  .v-mode-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.45);
    box-shadow: 0 0 12px -2px rgba(var(--accent-rgb), 0.35);
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
    user-select: none;
    transition: all .25s ease;
    white-space: nowrap;
  }
  .v-mode-badge.tool-on {
    background: rgba(var(--accent-rgb), 0.2) !important;
    border-color: var(--accent) !important;
    box-shadow: 0 0 16px -1px rgba(var(--accent-rgb), 0.75), inset 0 0 8px rgba(var(--accent-rgb), 0.15) !important;
    color: #fff !important;
  }
  .v-mode-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px 2px var(--accent);
    animation: vDotPulse 1.8s infinite ease-in-out;
  }
  @keyframes vDotPulse {
    0%, 100% { transform:scale(1); opacity:1; filter:drop-shadow(0 0 3px var(--accent)); }
    50% { transform:scale(1.25); opacity:.75; filter:drop-shadow(0 0 7px var(--accent)); }
  }

  /* Ocultar barra de opciones del editor SQL para máxima visibilidad */
  .v-toolbar.opciones-ocultas .v-dropdown,
  .v-toolbar.opciones-ocultas .v-tb-divider,
  .v-toolbar.opciones-ocultas #btnComentarios,
  .v-toolbar.opciones-ocultas #btnLimpiar {
    display: none !important;
  }
  .v-toolbar.opciones-ocultas {
    padding: 6px 14px;
  }
  
  .ed-tools-sidebar { width:240px; flex-shrink:0; display:none; flex-direction:column; background:var(--panel-alt); border:1px solid var(--panel-edge); padding:12px; overflow-y:auto; border-radius:10px; }
  .ed-layout:has(.rp.on) .ed-tools-sidebar { display:flex; }
  /* AISLAMIENTO ESTRICTO: Ocultar todas las opciones por defecto */
  .tool-opts,
  .ed-tools-sidebar .tool-opts {
    display: none !important;
  }

  /* ÚNICAMENTE mostrar el bloque de la herramienta que esté activa */
  .ed-layout:has(#rp.on) .ed-tools-sidebar .rp-opts,
  .ed-layout:has(#ls.on) .ed-tools-sidebar .ls-opts,
  .ed-layout:has(#sn.on) .ed-tools-sidebar .sn-opts,
  .ed-layout:has(#mx.on) .ed-tools-sidebar .mx-opts,
  .ed-layout:has(#pq.on) .ed-tools-sidebar .pq-opts,
  .ed-layout:has(#rv.on) .ed-tools-sidebar .rv-opts {
    display: flex !important;
    flex-direction: column;
    gap: 12px;
  }

  .ed-tools-sidebar .rv-actions { display:flex; flex-direction:column; gap:8px; width:100%; }
  .ed-tools-sidebar .rv-actions button { width:100%; justify-content:center; padding:8px 10px; font-size:11.5px; font-weight:600; gap:6px; }
  .ed-tools-sidebar .rv-stats-bar { display:flex; flex-direction:column; gap:6px; padding:10px; width:100%; box-sizing:border-box; background:var(--panel); border:1px solid var(--panel-edge); border-radius:8px; }
  .ed-tools-sidebar .rv-stat-pill { width:100%; justify-content:space-between; box-sizing:border-box; padding:5px 10px; font-size:11.5px; }
  .ed-tools-sidebar .rv-filter-group { display:flex; gap:4px; width:100%; }
  .ed-tools-sidebar .rv-filter-btn { flex:1; padding:5px 4px; font-size:10px; font-weight:700; border-radius:6px; text-align:center; background:var(--panel); border:1px solid var(--panel-edge); color:var(--muted); cursor:pointer; transition:all .15s ease; }
  .ed-tools-sidebar .rv-filter-btn:hover { color:var(--text); border-color:var(--accent); }
  .ed-tools-sidebar .rv-filter-btn.active { background:var(--accent); color:#fff; border-color:var(--accent); }

  
  .ed-tools-sidebar .rp-row { display:flex; flex-direction:column; align-items:flex-start; gap:8px; margin:0; width:100%; }
  .ed-tools-sidebar .rp-row > input[type=text], .ed-tools-sidebar .rp-row > select, .ed-tools-sidebar .rp-row > button { width:100%; margin:0; font-size:11.5px; padding:6px 8px; }
  .ed-tools-sidebar label.chk { display:flex; align-items:center; gap:6px; margin:0 0 4px 0; font-size:11.5px; }
  .ed-tools-sidebar .pq-box { display:flex; flex-direction:column; gap:12px; border:none; padding:0; background:transparent; width:100%; }
  .ed-tools-sidebar .pq-rango { display:flex; flex-direction:row; flex-wrap:wrap; gap:8px; width:100%; align-items:flex-end; }
  .ed-tools-sidebar .pq-d { display:flex; flex-direction:column; gap:2px; flex:1; min-width:40%; }
  .ed-tools-sidebar .pq-d span { font-size:9.5px; font-weight:bold; color:var(--muted); text-transform:uppercase; letter-spacing:0.05em; }
  .ed-tools-sidebar .pq-rango input { width:100%; font-size:11px; padding:4px; height:26px; }
  .ed-tools-sidebar .pq-dias { font-size:10px; color:var(--muted); text-align:center; display:block; width:100%; margin-top:2px; margin-bottom:4px; }
  
  .ed-tools-sidebar .pq-pre { display:flex; flex-wrap:wrap; flex-direction:row; gap:4px; width:100%; }
  .ed-tools-sidebar .pq-pre button { flex:1 1 45%; padding:4px; font-size:10px; height:24px; }
  .ed-tools-sidebar .seg { display:flex; flex-wrap:wrap; width:100%; gap:2px; }
  .ed-tools-sidebar .seg button { flex:1; padding:4px; font-size:11px; height:24px; }
  .ed-tools-sidebar .presets { font-size:10.5px; color:var(--muted); font-weight:700; text-transform:uppercase; margin-bottom:2px; display:block; letter-spacing:0.03em; }
  .ed-tools-sidebar .ls-hint { font-size:11px; color:var(--muted); line-height:1.3; }
  .ed-tools-sidebar .pq-tablas { display:flex; flex-direction:column; gap:4px; }
  .ed-tools-sidebar .pq-tablas label { font-size:11.5px; margin:0; }
  
  .ed-tools-sidebar .pq-vend { border:1px solid var(--panel-edge); border-radius:6px; padding:8px; background:rgba(0,0,0,0.1); }
  .ed-tools-sidebar .pq-vend summary { font-size:11px; font-weight:bold; cursor:pointer; outline:none; margin-bottom:8px; }
  .ed-tools-sidebar .pq-vend .rp-row { display:flex; flex-direction:row; flex-wrap:wrap; gap:4px; margin-bottom:8px; align-items:center; }
  .ed-tools-sidebar .pq-vend input[type=text] { padding:4px; font-size:10.5px; height:24px; }
  .ed-tools-sidebar .pq-vend #pqVCod { width:30%; flex:none; }
  .ed-tools-sidebar .pq-vend #pqVNom { width:65%; flex:none; }
  .ed-tools-sidebar .pq-vend #pqVAdd { width:100%; flex:none; height:24px; padding:0; font-size:10.5px; }
  .ed-tools-sidebar .pq-vend textarea { width:100%; height:45px; min-height:40px; padding:4px; font-size:10px; resize:vertical; line-height:1.2; margin-bottom:4px; }
  .ed-tools-sidebar .pq-vend #pqVAddLista { width:100%; flex:none; height:24px; padding:0; font-size:10.5px; margin-bottom:4px; }
  .ed-tools-sidebar .pq-vend #pqVFiltro { width:100%; flex:none; }
  .ed-tools-sidebar .pq-sub { font-size:10px; color:var(--muted); line-height:1.3; margin-top:8px; }
  
  .rp-row{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .rp-row + .rp-row{ margin-top:8px; }
  .rp input[type=text]{ flex:1; min-width:140px; font-size:13px; padding:7px 10px; }
  .rp label.chk{ display:inline-flex; align-items:center; gap:5px; margin:0; font-size:12.5px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; }
  .rp button{ padding:7px 12px; font-size:12.5px; }
  .rp .cnt{ font-size:12px; color:var(--muted); min-width:90px; }
  .rp .presets{ font-size:12px; color:var(--muted); font-weight:600; }
  .tk-sp{ background:rgba(255,167,38,.5); box-shadow:inset 0 -2px 0 #ffa726; border-radius:2px; }
  .aviso.dato{ background:#fff4e0; color:#8a5300; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
