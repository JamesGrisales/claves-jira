var PANELES = { btnRP: 'rp', btnLS: 'ls', btnSN: 'sn', btnMX: 'mx', btnPQ: 'pq', btnRV: 'rv' };
var NOMBRES_MODOS = {
  rp: 'Buscar / Reemplazar',
  ls: 'Lista datos',
  sn: 'Sentencias',
  mx: 'Masivo Excel',
  pq: 'Procesar querys',
  rv: 'Revisar SQL'
};

function actualizarBotonesPaneles() {
  var modoActivo = null;
  var panelActivoId = null;

  // 1. Identificar cuál herramienta está abierta (asegurar máximo UNA activa a la vez)
  Object.keys(PANELES).forEach(function(b){
    var id = PANELES[b];
    var panel = $(id);
    if (panel && panel.classList.contains('on')) {
      if (!panelActivoId) {
        panelActivoId = id;
        modoActivo = NOMBRES_MODOS[id] || id;
      } else {
        // Si más de un panel quedó encendido por error, desactivar los excedentes
        panel.classList.remove('on');
      }
    }
  });

  // 2. Alumbrar únicamente el botón correspondiente de la barra de herramientas
  Object.keys(PANELES).forEach(function(b){
    var id = PANELES[b];
    var btn = $(b);
    if (btn) {
      btn.classList.toggle('active', id === panelActivoId);
    }
  });

  // 3. AISLAMIENTO ESTRICTO DE LA BARRA LATERAL (#edToolsSidebar)
  var sidebar = $('edToolsSidebar');
  if (sidebar) {
    var allOpts = sidebar.querySelectorAll('.tool-opts');
    allOpts.forEach(function(optBox) {
      optBox.style.setProperty('display', 'none', 'important');
    });

    if (panelActivoId) {
      sidebar.style.display = 'flex';
      var titleEl = sidebar.querySelector('h3');
      if (titleEl) {
        titleEl.textContent = 'Opciones: ' + modoActivo;
      }
      var activeOptBox = sidebar.querySelector('.' + panelActivoId + '-opts');
      if (activeOptBox) {
        activeOptBox.style.setProperty('display', 'flex', 'important');
      }
    } else {
      sidebar.style.display = 'none';
    }
  }

  // 4. Alumbrar el botón del menú desplegable de Herramientas y mostrar la herramienta activa
  var btnH = $('btnDdHerramientas');
  var txtH = $('txtDdHerramientas');
  if (btnH) {
    btnH.classList.toggle('active', !!modoActivo);
  }
  if (txtH) {
    txtH.textContent = modoActivo ? ('Herramientas: ' + modoActivo) : 'Herramientas';
  }

  var badgeTxt = $('vModeTxt');
  var badge = $('vModeBadge');
  if (badgeTxt) {
    badgeTxt.textContent = modoActivo ? 'Modo: ' + modoActivo : 'Modo: Editor SQL';
  }
  if (badge) {
    badge.classList.toggle('tool-on', !!modoActivo);
  }
}

/* Control interactivo de los menús desplegables Archivo, Herramientas y Estilo */
(function setupDropdowns() {
  var dropdowns = document.querySelectorAll('.v-dropdown');
  
  function closeAllDropdowns() {
    dropdowns.forEach(function(dd) { dd.classList.remove('open'); });
  }

  dropdowns.forEach(function(dd) {
    var trigger = dd.querySelector('.v-dd-trigger');
    if (!trigger) return;
    
    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = dd.classList.contains('open');
      closeAllDropdowns();
      if (!isOpen) {
        dd.classList.add('open');
      }
    });

    var menu = dd.querySelector('.v-dd-menu');
    if (menu) {
      menu.addEventListener('click', function(e) {
        if (e.target.closest('button') || e.target.closest('label.btn')) {
          setTimeout(closeAllDropdowns, 80);
        }
      });
    }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.v-dropdown')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Esc') {
      closeAllDropdowns();
    }
  });
})();

// Garantizar que solo UNA herramienta pueda estar abierta a la vez
Object.keys(PANELES).forEach(function(b){
  var btnEl = $(b);
  if (!btnEl) return;
  btnEl.addEventListener('click', function(){
    // Cerrar inmediatamente todos los otros paneles
    Object.keys(PANELES).forEach(function(o){
      if (PANELES[o] !== PANELES[b] && $(PANELES[o])) {
        $(PANELES[o]).classList.remove('on');
      }
    });
    setTimeout(actualizarBotonesPaneles, 10);
  }, true);
});

actualizarBotonesPaneles();

/* ==========================================================================
   REVISOR Y AUDITOR DE SQL EN TIEMPO REAL
   ========================================================================== */
var diagActual = null;

function irALinea(numLinea, pos) {
  numLinea = Math.max(1, numLinea);
  var lineas = entrada.value.split('\n');
  var offset = 0;
  for (var i = 0; i < numLinea - 1 && i < lineas.length; i++) {
    offset += lineas[i].length + 1;
  }
  var fin = offset + (lineas[numLinea - 1] ? lineas[numLinea - 1].length : 0);
  entrada.focus();
  entrada.setSelectionRange(offset, fin);
  
  var m = metricas();
  entrada.scrollTop = Math.max(0, (numLinea - 3) * m.lh);
  sincronizarEditor();
  toast('Línea ' + numLinea + ' seleccionada');
}

function irADatoFaltante(d) {
  if (!d) return;
  var det = d.details || {};
  var pos = det.insertionPos != null ? det.insertionPos : d.tokenPos;
  if (pos == null) {
    if (d.line) irALinea(d.line, d.tokenPos);
    return;
  }

  var txt = entrada.value;
  var colName = (det.missingColumns && det.missingColumns[0]) ? det.missingColumns[0] : 'columna';
  var posNum = (det.valuesCount || 0) + 1;

  // Si antes de la posición de inserción hay un valor y no hay coma, agregamos una coma y espacio para que el usuario escriba directamente
  var before = txt.slice(0, pos);
  var trimmedBefore = before.replace(/\s+$/, '');
  var needsComma = trimmedBefore.length > 0 && !trimmedBefore.endsWith(',') && !trimmedBefore.endsWith('(');

  if (needsComma) {
    var insertText = ', ';
    entrada.value = before + insertText + txt.slice(pos);
    localStorage.setItem('boveda-sql-draft', entrada.value);
    procesar();
    var newPos = before.length + insertText.length;
    entrada.focus();
    entrada.setSelectionRange(newPos, newPos);
  } else {
    entrada.focus();
    entrada.setSelectionRange(pos, pos);
  }

  var lineas = entrada.value.slice(0, pos).split('\n');
  var numLinea = lineas.length;
  var m = metricas();
  entrada.scrollTop = Math.max(0, (numLinea - 3) * m.lh);
  sincronizarEditor();

  toast('🎯 Posicionado para ingresar dato #' + posNum + " ('" + colName + "'). Escribe la información requerida.");
}

var rvFiltroActivo = 'all';

function revisarSqlEnVivo() {
  if (typeof SqlValidador === 'undefined') return;
  var txt = entrada.value;
  var res = SqlValidador.validate(txt);
  diagActual = res;

  var bBadge = $('badgeErroresSql');
  var mBadge = $('badgeErroresSqlMenu');
  var cBadge = $('ctxBadgeErrores');
  var banner = $('edDiagBanner');
  var bTxt = $('edDiagTxt');
  var bIcon = $('edDiagIcon');
  var bFix = $('edDiagBtnFix');

  // Actualizar badges (en botón Herramientas y en ítem Revisar SQL del menú)
  [bBadge, mBadge].forEach(function(badgeEl) {
    if (!badgeEl) return;
    if (res.errorsCount > 0) {
      badgeEl.style.display = 'inline-block';
      badgeEl.className = 'rv-badge-cnt';
      badgeEl.textContent = res.errorsCount + (res.errorsCount === 1 ? ' error' : ' errores');
    } else if (res.warningsCount > 0) {
      badgeEl.style.display = 'inline-block';
      badgeEl.className = 'rv-badge-cnt ok';
      badgeEl.style.background = '#f59e0b';
      badgeEl.textContent = res.warningsCount + (res.warningsCount === 1 ? ' aviso' : ' avisos');
    } else {
      badgeEl.style.display = 'none';
    }
  });

  if (cBadge) {
    if (res.errorsCount > 0) {
      cBadge.style.display = 'inline-block';
      cBadge.className = 'ctx-badge';
      cBadge.textContent = res.errorsCount;
    } else {
      cBadge.style.display = 'none';
    }
  }

  // Actualizar banner en el editor principal
  if (banner && bTxt && bIcon) {
    if (!txt.trim()) {
      banner.style.display = 'none';
    } else if (res.errorsCount > 0) {
      banner.style.display = 'flex';
      banner.className = 'ed-diag-banner bad';
      bIcon.textContent = '❌';
      var primerError = res.diagnostics.find(function(d){ return d.type === 'error'; });
      bTxt.innerHTML = '<strong>' + res.errorsCount + (res.errorsCount === 1 ? ' error detectado: ' : ' errores detectados: ') + '</strong>' + esc(primerError ? primerError.message : 'Revisa la sintaxis de tu consulta.');
      
      if (primerError && (primerError.code === 'INSERT_VALUES_MISMATCH' || primerError.code === 'INSERT_SELECT_MISMATCH')) {
        bFix.style.display = 'inline-flex';
        var det = primerError.details || {};
        var primFaltante = (det.missingColumns && det.missingColumns[0]) ? det.missingColumns[0] : 'campo';
        var numPos = (det.valuesCount || 0) + 1;
        bFix.innerHTML = '🎯 Ir a donde falta el dato (#' + numPos + ": '" + esc(primFaltante) + "')";
        bFix.onclick = function() {
          irADatoFaltante(primerError);
        };
      } else {
        bFix.style.display = 'none';
      }
    } else if (res.warningsCount > 0) {
      banner.style.display = 'flex';
      banner.className = 'ed-diag-banner ok';
      banner.style.borderLeftColor = '#f59e0b';
      bIcon.textContent = '⚠️';
      bTxt.innerHTML = '<strong>' + res.warningsCount + ' advertencia(s):</strong> ' + esc(res.diagnostics[0].message);
      bFix.style.display = 'none';
    } else {
      banner.style.display = 'none';
    }
  }

  // Actualizar estadísticas del panel #rv
  var stValid = $('rvStatValid');
  var stValidTxt = $('rvValidTxt');
  var stErrors = $('rvStatErrors');
  var stWarnings = $('rvStatWarnings');
  var numErrors = $('rvErrorsNum');
  var numWarnings = $('rvWarningsNum');
  var numStmts = $('rvStmtsNum');
  var cardsCont = $('rvCards');

  if (stValid && stValidTxt) {
    if (res.errorsCount === 0) {
      stValid.className = 'rv-stat-pill ok';
      stValidTxt.textContent = txt.trim() ? 'SQL Válido' : 'Listo para revisar';
    } else {
      stValid.className = 'rv-stat-pill bad';
      stValidTxt.textContent = 'Requiere atención';
    }
  }

  if (numErrors && stErrors) {
    numErrors.textContent = res.errorsCount;
    stErrors.style.display = res.errorsCount > 0 ? 'inline-flex' : 'none';
  }
  if (numWarnings && stWarnings) {
    numWarnings.textContent = res.warningsCount;
    stWarnings.style.display = res.warningsCount > 0 ? 'inline-flex' : 'none';
  }
  if (numStmts) {
    numStmts.textContent = res.stats.statements;
  }

  // Actualizar conteos en los botones de filtro en la barra lateral
  var btnAll = document.querySelector('#rvFilterGroup [data-filter="all"]');
  var btnErr = document.querySelector('#rvFilterGroup [data-filter="error"]');
  var btnWarn = document.querySelector('#rvFilterGroup [data-filter="warning"]');
  if (btnAll) btnAll.textContent = 'Todos (' + res.diagnostics.length + ')';
  if (btnErr) btnErr.textContent = 'Errores (' + res.errorsCount + ')';
  if (btnWarn) btnWarn.textContent = 'Avisos (' + res.warningsCount + ')';

  // Renderizar tarjetas del panel #rv
  if (cardsCont) {
    cardsCont.innerHTML = '';
    if (!txt.trim()) {
      cardsCont.innerHTML = '<div class="rv-empty-state"><span class="ok-icon">📄</span><p>Pega tu consulta SQL en el editor para iniciar la auditoría y detección de errores en tiempo real.</p></div>';
      return;
    }

    if (res.diagnostics.length === 0) {
      cardsCont.innerHTML = '<div class="rv-empty-state"><span class="ok-icon">✅</span><h4 style="margin:0;color:var(--ok);">¡SQL impecable!</h4><p>No se encontraron discrepancias de columnas vs valores, cláusulas huérfanas ni errores de sintaxis.</p></div>';
      return;
    }

    var diagsFiltrados = res.diagnostics;
    if (rvFiltroActivo === 'error') {
      diagsFiltrados = res.diagnostics.filter(function(d){ return d.type === 'error'; });
    } else if (rvFiltroActivo === 'warning') {
      diagsFiltrados = res.diagnostics.filter(function(d){ return d.type === 'warning'; });
    }

    if (diagsFiltrados.length === 0) {
      cardsCont.innerHTML = '<div class="rv-empty-state"><span class="ok-icon">🔍</span><p>No hay diagnósticos para el filtro <strong>' + (rvFiltroActivo === 'error' ? 'Solo Errores' : (rvFiltroActivo === 'warning' ? 'Solo Avisos' : 'Todos')) + '</strong>.</p></div>';
      return;
    }

    diagsFiltrados.forEach(function (d) {
      var card = document.createElement('div');
      card.className = 'rv-card ' + d.type;

      var topRow = document.createElement('div');
      topRow.className = 'rv-card-top';

      var tag = document.createElement('span');
      tag.className = 'rv-card-tag';
      tag.textContent = d.type === 'error' ? '❌ ' + d.title : (d.type === 'warning' ? '⚠️ ' + d.title : 'ℹ️ ' + d.title);
      topRow.appendChild(tag);

      var loc = document.createElement('span');
      loc.className = 'rv-card-loc';
      loc.textContent = 'Línea ' + d.line + (d.col ? ', Col ' + d.col : '');
      topRow.appendChild(loc);

      card.appendChild(topRow);

      var msg = document.createElement('p');
      msg.className = 'rv-card-msg';
      msg.textContent = d.message;
      card.appendChild(msg);

      // Si es discrepancia de columnas vs valores en INSERT (VALUES o SELECT), mostrar tabla interactiva
      if ((d.code === 'INSERT_VALUES_MISMATCH' || d.code === 'INSERT_VALUES_SURPLUS' || d.code === 'INSERT_SELECT_MISMATCH' || d.code === 'INSERT_SELECT_SURPLUS') && d.details) {
        var isSelectQuery = (d.code === 'INSERT_SELECT_MISMATCH' || d.code === 'INSERT_SELECT_SURPLUS');
        var prevBox = document.createElement('div');
        prevBox.className = 'rv-card-table-preview';

        // Fila de Columnas
        var rowCols = document.createElement('div');
        rowCols.className = 'rv-cmp-row';
        var lblCols = document.createElement('span');
        lblCols.className = 'rv-cmp-label';
        lblCols.textContent = 'Campos (' + d.details.columnsCount + '):';
        rowCols.appendChild(lblCols);

        var chipsCols = document.createElement('div');
        chipsCols.className = 'rv-cmp-chips';
        d.details.columns.forEach(function (colName, cIdx) {
          var ch = document.createElement('span');
          var isMissing = d.details.missingColumns && d.details.missingColumns.indexOf(colName) >= 0;
          ch.className = 'rv-chip-item' + (isMissing ? ' missing' : '');
          ch.textContent = '#' + (cIdx + 1) + ' ' + colName + (isMissing ? ' ➔ [FALTA DATO]' : ' ✅');
          if (isMissing) {
            ch.style.cursor = 'pointer';
            ch.title = 'Haz clic para ir a escribir la información requerida';
            ch.onclick = function () {
              irADatoFaltante(d);
            };
          }
          chipsCols.appendChild(ch);
        });
        rowCols.appendChild(chipsCols);
        prevBox.appendChild(rowCols);

        // Fila de Valores o Proyecciones SELECT
        var rowVals = document.createElement('div');
        rowVals.className = 'rv-cmp-row';
        var lblVals = document.createElement('span');
        lblVals.className = 'rv-cmp-label';
        lblVals.textContent = (isSelectQuery ? 'SELECT (' : 'Valores Fila ' + (d.details.rowNumber || 1) + ' (') + d.details.valuesCount + '):';
        rowVals.appendChild(lblVals);

        var chipsVals = document.createElement('div');
        chipsVals.className = 'rv-cmp-chips';
        d.details.values.forEach(function (valTxt, vIdx) {
          var chv = document.createElement('span');
          chv.className = 'rv-chip-item';
          chv.textContent = '#' + (vIdx + 1) + '. ' + (valTxt.length > 20 ? valTxt.slice(0, 18) + '…' : valTxt);
          chipsVals.appendChild(chv);
        });
        if (d.details.diff && (d.code === 'INSERT_VALUES_MISMATCH' || d.code === 'INSERT_SELECT_MISMATCH')) {
          for (var m = 0; m < d.details.diff; m++) {
            var chm = document.createElement('span');
            chm.className = 'rv-chip-item missing';
            var colFaltante = (d.details.missingColumns && d.details.missingColumns[m]) ? ' (' + d.details.missingColumns[m] + ')' : '';
            chm.textContent = '❌ Falta dato #' + (d.details.valuesCount + m + 1) + colFaltante;
            chm.style.cursor = 'pointer';
            chm.title = 'Haz clic para ir a escribir la información requerida';
            chm.onclick = function () {
              irADatoFaltante(d);
            };
            chipsVals.appendChild(chm);
          }
        }
        rowVals.appendChild(chipsVals);
        prevBox.appendChild(rowVals);

        card.appendChild(prevBox);
      }

      // Botonera de acciones de la tarjeta
      var foot = document.createElement('div');
      foot.className = 'rv-card-footer';

      var btnIr = document.createElement('button');
      btnIr.type = 'button';
      btnIr.className = 'secondary btn-sm';
      btnIr.innerHTML = '🔍 Ir a Línea ' + d.line;
      btnIr.onclick = function () {
        irALinea(d.line, d.tokenPos);
      };
      foot.appendChild(btnIr);

      if (d.code === 'INSERT_VALUES_MISMATCH' || d.code === 'INSERT_SELECT_MISMATCH') {
        var det = d.details || {};
        var colFaltante = (det.missingColumns && det.missingColumns[0]) ? det.missingColumns[0] : 'columna';
        var posFaltante = (det.valuesCount || 0) + 1;

        var btnIrDato = document.createElement('button');
        btnIrDato.type = 'button';
        btnIrDato.className = 'btn-sm';
        btnIrDato.innerHTML = '🎯 Ir a escribir dato faltante (#' + posFaltante + ": '" + esc(colFaltante) + "')";
        btnIrDato.onclick = function () {
          irADatoFaltante(d);
        };
        foot.appendChild(btnIrDato);
      } else if (d.code === 'SELECT_TRAILING_COMMA' || d.code === 'UPDATE_SET_TRAILING_COMMA' || d.code === 'VALUES_TRAILING_COMMA' || d.code === 'INSERT_TRAILING_COMMA_COLUMNS') {
        var btnFixComma = document.createElement('button');
        btnFixComma.type = 'button';
        btnFixComma.className = 'btn-sm';
        btnFixComma.innerHTML = '✂️ Quitar coma sobrante';
        btnFixComma.onclick = function () {
          var nuevo = SqlValidador.autoFix(entrada.value, d);
          entrada.value = nuevo;
          localStorage.setItem('boveda-sql-draft', nuevo);
          procesar();
          toast('Coma sobrante eliminada');
        };
        foot.appendChild(btnFixComma);
      } else if (d.code === 'MISSING_COMMA_COLUMNS' || d.code === 'MISSING_COMMA_VALUES' || d.code === 'MISSING_COMMA_UPDATE_SET') {
        var btnAddComma = document.createElement('button');
        btnAddComma.type = 'button';
        btnAddComma.className = 'btn-sm';
        btnAddComma.innerHTML = "⚡ Insertar coma faltante ','";
        btnAddComma.onclick = function () {
          var nuevo = SqlValidador.autoFix(entrada.value, d);
          entrada.value = nuevo;
          localStorage.setItem('boveda-sql-draft', nuevo);
          procesar();
          toast("Coma ',' insertada");
        };
        foot.appendChild(btnAddComma);
      } else if (d.code === 'UPDATE_NO_WHERE' || d.code === 'DELETE_NO_WHERE') {
        var btnAddWhere = document.createElement('button');
        btnAddWhere.type = 'button';
        btnAddWhere.className = 'btn-sm secondary';
        btnAddWhere.innerHTML = '➕ Agregar WHERE';
        btnAddWhere.onclick = function () {
          var nuevo = SqlValidador.autoFix(entrada.value, d);
          entrada.value = nuevo;
          localStorage.setItem('boveda-sql-draft', nuevo);
          procesar();
          toast('Cláusula WHERE sugerida agregada');
        };
        foot.appendChild(btnAddWhere);
      }

      card.appendChild(foot);
      cardsCont.appendChild(card);
    });
  }
}

