function pqCargarTexto(txt, info){
  var lineas = String(txt).split(/\r?\n/).filter(function(l){ return l.trim() !== ''; }).map(function(l){
    var c = l.indexOf('\t') >= 0 ? l.split('\t') : l.split(/[;,]/);
    return c.slice(0, 3).map(function(x){ return x.trim(); }).join('\t');
  });
  $('pqEntrada').value = lineas.join('\n');
  $('pqEntrada').dispatchEvent(new Event('input'));
  $('pqArchInfo').textContent = info || '';
  var d = pqLeerFilas();
  toast(d.filas.length ? 'Cargado: ' + fmtNum(d.filas.length) + ' filas' + (d.malas ? ' · ' + d.malas + ' inválidas' : '') : 'No se encontraron filas válidas (NIT, sede, código)');
}
function pqCargarHoja(i, nombre){
  var n = pqLibro.SheetNames[i];
  pqCargarTexto(mxHojaATexto(pqLibro.Sheets[n]), nombre + (pqLibro.SheetNames.length > 1 ? ' · hoja «' + n + '»' : ''));
}
function pqAbrirArchivo(f){
  if (!f) return;
  var ext = (f.name.split('.').pop() || '').toLowerCase(), r = new FileReader();
  r.onerror = function(){ toast('No se pudo leer el archivo'); };
  r.onload = function(){
    try {
      if (/^(xlsx|xls|xlsm|xlsb|ods)$/.test(ext)) {
        if (typeof XLSX === 'undefined') { toast('Falta la librería de Excel: usa el server.js nuevo y reinicia'); return; }
        pqLibro = XLSX.read(r.result, { type: 'array', cellNF: true });
        var hs = pqLibro.SheetNames;
        $('pqHoja').innerHTML = hs.map(function(h, k){ return '<option value="' + k + '">' + esc(h) + '</option>'; }).join('');
        $('pqHoja').style.display = hs.length > 1 ? '' : 'none';
        pqCargarHoja(0, f.name);
      } else {
        var b = new Uint8Array(r.result), txt;
        try { txt = new TextDecoder('utf-8', { fatal: true }).decode(b); } catch (e) { txt = new TextDecoder('windows-1252').decode(b); }
        pqLibro = null; $('pqHoja').style.display = 'none';
        pqCargarTexto(txt, f.name);
      }
    } catch (e) { toast('No se pudo leer el archivo: ' + e.message); }
  };
  r.readAsArrayBuffer(f);
}
