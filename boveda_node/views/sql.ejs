  if (!w || (!forzar && w.texto.length < 2)) { cerrarAuto(); return; }
  var esTabla = contextoTabla(w.inicio);
  var tablas = sugerirTablas(w.texto, esTabla ? 12 : 4);
  var columnas = sugerirColumnas(w.texto, w.inicio, w.trasPunto, w.trasPunto ? 12 : 7);
  var items = SS.sugerencias(w.texto, palabrasDelTexto(), 7);

  var yaTabla = {}; tablas.forEach(function(t){ yaTabla[t.texto.toLowerCase()] = 1; });
