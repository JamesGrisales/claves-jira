/* ==========================================================================
   ORGANIZAR SQL A MI GUSTO (PREAJUSTES DE FORMATO)
   ========================================================================== */
function aplicarEstiloPreset(nombre) {
  if (nombre === 'estandar') {
    opts.kw = 'upper';
    opts.indent = '4';
    opts.selectMode = 'one';
    opts.perRow = 10;
    opts.vista = 'format';
  } else if (nombre === 'expandido') {
    opts.kw = 'upper';
    opts.indent = '4';
    opts.selectMode = 'one';
    opts.perRow = 1;
    opts.vista = 'format';
  } else if (nombre === '5col') {
    opts.kw = 'upper';
    opts.indent = '4';
    opts.selectMode = 'one';
    opts.perRow = 5;
    opts.vista = 'format';
  } else if (nombre === '8col') {
    opts.kw = 'upper';
    opts.indent = '4';
    opts.selectMode = 'one';
    opts.perRow = 8;
    opts.vista = 'format';
  } else if (nombre === 'compacto') {
    opts.kw = 'upper';
    opts.indent = '2';
    opts.selectMode = 'group';
    opts.perRow = 20;
    opts.vista = 'format';
  } else if (nombre === 'custom') {
    var num = prompt('¿Cuántos campos o valores quieres por fila/línea? (ej: 1, 3, 5, 8, 10, 15):', opts.perRow || 10);
    var p = parseInt(num, 10);
    if (p >= 1 && p <= 1000) {
      opts.perRow = p;
    } else {
      return;
    }
  } else if (nombre === 'mayusculas') {
    opts.kw = 'upper';
  } else if (nombre === 'minusculas') {
    opts.kw = 'lower';
  }
  guardarOpts();
  pintarOpts();
  var label = nombre === 'estandar' ? '10 por línea (Estándar)' : (nombre === 'expandido' ? '1 por línea (Expandido)' : (nombre === '5col' ? '5 por línea' : (nombre === '8col' ? '8 por línea' : (nombre === 'compacto' ? 'Compacto' : (nombre === 'custom' ? opts.perRow + ' por línea' : nombre.toUpperCase())))));
  formatearEditor('Estilo aplicado: ' + label);
}

// Botones de presets en barra y sidebar
['btnPresetEstandar', 'btnSbPresetEstandar'].forEach(function(id){
  var el = $(id); if (el) el.onclick = function(){ aplicarEstiloPreset('estandar'); };
});
['btnPresetExpandido', 'btnSbPresetExpandido'].forEach(function(id){
  var el = $(id); if (el) el.onclick = function(){ aplicarEstiloPreset('expandido'); };
});
['btnPresetCompacto', 'btnSbPresetCompacto'].forEach(function(id){
  var el = $(id); if (el) el.onclick = function(){ aplicarEstiloPreset('compacto'); };
});
var b5 = $('btnPreset5Col'); if (b5) b5.onclick = function(){ aplicarEstiloPreset('5col'); };
var b8 = $('btnPreset8Col'); if (b8) b8.onclick = function(){ aplicarEstiloPreset('8col'); };
var bCust = $('btnPresetCustom'); if (bCust) bCust.onclick = function(){ aplicarEstiloPreset('custom'); };
