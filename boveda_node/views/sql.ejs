// ---------- quitar comentarios (de línea y de bloque) sin tocar textos, identificadores ni bloques $$ ----------
function rangosComentarios(v){
  var out = [], n = v.length, i = 0, c, d, j, m, esc, prev, tag, prof;
  while (i < n) {
    c = v.charAt(i); d = v.charAt(i + 1);
    if (c === '-' && d === '-') {                       // comentario de línea
      j = v.indexOf('\n', i); if (j < 0) j = n;
      if (j > i && v.charAt(j - 1) === '\r') j--;
      out.push([i, j]); i = j; continue;
    }
    if (c === '/' && d === '*') {                       // comentario de bloque (Postgres permite anidarlos)
      prof = 1; j = i + 2;
      while (j < n && prof) {
        if (v.charAt(j) === '/' && v.charAt(j + 1) === '*') { prof++; j += 2; }
        else if (v.charAt(j) === '*' && v.charAt(j + 1) === '/') { prof--; j += 2; }
        else j++;
      }
      out.push([i, j]); i = j; continue;
    }
    if (c === "'") {                                    // texto 'a''b' (y E'a\'b')
      prev = v.charAt(i - 1); esc = (prev === 'E' || prev === 'e') && !/[\w$]/.test(v.charAt(i - 2));
      j = i + 1;
      while (j < n) {
        if (esc && v.charAt(j) === '\\') { j += 2; continue; }
        if (v.charAt(j) === "'") { if (v.charAt(j + 1) === "'") { j += 2; continue; } break; }
        j++;
      }
      i = j + 1; continue;
    }
    if (c === '"') {                                    // identificador entre comillas dobles
      j = i + 1;
      while (j < n) { if (v.charAt(j) === '"') { if (v.charAt(j + 1) === '"') { j += 2; continue; } break; } j++; }
      i = j + 1; continue;
    }
    if (c === '$' && !/[\w$]/.test(v.charAt(i - 1))) {  // bloque $$ ... $$ o $tag$ ... $tag$
      m = /^\$([A-Za-z_\u00C0-\uFFFF][\w\u00C0-\uFFFF]*)?\$/.exec(v.slice(i, i + 80));
      if (m) { tag = m[0]; j = v.indexOf(tag, i + tag.length); i = j < 0 ? n : j + tag.length; continue; }
    }
    i++;
  }
  return out;
}
function sinComentarios(v, a, b){
  var rg = rangosComentarios(v).filter(function(r){ return r[0] >= a && r[1] <= b; });
  if (!rg.length) return { texto: v, n: 0 };
  var out = '', pos = 0, marcas = [], k, r, izq, der;
  for (k = 0; k < rg.length; k++) {
    r = rg[k]; out += v.slice(pos, r[0]); pos = r[1];
    izq = out.charAt(out.length - 1); der = v.charAt(pos);
    if (v.charAt(r[0] + 1) === '*' && izq && !/\s/.test(izq) && der && !/\s/.test(der)) out += ' ';   // a/*x*/b  ->  a b
    else if (v.charAt(r[0] + 1) === '*' && /[ \t]/.test(izq) && /[ \t]/.test(der)) pos++;               // evita doble espacio
    marcas.push(out.length);
  }
  out += v.slice(pos);
  // las líneas que solo tenían comentario se eliminan; en las demás se quitan los espacios sobrantes al final
  var lineas = out.split('\n'), res = [], ini = 0, i, fin, hay;
  for (i = 0; i < lineas.length; i++) {
    fin = ini + lineas[i].length;
    hay = marcas.some(function(m){ return m >= ini && m <= fin; });
    if (hay) {
      var t = lineas[i].replace(/[ \t]+(\r?)$/, '$1');
      if (t.trim() === '') { ini = fin + 1; continue; }     // la línea solo tenía comentario: se elimina
      res.push(t);
    } else res.push(lineas[i]);
    ini = fin + 1;
  }
  return { texto: res.join('\n'), n: rg.length };
}
