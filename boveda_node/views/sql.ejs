function pqGuardarVend(items){
  return fetch('/api/vendedores', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
    .then(function(r){ return r.json(); }).then(function(j){
      if (!j.ok) { toast(j.error || 'No se pudo guardar'); return false; }
      return pqCargarVend().then(function(){ return j.guardados; });
    }).catch(function(){ toast('No se pudo guardar'); return false; });
}
