function sugerirTablas(texto, max){
  var q = texto.toLowerCase(), pre = [], con = [], i;
  if (!TABLAS.length) return [];
  for (i = 0; i < TABLAS.length && pre.length < max; i++) if (TABLAS_L[i].indexOf(q) === 0 && TABLAS_L[i] !== q) pre.push(i);
  if (pre.length < max && q.length >= 3) for (i = 0; i < TABLAS.length && pre.length + con.length < max; i++) if (TABLAS_L[i].indexOf(q) > 0) con.push(i);
  return pre.concat(con).slice(0, max).map(function(k){ return { tipo: 'tb', texto: TABLAS[k], desc: 'tabla' }; });
}
function pintarAuto(){
