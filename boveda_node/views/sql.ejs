function mxGenerar(){
  var op = $('mxOp').value, tabla = $('mxTabla').value.trim(), d = mxParsear(), I = [], S = [], W = [], N = mxNombres.map(function(c){ return c.trim(); });
  if (!d.n || !d.filas.length) return { err: 'Pega los datos (y los campos en la primera fila, o márcalos abajo)' };
  if (!tabla) return { err: 'Escribe o elige la tabla' };
  for (var q = 0; q < d.n; q++) if (mxRoles[q] && !N[q]) return { err: 'Falta el nombre del campo de la columna ' + (q + 1) + ' (o ponla en Omitir)' };
  for (var i0 = 0; i0 < d.n; i0++) {
    var r = mxRoles[i0];
    if (r === 'i') I.push(i0);
    else if (r === 's' || r === 'cf' || r === 'c' || r === 'rep') S.push(i0);
    else if (r === 'w') W.push(i0);
  }
  var celda = function(f, i){ return mxVal(f[i] === undefined ? '' : f[i], mxTipos[i] || 'a'); };
  var formatSet = function(f, i){
    var r = mxRoles[i];
    var colId = mxId(N[i]);
    var vRaw = f[i] === undefined ? '' : f[i];
    var v = celda(f, i);

    // 1. CONCAT + Fecha (current_date)
    if (r === 'cf') {
      var raw = String(vRaw || '').trim();
      if (/^\s*concat\s*\(/i.test(raw)) return colId + ' = ' + raw;

      var tpl = mxPlantillas[i] || "concat({campo}, '. Se actualiza saldo: 0 Fecha:', current_date, ' caso#{valor}')";
      var valParaTpl = raw;
      if (/caso#\{valor\}/i.test(tpl) && /^caso\s*#\s*/i.test(valParaTpl)) {
        valParaTpl = valParaTpl.replace(/^caso\s*#\s*/i, '');
      }
      var res = tpl.replace(/\{campo\}/gi, colId).replace(/\{valor\}/g, valParaTpl);
      return colId + ' = ' + res;
    }

    // 2. CONCAT simple (anexar texto)
    if (r === 'c') {
      if (/^\s*concat\s*\(/i.test(vRaw)) return colId + ' = ' + vRaw;
      var strVC = String(vRaw).trim();
      var conectorC = strVC.startsWith('.') ? '' : "'. ', ";
      return colId + ' = concat(' + colId + ', ' + conectorC + v + ')';
    }

    // 3. REPLACE (reemplazar dentro del texto)
    if (r === 'rep') {
      var bTxt = (mxBuscar[i] || '').trim();
      var bSql = bTxt ? "'" + bTxt.replace(/'/g, "''") + "'" : "'BUSCAR'";
      return colId + ' = replace(' + colId + ', ' + bSql + ', ' + v + ')';
    }

    // 4. SET tradicional
    return colId + ' = ' + v;
  };

  var fijosActivos = (mxFijos || []).filter(function(f){ return f.activo && f.nombre && f.nombre.trim(); });
  var fijosSet = fijosActivos.map(function(f){ return formatSetFijo(f, 'upd'); });

  var out = [];
  if (op === 'ins') {
    var fijosInsCols = fijosActivos.map(function(f){ return mxId(f.nombre); });
    var fijosInsVals = fijosActivos.map(function(f){
      if (f.rol === 'cf' || f.rol === 'c') {
        var s = formatSetFijo(f, 'ins');
        return s.indexOf(' = ') > 0 ? s.split(/ = (.*)/s)[1] : s;
      }
      return mxVal(f.valor, f.tipo || 'a');
    });
    var todosCols = I.map(function(i){ return mxId(N[i]); }).concat(fijosInsCols);
    if (!todosCols.length) return { err: 'Elige al menos un campo para el INSERT (o activa un campo fijo)' };
    var lote = Math.max(1, parseInt($('mxLote').value, 10) || 1000);
    var cab = 'INSERT INTO ' + tabla + ' (' + todosCols.join(', ') + ') VALUES\n';
    for (var k = 0; k < d.filas.length; k += lote) {
      out.push(cab + d.filas.slice(k, k + lote).map(function(f){
        return '(' + I.map(function(i){ return celda(f, i); }).concat(fijosInsVals).join(', ') + ')';
      }).join(',\n') + ';');
    }
  } else if (op === 'upd') {
    if (!S.length && !fijosSet.length) return { err: 'Elige al menos un campo para el SET (o activa un campo fijo)' };
    if (!W.length) return { err: 'Elige al menos un campo para el WHERE (sin WHERE se actualizaría toda la tabla)' };
    d.filas.forEach(function(f){
      var listaSet = S.map(function(i){ return formatSet(f, i); }).concat(fijosSet);
      out.push('UPDATE ' + tabla + ' SET ' + listaSet.join(', ') +
        ' WHERE ' + W.map(function(i){ return mxCond(N[i], celda(f, i)); }).join(' AND ') + ';');
    });
  } else {
    if (!W.length) return { err: 'Elige al menos un campo para el WHERE (sin WHERE se borraría toda la tabla)' };
    d.filas.forEach(function(f){
      out.push('DELETE FROM ' + tabla + ' WHERE ' + W.map(function(i){ return mxCond(N[i], celda(f, i)); }).join(' AND ') + ';');
    });
  }
  var camposUsados = I.concat(S, W).map(function(i){ return N[i]; }).concat(fijosActivos.map(function(f){ return f.nombre; }));
  mxAgregar(camposUsados); mxGuardarCfg();   // guarda los campos usados para esta tabla
  return { text: out.join('\n'), filas: d.filas.length };
}
