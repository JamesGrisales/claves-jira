    if (raw) {
      var arr = JSON.parse(raw);
      if (Array.isArray(arr) && arr.length) {
        return arr.map(function(f){
          if (f.plantilla && (f.plantilla.indexOf("'. Se actualiza saldo:") !== -1 || f.plantilla === "concat({campo}, '. Se actualiza saldo: 0 Fecha:', current_date, ' caso#{valor}')")) {
            f.plantilla = '';
          }
          if (f.textoManual === undefined) {
            f.textoManual = (f.rol === 'c' && f.valor ? f.valor : '. Se actualiza saldo: 0 Fecha:');
          }
          if (f.conFecha === undefined) {
            f.conFecha = f.rol === 'cf';
          }
          return f;
        });
      }
    }
  } catch (e) {}
  return [
    {
      activo: true,
      nombre: 'texto',
      rol: 'cf',
      textoManual: '. Se actualiza saldo: 0 Fecha:',
      conFecha: true,
