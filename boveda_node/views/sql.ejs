}

function sugerirColumnas(texto, inicio, trasPunto, max){
  var q = texto.toLowerCase(), res = [], vistos = {};
  if (!COLUMNAS) return [];

  var v = entrada.value;
  var prefijo = '';
  if (trasPunto) {
    var pPos = inicio - 1;
    var pMatch = /[A-Za-z_][\w$]*$/.exec(v.slice(Math.max(0, pPos - 50), pPos));
    if (pMatch) prefijo = pMatch[0].toLowerCase();
  }

  var info = detectarTablasEnSentencia(inicio);
  var targetTables = [];

  if (prefijo) {
    if (info.aliasMap[prefijo]) targetTables.push(info.aliasMap[prefijo]);
    else if (COLUMNAS[prefijo]) targetTables.push(prefijo);
  } else if (info.tablas.length) {
    targetTables = info.tablas;
  }

  // 1. Coincidencias en tablas detectadas o prefijo
  targetTables.forEach(function(tbl){
    var cList = COLUMNAS[tbl] || [];
    cList.forEach(function(c){
      var cL = c.toLowerCase();
      if (cL.indexOf(q) === 0 && cL !== q && !vistos[cL]) {
        vistos[cL] = 1;
        res.push({ tipo: 'col', texto: c, desc: 'campo · ' + tbl });
      }
    });
  });

  // 2. Si no hay prefijo de tabla y no hay suficientes, buscar coincidencias en todas las columnas
  if (!prefijo && res.length < max) {
    for (var tbl in COLUMNAS) {
      var cList = COLUMNAS[tbl] || [];
      for (var ci = 0; ci < cList.length; ci++) {
        var c = cList[ci], cL = c.toLowerCase();
        if (cL.indexOf(q) === 0 && cL !== q && !vistos[cL]) {
          vistos[cL] = 1;
          res.push({ tipo: 'col', texto: c, desc: 'campo · ' + tbl });
          if (res.length >= max) break;
        }
      }
      if (res.length >= max) break;
    }
  }

  // 3. Coincidencias que contienen el texto (si aún faltan)
  if (res.length < max && q.length >= 3) {
    targetTables.forEach(function(tbl){
      var cList = COLUMNAS[tbl] || [];
      cList.forEach(function(c){
        var cL = c.toLowerCase();
        if (cL.indexOf(q) > 0 && !vistos[cL]) {
          vistos[cL] = 1;
          res.push({ tipo: 'col', texto: c, desc: 'campo · ' + tbl });
        }
      });
    });
  }

  return res.slice(0, max);
}

// ¿lo que se escribe es un nombre de tabla? (tras FROM, JOIN, INTO, UPDATE, TABLE… o tras una coma dentro de un FROM)
function contextoTabla(inicio){
  var v = entrada.value, desde = v.lastIndexOf(';', inicio - 1) + 1, antes = v.slice(desde, inicio).replace(/[\w$"]+\.$/, '');
  if (/\b(from|join|into|update|table|truncate|only|analyze|vacuum|reindex|describe)\s+$/i.test(antes)) return true;
  var f = antes.toLowerCase().lastIndexOf('from');
