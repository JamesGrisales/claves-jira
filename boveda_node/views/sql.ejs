function mxId(c){ return /^[A-Za-z_][A-Za-z0-9_]*$/.test(c) ? c : '"' + c.replace(/"/g, '""') + '"'; }
function mxVal(x, t){
  var q = function(v){ return "'" + v.replace(/'/g, "''") + "'"; };
  if (x === '') return $('mxVacioNull').checked ? 'NULL' : "''";
  if (/^null$/i.test(x)) return 'NULL';
  if (t === 'r') return x;                                                    // crudo: NOW(), CURRENT_DATE, 5+3…
  if (t === 't') return q(x);                                                 // siempre texto
  if (t === 'n') { var n = x.replace(/\s/g, '').replace(/^(-?\d+),(\d+)$/, '$1.$2'); return /^-?\d+(\.\d+)?$/.test(n) ? n : q(x); }
  if (t === 'f') return q(x.replace(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})(.*)$/, function(m, d, mo, y, rest){ return y + '-' + ('0' + mo).slice(-2) + '-' + ('0' + d).slice(-2) + rest; }));
  // Si en la celda viene una función o expresión SQL directa (ej: concat(..., current_date, now(), replace(...)):
  if (/^\s*(concat|coalesce|replace|upper|lower|trim)\s*\(/i.test(x)) return x;
  if (/^\s*(current_date|current_timestamp|now\(\))\s*$/i.test(x)) return x;
  if ($('mxNums').checked && lsEsNum(x)) return x;                            // auto
  return q(x);
}
function mxCond(c, v){ return mxId(c) + (v === 'NULL' ? ' IS NULL' : ' = ' + v); }

