  var blob = new Blob([resultado.text + '\n'], { type: 'text/plain;charset=utf-8' });
  var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'consulta-formateada.sql';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1000);
});

function leerArchivo(f){
  if (!f) return;
  if (/\.(xlsx|xls|xlsm|xlsb|ods)$/i.test(f.name)) { $('mx').classList.add('on'); mxAbrirArchivo(f); return; }   // Excel: va al panel Masivo
  var r = new FileReader();
  r.onload = function(){ entrada.value = String(r.result); procesar(); };
  r.readAsText(f);
}
$('archivo').addEventListener('change', function(){ leerArchivo(this.files[0]); this.value = ''; });
['dragenter','dragover'].forEach(function(ev){ entrada.addEventListener(ev, function(e){ e.preventDefault(); entrada.classList.add('drag'); }); });
['dragleave','drop'].forEach(function(ev){ entrada.addEventListener(ev, function(e){ e.preventDefault(); entrada.classList.remove('drag'); }); });
entrada.addEventListener('drop', function(e){ leerArchivo(e.dataTransfer.files && e.dataTransfer.files[0]); });

/* ---------- buscar y reemplazar ---------- */
function rpRegex(global){
  var q = $('rpBuscar').value; if (q === '') return null;
  var f = ($('rpCase').checked ? 'g' : 'gi');
  try { return new RegExp($('rpRegex').checked ? q : q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), f); }
  catch (e) { $('rpCnt').textContent = 'Expresión inválida'; return null; }
}
function rpRepl(){
  var r = $('rpReemplazar').value;
  if ($('rpRegex').checked) return r.replace(/\\n/g, '\n').replace(/\\t/g, '\t');
  return function(){ return r; };
}
function trozos(texto){
  var alc = $('rpAlcance').value;
  if (alc === 'todo') return [{ text: texto, ok: true }];
  return SqlFormatter.segments(texto).map(function(sg){
    return { text: sg.text, ok: (alc === 'datos' && sg.kind === 'data') || (alc === 'sintaxis' && sg.kind === 'code') };
  });
}
function contarEn(re, texto){
  var c = new RegExp(re.source, re.flags), n = 0, m;
  while ((m = c.exec(texto)) !== null) { n++; if (m[0] === '') c.lastIndex++; if (n > 1e6) break; }
  return n;
}
function rpContar(){
  var re = rpRegex(); if (!re) { if (!$('rpBuscar').value) $('rpCnt').textContent = ''; return 0; }
  var n = 0; trozos(entrada.value).forEach(function(t){ if (t.ok) n += contarEn(re, t.text); });
  $('rpCnt').textContent = fmtNum(n) + (n === 1 ? ' coincidencia' : ' coincidencias');
  return n;
}
function aplicar(re, repl, msg){
  var n = 0;
  var nuevo = trozos(entrada.value).map(function(t){
    if (!t.ok) return t.text;
    n += contarEn(re, t.text);
    return t.text.replace(re, repl);
  }).join('');
  if (!n) { toast('Sin coincidencias'); return; }
  entrada.value = nuevo; procesar(); rpContar(); toast((msg || 'Reemplazado') + ': ' + fmtNum(n));
}
function quitarEspaciosDatos(){
  var r = SqlFormatter.trimData(entrada.value);
  if (!r.count) { toast('No hay datos con espacios al inicio/fin'); return; }
  entrada.value = r.text; procesar(); rpContar();
  toast(r.count === 1 ? '1 dato limpiado' : fmtNum(r.count) + ' datos limpiados');
}
$('btnTrimDatos').addEventListener('click', quitarEspaciosDatos);
$('btnRP').addEventListener('click', function(){ var p = $('rp'); p.classList.toggle('on'); if (p.classList.contains('on')) { $('rpBuscar').focus(); rpContar(); } });
['rpBuscar','rpCase','rpRegex','rpAlcance'].forEach(function(id){ $(id).addEventListener('input', rpContar); $(id).addEventListener('change', rpContar); });
$('rpTodo').addEventListener('click', function(){
  var re = rpRegex(); if (!re) return;
  var r = rpRepl();
  aplicar(re, r, 'Reemplazadas');
});
$('rpSig').addEventListener('click', function(){
  var re = rpRegex(); if (!re) return;
  re.lastIndex = entrada.selectionEnd || 0;
  var m = re.exec(entrada.value);
  if (!m) { re.lastIndex = 0; m = re.exec(entrada.value); }
  if (!m) { toast('Sin coincidencias'); return; }
  entrada.focus(); entrada.setSelectionRange(m.index, m.index + m[0].length);
  var linea = entrada.value.slice(0, m.index).split('\n').length;
  entrada.scrollTop = Math.max(0, (linea - 3) * 19.5);
});
$('rpBuscar').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); $('rpSig').click(); } });
$('rpReemplazar').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); $('rpTodo').click(); } });
$('rpUsar').addEventListener('click', function(){ if (resultado) { entrada.value = resultado.text; pintarCapa(); toast('Resultado pasado a la entrada'); rpContar(); } });
document.querySelector('.rp-row .presets').parentNode.addEventListener('click', function(e){
  var b = e.target.closest('button[data-p]'); if (!b) return;
  // Trabaja sobre el resultado formateado si existe, para no tocar el texto entre comillas por error
  var p = b.getAttribute('data-p');
  if (p === 'datos') quitarEspaciosDatos();
  else if (p === 'dobles') aplicar(/[ \t]{2,}/g, function(){ return ' '; }, 'Espacios dobles');
  else if (p === 'extremos') aplicar(/^[ \t]+|[ \t]+$/gm, function(){ return ''; }, 'Líneas limpiadas');
  else if (p === 'guion') aplicar(/[ \t]+/g, function(){ return '_'; }, 'Espacios reemplazados');
  else if (p === 'todos') {
    if (confirm('Esto quita TODOS los espacios, incluso los de dentro de los textos y entre palabras (SELECT a FROM t quedaría SELECTaFROMt). ¿Continuar?')) aplicar(/[ \t]+/g, function(){ return ''; }, 'Espacios quitados');
  }
});

/* ---------- lista de datos (comillas y paréntesis) ---------- */
var lsEnt = $('lsEntrada');
var cursorListo = false; // el usuario ya hizo clic en el SQL
entrada.addEventListener('focus', function(){ cursorListo = true; });

function lsEsNum(s){ return /^-?\d+(\.\d+)?$/.test(s) && !/^0\d/.test(s); }
function lsEnvolver(x, q, nums){
  if (q === '' || (nums && lsEsNum(x))) return x;
  return q + x.split(q).join(q + q) + q; // ' -> ''   |   " -> ""
}
function lsOrdenar(a, b){ return a.localeCompare(b, undefined, { numeric: true }); }
function lsUnicos(arr){ var vistos = {}; return arr.filter(function(x){ if (vistos.hasOwnProperty(x)) return false; vistos[x] = 1; return true; }); }

function lsGenerar(){
  var texto = lsEnt.value, modo = $('lsParent').value, q = $('lsComillas').value,
      nums = $('lsNums').checked, mayus = $('lsMayus').checked;
  if (!texto.trim()) return { text: '', total: 0 };
  var items;
  if (modo === 'filas') {
    // cada línea de Excel es una fila; las columnas vienen separadas por tabulador
    items = texto.split(/\r?\n/).filter(function(l){ return l.trim() !== ''; }).map(function(f){
      return '(' + f.split('\t').map(function(c){
        c = c.trim(); if (mayus) c = c.toUpperCase();
        return lsEnvolver(c, q, nums);
      }).join(',') + ')';
    });
    if ($('lsDups').checked) items = lsUnicos(items);
    if ($('lsOrden').checked) items.sort(lsOrden);
    return { text: items.join(','), total: items.length };
  }
  var datos = texto.split($('lsSep').value === 'lineas' ? /\r?\n/ : /[\r\n,;\t]+/)
    .map(function(x){ return x.trim(); }).filter(function(x){ return x !== ''; });
  if (mayus) datos = datos.map(function(x){ return x.toUpperCase(); });
  if ($('lsDups').checked) datos = lsUnicos(datos);
  if ($('lsOrden').checked) datos.sort(lsOrden);
  items = datos.map(function(x){ return lsEnvolver(x, q, nums); });
  var out;
  if (modo === 'cada') out = items.map(function(x){ return '(' + x + ')'; }).join(',');
  else if (modo === 'todo') out = '(' + items.join(',') + ')';
  else out = items.join(',');
  return { text: out, total: datos.length };
}

// Si el cursor ya está dentro de un ( ) no se duplican los paréntesis
function lsAjustar(valor, antes, despues){
  if ($('lsParent').value === 'todo' && /\(\s*$/.test(antes) && /^\s*\)/.test(despues) &&
      valor.charAt(0) === '(' && valor.charAt(valor.length - 1) === ')') return valor.slice(1, -1);
  return valor;
}

function lsActualizar(){
  var r = lsGenerar();
  $('lsCnt').textContent = r.total ? fmtNum(r.total) + (r.total === 1 ? ' dato' : ' datos') : '';
  $('lsPrev').textContent = r.text.length > 160 ? r.text.slice(0, 160) + '…' : r.text;
  $('lsPrev').title = r.text.length > 160 ? 'Vista previa (recortada)' : '';
}

function lsInsertar(){
  var r = lsGenerar();
  if (!r.text) { toast('Pega primero los datos de la lista'); return; }
  var v = entrada.value, nuevo, n = 0;
  if (/\{LISTA\}/i.test(v)) {
    nuevo = v.replace(/\{LISTA\}/gi, function(m, off, str){
      n++; return lsAjustar(r.text, str.slice(0, off), str.slice(off + m.length));
    });
    toast(n === 1 ? 'Lista puesta en {LISTA}' : 'Lista puesta en ' + n + ' marcadores {LISTA}');
  } else if (v.trim() === '') {
    nuevo = r.text; toast('Lista insertada');
  } else if (!cursorListo) {
    toast('Haz clic en el SQL donde va la lista, o escribe {LISTA}'); return;
  } else {
    var a = entrada.selectionStart, b = entrada.selectionEnd;
    var val = lsAjustar(r.text, v.slice(0, a), v.slice(b));
    nuevo = v.slice(0, a) + val + v.slice(b);
    entrada.value = nuevo; entrada.setSelectionRange(a + val.length, a + val.length);
    clearTimeout(temporizador); procesar(); toast('Lista insertada en el cursor'); return;
  }
  entrada.value = nuevo; clearTimeout(temporizador); procesar();
}

$('btnLS').addEventListener('click', function(){ var p = $('ls'); p.classList.toggle('on'); if (p.classList.contains('on')) lsEnt.focus(); });
['lsEntrada','lsSep','lsComillas','lsParent','lsDups','lsNums','lsMayus','lsOrden'].forEach(function(id){
  $(id).addEventListener('input', lsActualizar); $(id).addEventListener('change', lsActualizar);
});
$('lsInsertar').addEventListener('click', lsInsertar);
$('lsCopiar').addEventListener('click', function(){ var r = lsGenerar(); if (r.text) copiar(r.text, 'Lista copiada'); else toast('Pega primero los datos de la lista'); });
$('lsLimpiar').addEventListener('click', function(){ lsEnt.value = ''; lsActualizar(); lsEnt.focus(); });

