<script>
(function(){
'use strict';

var LOTE = 1500; // líneas dibujadas por bloque
var $ = function(id){ return document.getElementById(id); };
var entrada = $('entrada');
var opts = { kw: 'upper', perRow: 10, indent: '4', selectMode: 'one', vista: 'format' };
var resultado = null;   // { text, statements, warnings }
var lineasHtml = [];    // líneas ya coloreadas
var dibujadas = 0;
var lineasTxt = [];     // texto plano de cada línea (para filtrar)
var visibles = null;    // null = todas las líneas; si no, índices de las que pasan el filtro
var filtroRe = null;    // para marcar lo encontrado
var temporizador;

/* ---------- opciones (se recuerdan en este navegador) ---------- */
try {
  var guardado = JSON.parse(localStorage.getItem('boveda-sql-opts') || 'null');
  if (guardado) { for (var k in opts) if (guardado[k] !== undefined) opts[k] = guardado[k]; }
} catch (e) {}
function guardarOpts(){ try { localStorage.setItem('boveda-sql-opts', JSON.stringify(opts)); } catch (e) {} }

function marcar(segId, valor){
  var bs = $(segId).querySelectorAll('button');
  for (var i = 0; i < bs.length; i++) bs[i].classList.toggle('active', bs[i].getAttribute('data-v') === valor);
}
function pintarOpts(){
  marcar('segKw', opts.kw); marcar('segSel', opts.selectMode); marcar('segVista', opts.vista);
  if ($('perRow')) $('perRow').value = opts.perRow;
  if ($('indent')) $('indent').value = opts.indent;

  // Sincronizar botón y opciones de cantidad por fila en la barra
  var txtDd = $('txtDdPerRow');
  if (txtDd) {
    txtDd.textContent = opts.perRow;
  }
  var btnDd = $('btnDdPerRow');
  if (btnDd) {
    btnDd.title = 'Campos por fila: ' + opts.perRow + ' (Clic para cambiar)';
  }
  var menuPR = $('menuPerRow');
  if (menuPR) {
    var matched = false;
    menuPR.querySelectorAll('.perrow-opt').forEach(function(b){
      var v = b.getAttribute('data-val');
      if (v === String(opts.perRow)) {
        b.classList.add('active');
        matched = true;
      } else {
        b.classList.remove('active');
      }
    });
    if (!matched) {
      var customBtn = menuPR.querySelector('.perrow-opt[data-val="custom"]');
      if (customBtn) customBtn.classList.add('active');
    }
  }

  // Sincronizar botones chips del sidebar
  document.querySelectorAll('.btn-perrow-chip').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-n') === String(opts.perRow));
  });
}
pintarOpts();

/* ---------- utilidades ---------- */
function esc(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function fmtNum(n){ return Number(n).toLocaleString('es-CO'); }
function fmtTam(n){ return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : (n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' caracteres'); }

var toastT;
function toast(msg){
  var t = $('toast'); t.textContent = msg || 'Copiado'; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(function(){ t.classList.remove('show'); }, 1500);
}
function copiarViejo(texto){
  var ta = document.createElement('textarea'); ta.value = texto; document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } catch (e) {} document.body.removeChild(ta);
}
function copiar(texto, msg){
  var fin = function(){ toast(msg || 'Copiado'); };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(texto).then(fin, function(){ copiarViejo(texto); fin(); });
  } else { copiarViejo(texto); fin(); }
}

/* ---------- coloreado (no modifica el texto, solo lo pinta) ---------- */
var SS = window.SqlSentencias || null; // catálogo (public/sql-sentencias.js)
var RE_HL = /(--[^\n]*|\/\*[\s\S]*?(?:\*\/|$))|((?:[eEnNbBxX])?'(?:[^']|'')*(?:'|$)|(\$[A-Za-z_\u00C0-\u024F]*\$)[\s\S]*?(?:\3|$))|("(?:[^"]|"")*(?:"|$))|(::)|(\$\d+)|(\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b|\.\d+\b)|([A-Za-z_\u00C0-\u024F][\w$\u00C0-\u024F]*)|([\s\S])/g;
function resaltar(texto){
  var lineas = [''], m, cls, partes, j, prev = '', prevCh = '';
  RE_HL.lastIndex = 0;
  while ((m = RE_HL.exec(texto)) !== null) {
    if (m[0] === '') { RE_HL.lastIndex++; continue; }
    cls = '';
    if (m[1]) cls = 'tk-cm';
    else if (m[2]) cls = 'tk-st';
    else if (m[4]) cls = 'tk-qi';
    else if (m[6]) cls = 'tk-pa';
    else if (m[7]) cls = 'tk-nu';
    else if (m[8] && prevCh !== '.') {
      if (SS) {
        var c = SS.clasificar(m[8], /^\s*\(/.test(texto.substr(RE_HL.lastIndex, 24)), prev === '::');
        if (c) cls = 'tk-' + c;
      } else if (SqlFormatter.KEYWORDS[m[8].toUpperCase()]) cls = 'tk-kw';
    }
    if (!m[1] && m[0].trim() !== '') { prev = m[0]; prevCh = m[0].charAt(m[0].length - 1); }
    partes = m[0].split('\n');
    for (j = 0; j < partes.length; j++) {
      if (j > 0) lineas.push('');
      if (partes[j] !== '') {
        var inner = esc(partes[j]);
        if (cls === 'tk-st' && partes.length === 1) {
          var pm = /^([eEnNbBxX]?')([ \t]*)([\s\S]*?)([ \t]*)('?)$/.exec(partes[j]);
          if (pm && (pm[2] || pm[4])) {
            inner = esc(pm[1]) +
              (pm[2] ? '<span class="tk-sp" title="Espacio dentro del dato">' + esc(pm[2]) + '</span>' : '') +
              esc(pm[3]) +
              (pm[4] ? '<span class="tk-sp" title="Espacio dentro del dato">' + esc(pm[4]) + '</span>' : '') +
              esc(pm[5]);
          }
        }
        lineas[lineas.length - 1] += cls ? '<span class="' + cls + '">' + inner + '</span>' : inner;
      }
    }
  }
  return lineas;
}

function decod(t){ return t.replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&'); }
var smartRe = null;
function marcarHtml(html){
  return html.split(/(<[^>]*>)/).map(function(p){
    if (p.charAt(0) === '<' || !p) return p;
    var t = decod(p), out = '', ult = 0, m;
    var re = filtroRe || smartRe;
    if (!re) return esc(t);
    re.lastIndex = 0;
    while ((m = re.exec(t)) !== null) {
      if (m[0] === '') { re.lastIndex++; continue; }
      var clase = (smartRe && !filtroRe) ? 'class="smart-hl"' : '';
      out += esc(t.slice(ult, m.index)) + '<mark ' + clase + '>' + esc(m[0]) + '</mark>';
      ult = m.index + m[0].length;
    }
    return out + esc(t.slice(ult));
  }).join('');
}

function dibujarLote(){
  var cont = $('codigo'), viejo = cont.querySelector('.more'), html = '', fin, i, li;
  var total = visibles ? visibles.length : lineasHtml.length;
  if (viejo) viejo.remove();
  fin = Math.min(dibujadas + LOTE, total);
  for (i = dibujadas; i < fin; i++) {
    li = visibles ? visibles[i] : i;
    html += '<div class="code-line"><span class="ln">' + (li + 1) + '</span><span class="code-text">' + (((filtroRe || smartRe) ? marcarHtml(lineasHtml[li]) : lineasHtml[li]) || ' ') + '</span></div>';
  }
  cont.insertAdjacentHTML('beforeend', html);
  dibujadas = fin;
  if (dibujadas < total) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'secondary more';
    b.textContent = 'Mostrar ' + fmtNum(Math.min(LOTE, total - dibujadas)) + ' líneas más (' + fmtNum(total - dibujadas) + ' sin mostrar)';
    b.addEventListener('click', dibujarLote);
    cont.appendChild(b);
  }
}

/* ---------- filtro de líneas ---------- */
function aplicarFiltro(){
  var q = $('filtro').value, cnt = $('filtroCnt'), cont = $('codigo');
  filtroRe = null; visibles = null;
  if (q.trim() && lineasTxt.length) {
    var ql = q.toLowerCase();
    filtroRe = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
    visibles = [];
    for (var i = 0; i < lineasTxt.length; i++) if (lineasTxt[i].toLowerCase().indexOf(ql) !== -1) visibles.push(i);
    cnt.textContent = visibles.length ? fmtNum(visibles.length) + ' de ' + fmtNum(lineasTxt.length) + ' líneas' : 'Sin resultados';
  } else { cnt.textContent = ''; }
  $('bCopiarFiltro').style.display = visibles ? '' : 'none';
  dibujadas = 0;
  cont.innerHTML = '';
  if (visibles && !visibles.length) { cont.innerHTML = '<div class="sin-res">Ninguna línea contiene «' + esc(q) + '».</div>'; return; }
  dibujarLote();
}

/* ---------- formateo ---------- */
function procesar(){
  pintarCapa();
  var src = entrada.value;
  if (!src.trim()) {
    resultado = null; $('salida').classList.remove('on'); $('avisoDatos').style.display = 'none';
    var c = $('chipVacio'); c.className = 'chip info'; c.textContent = 'Pega o abre un archivo';
    if (typeof revisarSqlEnVivo === 'function') revisarSqlEnVivo();
    return;
  }
  var r;
  try {
    r = opts.vista === 'min' ? SqlFormatter.minify(src, opts) : SqlFormatter.format(src, opts);
  } catch (e) {
    resultado = null;
    $('salida').classList.add('on');
    $('status').innerHTML = '<span class="chip bad">Error al formatear</span>';
    $('aviso').style.display = 'block'; $('aviso').textContent = String(e && e.message || e);
    $('codigo').innerHTML = '';
    if (typeof revisarSqlEnVivo === 'function') revisarSqlEnVivo();
    return;
  }
  resultado = r;

  $('salida').classList.add('on');
  var chip = $('chipVacio');
  chip.className = 'chip' + (r.warnings.length ? ' bad' : ''); chip.textContent = r.warnings.length ? 'Revisa los avisos' : 'Listo';

  var nLineas = r.text ? r.text.split('\n').length : 0;
  var ahorro = src.length - r.text.length;
  $('status').innerHTML =
    '<span class="chip">' + fmtNum(r.statements) + (r.statements === 1 ? ' sentencia' : ' sentencias') + '</span>' +
    '<span class="chip info">' + fmtNum(nLineas) + ' líneas</span>' +
    '<span class="chip info">Entrada: ' + fmtTam(src.length) + '</span>' +
    '<span class="chip info">Salida: ' + fmtTam(r.text.length) + '</span>';

  var av = $('aviso');
  if (r.warnings.length) {
    av.style.display = 'block';
    av.innerHTML = '<strong>Avisos sobre el SQL (se formateó igual):</strong><ul>' + r.warnings.map(function(w){ return '<li>' + esc(w) + '</li>'; }).join('') + '</ul>';
  } else { av.style.display = 'none'; }

  var np = SqlFormatter.paddedCount(r.text), ad = $('avisoDatos');
  if (np) {
    ad.style.display = 'flex';
    $('avisoDatosTxt').textContent = np === 1
      ? 'Hay 1 dato con espacios al inicio o al final (marcado en naranja). Se respetó tal cual.'
      : 'Hay ' + fmtNum(np) + ' datos con espacios al inicio o al final (marcados en naranja). Se respetaron tal cual.';
  } else { ad.style.display = 'none'; }

  lineasHtml = resaltar(r.text);
  lineasTxt = r.text.split('\n');
  aplicarFiltro();

  var txt = entrada.value.trim();
  if (txt.length > 10) {
    try {
      var hist = JSON.parse(localStorage.getItem('sql_historial') || '[]');
      if (hist[0] !== txt) {
        hist.unshift(txt);
        if (hist.length > 20) hist.pop();
        localStorage.setItem('sql_historial', JSON.stringify(hist));
        actualizarSidebarHistorial();
      }
    } catch(e) {}
  }

  if (typeof revisarSqlEnVivo === 'function') revisarSqlEnVivo();
}

