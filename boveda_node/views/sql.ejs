/* ---------- tablas y columnas de la base de datos (public/sql-tablas.js y public/sql-columnas.js) ---------- */
var TABLAS = (window.SQL_TABLAS || []), TABLAS_L = TABLAS.map(function(t){ return t.toLowerCase(); });
var COLUMNAS = (window.SQL_COLUMNAS || {});

// Detectar tablas y alias en la sentencia actual alrededor del cursor
function detectarTablasEnSentencia(pos){
  var v = entrada.value;
  var desde = v.lastIndexOf(';', pos - 1) + 1;
  var hasta = v.indexOf(';', pos);
  if (hasta < 0) hasta = v.length;
  var sql = v.slice(desde, hasta);

  var tablas = [];
  var aliasMap = {};

  var re = /\b(?:from|join|into|update)\s+([A-Za-z_][A-Za-z0-9_]*)(?:\s+(?:as\s+)?([A-Za-z_][A-Za-z0-9_]*))?/gi;
