/* ---------- formateo en el editor y eventos ---------- */
function formatearEditor(mensajeToast) {
  var src = entrada.value;
  if (!src.trim()) {
    toast('Pega o escribe tu SQL primero');
    return;
  }
  try {
    var r = opts.vista === 'min' ? SqlFormatter.minify(src, opts) : SqlFormatter.format(src, opts);
    if (r && r.text) {
      if (r.text !== src) {
        // Intentar preservar historial de Ctrl+Z con execCommand
        entrada.focus();
        entrada.select();
        var aplicado = false;
        try {
          aplicado = document.execCommand('insertText', false, r.text);
        } catch(e) {}
        if (!aplicado || entrada.value !== r.text) {
          entrada.value = r.text;
        }
        localStorage.setItem('boveda-sql-draft', r.text);
      }
      procesar();
      toast(mensajeToast || ('SQL Formateado (' + opts.perRow + ' campos por línea)'));
    }
  } catch(e) {
    procesar();
    toast('Error al formatear: ' + (e && e.message || e));
  }
}

