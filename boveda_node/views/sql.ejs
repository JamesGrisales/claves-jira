/* ==========================================================================
   MENÚ CONTEXTUAL PERSONALIZADO (CLIC DERECHO EN EL EDITOR)
   ========================================================================== */
(function setupContextMenu() {
  var menu = $('sqlContextMenu');
  if (!menu) return;

  function closeMenu() {
    menu.style.display = 'none';
  }

  function openMenu(e) {
    e.preventDefault();
    if (diagActual && $('ctxBadgeErrores')) {
      $('ctxBadgeErrores').style.display = diagActual.errorsCount > 0 ? 'inline-block' : 'none';
      $('ctxBadgeErrores').textContent = diagActual.errorsCount;
    }
    menu.style.display = 'flex';
    var menuW = menu.offsetWidth || 250;
    var menuH = menu.offsetHeight || 380;
    var x = Math.min(e.clientX, window.innerWidth - menuW - 12);
    var y = Math.min(e.clientY, window.innerHeight - menuH - 12);
    menu.style.left = Math.max(8, x) + 'px';
    menu.style.top = Math.max(8, y) + 'px';
  }

  // Activar clic derecho en la caja del editor y en el visor de salida
  ['entrada', 'edBox', 'codigo'].forEach(function(id) {
    var el = $(id);
    if (el) el.addEventListener('contextmenu', openMenu);
  });

  // Opciones del menú
  $('ctxFormatear').onclick = function() { closeMenu(); formatearEditor(); };
  $('ctxRevisar').onclick = function() {
    closeMenu();
    Object.keys(PANELES).forEach(function(o){ if ($(PANELES[o])) $(PANELES[o]).classList.remove('on'); });
    $('rv').classList.add('on');
    actualizarBotonesPaneles();
    revisarSqlEnVivo();
    $('rv').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };
  $('ctxPresetEstandar').onclick = function() { closeMenu(); aplicarEstiloPreset('estandar'); };
  $('ctxPresetExpandido').onclick = function() { closeMenu(); aplicarEstiloPreset('expandido'); };
  if ($('ctxPreset5Col')) $('ctxPreset5Col').onclick = function() { closeMenu(); aplicarEstiloPreset('5col'); };
  if ($('ctxPreset8Col')) $('ctxPreset8Col').onclick = function() { closeMenu(); aplicarEstiloPreset('8col'); };
  if ($('ctxPresetCustom')) $('ctxPresetCustom').onclick = function() { closeMenu(); aplicarEstiloPreset('custom'); };
  $('ctxPresetCompacto').onclick = function() { closeMenu(); aplicarEstiloPreset('compacto'); };
  $('ctxMayusculas').onclick = function() { closeMenu(); aplicarEstiloPreset('mayusculas'); };
  $('ctxMinusculas').onclick = function() { closeMenu(); aplicarEstiloPreset('minusculas'); };
  $('ctxComentarios').onclick = function() { closeMenu(); $('btnComentarios').click(); };
  $('ctxCopiar').onclick = function() { closeMenu(); copiar(entrada.value, 'SQL copiado'); };
  $('ctxPegar').onclick = function() {
    closeMenu();
    if (navigator.clipboard && navigator.clipboard.readText) {
      navigator.clipboard.readText().then(function(clip) {
        insertarTexto(clip);
        procesar();
        toast('Pegado desde portapapeles');
      }).catch(function() {
        toast('Usa Ctrl+V para pegar');
      });
    } else {
      toast('Usa Ctrl+V para pegar');
    }
  };
  $('ctxLimpiar').onclick = function() { closeMenu(); $('btnLimpiar').click(); };

  // Cerrar al hacer clic fuera, scroll o Esc
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#sqlContextMenu')) closeMenu();
  });
  window.addEventListener('scroll', closeMenu, true);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Esc') closeMenu();
  });
})();

/* Botón para ocultar/mostrar opciones del toolbar SQL sin tocar el menú principal */
var btnOpc = $('btnToggleOpciones');
var vTb = $('vToolbar');
if (btnOpc && vTb) {
  function syncOpcBtn() {
    var isHidden = vTb.classList.contains('opciones-ocultas');
    btnOpc.classList.toggle('active', isHidden);
    var txt = $('txtToggleOpciones');
    if (txt) txt.textContent = isHidden ? 'Mostrar opciones' : 'Ocultar opciones';
  }
  btnOpc.addEventListener('click', function(){
    vTb.classList.toggle('opciones-ocultas');
    syncOpcBtn();
  });
  syncOpcBtn();
}
// Menú principal respeta la preferencia y estado mini-dock predeterminado

/* ---------- atajos de teclado ---------- */
entrada.addEventListener('keydown', function(e){
  var k = e.key.toLowerCase();
  if ((e.ctrlKey || e.metaKey) && e.shiftKey && k === 'f') { e.preventDefault(); clearTimeout(temporizador); formatearEditor(); }
  else if ((e.ctrlKey || e.metaKey) && e.shiftKey && k === 'r') { e.preventDefault(); $('btnRV').click(); }
  else if ((e.ctrlKey || e.metaKey) && !e.shiftKey && k === 'h') { e.preventDefault(); $('btnRP').click(); }
  else if ((e.ctrlKey || e.metaKey) && !e.shiftKey && k === 'm') { e.preventDefault(); if ($('btnToggleOpciones')) $('btnToggleOpciones').click(); }
});
document.addEventListener('keydown', function(e){
  var k = e.key.toLowerCase();
  if ((e.ctrlKey || e.metaKey) && e.shiftKey && k === 'f' && e.target !== entrada) { e.preventDefault(); clearTimeout(temporizador); formatearEditor(); }
  else if ((e.ctrlKey || e.metaKey) && e.shiftKey && k === 'r' && e.target !== entrada) { e.preventDefault(); $('btnRV').click(); }
  else if ((e.ctrlKey || e.metaKey) && !e.shiftKey && k === 'm' && e.target !== entrada) { e.preventDefault(); if ($('btnToggleOpciones')) $('btnToggleOpciones').click(); }
});

// Inicialización de revisión
revisarSqlEnVivo();

})();
</script>
