// Pantalla completa (ampliar): abre todo el entorno integrado. Esc para salir
var edEntradaPadre = null, edEntradaHermano = null;
function ampliar(){
  var ed1 = $('edEntrada');
  if (!ed1) return;
  var on = !ed1.classList.contains('fullscreen');
  salirAmpliado();
  if (on) {
    edEntradaPadre = ed1.parentNode; edEntradaHermano = ed1.nextSibling;
    document.body.appendChild(ed1);
    ed1.classList.add('fullscreen');
    document.body.classList.add('amp');
    document.body.style.overflow = 'hidden';
    $('btnAmpliarEntrada').innerHTML = '<svg viewBox="0 0 24 24" style="width:15px;height:15px;"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="14" y1="10" x2="21" y2="3"/><line x1="3" y1="21" x2="10" y2="14"/></svg>Salir';
    entrada.focus();
  }
}
function salirAmpliado(){
  var ed1 = $('edEntrada');
  if (!ed1) return;
  ed1.classList.remove('fullscreen');
  document.body.classList.remove('amp');
  document.body.style.overflow = '';
  $('btnAmpliarEntrada').innerHTML = '<svg viewBox="0 0 24 24" style="width:15px;height:15px;"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>Ampliar';
  if (edEntradaPadre) {
    edEntradaPadre.insertBefore(ed1, edEntradaHermano);
    edEntradaPadre = null;
  }
}
$('btnAmpliarEntrada').addEventListener('click', ampliar);
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') salirAmpliado(); });

/* ---------- editor estilo pgAdmin ---------- */
var capa = $('capa'), gut = $('gut'), gutIn = $('gutIn'), curl = $('curline'), brk1 = $('brk1'), brk2 = $('brk2'), phs = $('phs'), acBox = $('ac'), edEstado = $('edEstadoPos'), edBox = $('edBox'), mcLayer = $('mcLayer');
var capaTexto = null, rafCapa = 0, rafDec = 0, LIMITE_CAPA = 120000, gutLineas = 0, met = null;
var ses = null;                                  // sesión de plantilla (huecos con Tab)
var ac = { abierto: false, items: [], idx: 0, inicio: 0, navegado: false };
var sinAuto = false;

function metricas(){
  if (met && met.cw > 1) return met;
  var cs = getComputedStyle(entrada), sp = document.createElement('span');
  sp.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;font-family:' + cs.fontFamily + ';font-size:' + cs.fontSize + ';letter-spacing:' + cs.letterSpacing;
  sp.textContent = new Array(81).join('M'); document.body.appendChild(sp);
  var cw = sp.getBoundingClientRect().width / 80; document.body.removeChild(sp);
  met = { cw: cw, lh: parseFloat(cs.lineHeight) || 19.5, pl: parseFloat(cs.paddingLeft) || 14, pt: parseFloat(cs.paddingTop) || 12 };
  return met;
}
function colVisual(txt){ var c = 0, i; for (i = 0; i < txt.length; i++) c += txt.charCodeAt(i) === 9 ? 4 - (c % 4) : 1; return c; }
function lineaCol(v, idx){
  var antes = v.slice(0, idx), n = 0, i = -1;
  while ((i = antes.indexOf('\n', i + 1)) >= 0) n++;
  var ini = antes.lastIndexOf('\n') + 1;
  return { linea: n, texto: antes.slice(ini) };
}
function xyDe(v, idx){
  var m = metricas(), p = lineaCol(v, idx);
  return { x: m.pl + colVisual(p.texto) * m.cw - entrada.scrollLeft, y: m.pt + p.linea * m.lh - entrada.scrollTop };
}

/* números de línea + colores detrás del texto */
function pintarCapa(){
  var v = entrada.value;
  if (v === capaTexto) return;
  capaTexto = v;
  var n = 1, i = -1; while ((i = v.indexOf('\n', i + 1)) >= 0) n++;
  if (n !== gutLineas) {
    gutLineas = n; var a = new Array(n), k;
    for (k = 0; k < n; k++) a[k] = k + 1;
    gutIn.textContent = a.join('\n');
    gut.style.width = (Math.max(2, String(n).length) * metricas().cw + 26) + 'px';
  }
  if (v.length > LIMITE_CAPA) { edBox.classList.add('plain'); sincronizarEditor(); return; }
  edBox.classList.remove('plain');
  capa.innerHTML = resaltar(v).join('\n') + ' ';
  sincronizarEditor();
}
function sincronizarEditor(){
  capa.scrollTop = entrada.scrollTop; capa.scrollLeft = entrada.scrollLeft;
  gutIn.style.transform = 'translateY(' + (-entrada.scrollTop) + 'px)';
  decorar();
  if (typeof renderizarMultiCursores === 'function') renderizarMultiCursores();
}
function pintarCapaRapido(){ if (!rafCapa) rafCapa = requestAnimationFrame(function(){ rafCapa = 0; pintarCapa(); }); }
function decorarRapido(){ if (!rafDec) rafDec = requestAnimationFrame(function(){ rafDec = 0; decorar(); }); }

/* línea actual, paréntesis que se corresponden y huecos de la plantilla */
var APERT = { '(': ')', '[': ']' }, CIERRA = { ')': '(', ']': '[' };
function buscarPar(v, pos){
  var ch = v.charAt(pos), dir = APERT[ch] ? 1 : -1, objetivo = dir === 1 ? APERT[ch] : CIERRA[ch], prof = 0, i, k = 0, c;
  for (i = pos; i >= 0 && i < v.length && k < 20000; i += dir, k++) {
    c = v.charAt(i);
    if (c === ch) prof++; else if (c === objetivo) { prof--; if (prof === 0) return i; }
  }
  return -1;
}
function caja(el, x, y, w){ var m = metricas(); el.style.display = 'block'; el.style.left = x + 'px'; el.style.top = y + 'px'; el.style.width = w + 'px'; el.style.height = m.lh + 'px'; }
function decorar(){
  var m = metricas(), v = entrada.value, s = entrada.selectionStart, e = entrada.selectionEnd, p = lineaCol(v, s), enfocado = document.activeElement === entrada;
  var badgeHtml = (typeof multiCursores !== 'undefined' && multiCursores.length > 1) ? '<span class="mc-badge">⚡ ' + multiCursores.length + ' cursores</span> ' : '';
  edEstado.innerHTML = badgeHtml + 'Ln <b>' + (p.linea + 1) + '</b>, Col <b>' + (p.texto.length + 1) + '</b>' + (e > s ? ' · <b>' + (e - s) + '</b> seleccionados' : '') + ' · ' + fmtNum(gutLineas) + ' líneas · ' + fmtNum(v.length) + ' caracteres';
  var y = m.pt + p.linea * m.lh - entrada.scrollTop;
  if (enfocado && s === e) { curl.style.display = 'block'; curl.style.top = y + 'px'; curl.style.height = m.lh + 'px'; } else curl.style.display = 'none';
  brk1.style.display = brk2.style.display = 'none';
  if (enfocado && s === e && v.length < 400000) {
    var pos = -1;
    if (CIERRA[v.charAt(s - 1)] || APERT[v.charAt(s - 1)]) pos = s - 1; else if (CIERRA[v.charAt(s)] || APERT[v.charAt(s)]) pos = s;
    if (pos >= 0) {
      var otro = buscarPar(v, pos), a1 = xyDe(v, pos);
      caja(brk1, a1.x, a1.y, m.cw); brk1.className = 'brk' + (otro < 0 ? ' mal' : '');
      if (otro >= 0) { var a2 = xyDe(v, otro); caja(brk2, a2.x, a2.y, m.cw); brk2.className = 'brk'; }
    }
  }
  // huecos pendientes de la plantilla
  var cajas = phs.children, i, r, xy, ancho;
  for (i = 0; i < cajas.length; i++) cajas[i].style.display = 'none';
  if (ses) {
    for (i = 0; i < ses.rangos.length; i++) {
      r = ses.rangos[i];
      if (i === ses.idx || r.b <= r.a) continue;
      while (phs.children.length <= i) { var d = document.createElement('div'); d.className = 'ph'; phs.appendChild(d); }
      xy = xyDe(v, r.a); ancho = colVisual(v.slice(r.a, r.b)) * m.cw;
      caja(phs.children[i], xy.x, xy.y, ancho);
    }
  }
}

/* escribir con soporte de deshacer (Ctrl+Z) */
function insertarTexto(t){
  entrada.focus({ preventScroll: true });
  var ok = false;
  try { ok = document.execCommand('insertText', false, t); } catch (x) {}
  if (!ok || entrada.value.indexOf(t) < 0) {
    if (!ok) { var s = entrada.selectionStart, e = entrada.selectionEnd; entrada.setRangeText(t, s, e, 'end'); entrada.dispatchEvent(new Event('input', { bubbles: true })); }
  }
}
function borrarSeleccion(){
  entrada.focus({ preventScroll: true });
  var ok = false; try { ok = document.execCommand('delete'); } catch (x) {}
  if (!ok) { entrada.setRangeText('', entrada.selectionStart, entrada.selectionEnd, 'end'); entrada.dispatchEvent(new Event('input', { bubbles: true })); }
}

/* ---------- plantillas con huecos ({{campo}}) ---------- */
function insertarSnippet(code, frag, reemplazar){
  var v = entrada.value, a, b, prefijo = '';
  if (reemplazar) { a = reemplazar[0]; b = reemplazar[1]; }
  else if (v.trim() !== '' && !cursorListo) { a = b = v.length; prefijo = /\n\s*$/.test(v) ? (/\n\s*\n\s*$/.test(v) ? '' : '\n') : '\n\n'; }
  else { a = entrada.selectionStart; b = entrada.selectionEnd; }
  var antes = v.slice(0, a), iniLinea = antes.lastIndexOf('\n') + 1, tramo = antes.slice(iniLinea), ind = /^[ \t]*/.exec(tramo)[0];
  if (!frag && !prefijo && tramo.trim() !== '') { prefijo = '\n\n'; ind = ''; }
  var texto = prefijo + code.split('\n').join('\n' + ind), res = '', pos = 0, rangos = [];
  texto.replace(/\{\{([^{}]*)\}\}/g, function(mm, nombre, off){
    res += texto.slice(pos, off); var ini = res.length; res += nombre; rangos.push({ a: ini, b: ini + nombre.length }); pos = off + mm.length; return mm;
  });
  res += texto.slice(pos);
  sinAuto = true; cerrarAuto();
  entrada.setSelectionRange(a, b); insertarTexto(res);
  sinAuto = false;
  rangos = rangos.map(function(r){ return { a: a + r.a, b: a + r.b }; });
  if (rangos.length) {
    ses = { rangos: rangos, idx: 0, fin: a + res.length, len: entrada.value.length };
    entrada.setSelectionRange(rangos[0].a, rangos[0].b);
  } else { ses = null; entrada.setSelectionRange(a + res.length, a + res.length); }
  decorar();
}
function saltarHueco(dir){
  if (!ses) return;
  var n = ses.idx + dir;
  if (n < 0) n = 0;
  if (n >= ses.rangos.length) { var f = ses.fin; ses = null; entrada.setSelectionRange(f, f); decorar(); return; }
  ses.idx = n; entrada.setSelectionRange(ses.rangos[n].a, ses.rangos[n].b); decorar();
}
function ajustarSesion(){
  if (!ses) return;
  var d = entrada.value.length - ses.len; ses.len = entrada.value.length;
  if (d === 0) return;
  var r = ses.rangos[ses.idx], c = entrada.selectionStart;
  if (c < r.a || c > r.b + d) { ses = null; return; }
  var viejoB = r.b; r.b += d;
  ses.rangos.forEach(function(x, i){ if (i !== ses.idx && x.a >= viejoB) { x.a += d; x.b += d; } });
  if (ses.fin >= viejoB) ses.fin += d;
}

/* ---------- sugerencias mientras escribes ---------- */
function dentroDeTextoOComentario(linea){
  var q = 0, i, c;
  for (i = 0; i < linea.length; i++) { c = linea.charAt(i); if (c === "'") q ^= 1; else if (!q && c === '-' && linea.charAt(i + 1) === '-') return true; }
  return q === 1;
}
function palabraAntesCursor(){
  var v = entrada.value, s = entrada.selectionStart;
  if (entrada.selectionEnd !== s) return null;
  var m = /[A-Za-z_\u00C0-\u024F][\w$\u00C0-\u024F]*$/.exec(v.slice(Math.max(0, s - 60), s));
