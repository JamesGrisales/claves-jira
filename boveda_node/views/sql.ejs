  while ((m = re.exec(sql)) !== null) {
    var tbl = m[1].toLowerCase();
    var alias = (m[2] || '').toLowerCase();
    if (alias && /\b(where|on|set|inner|left|right|outer|cross|join|group|order|limit|values)\b/i.test(alias)) {
      alias = '';
    }
    if (COLUMNAS[tbl]) {
      if (tablas.indexOf(tbl) < 0) tablas.push(tbl);
      if (alias && alias !== tbl) aliasMap[alias] = tbl;
    }
  }

  // Si no encontró tablas directas por cláusula, buscar si el nombre de alguna tabla está en el texto
  if (!tablas.length) {
    for (var t in COLUMNAS) {
      if (sql.toLowerCase().indexOf(t) >= 0) {
        tablas.push(t);
        if (tablas.length >= 3) break;
      }
