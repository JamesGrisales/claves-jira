function pqCargarVend(){
  return fetch('/api/vendedores').then(function(r){ return r.json(); }).then(function(j){
    if (!j.ok) throw new Error(j.error);
    pqVend = {}; j.items.forEach(function(v){ pqVend[v.codigo.toUpperCase()] = v; });
    pqCargado = true; pqPintarLista();
  }).catch(function(){ toast('No se pudo leer la lista de vendedores'); });
