function pqLeerFilas(){   // -> { filas: [{nit, sede, cod}], malas: n }
  var filas = [], malas = 0;
  $('pqEntrada').value.split(/\r?\n/).forEach(function(linea, i){
    if (!linea.trim()) return;
    var p = linea.split(/[\t;,]+|\s+/).map(function(x){ return x.trim(); }).filter(Boolean);
    if (i === 0 && p.length && !/^\d/.test(p[0])) return;            // encabezado
    if (p.length < 3 || !/^[0-9A-Za-z.\-]+$/.test(p[0]) || !/^[0-9A-Za-z]+$/.test(p[1]) || !/^[0-9A-Za-z_.\-]+$/.test(p[2])) { malas++; return; }
    filas.push({ nit: p[0], sede: p[1], cod: p[2] });
  });
  return { filas: filas, malas: malas };
}
function pqFechaIso(v){ return v ? v.replace(/-/g, '') : ''; }

function pqGenerar(){
  var d = pqLeerFilas();
  if (!d.filas.length) return { err: d.malas ? 'Ninguna fila válida: se necesitan 3 columnas (NIT, sede, código de vendedor)' : 'Pega primero los datos (NIT, sede y código de vendedor)' };
  var tablas = PQ_TABLAS.filter(function(x){ return $('pqT_' + x.t).checked; });
  if (!tablas.length) return { err: 'Marca al menos una tabla' };

  var rango = $('pqFechaModo').value === 'rango', desde = '', hasta = '';
  if (rango) {
    desde = pqFechaIso($('pqDesde').value); hasta = pqFechaIso($('pqHasta').value);
    if (!desde || !hasta) return { err: 'Elige la fecha desde y la fecha hasta (o cambia Fechas a «Omitir»)' };
    if (desde > hasta) return { err: 'La fecha desde es mayor que la fecha hasta' };
  }
  var tipo = $('pqTipo').value.trim();
  var envolver = $('pqWrap').checked;

  // vendedores que no están en la lista
  var faltan = [], vistos = {};
  d.filas.forEach(function(f){ var k = f.cod.toUpperCase(); if (!pqVend[k] && !vistos[k]) { vistos[k] = 1; faltan.push(f.cod); } });
  var usaNombre = tablas.some(function(x){ return x.nombre; });
  if (faltan.length) { pqMostrarFaltan(faltan); if (usaNombre) return { err: 'Hay ' + faltan.length + ' código(s) sin nombre: guárdalos abajo (los ventas lo necesitan)' }; }
  else pqMostrarFaltan([]);

  var out = [], total = 0, notas = [];
  tablas.forEach(function(x){
    var desdeT = desde, hastaT = hasta;
    if (x.fecha && rango && PQ_Y[x.t]) {
      desdeT = desde > PQ_Y[x.t][0] ? desde : PQ_Y[x.t][0];
      hastaT = hasta < PQ_Y[x.t][1] ? hasta : PQ_Y[x.t][1];
      if (desdeT > hastaT) { notas.push(x.t + ' (el rango no toca ese año)'); return; }
    }
    var fechaSql = x.fecha && rango ? ' AND ' + (x.col || 'fecha') + " BETWEEN '" + desdeT + "' AND '" + hastaT + "'" : '';
    var tipoSql = x.tipo && tipo ? ' AND ' + x.tipo + "='" + pqQ(tipo) + "'" : '';
    var lineas = d.filas.map(function(f){
      var v = pqVend[f.cod.toUpperCase()], cod = pqQ(v ? v.codigo : f.cod), nit = pqQ(f.nit), sede = pqQ(f.sede), q;
      switch (x.t) {
        case 'facturac':  q = "UPDATE facturac SET vendedor='" + cod + "' WHERE NIT='" + nit + "' AND sede='" + sede + "'" + fechaSql + tipoSql + ';'; break;
        case 'dfacturac': q = "UPDATE dfacturac SET vendedor='" + cod + "' WHERE NIT='" + nit + "' AND sede='" + sede + "'" + fechaSql + tipoSql + ';'; break;
        case 'nitsx_sedes': q = "update nitsx_sedes set CODIGO_VENDEDOR='" + cod + "',codigo_cobrador='" + cod + "',codigo_vendedor1='" + cod + "' where NIT='" + nit + "' and sede='" + sede + "';"; break;
        case 'cartera_clientes': q = "UPDATE cartera_clientes SET codigo_vendedor='" + cod + "' WHERE NIT='" + nit + "' AND saldo<>0 AND sede='" + sede + "'" + fechaSql + ' ;'; break;
        case 'ventas2025':
        case 'ventas2026': q = 'UPDATE ' + x.t + " SET vendedor='" + cod + "', nvendedor='" + pqQ(v ? v.nombre : '') + "' WHERE NIT='" + nit + "' AND sede='" + sede + "'" + fechaSql + tipoSql + ';'; break;
        case 'pagos':     q = "UPDATE pagos SET vendedor='" + cod + "' WHERE nit='" + nit + "' AND sede='" + sede + "'" + fechaSql + ';'; break;
        default:          q = "UPDATE pedidos SET vendedor='" + cod + "' WHERE nit='" + nit + "' AND sede='" + sede + "' AND estado NOT IN ('F','R','T','S','E')" + fechaSql + ' ;';
      }
      return envolver ? "insert into procesar_querys (sentencia) values('" + pqQ(q) + "');" : q;
    });
    out.push('-- ' + x.t + ' (' + lineas.length + ')');
    out.push(lineas.join('\n'));
    total += lineas.length;
  });
  if (!total) return { err: 'No se generó nada: ' + notas.join(', ') };
  return { text: out.join('\n'), filas: d.filas.length, total: total, malas: d.malas, notas: notas };
}
function pqInfo(r){ return fmtNum(r.filas) + ' filas → ' + fmtNum(r.total) + ' sentencias' + (r.malas ? ' · ' + r.malas + ' fila(s) ignoradas' : '') + (r.notas.length ? ' · omitidas: ' + r.notas.join(', ') : ''); }

