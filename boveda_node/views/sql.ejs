function formatSetFijo(fijo, op){
  var colId = mxId(fijo.nombre || 'texto');
  var r = fijo.rol || 'cf';
  var vRaw = String(fijo.valor || '').trim();
  var tManual = fijo.textoManual !== undefined ? String(fijo.textoManual) : '';
  var esIns = op === 'ins';

  // Si el usuario escribió directamente una fórmula o función personalizada en la plantilla
  if (fijo.plantilla && fijo.plantilla.trim()) {
    var tpl = fijo.plantilla.trim();
    var cRef = esIns ? "''" : colId;
    var vCaso = vRaw;
    if (/caso#\{valor\}/i.test(tpl) && /^caso\s*#\s*/i.test(vCaso)) {
      vCaso = vCaso.replace(/^caso\s*#\s*/i, '');
    }
    var res = tpl
      .replace(/\{campo\}/gi, cRef)
      .replace(/\{texto\}/gi, tManual.replace(/'/g, "''"))
      .replace(/\{valor\}/g, vCaso);
    return colId + ' = ' + res;
  }

  // CONCAT + Fecha o CONCAT simple con texto manual
  if (r === 'cf' || r === 'c') {
    if (/^\s*concat\s*\(/i.test(vRaw)) return colId + ' = ' + vRaw;

    var partes = [];
    if (!esIns) {
      partes.push(colId);
    }
    if (tManual) {
      partes.push("'" + tManual.replace(/'/g, "''") + "'");
    }
    if (r === 'cf' && fijo.conFecha !== false) {
      partes.push('current_date');
    }
    if (vRaw) {
      var sep = (partes.length && !tManual.endsWith(' ') && !vRaw.startsWith(' ')) ? ' ' : '';
      partes.push("'" + sep + vRaw.replace(/'/g, "''") + "'");
    }

    if (!partes.length) partes.push("''");
    return colId + ' = concat(' + partes.join(', ') + ')';
  }

  // SET valor fijo
  return colId + ' = ' + mxVal(vRaw, fijo.tipo || 'a');
}
