/* ---------- abrir Excel (.xlsx / .xls) o CSV ---------- */
function mxFechaTxt(v, z){   // celda numérica con formato de fecha -> aaaa-mm-dd [hh:mm:ss]
  var p = XLSX.SSF.parse_date_code(v), f = function(n){ return ('0' + n).slice(-2); };
  var s = p.y + '-' + f(p.m) + '-' + f(p.d);
  return (p.H || p.M || Math.floor(p.S)) ? s + ' ' + f(p.H) + ':' + f(p.M) + ':' + f(Math.floor(p.S)) : s;
}
function mxHojaATexto(ws){
  if (!ws || !ws['!ref']) return '';
  var rg = XLSX.utils.decode_range(ws['!ref']), out = [], R, C;
  for (R = rg.s.r; R <= rg.e.r; R++) {
    var fila = [], vacia = true;
    for (C = rg.s.c; C <= rg.e.c; C++) {
      var c = ws[XLSX.utils.encode_cell({ r: R, c: C })], v = '';
      if (c && c.v !== undefined && c.v !== null) {
        if (c.t === 'n' && c.z && XLSX.SSF.is_date(c.z)) v = mxFechaTxt(c.v, c.z);
        else if (c.t === 'b') v = c.v ? 'TRUE' : 'FALSE';
        else if (c.t === 'e') v = '';
        else v = String(c.v);
      }
      v = v.replace(/[\t\r\n]+/g, ' ').trim(); if (v !== '') vacia = false; fila.push(v);
    }
    if (!vacia) out.push(fila.join('\t'));
  }
  return out.join('\n');
}
function mxCargarTexto(txt, info){
  if (!$('mxTabla').value.trim() && info) {
    var rawName = String(info).split(/[\/\\]/).pop().split('.')[0].trim().toLowerCase();
    if (TABLAS_L.indexOf(rawName) >= 0) {
      $('mxTabla').value = rawName;
      mxPintarGuardados();
    }
  }
  $('mxEntrada').value = txt; $('mxCab').checked = true; mxPintarCols(true);
  var d = mxParsear(); $('mxArchInfo').textContent = info || '';
  toast(d.n ? 'Cargado: ' + fmtNum(d.filas.length) + ' filas · ' + d.n + ' campos' : 'El archivo no tiene datos');
}
function mxCargarHoja(i, nombre){
  var n = mxLibro.SheetNames[i];
  mxCargarTexto(mxHojaATexto(mxLibro.Sheets[n]), nombre + (mxLibro.SheetNames.length > 1 ? ' · hoja «' + n + '»' : ''));
}
function mxAbrirArchivo(f){
  if (!f) return;
  var ext = (f.name.split('.').pop() || '').toLowerCase(), r = new FileReader();
  r.onerror = function(){ toast('No se pudo leer el archivo'); };
  r.onload = function(){
    try {
      if (/^(xlsx|xls|xlsm|xlsb|ods)$/.test(ext)) {
        if (typeof XLSX === 'undefined') { toast('Falta la librería de Excel: usa el server.js nuevo y reinicia'); return; }
        mxLibro = XLSX.read(r.result, { type: 'array', cellNF: true });
        var hs = mxLibro.SheetNames;
        $('mxHoja').innerHTML = hs.map(function(h, k){ return '<option value="' + k + '">' + esc(h) + '</option>'; }).join('');
        $('mxHoja').style.display = hs.length > 1 ? '' : 'none';
        mxCargarHoja(0, f.name);
      } else {
        var b = new Uint8Array(r.result), txt;
        try { txt = new TextDecoder('utf-8', { fatal: true }).decode(b); } catch (e) { txt = new TextDecoder('windows-1252').decode(b); }   // CSV de Excel (ANSI): ñ y tildes
        mxLibro = null; $('mxHoja').style.display = 'none';
        mxCargarTexto(txt, f.name);
      }
    } catch (e) { toast('No se pudo leer el archivo: ' + e.message); }
  };
  r.readAsArrayBuffer(f);
}
