/* ---------- procesar query: cambio de asesor (UPDATE por NIT + sede + vendedor) ---------- */
var PQ_Y = { ventas2025: ['20250101', '20251231'], ventas2026: ['20260101', '20261231'] };
var PQ_TABLAS = [
  { t: 'facturac',         fecha: true,  tipo: 'tipo' },
  { t: 'dfacturac',        fecha: true,  tipo: 'tipo' },
  { t: 'nitsx_sedes' },
  { t: 'cartera_clientes', fecha: true },
  { t: 'ventas2025',       fecha: true,  tipo: 'tipo_venta', nombre: true },
  { t: 'ventas2026',       fecha: true,  tipo: 'tipo_venta', nombre: true },
  { t: 'pagos',            fecha: true },
  { t: 'pedidos',          fecha: true }
];
// Filtro de fecha: se aplica a TODAS las tablas con fecha:true. Solo nitsx_sedes queda sin fecha
// (no tiene la propiedad). Si alguna tabla llama distinto a la columna, agrega  col: 'nombre_columna'.
var pqVend = {};      // CODIGO EN MAYÚSCULA -> { codigo, nombre }
var pqCargado = false;
function pqQ(v){ return String(v).replace(/'/g, "''"); }
function pqCfgLeer(){ try { return JSON.parse(localStorage.getItem('boveda-sql-pq') || '{}') || {}; } catch (e) { return {}; } }
function pqCfgGuardar(){
  var off = PQ_TABLAS.filter(function(d){ return !$('pqT_' + d.t).checked; }).map(function(d){ return d.t; });
  try { localStorage.setItem('boveda-sql-pq', JSON.stringify({ off: off, tipo: $('pqTipo').value, wrap: $('pqWrap').checked, modo: $('pqFechaModo').value, desde: $('pqDesde').value, hasta: $('pqHasta').value })); } catch (e) {}
}
function pqPintarTablas(){
  var c = pqCfgLeer(), off = c.off || [];
  $('pqTablas').innerHTML = PQ_TABLAS.map(function(d){
    return '<label class="chk"><input type="checkbox" id="pqT_' + d.t + '"' + (off.indexOf(d.t) < 0 ? ' checked' : '') + '> ' + d.t + '</label>';
  }).join('');
  if (typeof c.tipo === 'string') $('pqTipo').value = c.tipo;
  if (c.wrap === false) $('pqWrap').checked = false;
  if (c.modo) $('pqFechaModo').value = c.modo;
  if (c.desde) $('pqDesde').value = c.desde;
