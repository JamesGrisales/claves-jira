/* ---------- multicursor simultáneo (tipo pgAdmin / VS Code) ---------- */
var multiCursores = []; // Array de { s: start, e: end }
var mcUndoStack = [];   // Historial de deshacer para multicursor
var mcArrastrando = false;
var mcInicioArrastre = null;

function limpiarMultiCursores() {
  if (multiCursores.length > 0) {
    multiCursores = [];
    if (mcLayer) mcLayer.innerHTML = '';
    entrada.style.caretColor = '';
    decorar();
  }
}

function normalizarMultiCursores() {
  if (!multiCursores.length) return;
  multiCursores.sort(function(a, b){ return a.s - b.s; });
  var limpios = [];
  for (var i = 0; i < multiCursores.length; i++) {
    var c = multiCursores[i];
    if (c.s < 0) c.s = 0;
    if (c.e < 0) c.e = 0;
    if (c.s > entrada.value.length) c.s = entrada.value.length;
    if (c.e > entrada.value.length) c.e = entrada.value.length;
    var prev = limpios[limpios.length - 1];
    if (prev && prev.s === c.s && prev.e === c.e) continue;
    limpios.push(c);
  }
  multiCursores = limpios;
  if (multiCursores.length <= 1) {
    if (multiCursores.length === 1) {
      entrada.setSelectionRange(multiCursores[0].s, multiCursores[0].e);
    }
    limpiarMultiCursores();
  }
}

function posDeXY(cx, cy) {
  var rect = entrada.getBoundingClientRect();
  var m = metricas();
  var relX = cx - rect.left - m.pl + entrada.scrollLeft;
  var relY = cy - rect.top - m.pt + entrada.scrollTop;
  var lineIdx = Math.max(0, Math.floor(relY / m.lh));
  var colIdx = Math.max(0, Math.round(relX / m.cw));
  
  var lineas = entrada.value.split('\n');
  if (lineIdx >= lineas.length) lineIdx = lineas.length - 1;
  if (lineIdx < 0) return 0;
  
  var lineaTxt = lineas[lineIdx] || '';
  var colChar = 0, visualAcum = 0;
  for (var i = 0; i < lineaTxt.length; i++) {
    if (visualAcum >= colIdx) break;
    visualAcum += (lineTxt.charCodeAt(i) === 9 ? 4 - (visualAcum % 4) : 1);
    colChar++;
  }
  
  var offset = 0;
  for (var k = 0; k < lineIdx; k++) {
    offset += lineas[k].length + 1;
  }
  return offset + colChar;
}

function renderizarMultiCursores() {
  if (!mcLayer) mcLayer = $('mcLayer');
  if (!mcLayer) return;
  if (multiCursores.length <= 1) {
    mcLayer.innerHTML = '';
    entrada.style.caretColor = '';
    return;
  }
  entrada.style.caretColor = 'transparent';
  var v = entrada.value, m = metricas(), html = '';
  
  for (var i = 0; i < multiCursores.length; i++) {
    var c = multiCursores[i];
    var pStart = xyDe(v, c.s);
    if (c.s === c.e) {
      html += '<div class="mc-cursor" style="left:' + pStart.x + 'px; top:' + pStart.y + 'px; height:' + m.lh + 'px;"></div>';
    } else {
      var pEnd = xyDe(v, c.e);
      if (pStart.y === pEnd.y) {
        var w = Math.max(2, pEnd.x - pStart.x);
        html += '<div class="mc-sel" style="left:' + pStart.x + 'px; top:' + pStart.y + 'px; width:' + w + 'px; height:' + m.lh + 'px;"></div>';
      } else {
        html += '<div class="mc-sel" style="left:' + pStart.x + 'px; top:' + pStart.y + 'px; width:' + (m.cw * 2) + 'px; height:' + m.lh + 'px;"></div>';
      }
      html += '<div class="mc-cursor" style="left:' + pEnd.x + 'px; top:' + pEnd.y + 'px; height:' + m.lh + 'px;"></div>';
    }
  }
  mcLayer.innerHTML = html;
  decorarRapido();
}

function ejecutarMultiOp(getOp) {
  if (!multiCursores.length) return false;
  mcUndoStack.push({
    val: entrada.value,
    cursores: JSON.parse(JSON.stringify(multiCursores))
  });
  if (mcUndoStack.length > 50) mcUndoStack.shift();

  var v = entrada.value;
  var ordenados = multiCursores.slice().sort(function(a, b){ return a.s - b.s; });
  
  var newV = '';
  var lastIdx = 0;
  var nuevos = [];

  for (var i = 0; i < ordenados.length; i++) {
    var c = ordenados[i];
    var op = getOp(v, c.s, c.e, i, ordenados.length);
    var rStart = Math.max(lastIdx, Math.min(v.length, op.start));
    var rEnd = Math.max(rStart, Math.min(v.length, op.end));
    var ins = op.ins !== undefined ? op.ins : '';

    newV += v.slice(lastIdx, rStart);
    var posCursor = newV.length + ins.length;
    newV += ins;
    nuevos.push({ s: posCursor, e: posCursor });
    lastIdx = rEnd;
  }
  newV += v.slice(lastIdx);

  entrada.value = newV;
  multiCursores = nuevos;
  normalizarMultiCursores();
  pintarCapaRapido();
  renderizarMultiCursores();
  decorarRapido();
  try { localStorage.setItem('boveda-sql-draft', entrada.value); } catch(x){}
  return true;
}

function agregarCursorVertical(dir) {
  var v = entrada.value;
  if (!multiCursores.length) {
    multiCursores.push({ s: entrada.selectionStart, e: entrada.selectionEnd });
  }
  var base = (dir > 0) ? multiCursores[multiCursores.length - 1] : multiCursores[0];
  var p = lineaCol(v, base.s);
  var targetLine = p.linea + dir;
  var lineas = v.split('\n');
  if (targetLine < 0 || targetLine >= lineas.length) return;
  
  var colDeseada = p.texto.length;
  var targetTxt = lineas[targetLine];
  var colReal = Math.min(colDeseada, targetTxt.length);
  
  var offset = 0;
  for (var i = 0; i < targetLine; i++) offset += lineas[i].length + 1;
  var nuevoPos = offset + colReal;
  
  multiCursores.push({ s: nuevoPos, e: nuevoPos });
  normalizarMultiCursores();
  renderizarMultiCursores();
}

function agregarSiguienteOcurrencia() {
  var v = entrada.value;
  var textoBuscado = '';
  if (multiCursores.length > 0) {
    var ult = multiCursores[multiCursores.length - 1];
    if (ult.s !== ult.e) textoBuscado = v.slice(ult.s, ult.e);
  }
  if (!textoBuscado) {
    var s = entrada.selectionStart, e = entrada.selectionEnd;
    if (s !== e) {
      textoBuscado = v.slice(s, e);
      if (multiCursores.length === 0) multiCursores.push({ s: s, e: e });
    } else {
      var m = /[A-Za-z0-9_]+/.exec(v.slice(s));
      var mAnt = /[A-Za-z0-9_]+$/.exec(v.slice(0, s));
      var ini = s - (mAnt ? mAnt[0].length : 0);
      var fin = s + (m ? m[0].length : 0);
      if (ini < fin) {
        textoBuscado = v.slice(ini, fin);
        multiCursores = [{ s: ini, e: fin }];
        entrada.setSelectionRange(ini, fin);
        renderizarMultiCursores();
        return;
      }
    }
  }
  if (!textoBuscado) return;
  
  var maxE = 0;
  multiCursores.forEach(function(c){ if (c.e > maxE) maxE = c.e; });
  var idx = v.indexOf(textoBuscado, maxE);
  if (idx < 0) idx = v.indexOf(textoBuscado, 0);
  if (idx >= 0) {
    var yaExiste = multiCursores.some(function(c){ return c.s === idx; });
    if (!yaExiste) {
      multiCursores.push({ s: idx, e: idx + textoBuscado.length });
      normalizarMultiCursores();
      renderizarMultiCursores();
    }
  }
}

// Mouse events para multicursor
entrada.addEventListener('mousedown', function(e){
  if (e.button !== 0) return;
  if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey) {
    e.preventDefault();
    var clickPos = posDeXY(e.clientX, e.clientY);
    if (multiCursores.length === 0) {
      multiCursores.push({ s: entrada.selectionStart, e: entrada.selectionEnd });
    }
    var existeIdx = -1;
    for (var i = 0; i < multiCursores.length; i++) {
      if (Math.abs(multiCursores[i].s - clickPos) <= 1) {
        existeIdx = i; break;
      }
    }
    if (existeIdx >= 0) {
      multiCursores.splice(existeIdx, 1);
    } else {
      multiCursores.push({ s: clickPos, e: clickPos });
    }
    normalizarMultiCursores();
    renderizarMultiCursores();
    return;
  }
  
  if (e.altKey && !e.ctrlKey) {
    e.preventDefault();
    mcArrastrando = true;
    mcInicioArrastre = { clientX: e.clientX, clientY: e.clientY };
    return;
  }
  
  if (!e.ctrlKey && !e.altKey && !e.shiftKey) {
    if (multiCursores.length > 0) {
      limpiarMultiCursores();
    }
  }
});

window.addEventListener('mousemove', function(e){
  if (!mcArrastrando || !mcInicioArrastre) return;
  var posIni = posDeXY(mcInicioArrastre.clientX, mcInicioArrastre.clientY);
  var posFin = posDeXY(e.clientX, e.clientY);
  var v = entrada.value;
  var p1 = lineaCol(v, posIni);
  var p2 = lineaCol(v, posFin);
  var lMin = Math.min(p1.linea, p2.linea);
  var lMax = Math.max(p1.linea, p2.linea);
  var c1 = Math.min(p1.texto.length, p2.texto.length);
  var c2 = Math.max(p1.texto.length, p2.texto.length);
  
  var lineas = v.split('\n');
  var nuevos = [];
  var offset = 0;
  for (var i = 0; i < lineas.length; i++) {
    if (i >= lMin && i <= lMax) {
      var lTxt = lineas[i];
      var s = offset + Math.min(c1, lTxt.length);
      var f = offset + Math.min(c2, lTxt.length);
      nuevos.push({ s: s, e: f });
    }
    offset += lineas[i].length + 1;
  }
  multiCursores = nuevos;
  renderizarMultiCursores();
});

window.addEventListener('mouseup', function(){
  if (mcArrastrando) {
    mcArrastrando = false;
    mcInicioArrastre = null;
    normalizarMultiCursores();
    renderizarMultiCursores();
  }
});

entrada.addEventListener('copy', function(e){
  if (multiCursores.length > 1) {
    var v = entrada.value;
    var partes = [];
    multiCursores.forEach(function(c){
      if (c.s !== c.e) partes.push(v.slice(c.s, c.e));
      else {
        var ini = v.lastIndexOf('\n', c.s - 1) + 1;
        var fin = v.indexOf('\n', c.e);
        if (fin < 0) fin = v.length;
        partes.push(v.slice(ini, fin));
      }
    });
    if (partes.length > 0 && e.clipboardData) {
      e.clipboardData.setData('text/plain', partes.join('\n'));
      e.preventDefault();
    }
  }
});

entrada.addEventListener('paste', function(e){
  if (multiCursores.length > 1) {
    e.preventDefault();
    var clipText = (e.clipboardData || window.clipboardData).getData('text') || '';
    var lines = clipText.split('\n');
    var match1a1 = (lines.length === multiCursores.length);
    ejecutarMultiOp(function(v, s, e, idx){
      var ins = match1a1 ? lines[idx] : clipText;
      return { start: s, end: e, ins: ins };
    });
  }
});

/* ---------- teclado del editor ---------- */
var PARES = { '(': ')', '[': ']', "'": "'", '"': '"' };
entrada.addEventListener('keydown', function(e){
  var k = e.key, ctrl = e.ctrlKey || e.metaKey, v = entrada.value, s = entrada.selectionStart, f = entrada.selectionEnd;

  // Escape: cancelar multicursores si existen
  if (k === 'Escape' && multiCursores.length > 0) {
    e.preventDefault();
    limpiarMultiCursores();
    return;
  }

  // Ctrl + Alt + ArrowUp / ArrowDown: agregar cursor arriba o abajo
  if (ctrl && e.altKey && (k === 'ArrowUp' || k === 'ArrowDown')) {
    e.preventDefault();
    agregarCursorVertical(k === 'ArrowUp' ? -1 : 1);
    return;
  }

  // Ctrl + D: seleccionar siguiente ocurrencia
  if (ctrl && !e.altKey && (k === 'd' || k === 'D')) {
    e.preventDefault();
    agregarSiguienteOcurrencia();
    return;
  }

  // Ctrl + Z: deshacer para multicursor
  if (ctrl && !e.altKey && (k === 'z' || k === 'Z') && !e.shiftKey && mcUndoStack.length > 0) {
    e.preventDefault();
    var snap = mcUndoStack.pop();
    entrada.value = snap.val;
    multiCursores = snap.cursores;
    normalizarMultiCursores();
    pintarCapaRapido();
    renderizarMultiCursores();
    decorarRapido();
    return;
  }

  // Edición simultánea cuando hay múltiples cursores activos
  if (multiCursores.length > 1) {
    // Carácter simple
    if (k.length === 1 && !ctrl && !e.altKey) {
      e.preventDefault();
      ejecutarMultiOp(function(v, st, en){
        return { start: st, end: en, ins: k };
      });
      return;
    }
    // Backspace
    if (k === 'Backspace' && !ctrl && !e.altKey) {
      e.preventDefault();
      ejecutarMultiOp(function(v, st, en){
        if (st !== en) return { start: st, end: en, ins: '' };
        if (st > 0) return { start: st - 1, end: st, ins: '' };
        return { start: st, end: st, ins: '' };
      });
      return;
    }
    // Delete
    if (k === 'Delete' && !ctrl && !e.altKey) {
      e.preventDefault();
      ejecutarMultiOp(function(v, st, en){
        if (st !== en) return { start: st, end: en, ins: '' };
        if (st < v.length) return { start: st, end: st + 1, ins: '' };
        return { start: st, end: st, ins: '' };
      });
      return;
    }
    // Enter
    if (k === 'Enter') {
      e.preventDefault();
      ejecutarMultiOp(function(v, st, en){
        return { start: st, end: en, ins: '\n' };
      });
      return;
    }
    // Tab
    if (k === 'Tab') {
      e.preventDefault();
      ejecutarMultiOp(function(v, st, en){
        return { start: st, end: en, ins: '    ' };
      });
      return;
    }
    // Flecha izquierda
    if (k === 'ArrowLeft') {
      e.preventDefault();
      multiCursores.forEach(function(c){
        if (c.s !== c.e) c.e = c.s;
        else if (c.s > 0) { c.s--; c.e--; }
      });
      renderizarMultiCursores();
      return;
    }
    // Flecha derecha
    if (k === 'ArrowRight') {
      e.preventDefault();
      var len = entrada.value.length;
      multiCursores.forEach(function(c){
        if (c.s !== c.e) c.s = c.e;
        else if (c.s < len) { c.s++; c.e++; }
      });
      renderizarMultiCursores();
      return;
    }
    // Home / Inicio
    if (k === 'Home') {
      e.preventDefault();
      var val = entrada.value;
      multiCursores.forEach(function(c){
        var ini = val.lastIndexOf('\n', c.s - 1) + 1;
        c.s = ini; c.e = ini;
      });
      renderizarMultiCursores();
      return;
    }
    // End / Fin
    if (k === 'End') {
      e.preventDefault();
      var val = entrada.value;
      multiCursores.forEach(function(c){
        var fin = val.indexOf('\n', c.e);
        if (fin < 0) fin = val.length;
        c.s = fin; c.e = fin;
      });
      renderizarMultiCursores();
      return;
    }
  }

  if (ac.abierto) {
    if (k === 'ArrowDown' || k === 'ArrowUp') { e.preventDefault(); ac.idx = (ac.idx + (k === 'ArrowDown' ? 1 : ac.items.length - 1)) % ac.items.length; ac.navegado = true; marcarAuto(); return; }
    if (k === 'Tab' || (k === 'Enter' && ac.navegado)) { e.preventDefault(); aceptarAuto(ac.idx); return; }
    if (k === 'Escape') { e.preventDefault(); e.stopPropagation(); cerrarAuto(); return; }
    if (k === 'ArrowLeft' || k === 'ArrowRight' || k === 'Home' || k === 'End' || k === 'PageUp' || k === 'PageDown') cerrarAuto();
  }
  if (ses) {
    if (k === 'Tab') { e.preventDefault(); saltarHueco(e.shiftKey ? -1 : 1); return; }
    if (k === 'Escape') { e.preventDefault(); e.stopPropagation(); ses = null; decorar(); return; }
  }
  if (ctrl && (k === ' ' || k === 'Spacebar')) { e.preventDefault(); abrirAuto(true); return; }
  if (ctrl && k === '/') { e.preventDefault(); comentarLineas(); return; }
  if (ctrl && k.toLowerCase() === 'j') { e.preventDefault(); $('btnSN').click(); return; }
  if (ctrl || e.altKey) return;

  // cerrar paréntesis y comillas solos
  if (PARES[k] && !e.isComposing) {
    if (s !== f) { if (ses) return; e.preventDefault(); var sel = v.slice(s, f); insertarTexto(k + sel + PARES[k]); entrada.setSelectionRange(s + 1, s + 1 + sel.length); return; }
    var sig = v.charAt(s), ant = v.charAt(s - 1);
    if (k === "'" || k === '"') {
      if (sig === k) { e.preventDefault(); entrada.setSelectionRange(s + 1, s + 1); return; }
      if (/[\w$]/.test(ant)) return;
      if (k === "'" && dentroDeTextoOComentario(v.slice(v.lastIndexOf('\n', s - 1) + 1, s))) return;
    }
    e.preventDefault(); insertarTexto(k + PARES[k]); entrada.setSelectionRange(s + 1, s + 1); return;
  }
  if ((k === ')' || k === ']') && s === f && v.charAt(s) === k) { e.preventDefault(); entrada.setSelectionRange(s + 1, s + 1); return; }
  if (k === 'Backspace' && s === f && s > 0 && PARES[v.charAt(s - 1)] && PARES[v.charAt(s - 1)] === v.charAt(s)) {
    e.preventDefault(); entrada.setSelectionRange(s - 1, s + 1); borrarSeleccion(); return;
  }
  if (k === 'Enter' && !e.shiftKey) {
    var ini = v.lastIndexOf('\n', s - 1) + 1, ind = /^[ \t]*/.exec(v.slice(ini, s))[0];
    if (v.charAt(s - 1) === '(' && v.charAt(s) === ')') {
      e.preventDefault(); insertarTexto('\n' + ind + '    \n' + ind); var np = s + 1 + ind.length + 4; entrada.setSelectionRange(np, np); return;
    }
    var extra = /[(\[]\s*$/.test(v.slice(ini, s)) ? '    ' : '';
    if (ind || extra) { e.preventDefault(); insertarTexto('\n' + ind + extra); return; }
  }
});
entrada.addEventListener('input', function(e){
  ajustarSesion();
  pintarCapaRapido();
  if (sinAuto) return;
  var t = e.inputType || '';
  if (t === 'insertText' || t === 'deleteContentBackward' || t === 'insertCompositionText') { var tx = e.data || ''; if (t === 'insertText' && !/[\w$\u00C0-\u024F]/.test(tx)) cerrarAuto(); else abrirAuto(false); }
  else cerrarAuto();
});
entrada.addEventListener('scroll', function(){ sincronizarEditor(); if (ac.abierto) posicionarAuto(); });
['keyup', 'click', 'focus', 'select', 'mouseup'].forEach(function(ev){ entrada.addEventListener(ev, decorarRapido); });
entrada.addEventListener('click', function(){ cerrarAuto(); });
entrada.addEventListener('blur', function(){ setTimeout(function(){ cerrarAuto(); decorar(); }, 120); });
if (window.ResizeObserver) new ResizeObserver(function(){ met = null; sincronizarEditor(); }).observe(entrada);
window.addEventListener('resize', function(){ met = null; sincronizarEditor(); });
['btnAmpliarEntrada'].forEach(function(id){ $(id).addEventListener('click', function(){ setTimeout(function(){ met = null; sincronizarEditor(); }, 60); }); });
pintarCapa();

/* ---------- panel de sentencias SQL ---------- */
var snCat = 'todas', snLista = [], snActual = null;
function snConPlaceholders(code){ return code.replace(/\{\{([^{}]*)\}\}/g, '\u2039$1\u203A'); }
function snPreview(c){
  var p = $('snPrev');
  if (!c) { p.innerHTML = '<div class="vacio"><b>Pasa el cursor</b> por una sentencia para ver cómo queda.<br>Haz <b>clic</b> para insertarla donde tengas el cursor. Los huecos <u style="text-decoration:none;background:var(--ed-ph);border-radius:3px;padding:0 3px">en amarillo</u> se llenan saltando con <b>Tab</b>.</div>'; return; }
  var html = resaltar(snConPlaceholders(c.code)).join('\n').replace(/\u2039([^\u203A]*)\u203A/g, '<u>$1</u>');
  p.innerHTML = '<h4><span>' + esc(c.nombre) + '</span><em>' + (c.frag ? 'fragmento' : 'sentencia completa') + '</em></h4><pre>' + html + '</pre>' +
    '<div class="acc"><button type="button" data-a="ins">⬇ Insertar</button><button type="button" class="secondary" data-a="cop">Copiar</button></div>';
}
function snPintar(){
  if (!SS) return;
  var q = $('snBuscar').value;
  snLista = SS.buscar(q, snCat);
  var grid = $('snGrid'), html = '', MAX = 150;
  snLista.slice(0, MAX).forEach(function(c){
    html += '<button type="button" class="sn-card" data-i="' + c.i + '"><b>' + esc(c.nombre) + '</b><span>' + esc(c.desc) + '</span>' + (c.frag ? '<span class="tag">fragmento</span>' : '') + '</button>';
  });
  if (!snLista.length) html = '<div class="sn-vacio">Nada coincide con «' + esc(q) + '». Prueba con otra palabra: insert, join, fecha, duplicados…</div>';
  else if (snLista.length > MAX) html += '<div class="sn-vacio">Hay ' + (snLista.length - MAX) + ' más: escribe en el buscador para afinar.</div>';
  grid.innerHTML = html;
  $('snCnt').textContent = snLista.length + (snLista.length === 1 ? ' resultado' : ' resultados');
  var cuentas = {}; SS.buscar(q, 'todas').forEach(function(c){ cuentas[c.cat] = (cuentas[c.cat] || 0) + 1; });
  var chips = $('snCats').children, i;
  for (i = 0; i < chips.length; i++) { var id = chips[i].getAttribute('data-c'); chips[i].classList.toggle('on', id === snCat); chips[i].querySelector('small').textContent = id === 'todas' ? SS.buscar(q, 'todas').length : (cuentas[id] || 0); }
}
function snIniciar(){
  if (!SS) return;
  var h = '';
  SS.CATS.forEach(function(c){ h += '<button type="button" class="sn-chip" data-c="' + c.id + '">' + c.ico + ' ' + esc(c.nombre) + '<small>0</small></button>'; });
  $('snCats').innerHTML = h; snPreview(null); snPintar();
}
function snInsertar(c){ if (!c) return; insertarSnippet(c.code, c.frag); toast('«' + c.nombre + '» insertada'); }
$('btnSN').addEventListener('click', function(){
  if (!SS) { toast('Falta el archivo public/sql-sentencias.js'); return; }
  var p = $('sn'); p.classList.toggle('on');
  if (p.classList.contains('on')) { if (!$('snGrid').children.length) snIniciar(); $('snBuscar').focus(); $('snBuscar').select(); }
});
$('snBuscar').addEventListener('input', snPintar);
$('snBuscar').addEventListener('keydown', function(e){
  if (e.key === 'Enter' && snLista.length) { e.preventDefault(); snInsertar(snLista[0]); }
  else if (e.key === 'Escape') { e.stopPropagation(); $('sn').classList.remove('on'); if (typeof actualizarBotonesPaneles === 'function') actualizarBotonesPaneles(); entrada.focus(); }
});
$('snCats').addEventListener('click', function(e){ var b = e.target.closest('.sn-chip'); if (!b) return; snCat = b.getAttribute('data-c'); snPintar(); });
$('snGrid').addEventListener('mouseover', function(e){ var b = e.target.closest('.sn-card'); if (!b) return; snActual = SS.CATALOGO[+b.getAttribute('data-i')]; snPreview(snActual); });
$('snGrid').addEventListener('focusin', function(e){ var b = e.target.closest('.sn-card'); if (!b) return; snActual = SS.CATALOGO[+b.getAttribute('data-i')]; snPreview(snActual); });
$('snGrid').addEventListener('click', function(e){ var b = e.target.closest('.sn-card'); if (!b) return; snInsertar(SS.CATALOGO[+b.getAttribute('data-i')]); });
$('snPrev').addEventListener('click', function(e){
  var b = e.target.closest('button[data-a]'); if (!b || !snActual) return;
  if (b.getAttribute('data-a') === 'ins') snInsertar(snActual); else copiar(snActual.code.replace(/\{\{([^{}]*)\}\}/g, '$1'), 'Sentencia copiada');
});


/* ---------- masivo desde Excel: INSERT / UPDATE / DELETE (con campos guardados por tabla) ---------- */
var mxRoles = [], mxNombres = [], mxTipos = [], mxBuscar = [], mxPlantillas = [], mxFirma = '', mxLibro = null, mxFijos = [];
var MX_TIPOS = [['a', 'Tipo: Auto'], ['t', 'Texto (comillas)'], ['n', 'Número (sin comillas)'], ['f', 'Fecha (comillas)'], ['r', 'Crudo (sin comillas)']];
var MX_OPC = {
  ins: [['i', 'Incluir'], ['', 'Omitir']],
  upd: [
    ['s', 'SET (actualizar)'],
    ['cf', 'CONCAT + Fecha (current_date)'],
    ['c', 'CONCAT (anexar texto)'],
    ['rep', 'REPLACE (reemplazar texto)'],
    ['w', 'WHERE (condición)'],
    ['', 'Omitir']
  ],
  del: [['w', 'WHERE (condición)'], ['', 'Omitir']]
};
/* campos guardados: { "tabla": ["campo1","campo2"] } */
function mxLeer(){ try { return JSON.parse(localStorage.getItem('boveda-sql-campos') || '{}') || {}; } catch (e) { return {}; } }
function mxEscribir(o){ try { localStorage.setItem('boveda-sql-campos', JSON.stringify(o)); } catch (e) {} }
function mxClave(){ return $('mxTabla').value.trim().toLowerCase(); }
function mxCampos(){ return mxLeer()[mxClave()] || []; }
function mxAgregar(lista){
  var k = mxClave(); if (!k) return -1;
  var o = mxLeer(), a = o[k] || [], n = 0;
  lista.forEach(function(c){ c = String(c).trim(); if (c && a.indexOf(c) < 0) { a.push(c); n++; } });
  if (n) { o[k] = a; mxEscribir(o); mxPintarGuardados(); }
  return n;
}
function mxQuitar(c){
  var k = mxClave(), o = mxLeer(), a = o[k] || [], i = a.indexOf(c);
  if (i < 0) return;
  a.splice(i, 1); if (a.length) o[k] = a; else delete o[k];
  mxEscribir(o); mxPintarGuardados();
}
function mxPintarGuardados(){
  var a = mxCampos();
  var clave = mxClave();
  var colsBd = (window.SQL_COLUMNAS && clave) ? (window.SQL_COLUMNAS[clave] || []) : [];
  var todos = a.slice();
  colsBd.forEach(function(c){ if (todos.indexOf(c) < 0) todos.push(c); });
  $('mxCamposDl').innerHTML = todos.map(function(c){ return '<option value="' + esc(c) + '">'; }).join('');
  $('mxGuardados').innerHTML = !clave ? '<span class="mx-vacio">Elige una tabla para ver sus campos.</span>' :
    (a.length ? a.map(function(c){
      return '<span class="mx-chip" data-c="' + esc(c) + '" title="Clic: asignar a la primera columna sin nombre">' + esc(c) + '<i data-del="1" title="Quitar de la lista">✕</i></span>';
    }).join('') : (colsBd.length ? '<span class="mx-vacio" style="color:var(--text); font-weight:600;"><span style="color:#10b981;">✓</span> ' + colsBd.length + ' campos de la base de datos disponibles para autocompletar.</span>' : '<span class="mx-vacio">Esta tabla aún no tiene campos guardados: se guardan solos al generar, o agrégalos arriba.</span>'));
}
function mxSep(t){
  var l = t.split('\n', 1)[0], tab = (l.match(/\t/g) || []).length, pc = (l.match(/;/g) || []).length, co = (l.match(/,/g) || []).length;
  return tab ? '\t' : (pc && pc >= co ? ';' : ',');
}
function mxTabla2(t, sep){   // CSV/TSV con comillas (Excel pone comillas a las celdas con saltos de línea)
  var rows = [], row = [], c = '', q = false, i, ch;
  for (i = 0; i < t.length; i++) {
    ch = t.charAt(i);
    if (q) { if (ch === '"') { if (t.charAt(i + 1) === '"') { c += '"'; i++; } else q = false; } else c += ch; }
    else if (ch === '"' && c === '') q = true;
    else if (ch === sep) { row.push(c); c = ''; }
    else if (ch === '\n') { row.push(c); rows.push(row); row = []; c = ''; }
    else c += ch;
  }
  if (c !== '' || row.length) { row.push(c); rows.push(row); }
  return rows;
}
function mxParsear(){
  var txt = $('mxEntrada').value.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n');
  var filas = mxTabla2(txt, mxSep(txt)).filter(function(f){ return f.some(function(c){ return c.trim() !== ''; }); })
    .map(function(f){ return f.map(function(c){ return c.trim(); }); });
  if (!filas.length) return { cols: [], filas: [], n: 0 };
  var cab = $('mxCab').checked, cols = cab ? filas[0].map(function(c){ return c.replace(/^"(.*)"$/, '$1'); }) : [];
  var datos = cab ? filas.slice(1) : filas, n = cols.length;
  datos.forEach(function(f){ if (f.length > n) n = f.length; });
  return { cols: cols, filas: datos, n: n };
}
function mxRolInicial(op, i){ return op === 'upd' ? (i === 0 ? 'w' : 's') : (op === 'ins' ? 'i' : 'w'); }
function mxRefrescarSelects(){
  Array.prototype.forEach.call($('mxCols').children, function(div, i){
    var sr = div.querySelector('select[data-k="r"]'), st = div.querySelector('select[data-k="t"]');
    if (sr) sr.value = mxRoles[i] || ''; if (st) st.value = mxTipos[i] || 'a';
    div.className = 'mx-col r-' + (mxRoles[i] || 'x');
    var repBox = div.querySelector('.mx-rep-box');
    if (repBox) repBox.style.display = mxRoles[i] === 'rep' ? 'flex' : 'none';
    var cfBox = div.querySelector('.mx-cf-box');
    if (cfBox) cfBox.style.display = mxRoles[i] === 'cf' ? 'flex' : 'none';
  });
}
/* configuración guardada por tabla: tipo de cada campo y su acción en cada operación */
function mxCfgLeer(){ try { return JSON.parse(localStorage.getItem('boveda-sql-cfg') || '{}') || {}; } catch (e) { return {}; } }
function mxGuardarCfg(){
  var k = mxClave(); if (!k) return;
  var o = mxCfgLeer(), t = o[k] || {}, op = $('mxOp').value;
  mxNombres.forEach(function(n, i){ n = n.trim(); if (!n) return; var c = t[n] || (t[n] = { r: {} }); c.t = mxTipos[i] || 'a'; c.r[op] = mxRoles[i] || ''; });
  o[k] = t; try { localStorage.setItem('boveda-sql-cfg', JSON.stringify(o)); } catch (e) {}
}
function mxAplicarCfg(){
  var t = mxCfgLeer()[mxClave()]; if (!t) return;
  var op = $('mxOp').value, n = 0;
  mxNombres.forEach(function(nm, i){
    var c = t[nm.trim()]; if (!c) return;
    if (c.t) mxTipos[i] = c.t; if (c.r && c.r[op] !== undefined) mxRoles[i] = c.r[op]; n++;
  });
  if (n) mxRefrescarSelects();
}
/* Normalización flexible de texto para emparejar cabeceras de Excel con columnas de BD */
function mxNorm(str) {
  if (!str) return '';
  return String(str)
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]/g, '');
}

/* Diccionario de sinónimos comunes en bases de datos colombianas / ERP */
var MX_SINONIMOS = [
  { clave: 'nit', aliases: ['nit', 'cedula', 'cc', 'documento', 'doc', 'identificacion', 'rut', 'nitcliente', 'terceroid', 'nittercero', 'nitproveedor'] },
  { clave: 'codigo', aliases: ['codigo', 'cod', 'articulo', 'ref', 'referencia', 'item', 'producto', 'codarticulo', 'codigoarticulo', 'plu', 'sku'] },
  { clave: 'nombre', aliases: ['nombre', 'nom', 'descripcion', 'desc', 'detalle', 'razonsocial', 'nombrearticulo', 'nombrecliente', 'nombretercero'] },
  { clave: 'numero', aliases: ['numero', 'num', 'nro', 'factura', 'numfactura', 'nrofactura', 'consecutivo', 'docto', 'numdocto', 'documentonumero'] },
  { clave: 'saldo', aliases: ['saldo', 'saldo1', 'saldoactual', 'saldopendiente', 'valorsaldo', 'saldoanterior', 'cantidad', 'cant', 'unidades', 'stock'] },
  { clave: 'precio', aliases: ['precio', 'precio1', 'pvp', 'valorunitario', 'precioventa', 'tarifa', 'costo', 'valor'] },
  { clave: 'fecha', aliases: ['fecha', 'fechacreacion', 'fechaemision', 'fechafactura', 'f_emision', 'f_factura', 'fcreacion', 'fechasistema'] },
  { clave: 'sede', aliases: ['sede', 'sucursal', 'agencia', 'pto', 'sedeid', 'sucursalid'] },
  { clave: 'vendedor', aliases: ['vendedor', 'codigovendedor', 'codvendedor', 'asesor', 'codasesor', 'comercial'] },
  { clave: 'estado', aliases: ['estado', 'status', 'activo', 'estadoactivoid'] },
  { clave: 'tipo', aliases: ['tipo', 'tipoventa', 'tipov', 'tipofactura'] }
];

function mxBuscarMejorCampo(colExcel, colsBd) {
  if (!colExcel || !colsBd || !colsBd.length) return null;
  var orig = String(colExcel).trim();
  var origLow = orig.toLowerCase();
  var normEx = mxNorm(orig);
  if (!normEx) return null;

  for (var i = 0; i < colsBd.length; i++) {
    if (colsBd[i].toLowerCase() === origLow) return colsBd[i];
  }
  for (var j = 0; j < colsBd.length; j++) {
    if (mxNorm(colsBd[j]) === normEx) return colsBd[j];
  }
  for (var s = 0; s < MX_SINONIMOS.length; s++) {
    var grupo = MX_SINONIMOS[s];
    var coincideAlias = grupo.aliases.some(function(al){
      return normEx === al || normEx.indexOf(al) >= 0 || al.indexOf(normEx) >= 0;
    });
    if (coincideAlias) {
      for (var k = 0; k < colsBd.length; k++) {
        var nBd = mxNorm(colsBd[k]);
        if (nBd === grupo.clave || grupo.aliases.some(function(al){ return nBd === al || nBd.indexOf(al) >= 0; })) {
          return colsBd[k];
        }
      }
    }
  }
  if (normEx.length >= 4) {
    for (var m = 0; m < colsBd.length; m++) {
      var nB = mxNorm(colsBd[m]);
      if (nB.indexOf(normEx) >= 0 || normEx.indexOf(nB) >= 0) {
        return colsBd[m];
      }
    }
  }
  return null;
}

function mxAutoDetectarTabla(colsExcel) {
  if (!colsExcel || !colsExcel.length || !window.SQL_COLUMNAS) return null;
  var tablas = Object.keys(window.SQL_COLUMNAS);
  var mejorTabla = null;
  var maxPuntos = 0;
  var normHeaders = colsExcel.map(mxNorm).filter(Boolean);
  if (!normHeaders.length) return null;

  tablas.forEach(function(tbl){
    if (/^(tmp_|conteo|copia_|cruce_|dtmp_)/i.test(tbl)) return;
    var cols = window.SQL_COLUMNAS[tbl];
    if (!cols || !cols.length) return;

    var puntos = 0;
    normHeaders.forEach(function(h){
      for (var c = 0; c < cols.length; c++) {
        var nc = mxNorm(cols[c]);
        if (nc === h) { puntos += 3; break; }
        else if (nc.indexOf(h) >= 0 || h.indexOf(nc) >= 0) { puntos += 1; break; }
      }
    });

    if (puntos > maxPuntos) {
      maxPuntos = puntos;
      mejorTabla = tbl;
    }
  });

  if (maxPuntos >= 3 && mejorTabla) {
    return { tabla: mejorTabla, puntos: maxPuntos };
  }
  return null;
}

var mxMatches = [];

function mxIntentarAutoGenerar(){
  var autoChk = $('mxAutoGenerar');
  if (!autoChk || !autoChk.checked) return;
  var tabla = mxClave();
  if (!tabla) return;
  var d = mxParsear();
