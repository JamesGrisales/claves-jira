  if (toggleAuditBtn) toggleAuditBtn.setAttribute('aria-expanded', 'false');
});


async function copyPassword(id){
  let clave = revealedState[id] && revealedState[id].value;
  if (!clave){
    const res = await fetch('/empresa/' + id + '/clave');
    if (!res.ok) return;
    const data = await res.json();
    clave = data.clave;
  }
  try{
    await navigator.clipboard.writeText(clave);
  }catch(e){
    const ta = document.createElement('textarea');
    ta.value = clave;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  }
  showToast('Clave de «' + nombreDe(id) + '» copiada');
}

async function copyAsSql(id){
  let clave = revealedState[id] && revealedState[id].value;
  if (!clave){
    const res = await fetch('/empresa/' + id + '/clave');
    if (!res.ok) return;
    const data = await res.json();
    clave = data.clave;
  }
  const cond = "nit_empresa = '" + (clave || '').trim() + "'";
  try{
    await navigator.clipboard.writeText(cond);
  }catch(e){
    const ta = document.createElement('textarea');
    ta.value = cond;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  }
  showToast('Condición SQL copiada: ' + cond);
}

function toggleEdit(id){
  const p = document.getElementById('edit-' + id);
  const abierto = p.classList.toggle('open');
  p.closest('.row').classList.toggle('open', abierto);
  const b = document.getElementById('editbtn-' + id);
  if (b){ b.classList.toggle('on', abierto); b.querySelector('.t').textContent = abierto ? 'Cerrar' : 'Editar'; }
}

let toastTimer;
function showToast(texto){
  const t = document.getElementById('toast');
  document.getElementById('toastTxt').textContent = texto || 'Copiado';
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 1800);
}
// === SISTEMA DE FAVORITOS (PINS) ===
function getFavs(){ return JSON.parse(localStorage.getItem('boveda-favs') || '[]'); }
function saveFavs(favs){ localStorage.setItem('boveda-favs', JSON.stringify(favs)); }
function initFavs(){
  const favs = getFavs();
  favs.forEach(id => {
    const btn = document.getElementById('fav-' + id);
    const row = document.querySelector('.row[data-id="'+id+'"]');
    if(btn && row) { btn.classList.add('on'); row.classList.add('fav'); }
  });
}
function toggleFav(id){
  const btn = document.getElementById('fav-' + id);
  const row = document.querySelector('.row[data-id="'+id+'"]');
  if(!btn || !row) return;
  let favs = getFavs();
  if(favs.includes(id)){
    favs = favs.filter(x => x !== id);
    btn.classList.remove('on'); row.classList.remove('fav');
  } else {
    favs.push(id);
    btn.classList.add('on'); row.classList.add('fav');
  }
  saveFavs(favs);
}
document.addEventListener('DOMContentLoaded', initFavs);
