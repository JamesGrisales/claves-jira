// === AUDITORÍA GLOBAL DE LA BÓVEDA ===
const toggleAuditBtn = document.getElementById('toggleAuditBtn');
const auditCard = document.getElementById('auditCard');
const auditLoading = document.getElementById('auditLoading');
const auditContent = document.getElementById('auditContent');
const btnRecargarAuditoria = document.getElementById('btnRecargarAuditoria');
const btnCerrarAuditoria = document.getElementById('btnCerrarAuditoria');

async function ejecutarAuditoria() {
  if (!auditCard) return;
  auditLoading.style.display = 'block';
  auditContent.innerHTML = '';
  try {
    const res = await fetch('/api/seguridad/auditoria');
    if (!res.ok) {
      if (res.status === 404) {
        throw new Error('El servidor necesita reiniciarse para registrar el nuevo módulo de auditoría. Por favor, detén la terminal con Ctrl+C, ejecuta "npm start" y recarga la página.');
      }
      throw new Error('Error al auditar la bóveda (' + res.status + ').');
    }
    const data = await res.json();
    auditLoading.style.display = 'none';

    const saludColor = data.salud >= 80 ? 'var(--ok)' : (data.salud >= 50 ? '#f59e0b' : '#ef4444');
    let html = `
      <div class="audit-stat-grid">
        <div class="audit-card-box salud">
          <div class="num" style="color:${saludColor};">${data.salud}%</div>
          <div class="lbl">Índice de Salud Global</div>
        </div>
        <div class="audit-card-box ${data.duplicadas.length ? 'danger' : 'info'}">
          <div class="num">${data.duplicadas.length}</div>
          <div class="lbl">Grupos de Claves Duplicadas</div>
        </div>
        <div class="audit-card-box ${data.debiles.length ? 'warn' : 'info'}">
          <div class="num">${data.debiles.length}</div>
          <div class="lbl">Contraseñas Débiles</div>
        </div>
        <div class="audit-card-box ${data.desactualizadas.length ? 'warn' : 'info'}">
          <div class="num">${data.desactualizadas.length}</div>
          <div class="lbl">Sin cambiar (+6 meses)</div>
        </div>
      </div>
    `;

    function formatearFechaMod(fIso) {
      if (!fIso) return 'Sin fecha registrada';
      try {
        const d = new Date(fIso);
        if (isNaN(d.getTime())) return 'Sin fecha';
        return d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch (e) {
        return 'Sin fecha';
      }
    }

    // Sección de duplicadas
    if (data.duplicadas.length > 0) {
      html += `
        <div class="audit-sec">
          <h4 style="color:#ef4444;"><svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#ef4444;fill:none;stroke-width:2;filter:drop-shadow(0 0 4px rgba(239,68,68,0.5));"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Contraseñas Duplicadas (Riesgo Crítico)
          </h4>
          <div class="audit-list">
      `;
      data.duplicadas.forEach(g => {
        const empItems = g.empresas.map(e => `
          <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:3px 0;">
            <a href="javascript:void(0)" onclick="saltarAEmpresa(${e.id})" style="color:var(--accent); font-weight:700; text-decoration:none;">${e.empresa}</a>
            <span class="audit-meta-date" title="Última actualización de contraseña"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>${formatearFechaMod(e.fecha)} (${e.dias != null ? e.dias + ' d' : 'reciente'})</span>
          </div>
        `).join('');
        html += `
          <div class="audit-item" style="align-items:flex-start;">
            <div style="flex:1;">
              <span style="font-size:12px; color:var(--muted); font-weight:600;">Misma clave usada en ${g.cantidad} empresas:</span>
              <div style="margin-top:2px;">${empItems}</div>
            </div>
            <span class="audit-tag danger"><svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.5;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/></svg>Duplicada</span>
          </div>
        `;
      });
      html += `</div></div>`;
    }

    // Sección de débiles
    if (data.debiles.length > 0) {
      html += `
        <div class="audit-sec">
          <h4 style="color:#f59e0b;"><svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#f59e0b;fill:none;stroke-width:2;filter:drop-shadow(0 0 4px rgba(245,158,11,0.5));"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Contraseñas Débiles o Predecibles
          </h4>
          <div class="audit-list">
      `;
      data.debiles.forEach(d => {
        html += `
          <div class="audit-item">
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; flex:1;">
              <a href="javascript:void(0)" onclick="saltarAEmpresa(${d.id})" class="link-edit">
                <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:var(--accent);fill:none;stroke-width:2;"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                ${d.empresa}
              </a>
              <span class="audit-meta-date" title="Última actualización de contraseña">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                ${formatearFechaMod(d.fecha)}
              </span>
            </div>
            <span class="audit-tag warn"><svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.5;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>${d.motivos.join(' · ')}</span>
          </div>
        `;
      });
      html += `</div></div>`;
    }

    // Sección de desactualizadas
    if (data.desactualizadas.length > 0) {
      html += `
        <div class="audit-sec">
          <h4 style="color:var(--text);"><svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#38bdf8;fill:none;stroke-width:2;filter:drop-shadow(0 0 4px rgba(56,189,248,0.5));"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Credenciales con más de 6 meses sin renovar
          </h4>
          <div class="audit-list">
      `;
      data.desactualizadas.forEach(a => {
        html += `
          <div class="audit-item">
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; flex:1;">
              <a href="javascript:void(0)" onclick="saltarAEmpresa(${a.id})" class="link-edit">${a.empresa}</a>
              <span class="audit-meta-date" title="Fecha de última actualización">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Última vez: ${formatearFechaMod(a.fecha)}
              </span>
            </div>
            <span class="audit-tag warn"><svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>${a.dias} días sin cambio</span>
          </div>
        `;
      });
      html += `</div></div>`;
    }

    if (!data.duplicadas.length && !data.debiles.length && !data.desactualizadas.length) {
      html += `
        <div style="text-align:center; padding:30px 10px; color:var(--ok);">
          <svg viewBox="0 0 24 24" style="width:40px;height:40px;stroke:currentColor;fill:none;stroke-width:2;margin-bottom:8px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div style="font-size:16px; font-weight:700;">¡Bóveda Acorazada al 100%!</div>
          <div style="font-size:13px; color:var(--muted); margin-top:4px;">No se encontraron claves duplicadas ni contraseñas débiles en tus registros.</div>
        </div>
      `;
    }

    auditContent.innerHTML = html;
  } catch (err) {
    auditLoading.style.display = 'none';
    auditContent.innerHTML = `<div class="imp-msg err">${err.message}</div>`;
  }
}

window.saltarAEmpresa = function(id) {
  const row = document.querySelector('.row[data-id="' + id + '"]');
  if (row) {
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    row.classList.add('bump');
    setTimeout(() => row.classList.remove('bump'), 1000);
    const p = document.getElementById('edit-' + id);
    if (p && !p.classList.contains('open')) toggleEdit(id);
  }
};

