<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .chip{ display:inline-block; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; color:var(--accent-dark); background:var(--accent-soft); }
  .chip.ok{ color:#14683a; background:#dff5e7; }
  .chip.bad{ color:var(--danger); background:var(--danger-soft); }
  .chip.info{ color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); font-weight:600; }
  :root[data-theme="dark"] .chip.ok{ color:#6ee7a1; background:#173a28; }

  .v-toolbar{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .seg{ display:inline-flex; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:999px; padding:3px; }
  .seg button{ background:transparent; color:var(--muted); box-shadow:none; border:none; padding:6px 13px; font-size:12.5px; border-radius:999px; transform:none; }
  .seg button:hover{ color:var(--accent-dark); transform:none; box-shadow:none; filter:none; }
  .seg button.active{ background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; }
  .v-toolbar .sp{ flex:1; }
  .v-toolbar button, .v-toolbar label.btn{ padding:8px 13px; font-size:13px; }
  label.btn{ display:inline-flex; align-items:center; gap:6px; cursor:pointer; margin:0; text-transform:none; letter-spacing:0; }
  #entrada{
    width:100%; min-height:190px; max-height:60vh; resize:vertical; background:var(--panel-alt); border:1px solid var(--panel-edge);
    color:var(--text); font-family:var(--mono); font-size:13px; line-height:1.5; padding:12px 14px; border-radius:10px; outline:none;
    white-space:pre; overflow:auto; tab-size:4; transition:border-color .15s ease, box-shadow .15s ease;
  }
  #entrada:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  #entrada.drag{ border-color:var(--accent); background:var(--accent-soft); }
  .hint{ font-size:12px; color:var(--muted); margin-top:6px; }

  #salida{ margin-top:16px; display:none; }
  #salida.on{ display:block; }
  .v-status{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .aviso{ font-size:12.5px; background:var(--accent-soft); color:var(--accent-dark); border-radius:8px; padding:7px 11px; margin-bottom:10px; }

  .errbox{ border:1px solid var(--danger); background:var(--danger-soft); color:var(--text); border-radius:10px; padding:12px 14px; margin-bottom:10px; }
  .errbox .t{ color:var(--danger); font-weight:700; font-size:13.5px; margin-bottom:4px; }
  .errbox .m{ font-size:13px; overflow-wrap:anywhere; }
  .errbox pre{ margin:10px 0 0; background:#1e1e1e; color:#d4d4d4; border-radius:8px; padding:8px 0; font-family:var(--mono); font-size:12.5px; line-height:1.55; overflow:auto; }
  .errbox pre .l{ display:block; padding:0 12px; white-space:pre-wrap; word-break:break-word; }
  .errbox pre .l.bad{ background:rgba(209,72,58,.28); }
  .errbox pre .n{ color:#6e7681; display:inline-block; width:44px; user-select:none; }
  .errbox button{ margin-top:10px; padding:7px 12px; font-size:12.5px; }

  .v-tabs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px; }
  .v-tabs .sp{ flex:1; }
  .vsearch{ display:flex; align-items:center; gap:6px; }
  .vsearch input{ width:220px; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13px; padding:7px 10px; border-radius:8px; outline:none; }
  .vsearch input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .vsearch .cnt{ font-size:11.5px; color:var(--muted); white-space:nowrap; min-width:64px; }
  .mini{ background:transparent; border:1px solid var(--panel-edge); color:var(--muted); width:30px; height:30px; border-radius:7px; padding:0; box-shadow:none; font-size:11px; transform:none; }
  .mini:hover{ border-color:var(--accent); color:var(--accent-dark); background:var(--accent-soft); transform:none; box-shadow:none; filter:none; }

  /* Código estilo editor */
  .code-block{ background:#1e1e1e; color:#d4d4d4; border:1px solid #2d2d2d; border-radius:9px; padding:10px 0; font-family:var(--mono); font-size:13px; line-height:1.6; margin:0; max-height:70vh; min-height:120px; overflow:auto; resize:vertical; tab-size:4; }
  .code-line{ display:flex; }
  .code-line:hover{ background:rgba(255,255,255,.04); }
  .code-line .ln{ flex-shrink:0; width:52px; text-align:right; padding-right:12px; margin-right:12px; color:#6e7681; border-right:1px solid #333; user-select:none; }
  .code-line .code-text{ flex:1; min-width:0; white-space:pre-wrap; word-break:break-word; padding-right:14px; }
  .tk-tg{ color:#569cd6; } .tk-an{ color:#9cdcfe; } .tk-av{ color:#ce9178; } .tk-pn{ color:#808080; } .tk-tx{ color:#d4d4d4; }
  .tk-cd{ color:#dcdcaa; } .tk-pi{ color:#c586c0; } .tk-cm{ color:#6a9955; font-style:italic; }
  .tk-jk{ color:#9cdcfe; } .tk-js{ color:#ce9178; } .tk-jn{ color:#b5cea8; } .tk-jb{ color:#569cd6; } .tk-jl{ color:#569cd6; font-style:italic; }
  .code-block mark{ background:#ffd54a; color:#1e1e1e; border-radius:2px; padding:0 1px; }
  .cur-line{ outline:1px solid #ffd54a; outline-offset:-1px; background:rgba(255,213,74,.09); }
  .mas-lineas{ text-align:center; font-family:var(--sans); font-size:12px; color:#8b949e; padding:10px 8px 4px; }
  .mas-lineas a{ color:#4fc1ff; }
  .ver-mas{ color:#4fc1ff; font-style:italic; text-decoration:none; }

  /* Árbol */
  #vista-arbol{ display:none; border:1px solid var(--panel-edge); background:var(--panel-alt); border-radius:9px; padding:10px 8px; font-family:var(--mono); font-size:13px; line-height:1.55; max-height:70vh; overflow:auto; resize:vertical; }
  .tn > .tc{ display:none; margin-left:10px; padding-left:12px; border-left:1px solid var(--panel-edge); }
  .tn.open > .tc{ display:block; }
  .tr{ display:flex; align-items:baseline; gap:6px; padding:1px 6px; border-radius:6px; cursor:default; }
  .tr:hover{ background:var(--accent-soft); }
  .tr.sel{ background:var(--accent-soft); outline:1px solid var(--accent); }
  .tr .tg{ width:14px; flex-shrink:0; color:var(--muted); font-size:10px; text-align:center; transition:transform .12s; user-select:none; }
  .tn.open > .tr .tg{ transform:rotate(90deg); }
  .tn.hoja > .tr .tg{ visibility:hidden; }
  .tn.hijos > .tr{ cursor:pointer; }
  .tr .et{ overflow-wrap:anywhere; min-width:0; }
  .tr .nn{ color:var(--muted); font-size:11.5px; font-family:var(--sans); margin-left:4px; }
  #vista-arbol .tk-tg{ color:#0b5cad; } #vista-arbol .tk-an{ color:#1f6f8b; } #vista-arbol .tk-av{ color:#a3391f; } #vista-arbol .tk-pn{ color:#888; }
  #vista-arbol .tk-tx{ color:var(--text); } #vista-arbol .tk-cd{ color:#8a6d00; } #vista-arbol .tk-cm{ color:#3c7d3c; } #vista-arbol .tk-pi{ color:#8f3fa0; }
  #vista-arbol .tk-jk{ color:#1f6f8b; } #vista-arbol .tk-js{ color:#a3391f; } #vista-arbol .tk-jn{ color:#1b7a48; } #vista-arbol .tk-jb, #vista-arbol .tk-jl{ color:#0b5cad; }
  :root[data-theme="dark"] #vista-arbol .tk-tg{ color:#569cd6; } :root[data-theme="dark"] #vista-arbol .tk-an{ color:#9cdcfe; } :root[data-theme="dark"] #vista-arbol .tk-av{ color:#ce9178; }
  :root[data-theme="dark"] #vista-arbol .tk-cd{ color:#dcdcaa; } :root[data-theme="dark"] #vista-arbol .tk-cm{ color:#6a9955; } :root[data-theme="dark"] #vista-arbol .tk-pi{ color:#c586c0; }
  :root[data-theme="dark"] #vista-arbol .tk-jk{ color:#9cdcfe; } :root[data-theme="dark"] #vista-arbol .tk-js{ color:#ce9178; } :root[data-theme="dark"] #vista-arbol .tk-jn{ color:#b5cea8; }
  :root[data-theme="dark"] #vista-arbol .tk-jb, :root[data-theme="dark"] #vista-arbol .tk-jl{ color:#569cd6; }
  .masbtn{ font-family:var(--sans); font-size:12px; color:var(--accent-dark); cursor:pointer; padding:2px 6px; }
  .pathbar{ display:none; align-items:center; gap:8px; margin-top:8px; font-size:12.5px; }
  .pathbar.on{ display:flex; }
  .pathbar code{ flex:1; min-width:0; overflow-wrap:anywhere; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:7px; padding:6px 9px; font-family:var(--mono); }
  .pathbar button{ padding:6px 11px; font-size:12px; }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .22s ease, transform .22s cubic-bezier(.34,1.56,.64,1); box-shadow:0 6px 20px rgba(20,30,45,.18); z-index:1200; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  /* Pantalla completa (ampliar) y filtro de líneas */
  .ed-wrap.fullscreen{ position:fixed; inset:0; z-index:900; background:var(--bg); padding:14px 20px; margin:0; display:flex; flex-direction:column; overflow:auto; }
  .ed-wrap.fullscreen > *{ flex-shrink:0; }
  .ed-wrap.fullscreen #entrada{ flex:1 1 0; max-height:none; min-height:0; resize:none; }
  .ed-wrap.fullscreen .code-block, .ed-wrap.fullscreen #vista-arbol{ flex:1 1 0; min-height:0; max-height:none; resize:none; }
  .chk{ display:inline-flex; align-items:center; gap:5px; margin:0; font-size:12.5px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; white-space:nowrap; }
</style>

<div class="top">
  <h1>Visor XML / JSON</h1>
  <span class="chip info" id="chipVacio">Pega o abre un archivo</span>
</div>
<p class="sub">Pega aquí un XML o un JSON (o abre / arrastra un archivo) y se muestra formateado, validado y con colores. Todo se procesa en tu navegador: no se guarda ni se envía nada.</p>

<div class="card" style="padding:18px;">
 <div class="ed-wrap" id="edEntrada">
  <div class="v-toolbar">
    <div class="seg" id="seg">
      <button type="button" class="active" data-modo="auto">Auto</button>
      <button type="button" data-modo="json">JSON</button>
      <button type="button" data-modo="xml">XML</button>
    </div>
    <span class="sp"></span>
    <label class="btn secondary" for="archivo">⬆ Abrir archivo</label>
    <input type="file" id="archivo" accept=".xml,.json,.txt,.xsd,.xsl,.xslt,.svg,.config,.csproj,.wsdl,.html" style="display:none;">
    <button type="button" class="secondary" id="btnAmpliarEntrada" title="Pantalla completa (Esc para salir)">⤢ Ampliar</button>
    <button type="button" class="secondary" id="btnLimpiar">Limpiar</button>
  </div>
  <textarea id="entrada" spellcheck="false" wrap="off" placeholder="Pega aquí tu XML o JSON…"></textarea>
  <div class="hint">También puedes arrastrar un archivo sobre esta caja. Los números grandes (NIT, IDs) se respetan tal cual, sin redondear.</div>
 </div>
</div>

