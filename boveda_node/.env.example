# Copia este archivo a ".env" y ajusta los datos de tu PostgreSQL local.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=pon_aqui_tu_password_de_postgres
PGDATABASE=boveda_jira

# Clave usada para firmar la cookie de sesión (pon cualquier texto largo y raro)
SESSION_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

PORT=5050

# Tamaño máximo por archivo subido en Notas/Jaivaná, en MB (opcional, por defecto 100)
# MAX_UPLOAD_MB=100
