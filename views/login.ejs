  var dragVelX = 0, dragVelY = 0;
  var mouseX = 0, mouseY = 0, targetRotX = 0.14, targetRotY = 0;

  window.addEventListener('mousedown', function(e) {
    if (e.target.closest('#earthCanvasWrap')) {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    }
  });

  window.addEventListener('mousemove', function(e) {
    if (isDragging) {
      var deltaX = e.clientX - previousMousePosition.x;
      var deltaY = e.clientY - previousMousePosition.y;
      dragVelX = deltaX * 0.0055;
      dragVelY = deltaY * 0.0055;
      globeGroup.rotation.y += dragVelX;
      globeGroup.rotation.x += dragVelY;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    } else {
      mouseX = (e.clientX / window.innerWidth) * 2 - 1;
      mouseY = (e.clientY / window.innerHeight) * 2 - 1;
      targetRotX = 0.14 + (mouseY * 0.12);
      targetRotY = mouseX * 0.18;
    }
  });

  window.addEventListener('mouseup', function() {
    isDragging = false;
  });

  // Soporte para dispositivos táctiles (Touch)
  window.addEventListener('touchstart', function(e) {
    if (e.touches.length === 1 && e.target.closest('#earthCanvasWrap')) {
      isDragging = true;
      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: true });

  window.addEventListener('touchmove', function(e) {
    if (isDragging && e.touches.length === 1) {
      var deltaX = e.touches[0].clientX - previousMousePosition.x;
      var deltaY = e.touches[0].clientY - previousMousePosition.y;
      dragVelX = deltaX * 0.006;
      dragVelY = deltaY * 0.006;
      globeGroup.rotation.y += dragVelX;
      globeGroup.rotation.x += dragVelY;
      previousMousePosition = { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
  }, { passive: true });

  window.addEventListener('touchend', function() {
    isDragging = false;
  });

  window.addEventListener('resize', function() {
    var nw = window.innerWidth, nh = window.innerHeight;
    camera.aspect = nw / nh;
    camera.updateProjectionMatrix();
    renderer.setSize(nw, nh);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2.5));
    updateGlobePlacement();
  });

  var waveCanvas = document.getElementById('hudWaveCanvas');
  var waveCtx = waveCanvas ? waveCanvas.getContext('2d') : null;
  var waveStep = 0;
  function dibujarOndaECG() {
    if (!waveCtx) return;
    waveStep += 0.08;
    waveCtx.clearRect(0, 0, 80, 28);
    waveCtx.beginPath();
    waveCtx.strokeStyle = planetaActual ? planetaActual.colorHex : '#ff3b30';
    waveCtx.lineWidth = 1.6;
    for (var x = 0; x < 80; x++) {
      var y = 14 + Math.sin(x * 0.18 + waveStep) * 4;
      if (x > 32 && x < 46) {
        y += Math.sin((x - 32) * 0.4) * 9;
      }
      if (x === 0) waveCtx.moveTo(x, y);
      else waveCtx.lineTo(x, y);
    }
    waveCtx.stroke();
  }

  var hudClock = document.getElementById('hudLiveClock');
  function actualizarReloj() {
    if (!hudClock) return;
    var d = new Date();
    hudClock.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0') + ':' + String(d.getSeconds()).padStart(2, '0');
  }
  setInterval(actualizarReloj, 1000);
  actualizarReloj();

  // Bucle de animación continuo a 60fps con cálculo de rotación física
  var trackerAngle = 0;
  function animate() {
    requestAnimationFrame(animate);

    if (!isDragging) {
      if (Math.abs(dragVelX) > 0.0001 || Math.abs(dragVelY) > 0.0001) {
        globeGroup.rotation.y += dragVelX;
        globeGroup.rotation.x += dragVelY;
        dragVelX *= 0.93;
        dragVelY *= 0.93;
      }
      globeGroup.rotation.y += (planetaActual ? planetaActual.vel : 0.0034);
      globeGroup.rotation.x += (targetRotX - globeGroup.rotation.x) * 0.04;
      globeGroup.rotation.z = targetRotY * 0.25;
    }

    // Rotación del retículo de telemetría a lo largo del anillo orbital
    trackerAngle += 0.014;
    var trackRadius = GLOBE_RADIUS + 0.48;
    trackerMesh.position.set(Math.cos(trackerAngle) * trackRadius, Math.sin(trackerAngle) * trackRadius, 0);

    // Rotación de los anillos HUD y del pedestal
    hudRingGroup.rotation.z += 0.0035;
    pedestalGroup.rotation.z -= 0.002;
    dustMesh.rotation.y += 0.0018;

    if (earthCloudsMesh && earthCloudsMesh.visible) {
      earthCloudsMesh.rotation.y += 0.0006;
    }
    if (venusCloudsMesh && venusCloudsMesh.visible) {
      venusCloudsMesh.rotation.y += 0.0048;
    }
    if (neptuneCloudsMesh && neptuneCloudsMesh.visible) {
      neptuneCloudsMesh.rotation.y += 0.0016;
    }

    if (saturnGroup && saturnGroup.visible) {
      saturnGroup.rotation.z += 0.0012;
      if (meteoritosMesh && meteoritoData && meteoritoData.length) {
        for (var mi = 0; mi < NUM_METEORITOS; mi++) {
          var m = meteoritoData[mi];
          m.ang += m.velOrbital;
          m.rotX += m.tumbleX;
          m.rotY += m.tumbleY;
          m.rotZ += m.tumbleZ;
          dummyMeteor.position.set(Math.cos(m.ang) * m.dist, m.y, Math.sin(m.ang) * m.dist);
          dummyMeteor.rotation.set(m.rotX, m.rotY, m.rotZ);
          dummyMeteor.scale.set(m.scaleX, m.scaleY, m.scaleZ);
          dummyMeteor.updateMatrix();
          meteoritosMesh.setMatrixAt(mi, dummyMeteor.matrix);
        }
        meteoritosMesh.instanceMatrix.needsUpdate = true;
      }
    }
    if (stars) {
      stars.rotation.y += 0.0002;
    }

    dibujarOndaECG();
    renderer.render(scene, camera);
  }

  animate();
})();

// --- GESTIÓN DEL FORMULARIO DE ACCESO AJAX ---
(function() {
  var form = document.getElementById('loginForm');
  var btn = document.getElementById('btnLogin');
  var txtUser = document.getElementById('usuario');
  var txtPass = document.getElementById('clave');
  var chkRecordar = document.getElementById('chkRecordar');
  if (!form || !btn) return;

  var originalHTML = btn.innerHTML;
  var animando = false;

  try {
    var savedUser = localStorage.getItem('boveda_saved_user');
    if (savedUser && txtUser) {
      txtUser.value = savedUser;
      if (chkRecordar) chkRecordar.checked = true;
      if (txtPass) setTimeout(function(){ txtPass.focus(); }, 50);
    }
  } catch(e) {}

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (animando) return;

    var username = (txtUser ? txtUser.value : '').trim();
    var password = txtPass ? txtPass.value : '';
    if (!username || !password) return;

    try {
      if (chkRecordar && chkRecordar.checked) localStorage.setItem('boveda_saved_user', username);
      else localStorage.removeItem('boveda_saved_user');
    } catch(e) {}

    animando = true;
    btn.disabled = true;
    btn.classList.add('btn-validando');
    btn.innerHTML = '<span class="btn-label">VALIDANDO ACCESO…</span><svg viewBox="0 0 24 24" style="animation: spin 0.8s linear infinite; width:18px; height:18px;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-linecap="round" fill="none"/></svg>';

    fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ username: username, password: password, ajax: '1' }),
      credentials: 'same-origin'
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data && data.ok) {
        btn.classList.remove('btn-validando', 'btn-invalido');
        btn.classList.add('btn-valido');
        btn.innerHTML = '<span class="btn-label">¡AUTORIZADO!</span><svg viewBox="0 0 24 24" style="stroke-width:3.2; width:18px; height:18px;"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(function() { window.location.href = data.redirect || '/'; }, 500);
      } else {
        mostrarError(data && data.error ? data.error : 'Credenciales inválidas');
      }
    })
    .catch(function() { mostrarError('Error de enlace'); });
  });

  function mostrarError(msg) {
    btn.classList.remove('btn-validando', 'btn-valido');
    btn.classList.add('btn-invalido');
    btn.innerHTML = '<span class="btn-label">' + (msg || 'DATOS INCORRECTOS') + '</span>';
    if (txtPass) txtPass.select();
    setTimeout(function() {
      btn.classList.remove('btn-invalido');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      animando = false;
    }, 1800);
  }
})();

// --- GESTIÓN DE ACCESO BIOMÉTRICO (WEBAUTHN / WINDOWS HELLO HUELLA DIGITAL) ---
(function() {
  var btnBio = document.getElementById('btnBiometria');
  var divBio = document.getElementById('bioDivider');
  var txtUser = document.getElementById('usuario');
  if (!btnBio || typeof Biometria === 'undefined') return;

  var originalBioHTML = btnBio.innerHTML;
  var bioEscaneando = false;

  Biometria.esCompatible().then(function(compatible) {
    if (compatible) {
      btnBio.style.display = 'flex';
      if (divBio) divBio.style.display = 'flex';
    }
  }).catch(function() {});

  btnBio.addEventListener('click', async function() {
    if (bioEscaneando) return;
    bioEscaneando = true;

    var usuario = (txtUser ? txtUser.value : '').trim();

    btnBio.classList.add('scanning');
    btnBio.disabled = true;
    var t = btnBio.querySelector('.bio-title');
    var s = btnBio.querySelector('.bio-sub');
    if (t) t.textContent = 'COLOCA TU DEDO EN EL SENSOR...';
    if (s) s.textContent = 'Escaneando huella dactilar Windows Hello';

    try {
      var resultado = await Biometria.autenticar(usuario);
      if (resultado && resultado.ok) {
        btnBio.classList.remove('scanning');
        btnBio.style.borderColor = '#10b981';
        btnBio.style.background = 'rgba(16, 185, 129, 0.2)';
        if (t) t.textContent = '¡HUELLA RECONOCIDA! BIENVENIDO';
        if (s) s.textContent = (resultado.user ? resultado.user.username : '') + ' · Acceso concedido';
        setTimeout(function() {
          window.location.href = resultado.redirect || '/';
        }, 550);
      }
    } catch(err) {
      btnBio.classList.remove('scanning');
      btnBio.style.borderColor = '#ef4444';
      btnBio.style.background = 'rgba(239, 68, 68, 0.2)';
      if (t) t.textContent = 'NO SE PUDO VERIFICAR HUELLA';
      if (s) s.textContent = err.message || 'Intenta de nuevo o ingresa con tu contraseña';

      setTimeout(function() {
        btnBio.style.borderColor = '';
        btnBio.style.background = '';
        btnBio.innerHTML = originalBioHTML;
        btnBio.disabled = false;
        bioEscaneando = false;
      }, 2500);
    }
  });
})();
</script>
