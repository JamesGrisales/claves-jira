  // 8.2 CINTURÓN DE METEORITOS 3D FOTORREALISTA (2,200 ROCAS, MONOLITOS Y ASTEROIDES EN ÓRBITA)
  function crearGeometriaAsteroide(radioBase, semilla) {
    var geo = new THREE.DodecahedronGeometry(radioBase, 1);
    var pos = geo.attributes.position;
    var v = new THREE.Vector3();
    for (var i = 0; i < pos.count; i++) {
      v.fromBufferAttribute(pos, i);
      var ang = Math.atan2(v.z, v.x);
      var elev = v.y / radioBase;
      var ruido = Math.sin(ang * 3.2 + semilla) * Math.cos(elev * 4.1 + semilla * 1.5) * 0.35
                + Math.sin(v.x * 5.5 + v.y * 3.3) * 0.18;
      var factor = 1.0 + ruido + (Math.sin(i * 11.3) * 0.12);
      v.x *= 1.20;
      v.z *= 0.85;
      v.multiplyScalar(factor);
      pos.setXYZ(i, v.x, v.y, v.z);
    }
    geo.computeVertexNormals();
    return geo;
  }

