(function mountGuestNavAboveLogin() {
  function moveNav() {
    var nb = document.querySelector('body.guest .navbar');
    var target = document.getElementById('loginTopControls');
    if (nb && target && nb.parentNode !== target) {
      target.appendChild(nb);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', moveNav);
  } else {
    moveNav();
  }
  setTimeout(moveNav, 50);
})();

// --- MOTOR 3D HOLOGRÁFICO CYBERNETIC DATA CORE (THREE.JS) ---
(function initCyberDataCore() {
  var container = document.getElementById('earthCanvasWrap');
  if (!container || typeof THREE === 'undefined') return;

  var width = window.innerWidth;
  var height = window.innerHeight;

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
  camera.position.set(0, 0, 7.5);

  var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setSize(width, height);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  var group = new THREE.Group();
  scene.add(group);
  group.position.set(-1.8, 0.3, 0);

  // 1. Núcleo geométrico wireframe holográfico
  var geomIco = new THREE.IcosahedronGeometry(1.6, 1);
  var matIco = new THREE.MeshBasicMaterial({
    color: 0x00f5ff,
    wireframe: true,
    transparent: true,
    opacity: 0.35
  });
  var coreMesh = new THREE.Mesh(geomIco, matIco);
  group.add(coreMesh);

  // 2. Cubo interior cuántico
  var geomCube = new THREE.BoxGeometry(1.3, 1.3, 1.3);
  var matCube = new THREE.MeshBasicMaterial({
    color: 0x00f5ff,
    wireframe: true,
    transparent: true,
    opacity: 0.22
  });
  var cubeMesh = new THREE.Mesh(geomCube, matCube);
  group.add(cubeMesh);

  // 3. Anillos orbitales de telemetría de datos
  var ringGeom1 = new THREE.RingGeometry(2.1, 2.14, 64);
  var ringMat1 = new THREE.MeshBasicMaterial({ color: 0x00f5ff, side: THREE.DoubleSide, transparent: true, opacity: 0.45 });
  var ringMesh1 = new THREE.Mesh(ringGeom1, ringMat1);
  ringMesh1.rotation.x = Math.PI * 0.35;
  group.add(ringMesh1);

  var ringGeom2 = new THREE.RingGeometry(2.5, 2.53, 64);
  var ringMat2 = new THREE.MeshBasicMaterial({ color: 0x00f5ff, side: THREE.DoubleSide, transparent: true, opacity: 0.28 });
  var ringMesh2 = new THREE.Mesh(ringGeom2, ringMat2);
  ringMesh2.rotation.y = Math.PI * 0.4;
  group.add(ringMesh2);

  // 4. Nube de partículas de telemetría cuántica
  var partCount = 380;
  var partGeom = new THREE.BufferGeometry();
  var partPos = new Float32Array(partCount * 3);
  for (var i = 0; i < partCount * 3; i += 3) {
    var r = 1.9 + Math.random() * 1.8;
    var theta = Math.random() * Math.PI * 2;
    var phi = (Math.random() - 0.5) * Math.PI;
    partPos[i] = r * Math.cos(theta) * Math.cos(phi);
    partPos[i + 1] = r * Math.sin(phi);
    partPos[i + 2] = r * Math.sin(theta) * Math.cos(phi);
  }
  partGeom.setAttribute('position', new THREE.BufferAttribute(partPos, 3));
  var partMat = new THREE.PointsMaterial({
    color: 0x00f5ff,
    size: 0.05,
    transparent: true,
    opacity: 0.65
  });
  var particleSystem = new THREE.Points(partGeom, partMat);
  group.add(particleSystem);

  // Función global para actualizar el color del holograma según el motor activo
  window.updateHologramColor = function(hexColor) {
    try {
      var c = new THREE.Color(hexColor);
      matIco.color.copy(c);
      matCube.color.copy(c);
      ringMat1.color.copy(c);
      ringMat2.color.copy(c);
      partMat.color.copy(c);
    } catch(e) {}
  };

  // Interacción suave con el mouse
  var mouseX = 0, mouseY = 0;
  window.addEventListener('mousemove', function(e) {
    mouseX = (e.clientX / width - 0.5) * 0.4;
    mouseY = (e.clientY / height - 0.5) * 0.4;
  }, { passive: true });

  window.addEventListener('resize', function() {
    width = window.innerWidth;
    height = window.innerHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    group.position.set(width < 960 ? 0 : -1.8, 0.3, 0);
  });

  if (width < 960) group.position.set(0, 0.3, 0);

  function animate() {
    requestAnimationFrame(animate);
    coreMesh.rotation.y += 0.005;
    coreMesh.rotation.x += 0.002;
    cubeMesh.rotation.y -= 0.007;
    cubeMesh.rotation.z += 0.003;
    ringMesh1.rotation.z += 0.004;
    ringMesh2.rotation.z -= 0.003;
    particleSystem.rotation.y += 0.0015;

    group.rotation.y += (mouseX - group.rotation.y) * 0.05;
    group.rotation.x += (mouseY - group.rotation.x) * 0.05;

    renderer.render(scene, camera);
  }
  animate();
})();

