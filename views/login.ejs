  // 8. Anillos de Saturno Fotorrealistas con División de Cassini en Alta Definición (2048x2048)
  function generarTexturaAnillosSaturno() {
    var c = document.createElement('canvas');
    c.width = 2048;
    c.height = 2048;
    var ctx = c.getContext('2d');
    var cx = 1024, cy = 1024;
    ctx.clearRect(0, 0, 2048, 2048);

    for (var r = 530; r <= 1016; r += 0.5) {
      var norm = (r - 530) / (1016 - 530);
      var alpha = 0;
      var rColor = 'rgba(225, 205, 160, ';

      if (norm < 0.16) {
        // Anillo C (Crepe ring)
        alpha = 0.20 + Math.sin(r * 0.2) * 0.08;
        rColor = 'rgba(165, 145, 115, ';
      } else if (norm >= 0.16 && norm < 0.62) {
        // Anillo B (brillante, denso)
        alpha = 0.88 + Math.sin(r * 0.45) * 0.10;
        rColor = (Math.floor(r) % 4 < 2) ? 'rgba(235, 215, 168, ' : 'rgba(215, 192, 145, ';
      } else if (norm >= 0.62 && norm < 0.70) {
        // División de Cassini (Brecha oscura transparente)
        alpha = 0.02;
      } else if (norm >= 0.70 && norm < 0.94) {
        // Anillo A
        if (norm > 0.86 && norm < 0.885) {
          // Brecha de Encke
          alpha = 0.06;
        } else {
          alpha = 0.70 + Math.sin(r * 0.3) * 0.08;
          rColor = 'rgba(215, 195, 150, ';
        }
      } else {
        // Borde exterior difuminado (Anillo F)
        alpha = (1.0 - (norm - 0.94) / 0.06) * 0.35;
      }

      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.lineWidth = 1.0;
      ctx.strokeStyle = rColor + Math.max(0, Math.min(1, alpha)) + ')';
      ctx.stroke();
    }

    var tex = new THREE.CanvasTexture(c);
    tex.anisotropy = maxAnisotropy;
    tex.generateMipmaps = true;
    tex.minFilter = THREE.LinearMipmapLinearFilter;
    tex.magFilter = THREE.LinearFilter;
    return tex;
  }

