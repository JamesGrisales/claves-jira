      glow: 'rgba(56, 189, 248, 0.35)',
      chip: 'GO v1.23 CHANNELS',
      iops: '1,450,000 IOPS',
      latency: '0.002 ms',
      code: [
        "// [GO 1.23 · GOROUTINES CONCURRENCY PIPELINE]",
        "package vault",
        "",
        "import (",
        "    \"crypto/sha256\",",
        "    \"net/http\",",
        "    \"time\",",
        ")",
        "",
        "type AuthResult struct {",
        "    Authorized bool          `json:\"authorized\"`",
        "    Latency    time.Duration `json:\"latency\"`",
        "}",
        "",
        "func HandleAuthPipeline(w http.ResponseWriter, r *http.Request) {",
        "    start := time.Now()",
        "    h := sha256.Sum256([]byte(r.Header.Get(\"X-Vault-Token\")))",
        "    _ = h",
        "    w.WriteHeader(http.StatusOK)",
        "}"
      ]
    }
  };

  var backdrop = document.getElementById('dbThemeBackdrop');
  var mainTitle = document.getElementById('hudMainTitle');
  var termBox = document.getElementById('hudPlsqlTerminal');
  var termIcon = document.getElementById('hudTermIcon');
  var termEngine = document.getElementById('hudTermEngine');
  var termChip = document.getElementById('hudTermChip');
  var codeContent = document.getElementById('hudCodeContent');
  var termBody = document.getElementById('hudTermBody');
  var termIops = document.getElementById('hudTermIops');
  var termLatency = document.getElementById('hudTermLatency');
  var switcher = document.getElementById('hudEngineSwitcher');
  var btnAutoRotar = document.getElementById('btnAutoRotar');
  var aebIcon = document.getElementById('aebIcon');
  var aebTxt = document.getElementById('aebTxt');

  var savedTheme = localStorage.getItem('boveda_login_theme');
  if (!savedTheme || savedTheme === 'planetas' || !DB_THEMES[savedTheme]) {
    savedTheme = 'postgres';
  }
  var currentTheme = savedTheme;
  var autoRotate = localStorage.getItem('boveda_theme_autorotate') === 'true';
  var rotateTimer = null;

  // Resaltador de sintaxis multilingüe para terminal (protección contra colisión HTML)
  function highlightLine(line) {
    if (!line) return '';
    var trimmed = line.trim();
    if (trimmed.startsWith('--') || trimmed.startsWith('//') || trimmed.startsWith('#')) {
      return '<span class="plsql-cm">' + escapeHtml(line) + '</span>';
    }
    var s = escapeHtml(line);
    // Reemplazo estricto de strings por tipo de comilla sin cruces
    s = s.replace(/("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|`[^`]*`)/g, '<span class="plsql-str">$1</span>');
    var kwRegex = /\b(CREATE|OR|REPLACE|PACKAGE|BODY|PROCEDURE|FUNCTION|RETURNS|TABLE|DECLARE|BEGIN|END|IS|AS|IF|THEN|OPEN|FETCH|CLOSE|INTO|CURSOR|SELECT|INSERT|FROM|WHERE|FOR|UPDATE|COMMIT|RETURN|QUERY|LANGUAGE|SET|TRANSACTION|OUTPUT|NOCOUNT|WITH|ROWLOCK|UPDLOCK|HOLDLOCK|import|export|from|async|await|const|let|var|function|def|class|pub|fn|impl|struct|type|package|return|match|record|public|private|protected|static|final|new|try|catch|throw|throws|MERGE|MATCH|KEYSPACE|PRAGMA)\b/g;
    s = s.replace(kwRegex, function(m, p1, offset, full) {
      // Evitar reemplazar dentro de tags span class="..."
      var prev = full.slice(Math.max(0, offset - 15), offset);
      if (prev.includes('class="') || prev.includes('span')) return m;
      return '<span class="plsql-kw">' + m + '</span>';
    });
    var typeRegex = /\b(VARCHAR2|VARCHAR|NUMBER|BOOLEAN|RAW|BYTEA|INT|INTEGER|INET|TEXT|BIT|NVARCHAR|VARBINARY|MAX|SYSUTCDATETIME|ROWTYPE|UUID|BLOB|TIMESTAMP|Result|Option|String|Arc|RwLock|Duration|Response|Request)\b/g;
    s = s.replace(typeRegex, function(m, p1, offset, full) {
      var prev = full.slice(Math.max(0, offset - 15), offset);
      if (prev.includes('class="') || prev.includes('span')) return m;
      return '<span class="plsql-type">' + m + '</span>';
    });
    var fnRegex = /\b(ORA_HASH|DBMS_CRYPTO|VERIFY_SIGNATURE|clock_timestamp|db|redis|sha256|createHash|randomBytes|datetime)\b/g;
    s = s.replace(fnRegex, function(m, p1, offset, full) {
      var prev = full.slice(Math.max(0, offset - 15), offset);
      if (prev.includes('class="') || prev.includes('span')) return m;
      return '<span class="plsql-fn">' + m + '</span>';
    });
    return s;
  }

  function escapeHtml(t) {
    return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Motor Typewriter en vivo
  var typeTimer = null;
  var currentLineIdx = 0;
  var currentCharIdx = 0;
  var activeLines = [];
  var renderedLines = [];

  function stopTypewriter() {
    if (typeTimer) clearTimeout(typeTimer);
    typeTimer = null;
  }

  function startTypewriter(lines) {
    stopTypewriter();
    activeLines = lines || [];
    currentLineIdx = 0;
    currentCharIdx = 0;
    renderedLines = [];
    if (codeContent) codeContent.innerHTML = '';
    if (!activeLines.length) return;
    typeNext();
  }

  function typeNext() {
    if (currentLineIdx >= activeLines.length) {
      typeTimer = setTimeout(function() {
        startTypewriter(activeLines);
      }, 4500);
      return;
    }

    var fullLine = activeLines[currentLineIdx];
    currentCharIdx++;

    var partialLine = fullLine.slice(0, currentCharIdx);
    var displayHTML = renderedLines.map(function(l) { return highlightLine(l); }).join('\n');
    if (renderedLines.length > 0) displayHTML += '\n';
    displayHTML += highlightLine(partialLine);

    if (codeContent) codeContent.innerHTML = displayHTML;
    if (termBody) termBody.scrollTop = termBody.scrollHeight;

    if (currentCharIdx >= fullLine.length) {
      renderedLines.push(fullLine);
      currentLineIdx++;
      currentCharIdx = 0;
      var lineDelay = (fullLine.trim().startsWith('--') || fullLine.trim().startsWith('//') || fullLine.trim().startsWith('#')) ? 200 : 80;
      typeTimer = setTimeout(typeNext, lineDelay);
    } else {
      var charSpeed = Math.floor(Math.random() * 24) + 12;
      typeTimer = setTimeout(typeNext, charSpeed);
    }
  }

  // Aplicar tema seleccionado
  function aplicarTema(themeId, persist) {
    if (!DB_THEMES[themeId]) themeId = 'postgres';
    var theme = DB_THEMES[themeId];
    currentTheme = themeId;
    if (persist) {
      try {
        localStorage.setItem('boveda_login_theme', themeId);
        localStorage.setItem('boveda_db_engine', themeId);
      } catch(e) {}
    }

    // Actualizar botones del selector
    if (switcher) {
      var tabs = switcher.querySelectorAll('.engine-tab[data-engine]');
      tabs.forEach(function(tb) {
        var isThis = tb.getAttribute('data-engine') === themeId;
        tb.classList.toggle('active', isThis);
        if (isThis && persist) {
          tb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    }

    // Actualizar badge en la tarjeta de login
    if (aebIcon) aebIcon.textContent = theme.icon;
    if (aebTxt) aebTxt.textContent = theme.name;

    // Actualizar color dinámico en todo el documento
    document.documentElement.style.setProperty('--planet-accent', theme.accent);
    document.documentElement.style.setProperty('--p1', theme.accent);
    document.documentElement.style.setProperty('--accent-rgb', theme.accentRgb);
    document.documentElement.setAttribute('data-db-engine', themeId);

    // Actualizar fondo ambiental
    if (backdrop) {
      backdrop.style.backgroundImage = "url('" + theme.image + "')";
      backdrop.classList.add('active');
    }

    // Actualizar color del holograma 3D Three.js
    if (window.updateHologramColor) {
      window.updateHologramColor(theme.accent);
    }

    // Actualizar Terminal Holográfico
    if (termBox) {
      termBox.style.display = 'flex';
      if (termIcon) termIcon.textContent = theme.icon;
      if (termEngine) termEngine.textContent = theme.fullName;
      if (termChip) termChip.textContent = theme.chip;
      if (termIops) termIops.textContent = theme.iops;
      if (termLatency) termLatency.textContent = theme.latency;
    }
    if (mainTitle) {
      mainTitle.textContent = theme.fullName;
    }

    startTypewriter(theme.code);
  }

  // Delegación de eventos del selector
  if (switcher) {
    switcher.addEventListener('click', function(e) {
      var btn = e.target.closest('.engine-tab');
      if (!btn) return;

      if (btn.id === 'btnAutoRotar') {
        autoRotate = !autoRotate;
        try { localStorage.setItem('boveda_theme_autorotate', String(autoRotate)); } catch(e) {}
        btn.classList.toggle('active', autoRotate);
        if (autoRotate) {
          iniciarAutoRotacion();
        } else {
          detenerAutoRotacion();
        }
        return;
      }

      var engineId = btn.getAttribute('data-engine');
      if (engineId) {
        if (autoRotate) {
          autoRotate = false;
          try { localStorage.setItem('boveda_theme_autorotate', 'false'); } catch(e) {}
          if (btnAutoRotar) btnAutoRotar.classList.remove('active');
          detenerAutoRotacion();
        }
        aplicarTema(engineId, true);
      }
    });

    // Desplazamiento horizontal fluido con la rueda del ratón
    switcher.addEventListener('wheel', function(e) {
      if (e.deltaY !== 0) {
        e.preventDefault();
        switcher.scrollLeft += e.deltaY;
      }
    }, { passive: false });
  }

  var engineKeys = [
    'postgres', 'oracle', 'sqlserver', 'mysql', 'mongodb', 'redis', 'sqlite', 'cassandra', 'neo4j',
    'vscode', 'neovim',
    'python', 'javascript', 'java', 'rust', 'golang'
  ];

  function rotarSiguiente() {
    var curIdx = engineKeys.indexOf(currentTheme);
    var nextIdx = (curIdx + 1) % engineKeys.length;
    aplicarTema(engineKeys[nextIdx], true);
  }

  function iniciarAutoRotacion() {
    detenerAutoRotacion();
    rotateTimer = setInterval(rotarSiguiente, 8000);
  }

  function detenerAutoRotacion() {
    if (rotateTimer) {
      clearInterval(rotateTimer);
      rotateTimer = null;
    }
  }

  // Inicialización
  aplicarTema(currentTheme, false);

  if (autoRotate) {
    if (btnAutoRotar) btnAutoRotar.classList.add('active');
    iniciarAutoRotacion();
  }
})();


// --- PERSPECTIVA 3D ESTÁTICA TIPO CABINA (OPCIÓN C) ---
// Fijada a -8.5° en CSS para estabilidad perfecta permanente.

// --- GESTIÓN DE ACCESO BIOMÉTRICO (WEBAUTHN / WINDOWS HELLO HUELLA DIGITAL) ---
(function initBiometriaLogin() {
  var btnBio = document.getElementById('btnBiometria');
  var txtUser = document.getElementById('usuario');
  if (!btnBio) return;

  var bioEscaneando = false;

  function setScanningState(scanning) {
    bioEscaneando = scanning;
    btnBio.classList.toggle('scanning', scanning);
    var title = btnBio.querySelector('.bh-title');
    var sub = document.getElementById('bioSub');

    if (scanning) {
      if (title) title.textContent = 'ESCANEANDO HUELLA...';
      if (sub) sub.textContent = 'Coloca tu dedo en el sensor Windows Hello';
    } else {
      if (title) title.textContent = 'Desbloqueo Biométrico';
      if (sub) sub.textContent = 'Toca para escanear con Windows Hello';
    }
  }

  btnBio.addEventListener('click', async function() {
    if (bioEscaneando) return;
    setScanningState(true);

    var usuario = (txtUser ? txtUser.value : '').trim();
    var title = btnBio.querySelector('.bh-title');
    var sub = document.getElementById('bioSub');

    try {
      if (typeof Biometria === 'undefined') {
        throw new Error('Módulo biométrico no disponible en este navegador');
      }

      var resultado = await Biometria.autenticar(usuario);
      if (resultado && resultado.ok) {
        btnBio.classList.remove('scanning');
        btnBio.classList.add('authorized');
        if (title) title.textContent = '¡HUELLA AUTORIZADA!';
        if (sub) sub.textContent = (resultado.user ? resultado.user.username : 'Usuario') + ' · Acceso concedido';

        setTimeout(function() {
          window.location.href = resultado.redirect || '/';
        }, 550);
      } else {
        throw new Error((resultado && resultado.error) || 'Huella no reconocida.');
      }
    } catch(err) {
      console.warn('Biometría:', err);
      btnBio.classList.remove('scanning');
      btnBio.classList.add('rejected');
      if (title) title.textContent = 'NO SE PUDO VERIFICAR HUELLA';
      if (sub) sub.textContent = err.message || 'Intenta de nuevo o ingresa con contraseña abajo';

      setTimeout(function() {
        btnBio.classList.remove('rejected');
        setScanningState(false);
      }, 3000);
    }
  });

  // Accesibilidad con teclado (Enter o Espacio)
  btnBio.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      btnBio.click();
    }
  });

  // Medidor dinámico de seguridad de contraseña
  var txtClave = document.getElementById('clave');
  var pwWrap = document.getElementById('pwStrengthWrap');
  var pwText = document.getElementById('pwStrengthText');
  var seg1 = document.getElementById('pwSeg1');
  var seg2 = document.getElementById('pwSeg2');
  var seg3 = document.getElementById('pwSeg3');
  var seg4 = document.getElementById('pwSeg4');

  if (txtClave && pwWrap) {
    txtClave.addEventListener('input', function() {
      var val = this.value;
      if (!val) {
        pwWrap.style.display = 'none';
        return;
      }
      pwWrap.style.display = 'flex';
      
      var score = 0;
      if (val.length >= 6) score++;
      if (val.length >= 8 && /[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
      if (/d/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val) && val.length >= 9) score++;

      [seg1, seg2, seg3, seg4].forEach(function(s){ if (s) s.style.background = 'transparent'; });

      if (score <= 1) {
        if (seg1) seg1.style.background = '#ef4444';
        if (pwText) { pwText.textContent = 'Contraseña corta o débil'; pwText.style.color = '#ef4444'; }
      } else if (score === 2) {
        if (seg1) seg1.style.background = '#f59e0b';
        if (seg2) seg2.style.background = '#f59e0b';
        if (pwText) { pwText.textContent = 'Seguridad media'; pwText.style.color = '#f59e0b'; }
      } else if (score === 3) {
        if (seg1) seg1.style.background = '#00f5ff';
        if (seg2) seg2.style.background = '#00f5ff';
        if (seg3) seg3.style.background = '#00f5ff';
        if (pwText) { pwText.textContent = 'Seguridad fuerte'; pwText.style.color = '#00f5ff'; }
      } else {
        [seg1, seg2, seg3, seg4].forEach(function(s){ if (s) s.style.background = '#10b981'; });
        if (pwText) { pwText.textContent = 'Blindada • AES-256 Ready'; pwText.style.color = '#10b981'; }
      }
    });
  }
})();

// --- ENVÍO DE FORMULARIO DE ACCESO (AJAX CON FEEDBACK EN VIVO) ---
(function initLoginForm() {
  var form = document.getElementById('loginForm');
  var btn = document.getElementById('btnLogin');
  var txtUser = document.getElementById('usuario');
  var txtPass = document.getElementById('clave');
  var chkRecordar = document.getElementById('chkRecordar');
  if (!form || !btn) return;

  var originalHTML = btn.innerHTML;
  var animando = false;

  try {
    var savedUser = localStorage.getItem('boveda_saved_user');
    if (savedUser && txtUser) {
      txtUser.value = savedUser;
      if (chkRecordar) chkRecordar.checked = true;
      if (txtPass) setTimeout(function(){ txtPass.focus(); }, 60);
    }
  } catch(e) {}

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (animando) return;

    var username = (txtUser ? txtUser.value : '').trim();
    var password = txtPass ? txtPass.value : '';
    if (!username || !password) return;

    try {
      if (chkRecordar && chkRecordar.checked) localStorage.setItem('boveda_saved_user', username);
      else localStorage.removeItem('boveda_saved_user');
    } catch(e) {}

    animando = true;
    btn.disabled = true;
    btn.classList.add('btn-validando');
    btn.innerHTML = '<span class="btn-label">VALIDANDO ACCESO…</span><svg viewBox="0 0 24 24" style="animation: spin 0.8s linear infinite; width:18px; height:18px;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="32" stroke-linecap="round" fill="none"/></svg>';

    fetch('/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ username: username, password: password, ajax: '1' }),
      credentials: 'same-origin'
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data && data.ok) {
        btn.classList.remove('btn-validando', 'btn-invalido');
        btn.classList.add('btn-valido');
        btn.innerHTML = '<span class="btn-label">¡AUTORIZADO!</span><svg viewBox="0 0 24 24" style="stroke-width:3.2; width:18px; height:18px;"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(function() { window.location.href = data.redirect || '/'; }, 450);
      } else {
        mostrarError(data && data.error ? data.error : 'Usuario o contraseña incorrectos');
      }
    })
    .catch(function(err) {
      console.error(err);
      mostrarError('Error al contactar con el servidor');
    });
  });

  // Asegurar que el clic en cualquier parte del contenedor del campo o su icono active el input
  document.querySelectorAll('.field').forEach(function(fld) {
    fld.addEventListener('click', function(e) {
      if (e.target.closest('.pw-toggle')) return;
      var inp = fld.querySelector('input');
      if (inp && e.target !== inp) {
        inp.focus();
      }
    });
  });

  // Asegurar que el clic en etiquetas de texto 'Usuario' o 'Contraseña' enfoque de inmediato
  document.querySelectorAll('.auth-card-glass label[for]').forEach(function(lbl) {
    lbl.addEventListener('click', function(e) {
      var targetId = lbl.getAttribute('for');
      if (targetId && targetId !== 'chkRecordar') {
        var targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.focus();
      }
    });
  });

  // Manejador ultra-confiable para 'Recordar mi usuario' (tanto en casilla como en texto)
  var lblRecordar = document.getElementById('lblRecordar');
  if (lblRecordar && chkRecordar) {
    lblRecordar.addEventListener('click', function(e) {
      if (e.target === chkRecordar) return;
      e.preventDefault();
      chkRecordar.checked = !chkRecordar.checked;
      chkRecordar.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }

  // Alternar visualización de contraseña
  document.querySelectorAll('.pw-toggle').forEach(function(btnToggle) {
    btnToggle.addEventListener('click', function(e) {
      e.preventDefault();
      var fld = btnToggle.closest('.field');
      var inp = fld ? fld.querySelector('input') : document.getElementById('clave');
      if (!inp) return;
      var isPass = inp.type === 'password';
      inp.type = isPass ? 'text' : 'password';
      btnToggle.classList.toggle('showing', isPass);
      btnToggle.setAttribute('aria-label', isPass ? 'Ocultar contraseña' : 'Mostrar contraseña');
      btnToggle.title = isPass ? 'Ocultar contraseña' : 'Mostrar contraseña';
      inp.focus();
    });
  });

  function mostrarError(msg) {
    btn.classList.remove('btn-validando', 'btn-valido');
    btn.classList.add('btn-invalido');
    btn.innerHTML = '<span class="btn-label">' + (msg || 'DATOS INCORRECTOS') + '</span>';
    if (txtPass) txtPass.select();
    setTimeout(function() {
      btn.classList.remove('btn-invalido');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      animando = false;
    }, 2000);
  }
})();

</script>
