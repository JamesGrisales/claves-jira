<script>
// --- MOTOR 3D HIPERREALISTA DE PLANETAS CON PEDESTAL Y SHADERS (THREE.JS) ---
(function initPlanetHologram() {
  var container = document.getElementById('earthCanvasWrap');
  if (!container || typeof THREE === 'undefined') return;

  var width = window.innerWidth;
  var height = window.innerHeight;

  // Escena, Cámara y Renderer
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
  camera.position.z = 7.0;

  var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setSize(width, height);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2.0));
  if (THREE.sRGBEncoding) renderer.outputEncoding = THREE.sRGBEncoding;
  if (THREE.ACESFilmicToneMapping) {
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.88;
  }
  container.appendChild(renderer.domElement);

  // Iluminación cinemática equilibrada (Luz solar suave + Rim sutil + Ambiente cósmico)
  var sunLight = new THREE.DirectionalLight(0xfff5ea, 1.45);
  sunLight.position.set(-6, 3.8, 4.5);
  scene.add(sunLight);

  var rimSunLight = new THREE.DirectionalLight(0xff453a, 1.10);
  rimSunLight.position.set(5.5, 1.8, -2.5);
  scene.add(rimSunLight);

  var ambientLight = new THREE.AmbientLight(0x101524, 0.40);
  scene.add(ambientLight);

  // Grupo principal del holograma planetario
  var globeGroup = new THREE.Group();
  scene.add(globeGroup);

  var GLOBE_RADIUS = 2.3;

  // 1. Texturas Satelitales Oficiales de la NASA (sin relieves circulares artificiales)

  // 2. Texturas Procedurales en Canvas de Respaldo (Fallback)
  function generarTexturaPlaneta(tipo) {
    var c = document.createElement('canvas');
    c.width = 1024;
    c.height = 512;
    var ctx = c.getContext('2d');

    if (tipo === 'marte') {
      var grad = ctx.createLinearGradient(0, 0, 0, 512);
      grad.addColorStop(0, '#752410');
      grad.addColorStop(0.3, '#b8441f');
      grad.addColorStop(0.5, '#cf562b');
      grad.addColorStop(0.7, '#963618');
      grad.addColorStop(1, '#5a190a');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 1024, 512);
    } else if (tipo === 'tierra') {
      ctx.fillStyle = '#0a2342';
      ctx.fillRect(0, 0, 1024, 512);
      ctx.fillStyle = '#1e593a';
      for (var t = 0; t < 55; t++) {
        ctx.beginPath();
        ctx.arc(Math.random() * 1024, 80 + Math.random() * 350, 40 + Math.random() * 90, 0, Math.PI * 2);
        ctx.fill();
      }
    } else if (tipo === 'jupiter') {
      for (var j = 0; j < 512; j += 16) {
        ctx.fillStyle = (j % 32 === 0) ? '#cf822b' : ((j % 48 === 0) ? '#7a3e14' : '#e6a457');
        ctx.fillRect(0, j, 1024, 16);
      }
    } else if (tipo === 'saturno') {
      for (var s = 0; s < 512; s += 20) {
        ctx.fillStyle = (s % 40 === 0) ? '#c2a66b' : '#dfcca1';
        ctx.fillRect(0, s, 1024, 20);
      }
    } else if (tipo === 'mercurio') {
      ctx.fillStyle = '#555f6d';
      ctx.fillRect(0, 0, 1024, 512);
    } else if (tipo === 'venus') {
      ctx.fillStyle = '#d4a237';
      ctx.fillRect(0, 0, 1024, 512);
    } else if (tipo === 'urano') {
      var gradU = ctx.createLinearGradient(0, 0, 0, 512);
      gradU.addColorStop(0, '#5eead4');
      gradU.addColorStop(0.3, '#38bdf8');
      gradU.addColorStop(0.5, '#4ef2d2');
      gradU.addColorStop(0.7, '#2dd4bf');
      gradU.addColorStop(1, '#0284c7');
      ctx.fillStyle = gradU;
      ctx.fillRect(0, 0, 1024, 512);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
      for (var u = 0; u < 512; u += 24) {
        ctx.fillRect(0, u, 1024, 12);
      }
    } else {
      ctx.fillStyle = '#103982';
      ctx.fillRect(0, 0, 1024, 512);
    }
    return new THREE.CanvasTexture(c);
  }

  // 3. Cargador de Texturas Fotográficas Satelitales y Generador de Relieve Normal Maps
  var textureLoader = new THREE.TextureLoader();
  var maxAnisotropy = renderer.capabilities.getMaxAnisotropy();
  var NORMAL_MAPS_CACHE = {};

  // Generador de Relieve Topográfico Fotorrealista (Sobel Suavizado con Preservación de Tono Natural)
  function crearNormalMapDeImagen(img, fuerza) {
    if (!img) return null;
    try {
      var w = Math.min(img.naturalWidth || img.width || 2048, 2048);
      var h = Math.min(img.naturalHeight || img.height || 1024, 1024);
      var c = document.createElement('canvas');
      c.width = w; c.height = h;
      var ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      var src = ctx.getImageData(0, 0, w, h);
      var dst = ctx.createImageData(w, h);
      var s = src.data, d = dst.data;
      var f = fuerza || 1.4;

      // 1. Extraer luminancia linealizada
      var rawLum = new Float32Array(w * h);
      for (var i = 0, p = 0; i < rawLum.length; i++, p += 4) {
        rawLum[i] = (s[p] * 0.299 + s[p + 1] * 0.587 + s[p + 2] * 0.114) * 0.0039215686;
      }

      // 2. Filtro de suavizado espacial 3x3 para eliminar artefactos de compresión y micro-picos
      var lum = new Float32Array(w * h);
      for (var y = 0; y < h; y++) {
        var y0 = (y > 0 ? y - 1 : 0) * w;
        var y1 = y * w;
        var y2 = (y < h - 1 ? y + 1 : h - 1) * w;
        for (var x = 0; x < w; x++) {
          var x0 = (x > 0 ? x - 1 : w - 1);
          var x2 = (x < w - 1 ? x + 1 : 0);
          lum[y1 + x] = (rawLum[y0 + x0] + rawLum[y0 + x] * 2.0 + rawLum[y0 + x2]
                      + rawLum[y1 + x0] * 2.0 + rawLum[y1 + x] * 4.0 + rawLum[y1 + x2] * 2.0
                      + rawLum[y2 + x0] + rawLum[y2 + x] * 2.0 + rawLum[y2 + x2]) * 0.0625;
        }
      }

      // 3. Sobel con componente Z dominante perpendicular (+Z a 1.0)
      for (var y = 0; y < h; y++) {
        var yPrev = (y > 0 ? y - 1 : 0) * w;
        var yCurr = y * w;
        var yNext = (y < h - 1 ? y + 1 : h - 1) * w;

        for (var x = 0; x < w; x++) {
          var xPrev = (x > 0 ? x - 1 : w - 1);
          var xNext = (x < w - 1 ? x + 1 : 0);

          var tl = lum[yPrev + xPrev];
          var t  = lum[yPrev + x];
          var tr = lum[yPrev + xNext];
          var l  = lum[yCurr + xPrev];
          var r  = lum[yCurr + xNext];
          var bl = lum[yNext + xPrev];
          var b  = lum[yNext + x];
          var br = lum[yNext + xNext];

          var dX = ((tr + 2.0 * r + br) - (tl + 2.0 * l + bl)) * f;
          var dY = ((bl + 2.0 * b + br) - (tl + 2.0 * t + tr)) * f;
          var dZ = 1.0;

          var invLen = 1.0 / Math.sqrt(dX * dX + dY * dY + dZ * dZ);
          var nx = -dX * invLen;
          var ny = -dY * invLen;
          var nz = dZ * invLen;

          var p = (yCurr + x) * 4;
          d[p]     = (nx * 127.5 + 127.5) | 0;
          d[p + 1] = (ny * 127.5 + 127.5) | 0;
          d[p + 2] = (nz * 127.5 + 127.5) | 0;
          d[p + 3] = 255;
        }
      }
      ctx.putImageData(dst, 0, 0);
      var nTex = new THREE.CanvasTexture(c);
      nTex.wrapS = THREE.RepeatWrapping;
      nTex.wrapT = THREE.ClampToEdgeWrapping;
      nTex.anisotropy = maxAnisotropy;
      nTex.generateMipmaps = true;
      nTex.minFilter = THREE.LinearMipmapLinearFilter;
      nTex.magFilter = THREE.LinearFilter;
      return nTex;
    } catch(err) {
      return null;
    }
  }

  function cargarFotoPlaneta(ruta) {
    try {
      var tex = textureLoader.load(ruta);
      tex.anisotropy = maxAnisotropy;
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.ClampToEdgeWrapping;
      tex.generateMipmaps = true;
      tex.minFilter = THREE.LinearMipmapLinearFilter;
      tex.magFilter = THREE.LinearFilter;
      return tex;
    } catch(e) {
      return null;
    }
  }

  function cargarFotoPlanetaConRelieve(id, ruta, fuerzaNormal) {
    try {
      var tex = textureLoader.load(ruta, function(loadedTex) {
        if (id !== 'tierra') {
          var nMap = crearNormalMapDeImagen(loadedTex.image, fuerzaNormal || 1.2);
          if (nMap) {
            NORMAL_MAPS_CACHE[id] = nMap;
            if (planetaActual && planetaActual.id === id) {
              planetMat.normalMap = nMap;
              var ns = planetaActual.normalScale || 0.45;
              planetMat.normalScale = new THREE.Vector2(ns, ns);
              planetMat.needsUpdate = true;
            }
          }
        }
      });
      tex.anisotropy = maxAnisotropy;
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.ClampToEdgeWrapping;
      tex.generateMipmaps = true;
      tex.minFilter = THREE.LinearMipmapLinearFilter;
      tex.magFilter = THREE.LinearFilter;
      return tex;
    } catch(e) {
      return null;
    }
  }

  var TEXTURAS_FOTO = {
    'mercurio': cargarFotoPlanetaConRelieve('mercurio', '/planets/mercury_texture.jpg?v=2026', 1.4),
    'venus': cargarFotoPlanetaConRelieve('venus', '/planets/venus_texture.jpg?v=2026', 0.7),
    'tierra': cargarFotoPlaneta('/planets/earth_texture.jpg?v=2026'),
    'marte': cargarFotoPlanetaConRelieve('marte', '/planets/mars_texture.jpg?v=2026', 1.2),
    'jupiter': cargarFotoPlanetaConRelieve('jupiter', '/planets/jupiter_texture.jpg?v=2026', 0.6),
    'saturno': cargarFotoPlanetaConRelieve('saturno', '/planets/saturn_texture.jpg?v=2026', 0.5),
    'urano': cargarFotoPlanetaConRelieve('urano', '/planets/uranus_texture.jpg?v=2026', 0.5),
    'neptuno': cargarFotoPlanetaConRelieve('neptuno', '/planets/neptune_texture.jpg?v=2026', 0.6)
  };

  var earthNormalMap = cargarFotoPlaneta('/planets/earth_normal.jpg?v=2026');
  var earthSpecularMap = cargarFotoPlaneta('/planets/earth_specular.jpg?v=2026');
  var earthCloudsTexture = cargarFotoPlaneta('/planets/earth_clouds.png?v=2026');

  var planetGeo = new THREE.SphereGeometry(GLOBE_RADIUS, 128, 128);
  var planetMat = new THREE.MeshStandardMaterial({
    map: TEXTURAS_FOTO['tierra'] || generarTexturaPlaneta('tierra'),
    roughness: 0.45,
    metalness: 0.05
  });
  var planetMesh = new THREE.Mesh(planetGeo, planetMat);
  globeGroup.add(planetMesh);

  // Capa Dinámica Tridimensional de Nubes Terrestres Fotorrealistas
  var earthCloudsGeo = new THREE.SphereGeometry(GLOBE_RADIUS * 1.014, 128, 128);
  var earthCloudsMat = new THREE.MeshStandardMaterial({
    map: earthCloudsTexture,
    transparent: true,
    opacity: 0.88,
    blending: THREE.AdditiveBlending,
    side: THREE.DoubleSide
  });
  var earthCloudsMesh = new THREE.Mesh(earthCloudsGeo, earthCloudsMat);
  globeGroup.add(earthCloudsMesh);
  earthCloudsMesh.visible = false;

  // Capa Dinámica Tridimensional de Atmósfera Super-Rotatoria de Venus
  function generarTexturaNubesVenus() {
    var c = document.createElement('canvas');
    c.width = 1024; c.height = 512;
    var ctx = c.getContext('2d');
    ctx.fillStyle = '#eed690';
    ctx.fillRect(0, 0, 1024, 512);
    for (var y = 0; y < 512; y += 4) {
      var vFactor = Math.sin(y * 0.045) * Math.cos(y * 0.018);
      ctx.fillStyle = (vFactor > 0.2) ? 'rgba(255, 235, 165, 0.38)' : 'rgba(185, 140, 55, 0.30)';
      ctx.fillRect(0, y, 1024, 4);
    }
    for (var i = 0; i < 35; i++) {
      ctx.beginPath();
      var cx = Math.random() * 1024;
      var cy = 110 + Math.random() * 290;
      ctx.ellipse(cx, cy, 65 + Math.random() * 140, 16 + Math.random() * 28, Math.PI / 6, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 245, 205, 0.26)';
      ctx.fill();
    }
    var tex = new THREE.CanvasTexture(c);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.ClampToEdgeWrapping;
    return tex;
  }
  var venusCloudsGeo = new THREE.SphereGeometry(GLOBE_RADIUS * 1.012, 96, 96);
  var venusCloudsMat = new THREE.MeshStandardMaterial({
    map: generarTexturaNubesVenus(),
    transparent: true,
    opacity: 0.65,
    roughness: 0.60,
    blending: THREE.NormalBlending
  });
  var venusCloudsMesh = new THREE.Mesh(venusCloudsGeo, venusCloudsMat);
  globeGroup.add(venusCloudsMesh);
  venusCloudsMesh.visible = false;

  // Capa Dinámica Tridimensional de Cirros de Metano de Neptuno
  function generarTexturaNubesNeptuno() {
    var c = document.createElement('canvas');
    c.width = 1024; c.height = 512;
    var ctx = c.getContext('2d');
    ctx.clearRect(0, 0, 1024, 512);
    for (var i = 0; i < 45; i++) {
      var y = 130 + Math.random() * 250;
      var x = Math.random() * 1024;
      var w = 90 + Math.random() * 240;
      var grad = ctx.createLinearGradient(x, y, x + w, y);
      grad.addColorStop(0, 'rgba(255,255,255,0)');
      grad.addColorStop(0.5, 'rgba(220,245,255,0.92)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.ellipse(x + w / 2, y, w / 2, 4 + Math.random() * 9, 0, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.beginPath();
    ctx.ellipse(650, 310, 48, 26, -0.15, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(3, 14, 52, 0.72)';
    ctx.fill();
    ctx.beginPath();
    ctx.ellipse(668, 290, 40, 10, -0.1, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
    ctx.fill();
    var tex = new THREE.CanvasTexture(c);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.ClampToEdgeWrapping;
    return tex;
  }
  var neptuneCloudsGeo = new THREE.SphereGeometry(GLOBE_RADIUS * 1.010, 96, 96);
