.brand .badge{ width:34px; height:34px; border-radius:10px; background:var(--grad); display:flex; align-items:center; justify-content:center; font-size:17px; box-shadow:0 0 18px 2px rgba(var(--accent-rgb), .75), inset 0 1px 0 rgba(255,255,255,.4); transition:transform .3s var(--spring); }
.brand:hover .badge{ transform:rotate(-12deg) scale(1.08); }
body:not(.guest) .brand{ padding:2px 6px 14px; color:#fff; font-size:15px; border-bottom:1px solid rgba(255,255,255,.08); text-shadow:0 0 12px rgba(var(--accent-rgb), .6); }
body:not(.guest) .brand .badge{ background:rgba(var(--accent-rgb), .25); border:1px solid rgba(var(--accent-rgb), .6); box-shadow:0 0 18px 2px rgba(var(--accent-rgb), .75), inset 0 1px 0 rgba(255,255,255,0.4); }
.sb-close{ margin-left:auto; width:30px; height:30px; padding:0; background:transparent; color:rgba(255,255,255,.7); border:0; border-radius:8px; box-shadow:none; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:transform .2s var(--spring), background-color .15s ease, color .15s ease; }
.sb-close:hover{ background:rgba(255,255,255,.14); color:#fff; transform:scale(1.1); }
.sb-close svg{ width:16px; height:16px; stroke-width:2.2; }

.nav-tabs{ display:flex; flex-direction:column; gap:4px; flex:1; min-height:0; overflow-y:auto; overflow-x:hidden; scrollbar-width:thin; scrollbar-color:rgba(var(--accent-rgb),.6) transparent; }
.nav-tabs::-webkit-scrollbar{ width:5px; }
.nav-tabs::-webkit-scrollbar-thumb{ background:rgba(var(--accent-rgb),.55); border-radius:10px; box-shadow:0 0 8px var(--accent); }
.nav-tabs a{
  position:relative; display:flex; align-items:center; text-decoration:none; padding:8px 10px; border-radius:11px; font-size:13.5px; font-weight:500; color:rgba(255,255,255,.82);
  border:1px solid transparent; text-shadow:0 1px 2px rgba(0,0,0,0.85);
  transition:background-color .15s ease, color .15s ease, transform .2s var(--ease), border-color .15s ease, box-shadow .2s ease;
}
.nav-tabs a .nav-ic{
  display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:8px; margin-right:10px; flex-shrink:0;
  background:rgba(255,255,255,.05); border:1px solid rgba(var(--accent-rgb),.35); color:var(--accent);
  box-shadow:0 0 12px -2px rgba(var(--accent-rgb), .45), inset 0 1px 0 rgba(255,255,255,.12);
  transition:all .22s var(--spring);
}
.nav-tabs a .nav-ic svg, .nav-tabs a > svg{
  width:16px; height:16px; margin-right:0; flex-shrink:0; fill:none; stroke:var(--accent); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;
  filter:drop-shadow(0 0 6px rgba(var(--accent-rgb), .75));
  transition:transform .25s var(--spring), filter .25s ease, stroke .2s ease;
}
.nav-tabs a > svg{ margin-right:10px; }
.nav-tabs a:hover{
  background:rgba(var(--accent-rgb),.15); color:#fff; transform:translateX(3px);
  border-color:var(--accent);
  box-shadow:0 0 16px rgba(var(--accent-rgb), .6), inset 0 0 10px rgba(var(--accent-rgb), .25);
  text-shadow:0 0 10px rgba(var(--accent-rgb), .8);
}
.nav-tabs a:hover .nav-ic{
  background:rgba(var(--accent-rgb), .26); border-color:var(--accent); color:#fff;
  transform:scale(1.1) rotate(-3deg);
  box-shadow:0 0 16px 2px rgba(var(--accent-rgb), .85), inset 0 1px 0 rgba(255,255,255,.35);
}
.nav-tabs a:hover .nav-ic svg, .nav-tabs a:hover > svg{
  stroke:#fff; transform:scale(1.08); filter:drop-shadow(0 0 8px var(--accent)) drop-shadow(0 0 4px #fff);
}
.nav-tabs a.active, .nav-tabs a.active:hover{
  background:rgba(var(--accent-rgb), .26) !important; color:#fff !important; font-weight:700 !important; transform:none !important;
  border:1.5px solid var(--accent) !important;
  box-shadow:0 0 24px 3px rgba(var(--accent-rgb), .85), inset 0 0 16px rgba(var(--accent-rgb), .45), inset 0 1px 0 rgba(255,255,255,.6) !important;
  text-shadow:0 0 10px var(--accent), 0 0 20px var(--accent) !important;
}
.nav-tabs a.active .nav-ic{
  background:var(--grad) !important; border:1px solid rgba(255,255,255,.6) !important; color:#fff !important;
  box-shadow:0 0 20px 3px rgba(var(--accent-rgb), .95), inset 0 1px 0 rgba(255,255,255,.7) !important;
}
.nav-tabs a.active .nav-ic svg, .nav-tabs a.active > svg{
  stroke:#fff !important; opacity:1 !important; filter:drop-shadow(0 0 6px #fff) drop-shadow(0 0 12px var(--accent)) drop-shadow(0 0 20px var(--accent)) !important;
}
:root[data-theme="oled"] .nav-tabs a .nav-ic{
  background:rgba(255,255,255,.04); border-color:rgba(var(--accent-rgb),.45);
  box-shadow:0 0 14px -1px rgba(var(--accent-rgb), .55);
}
.nav-tabs .tab-count{ margin-left:auto; min-width:20px; padding:1px 7px; border-radius:999px; background:var(--danger); color:#fff; font-size:10.5px; font-weight:700; text-align:center; }



.nav-account{ display:flex; align-items:center; gap:12px; font-size:13px; color:var(--muted); }
body:not(.guest) .nav-account{ flex-direction:column; align-items:stretch; gap:2px; padding-top:12px; border-top:1px solid rgba(255,255,255,.10); color:rgba(255,255,255,.65); }
.nav-account .user{ display:inline-flex; align-items:center; gap:9px; color:var(--text); font-weight:700; }
body:not(.guest) .nav-account .user{ color:#fff; padding:4px 6px 8px; font-size:13.5px; }
.avatar{ width:30px; height:30px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; color:#fff; text-transform:uppercase; background:var(--grad); box-shadow:0 4px 12px -2px rgba(var(--accent-rgb), .6); }
body:not(.guest) .nav-account .avatar{ background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.3); box-shadow:none; }
.nav-account .divider{ display:none; }
.nav-account a{ display:block; text-decoration:none; padding:8px 12px; border-radius:9px; font-size:13px; font-weight:500; color:rgba(255,255,255,.78); transition:background-color .15s ease, color .15s ease; }
.nav-account a:hover{ background:rgba(255,255,255,.10); color:#fff; }
.nav-tools{ display:flex; gap:8px; margin:8px 0 0 4px; }

.theme-toggle{ width:34px; height:34px; border-radius:10px; background:var(--panel); border:1px solid var(--panel-edge); color:var(--muted); padding:0; flex-shrink:0; box-shadow:none; transition:border-color .15s ease, color .15s ease, transform .2s var(--spring), background-color .15s ease; }
.theme-toggle:hover{ border-color:var(--accent); color:var(--accent-dark); transform:translateY(-1px) rotate(8deg); box-shadow:none; background:var(--panel); }
.theme-toggle svg{ width:17px; height:17px; }
.theme-toggle .icon-moon{ display:none; }
:root[data-theme="dark"] .theme-toggle .icon-sun{ display:none; }
:root[data-theme="dark"] .theme-toggle .icon-moon{ display:block; }
body:not(.guest) .theme-toggle{ background:transparent; border-color:rgba(255,255,255,.18); color:rgba(255,255,255,.85); }
body:not(.guest) .theme-toggle:hover{ background:rgba(255,255,255,.12); color:#fff; border-color:rgba(255,255,255,.4); }
.pal-dot{ width:16px; height:16px; border-radius:50%; background:var(--grad); box-shadow:0 0 0 2px rgba(255,255,255,.55); display:block; }

#sbOpen{
  position:fixed;
  top:14px;
  left:16px;
  z-index:170;
  display:none;
  align-items:center;
  gap:8px;
  height:38px;
  padding:0 14px 0 11px;
  border-radius:999px;
  background:rgba(12, 17, 26, 0.82);
  border:1px solid rgba(var(--accent-rgb), 0.4);
  color:#fff;
  font-family:var(--sans);
  font-size:13px;
  font-weight:600;
  letter-spacing:.02em;
  cursor:pointer;
  backdrop-filter:blur(20px) saturate(1.8);
  -webkit-backdrop-filter:blur(20px) saturate(1.8);
  box-shadow:0 8px 24px -4px rgba(0, 0, 0, 0.65), 0 0 16px -2px rgba(var(--accent-rgb), 0.35);
  transition:all .22s var(--spring);
}
#sbOpen:hover{
  background:rgba(18, 25, 38, 0.95);
  color:#fff;
  border-color:var(--accent);
  box-shadow:0 10px 28px -4px rgba(0, 0, 0, 0.8), 0 0 24px 0 rgba(var(--accent-rgb), 0.6);
  transform:translateY(-1px) scale(1.02);
}
#sbOpen svg{
  width:18px;
  height:18px;
  stroke:var(--accent);
  transition:transform .2s ease;
}
#sbOpen:hover svg{
  transform:rotate(90deg);
}
html.sb-off #sbOpen{
  display:inline-flex !important;
}
.sb-backdrop{ display:none; }
html:not(.sb-off) .sb-backdrop{
  display:block !important;
  position:fixed !important;
  inset:0 !important;
  z-index:190 !important;
  background:rgba(5, 10, 25, 0.40) !important;
  backdrop-filter:blur(4px) !important;
  -webkit-backdrop-filter:blur(4px) !important;
  animation:pageIn .2s ease !important;
}

.to-top{ position:fixed; right:29px; bottom:90px; z-index:90; width:42px; height:42px; padding:0; border-radius:50%; opacity:0; transform:translateY(14px) scale(.9); pointer-events:none; box-shadow:0 12px 26px -8px rgba(var(--accent-rgb), .8); transition:opacity .25s ease, transform .3s var(--ease); }
.to-top.show{ opacity:1; transform:none; pointer-events:auto; }
.to-top svg{ width:18px; height:18px; }

/* ---------- RELOJ Y FECHA (píldora superior) ---------- */
.topbar{ width:100%; max-width:1700px; display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 18px; }
.topbar-left{ display:flex; align-items:center; gap:10px; transition:margin-left .22s ease; }
.topbar-right{ display:flex; align-items:center; gap:12px; margin-left:auto; }
html.sb-off:root[data-nav-style="oculto"] .topbar-left{ margin-left:110px; }
.clock{ display:inline-flex; align-items:center; gap:12px; padding:6px 18px 6px 8px; border-radius:999px; background:var(--panel); border:1px solid var(--panel-edge); box-shadow:var(--shadow); color:var(--text); }
.clock svg.face{ width:34px; height:34px; flex-shrink:0; }
.clock .ring{ fill:var(--accent-soft); stroke:var(--accent); stroke-width:1.8; }
.clock .tick{ stroke:var(--accent); stroke-width:1.8; stroke-linecap:round; }
.clock .hand{ stroke:var(--text); stroke-linecap:round; } .clock .hand.s{ stroke:var(--accent); stroke-width:1.2; } .clock .pin{ fill:var(--accent); }
.clock-txt{ display:flex; align-items:center; gap:12px; min-width:0; line-height:1.1; }
.clock-time{ font-size:17px; font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; display:flex; align-items:baseline; gap:1px; white-space:nowrap; }
.clock-time i{ font-style:normal; animation:parpadeo 1s steps(2,jump-none) infinite; }
@keyframes parpadeo{ 50%{ opacity:.25; } }
.clock-time small{ font-size:10.5px; font-weight:700; margin-left:5px; color:var(--muted); letter-spacing:.03em; }
.clock-date{ font-size:12.5px; font-weight:500; color:var(--muted); padding-left:12px; border-left:1px solid var(--panel-edge); white-space:nowrap; }
body.guest .clock{ margin-right:0; }
@media (max-width:900px){ .topbar{ margin-top:-6px; } }
@media (max-width:580px){
  .topbar{ flex-direction:column; align-items:stretch; gap:10px; }
  .topbar-right{ justify-content:flex-end; }
  .clock-date{ display:none; }
  .clock{ padding-right:14px; }
  html.sb-off:root[data-nav-style="oculto"] .topbar-left{ margin-left:0; margin-top:42px; }
}

/* ---------- CUENTA DE USUARIO (menú lateral) ---------- */
body:not(.guest) .nav-account{ gap:10px; padding-top:14px; }
.user-card{
  display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:14px; min-width:0;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(var(--accent-rgb), .45);
  box-shadow:0 0 16px -2px rgba(var(--accent-rgb), .38), inset 0 1px 0 rgba(255,255,255,.15);
  transition:border-color .2s ease, box-shadow .25s ease, background-color .2s ease, transform .2s var(--ease);
}
.user-card:hover{
  border-color:var(--accent);
  background:rgba(var(--accent-rgb), .16);
  box-shadow:0 0 22px 2px rgba(var(--accent-rgb), .65), inset 0 1px 0 rgba(255,255,255,.25);
  transform:translateY(-1px);
}
:root[data-theme="oled"] .user-card{
  background:rgba(255,255,255,.04);
  border-color:rgba(var(--accent-rgb), .55);
  box-shadow:0 0 18px -2px rgba(var(--accent-rgb), .45);
}
:root[data-theme="oled"] .user-card:hover{
  border-color:var(--accent);
  box-shadow:0 0 24px 3px rgba(var(--accent-rgb), .75);
}
.user-card .avatar{
  width:38px; height:38px; font-size:16px; border-radius:12px; flex-shrink:0;
  background:rgba(var(--accent-rgb), .20);
  border:1.5px solid var(--accent);
  color:#fff;
  box-shadow:0 0 14px 1px rgba(var(--accent-rgb), .6), inset 0 1px 0 rgba(255,255,255,.3);
  transition:transform .25s var(--spring), box-shadow .25s ease, color .2s ease;
}
.user-card:hover .avatar{
  transform:scale(1.08) rotate(-4deg);
  background:var(--grad);
  color:#fff;
  border-color:rgba(255,255,255,.6);
  box-shadow:0 0 22px 3px rgba(var(--accent-rgb), .85);
}
body:not(.guest) .nav-account .user-card .avatar{
  background:rgba(var(--accent-rgb), .22);
  border:1.5px solid var(--accent);
  color:#fff;
  box-shadow:0 0 14px 1px rgba(var(--accent-rgb), .6);
}
.user-card .who{ min-width:0; }
.user-card b{ display:block; color:#fff; font-size:14px; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-shadow:0 1px 3px rgba(0,0,0,0.8); }
.user-card small{ display:flex; align-items:center; gap:6px; margin-top:2px; font-size:11.5px; color:rgba(255,255,255,.85); }
.user-card small::before{ content:''; width:7px; height:7px; border-radius:50%; background:#4ade80; box-shadow:0 0 0 2px rgba(74,222,128,.35), 0 0 10px #4ade80, 0 0 18px #4ade80; }
.acc-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.nav-account .acc-btn{
  display:flex; flex-direction:column; align-items:center; gap:7px; padding:12px 6px 10px; border-radius:12px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(var(--accent-rgb), .38);
  box-shadow:0 0 12px -2px rgba(var(--accent-rgb), .3);
  font-size:12px; font-weight:600; line-height:1.2; text-align:center; color:#fff; text-shadow:0 1px 2px rgba(0,0,0,0.85);
  transition:background-color .15s ease, transform .2s var(--spring), border-color .15s ease, box-shadow .2s ease;
}
.nav-account .acc-btn svg{
  width:19px; height:19px; fill:none; stroke:var(--accent); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;
  filter:drop-shadow(0 0 6px rgba(var(--accent-rgb), .75));
  transition:transform .2s var(--spring), stroke .15s ease, filter .2s ease;
}
.nav-account .acc-btn:hover{
  background:rgba(var(--accent-rgb), .20); border-color:var(--accent); color:#fff; transform:translateY(-2px);
  box-shadow:0 0 20px 2px rgba(var(--accent-rgb), .7);
}
.nav-account .acc-btn:hover svg{ stroke:#fff; transform:scale(1.1); filter:drop-shadow(0 0 8px var(--accent)) drop-shadow(0 0 3px #fff); }
.acc-foot{ display:flex; align-items:center; gap:8px; }
.nav-account .acc-out{ flex:1; display:flex; align-items:center; justify-content:center; gap:8px; padding:9px 10px; border-radius:11px; font-size:13px; font-weight:700; color:#ffd7de; background:rgba(225,29,72,.16); border:1px solid rgba(251,113,133,.5); box-shadow:0 0 14px -2px rgba(225,29,72,.45); transition:all .2s ease; text-shadow:0 1px 2px rgba(0,0,0,0.8); }
.nav-account .acc-out svg{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 0 6px rgba(251,113,133,.8)); }
.nav-account .acc-out:hover{ background:#e11d48; color:#fff; border-color:#e11d48; box-shadow:0 0 22px 3px rgba(225,29,72,.85); transform:translateY(-1px); }



/* ---------- 7) PANEL DE APARIENCIA ---------- */
.pal-panel{
  display:none;
  position:fixed;
  z-index:750;
  width:360px;
  max-height:85vh;
  backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px); max-height:85vh; overflow-y:auto; scrollbar-width:thin; padding:16px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:16px; box-shadow:var(--shadow-lg); left:calc(var(--sb-w) + 10px); bottom:14px; }
.pal-panel.open{ display:block; animation:panelIn .2s var(--ease); }
body.guest .pal-panel{ left:50%; transform:translateX(-50%); right:auto; bottom:auto; top:75px; }
.pal-panel h4{ margin:0 0 2px; font-size:15px; font-weight:800; }
.pal-panel .hint{ margin:0 0 12px; font-size:12px; color:var(--muted); }
.pal-sec{ margin:14px 0 8px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
.seg{ display:grid; grid-template-columns:repeat(3,1fr); gap:4px; padding:4px; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:11px; }
.seg button.plain{ padding:7px 4px; border-radius:8px; font-size:12.5px; font-weight:600; color:var(--muted); display:flex; align-items:center; justify-content:center; gap:5px; transition:background-color .15s ease, color .15s ease; }
.seg button.plain:hover{ color:var(--text); }
.seg button.plain.on{ background:var(--panel); color:var(--accent-dark); box-shadow:0 1px 4px rgba(15,27,51,.14); }

/* Selector de Estilo de Menú en el panel de Apariencia */
.nav-style-grid{
  display:grid !important;
  grid-template-columns:repeat(2, 1fr) !important;
  gap:7px !important;
  margin-top:6px !important;
}
.nav-style-btn{
  display:flex !important;
  flex-direction:column !important;
  align-items:flex-start !important;
  gap:2px !important;
  padding:8px 10px !important;
  border-radius:12px !important;
  background:var(--panel-alt) !important;
  border:1px solid var(--panel-edge) !important;
  color:var(--text) !important;
  font-family:var(--sans) !important;
  cursor:pointer !important;
  text-align:left !important;
  transition:all .2s ease !important;
  position:relative !important;
  overflow:hidden !important;
  box-shadow:none !important;
}
.nav-style-btn:hover{
  border-color:var(--accent) !important;
  background:rgba(var(--accent-rgb), 0.08) !important;
  transform:translateY(-1px) !important;
  color:var(--text) !important;
}
.nav-style-btn.on{
  border-color:var(--accent) !important;
  background:rgba(var(--accent-rgb), 0.16) !important;
  box-shadow:0 0 14px -2px rgba(var(--accent-rgb), 0.45) !important;
  color:var(--text) !important;
}
.nav-style-btn.on::after{
  content:'✓' !important;
  position:absolute !important;
  top:6px !important;
  right:8px !important;
  font-size:11px !important;
  font-weight:800 !important;
  color:var(--accent) !important;
}
.nav-style-btn .nav-s-icon{
  font-size:16px !important;
  margin-bottom:2px !important;
  line-height:1 !important;
}
.nav-style-btn b{
  font-size:11.5px !important;
  font-weight:700 !important;
  color:var(--text) !important;
  line-height:1.2 !important;
}
.nav-style-btn.on b{
  color:#fff !important;
}
.nav-style-btn small{
  font-size:9.5px !important;
  color:var(--muted) !important;
  line-height:1.2 !important;
}

/* Círculos de Colores / Swatches Cósmicos y Clásicos */
.swatches{
  display:grid !important;
  grid-template-columns:repeat(4, 1fr) !important;
  gap:10px 6px !important;
  margin-top:6px !important;
}
.sw{
  display:flex !important;
  flex-direction:column !important;
  align-items:center !important;
  gap:5px !important;
  font-size:11px !important;
  font-weight:600 !important;
  color:var(--muted) !important;
  background:none !important;
  border:none !important;
  cursor:pointer !important;
  padding:4px 0 !important;
  box-shadow:none !important;
  border-radius:8px !important;
}
.sw:hover{
  color:var(--text) !important;
  background:none !important;
}
.sw .dot{
  width:34px !important;
  height:34px !important;
  border-radius:50% !important;
  background:linear-gradient(135deg, var(--a), var(--b)) !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  box-shadow:0 0 0 1px var(--panel-edge), 0 2px 8px rgba(0,0,0,0.25) !important;
  transition:transform .2s var(--spring), box-shadow .2s ease !important;
}
.sw:hover .dot{
  transform:scale(1.15) !important;
  box-shadow:0 0 0 2px var(--accent), 0 4px 12px rgba(0,0,0,0.35) !important;
}
.sw .dot svg{
  width:16px !important;
  height:16px !important;
  stroke:#fff !important;
  stroke-width:3 !important;
  fill:none !important;
  stroke-linecap:round !important;
  stroke-linejoin:round !important;
  opacity:0 !important;
  transform:scale(.4) !important;
  transition:all .2s var(--spring) !important;
}
.sw.on{
  color:var(--text) !important;
}
.sw.on .dot{
