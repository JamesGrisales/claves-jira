<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="view-transition" content="same-origin">
<title><%= typeof title !== 'undefined' ? title + ' — Bóveda Jira' : 'Bóveda de claves — Jira' %></title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔐</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script>
  /* Aplica modo, paleta y menú ANTES de pintar (evita parpadeos) */
  (function(){
    var d = document.documentElement;
    function rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h.replace(/./g, '$&$&'); var n = parseInt(h, 16); return (n >> 16) + ',' + ((n >> 8) & 255) + ',' + (n & 255); }
    window.PLANETAS_SISTEMA = {
      1: { id: 'mercurio', dia: 'Lunes', nombre: 'Mercurio', c1: '#94a3b8', c2: '#475569', icon: '🌑', desc: 'Gris Titanio Espacial' },
      2: { id: 'venus', dia: 'Martes', nombre: 'Venus', c1: '#ffd700', c2: '#d97706', icon: '✨', desc: 'Oro y Ámbar Atmosférico' },
      3: { id: 'tierra', dia: 'Miércoles', nombre: 'Tierra', c1: '#00f5ff', c2: '#0284c7', icon: '🌍', desc: 'Azul Bóveda Shield' },
      4: { id: 'marte', dia: 'Jueves', nombre: 'Marte', c1: '#ff3b30', c2: '#b91c1c', icon: '🔴', desc: 'Rojo Táctico' },
      5: { id: 'jupiter', dia: 'Viernes', nombre: 'Júpiter', c1: '#f59e0b', c2: '#b45309', icon: '🟠', desc: 'Terracota Joviano' },
      6: { id: 'saturno', dia: 'Sábado', nombre: 'Saturno', c1: '#e0c580', c2: '#92400e', icon: '🪐', desc: 'Dorado Anillos 3D' },
      0: { id: 'urano', dia: 'Domingo', nombre: 'Urano', c1: '#4ef2d2', c2: '#0284c7', icon: '💎', desc: 'Turquesa Gélido Cósmico' }
    };
    try {
      var navStyle = localStorage.getItem('boveda-nav-style') || 'oculto';
      d.setAttribute('data-nav-style', navStyle);
      if (navStyle === 'oculto') d.classList.add('sb-off');
      var m = localStorage.getItem('boveda-theme') || 'oled';
      var theme = m === 'oled' ? 'oled' : ((m === 'dark' || (m === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) ? 'dark' : 'light');
      d.setAttribute('data-theme', theme); d.setAttribute('data-mode', m);

      var dbEng = localStorage.getItem('boveda_db_engine') || 'postgres';
      d.setAttribute('data-db-engine', dbEng);
      var DB_ENGINES_CONFIG = {
        postgres:  { name:'PostgreSQL 16', icon:'🐘', c1:'#00f5ff', c2:'#0284c7', rgb:'0, 245, 255' },
        oracle:    { name:'Oracle Enterprise', icon:'🏛️', c1:'#f59e0b', c2:'#d97706', rgb:'245, 158, 11' },
        sqlserver: { name:'SQL Server', icon:'🟦', c1:'#3b82f6', c2:'#1d4ed8', rgb:'59, 130, 246' },
        mysql:     { name:'MySQL / MariaDB', icon:'🐬', c1:'#06b6d4', c2:'#0284c7', rgb:'6, 182, 212' },
        mongodb:   { name:'MongoDB Document', icon:'🍃', c1:'#10b981', c2:'#059669', rgb:'16, 185, 129' },
        redis:     { name:'Redis Cache', icon:'⚡', c1:'#ef4444', c2:'#b91c1c', rgb:'239, 68, 68' },
        sqlite:    { name:'SQLite Embedded', icon:'💾', c1:'#a855f7', c2:'#7c3aed', rgb:'168, 85, 247' }
      };

      var p = localStorage.getItem('boveda-palette') || 'db-engine';
      d.setAttribute('data-palette', p);

      if (p === 'db-engine' || DB_ENGINES_CONFIG[dbEng]) {
        var engCfg = DB_ENGINES_CONFIG[dbEng] || DB_ENGINES_CONFIG.postgres;
        d.style.setProperty('--p1', engCfg.c1);
        d.style.setProperty('--p2', engCfg.c2);
        d.style.setProperty('--accent-rgb', engCfg.rgb);
      } else if (p === 'planeta-dia') {
        var dayNum = new Date().getDay();
        var pl = window.PLANETAS_SISTEMA[dayNum] || window.PLANETAS_SISTEMA[2];
        d.setAttribute('data-planet-active', pl.id);
        d.style.setProperty('--p1', pl.c1);
        d.style.setProperty('--p2', pl.c2);
        d.style.setProperty('--accent-rgb', rgb(pl.c1));
      } else if (p === 'custom') {
        var c = localStorage.getItem('boveda-custom') || '#2563eb';
        d.style.setProperty('--p1', c);
        d.style.setProperty('--accent-rgb', rgb(c));
      }
    } catch (e) {}
  })();
</script>
<style>
/* =====================================================================
   SISTEMA DE DISEÑO — Bóveda Jira
   1) Paletas  2) Tokens claro/oscuro  3) Base  4) Botones  5) Formularios
   6) Menú lateral  7) Panel de apariencia  8) Acceso (login)  9) Utilidades
   ===================================================================== */

/* ---------- 1) PALETAS (cada una define 2 colores + su RGB) ---------- */
:root[data-palette="planeta-dia"]       { --p1:#ffd700; --p2:#d97706; --accent-rgb:255,215,0; }
:root[data-palette="mercurio"]          { --p1:#94a3b8; --p2:#475569; --accent-rgb:148,163,184; }
:root[data-palette="venus"]             { --p1:#ffd700; --p2:#d97706; --accent-rgb:255,215,0; }
:root[data-palette="tierra"]            { --p1:#00f5ff; --p2:#0284c7; --accent-rgb:0,245,255; }
:root[data-palette="marte"]             { --p1:#ff3b30; --p2:#b91c1c; --accent-rgb:255,59,48; }
:root[data-palette="jupiter"]           { --p1:#f59e0b; --p2:#b45309; --accent-rgb:245,158,11; }
:root[data-palette="saturno"]           { --p1:#e0c580; --p2:#92400e; --accent-rgb:224,197,128; }
:root[data-palette="urano"], :root[data-palette="neptuno"] { --p1:#4ef2d2; --p2:#0284c7; --accent-rgb:78,242,210; }
:root, :root[data-palette="cyber"]      { --p1:#00f5ff; --p2:#ff0055; --accent-rgb:0,245,255; }
:root[data-palette="azul"]              { --p1:#2563eb; --p2:#4f46e5; --accent-rgb:37,99,235; }
:root[data-palette="cobalto"]          { --p1:#38bdf8; --p2:#1d4ed8; --accent-rgb:56,189,248; }
:root[data-palette="nordico"]          { --p1:#0284c7; --p2:#0369a1; --accent-rgb:2,132,199; }
:root[data-palette="turquesa"]         { --p1:#06b6d4; --p2:#0ea5e9; --accent-rgb:6,182,212; }
:root[data-palette="cian"]             { --p1:#0891b2; --p2:#2563eb; --accent-rgb:8,145,178; }
:root[data-palette="menta"]            { --p1:#10b981; --p2:#06b6d4; --accent-rgb:16,185,129; }
:root[data-palette="esmeralda"]        { --p1:#059669; --p2:#0d9488; --accent-rgb:5,150,105; }
:root[data-palette="lima"]             { --p1:#84cc16; --p2:#22c55e; --accent-rgb:132,204,22; }
:root[data-palette="oro"]              { --p1:#eab308; --p2:#b45309; --accent-rgb:234,179,8; }
:root[data-palette="ambar"]            { --p1:#f59e0b; --p2:#d97706; --accent-rgb:245,158,11; }
:root[data-palette="cobre"]            { --p1:#f97316; --p2:#9a3412; --accent-rgb:249,115,22; }
:root[data-palette="carmesi"]          { --p1:#f43f5e; --p2:#be123c; --accent-rgb:244,63,94; }
:root[data-palette="atardecer"]        { --p1:#ea580c; --p2:#db2777; --accent-rgb:234,88,12; }
:root[data-palette="rosa"]             { --p1:#db2777; --p2:#9333ea; --accent-rgb:219,39,119; }
:root[data-palette="purpura"]          { --p1:#a855f7; --p2:#ec4899; --accent-rgb:168,85,247; }
:root[data-palette="lavanda"]          { --p1:#8b5cf6; --p2:#6366f1; --accent-rgb:139,92,246; }
:root[data-palette="violeta"]          { --p1:#7c3aed; --p2:#4f46e5; --accent-rgb:124,58,237; }
:root[data-palette="titanio"]          { --p1:#64748b; --p2:#334155; --accent-rgb:100,116,139; }
:root[data-palette="grafito"]          { --p1:#475569; --p2:#1e293b; --accent-rgb:71,85,105; }
:root[data-palette="custom"]           { --p2:color-mix(in srgb, var(--p1) 62%, #1e1b4b); }

/* Paletas por Motor de Base de Datos Activo */
:root[data-db-engine="postgres"], :root[data-palette="db-postgres"] { --p1:#00f5ff; --p2:#0284c7; --accent-rgb:0,245,255; }
:root[data-db-engine="oracle"],   :root[data-palette="db-oracle"]   { --p1:#f59e0b; --p2:#d97706; --accent-rgb:245,158,11; }
:root[data-db-engine="sqlserver"],:root[data-palette="db-sqlserver"]{ --p1:#3b82f6; --p2:#1d4ed8; --accent-rgb:59,130,246; }
:root[data-db-engine="mysql"],    :root[data-palette="db-mysql"]    { --p1:#06b6d4; --p2:#0284c7; --accent-rgb:6,182,212; }
:root[data-db-engine="mongodb"],  :root[data-palette="db-mongodb"]  { --p1:#10b981; --p2:#059669; --accent-rgb:16,185,129; }
:root[data-db-engine="redis"],    :root[data-palette="db-redis"]    { --p1:#ef4444; --p2:#b91c1c; --accent-rgb:239,68,68; }
:root[data-db-engine="sqlite"],   :root[data-palette="db-sqlite"]   { --p1:#a855f7; --p2:#7c3aed; --accent-rgb:168,85,247; }

/* ---------- 2) TOKENS ---------- */
:root{
  --accent:var(--p1); --accent-dark:var(--p2); --accent-2:#06b6d4;
  --accent-soft:color-mix(in srgb, var(--accent) 12%, var(--panel));
  --grad:linear-gradient(135deg, var(--p1), var(--p2));
  --bg:color-mix(in srgb, var(--accent) 5%, #f5f7fb);
  --bg-glow:rgba(var(--accent-rgb), .15);
  --panel:#ffffff;
  --panel-glass:rgba(255, 255, 255, 0.75);
  --panel-alt:color-mix(in srgb, var(--accent) 4%, #f8fafd);
  --panel-edge:color-mix(in srgb, var(--accent) 14%, #e2e7f0);
  --text:#0f1b33; --muted:#5d6b86;
  --danger:#e11d48; --danger-soft:#ffe4ea; --ok:#059669; --ok-soft:#d8f6e8;
  --shadow:0 1px 2px rgba(15,27,51,.05), 0 10px 28px rgba(15,27,51,.07);
  --shadow-lg:0 6px 16px rgba(15,27,51,.10), 0 18px 44px rgba(15,27,51,.12);
  --scrollbar:color-mix(in srgb, var(--accent) 22%, #cbd5e1);
  --glass:rgba(255,255,255,.78);
  --sb-w:250px;
  --sb-bg:linear-gradient(185deg, color-mix(in srgb, var(--p2) 62%, #0a1024) 0%, color-mix(in srgb, var(--p1) 36%, #0a1024) 100%);
  --mono:'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  --sans:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --radius:16px; --radius-sm:10px;
  --ease:cubic-bezier(.22,1,.36,1); --spring:cubic-bezier(.34,1.56,.64,1);
  color-scheme:light;
}
:root[data-theme="dark"]{
  --accent:color-mix(in srgb, var(--p1) 72%, #fff);
  --accent-dark:color-mix(in srgb, var(--p2) 55%, #fff);
  --bg:color-mix(in srgb, var(--accent) 7%, #080d19);
  --bg-glow:rgba(var(--accent-rgb), .20);
  --panel:color-mix(in srgb, var(--accent) 5%, #0e1527);
  --panel-glass:rgba(14, 21, 39, 0.75);
  --panel-alt:color-mix(in srgb, var(--accent) 4%, #0a1120);
  --panel-edge:color-mix(in srgb, var(--accent) 18%, #172038);
  --text:#e8eefc; --muted:#8e9cbc;
  --danger:#fb7185; --danger-soft:rgba(251,113,133,.14); --ok:#34d399; --ok-soft:rgba(52,211,153,.14);
  --shadow:0 1px 2px rgba(0,0,0,.30), 0 14px 36px rgba(0,0,0,.42);
  --shadow-lg:0 8px 20px rgba(0,0,0,.40), 0 22px 54px rgba(0,0,0,.50);
  --scrollbar:color-mix(in srgb, var(--accent) 30%, #1e2a48);
  --glass:rgba(14,21,39,.78);
  color-scheme:dark;
}
:root[data-theme="oled"]{
  --accent:var(--p1);
  --accent-dark:var(--p2);
  --bg:#000000;
  --bg-glow:rgba(var(--accent-rgb), .18);
  --panel:#08090b;
  --panel-glass:rgba(8, 9, 11, 0.94);
  --panel-alt:#030405;
  --panel-edge:rgba(255, 255, 255, 0.08);
  --text:#f8fafc; --muted:#94a3b8;
  --danger:#ef4444; --danger-soft:rgba(239,68,68,.14); --ok:#22c55e; --ok-soft:rgba(34,197,94,.14);
  --shadow:none;
  --shadow-lg:0 4px 20px -2px rgba(0,0,0,.9);
  --scrollbar:#14171d;
  --glass:rgba(8,9,11,.92);
  --sb-bg:#000000;
  color-scheme:dark;
}
:root[data-theme="oled"] .card{
  border-radius:12px;
  box-shadow:none;
  border:1px solid rgba(255, 255, 255, 0.08);
  background:#07080a;
}
:root[data-theme="oled"] .card::before{
  display:none;
}
:root[data-theme="oled"] .row{
  border-radius:8px;
  border-color:rgba(255, 255, 255, 0.06);
}
:root[data-theme="oled"] .row:hover{
  border-color:var(--accent);
}
:root[data-theme="oled"] input[type=text],
:root[data-theme="oled"] input[type=password],
:root[data-theme="oled"] input[type=number],
:root[data-theme="oled"] input[type=email],
:root[data-theme="oled"] select,
:root[data-theme="oled"] textarea:not(#entrada):not(.nt-ed-input),
:root[data-theme="oled"] .ed-frame,
:root[data-theme="oled"] .code-block,
:root[data-theme="oled"] #vista-arbol {
  background:#050608 !important;
  border-color:rgba(255, 255, 255, 0.09) !important;
  color:#f8fafc;
}
:root[data-theme="oled"] input:focus,
:root[data-theme="oled"] select:focus,
:root[data-theme="oled"] textarea:not(#entrada):not(.nt-ed-input):focus,
:root[data-theme="oled"] .ed-frame:focus-within {
  border-color:var(--accent) !important;
  box-shadow:0 0 0 1px var(--accent) !important;
}

/* ---------- 3) BASE ---------- */
*{ box-sizing:border-box; }
html{ scrollbar-color:var(--scrollbar) transparent; scroll-behavior:smooth; }
::-webkit-scrollbar{ width:10px; height:10px; }
::-webkit-scrollbar-thumb{ background:var(--scrollbar); border-radius:8px; border:2px solid transparent; background-clip:padding-box; }
::-webkit-scrollbar-thumb:hover{ background:var(--accent); background-clip:padding-box; }
::selection{ background:rgba(var(--accent-rgb), .85); color:#fff; }
:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
body{
  margin:0; min-height:100vh; color:var(--text); font-family:var(--sans);
  display:flex; flex-direction:column; align-items:center; padding:0 20px 70px;
  background:
    radial-gradient(1000px 520px at 6% -10%, var(--bg-glow), transparent 62%),
    radial-gradient(800px 460px at 104% 4%, rgba(var(--accent-rgb), .09), transparent 60%), var(--bg);
  background-attachment:fixed; transition:background-color .25s ease, color .25s ease;
}
body::before{ content:''; position:fixed; left:-10%; right:-10%; top:-18%; height:70vh; z-index:-1; pointer-events:none; filter:blur(50px); opacity:.8;
  background:radial-gradient(38% 58% at 18% 32%, rgba(var(--accent-rgb), .18), transparent 70%), radial-gradient(34% 54% at 78% 22%, rgba(var(--accent-rgb), .12), transparent 70%);
  animation:aurora 24s ease-in-out infinite alternate; }
@keyframes aurora{ from{ transform:translate3d(-2%,0,0) scale(1); } to{ transform:translate3d(3%,7%,0) scale(1.1); } }
a{ color:var(--accent); }
.wrap{ position:relative; z-index:1; width:100%; max-width:1700px; animation:pageIn .45s var(--ease) backwards; }
body.amp .wrap,
body:has(> .fullscreen) .wrap,
body.has-fullscreen .wrap:not(:has(.fullscreen)){
  visibility:hidden !important;
  opacity:0 !important;
  pointer-events:none !important;
}
body:has(.fullscreen) .navbar, body.has-fullscreen .navbar, body.amp .navbar,
body:has(.fullscreen) #sbOpen, body.has-fullscreen #sbOpen, body.amp #sbOpen,
body:has(.fullscreen) .to-top, body.has-fullscreen .to-top, body.amp .to-top,
body:has(.fullscreen) #as-trigger, body.has-fullscreen #as-trigger, body.amp #as-trigger,
body:has(.fullscreen) .nav-popover-global, body.has-fullscreen .nav-popover-global, body.amp .nav-popover-global{
  display:none !important;
  opacity:0 !important;
  pointer-events:none !important;
  visibility:hidden !important;
}
.fullscreen{
  z-index:999999 !important;
  background:var(--bg) !important;
}
@keyframes pageIn{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }
@keyframes panelIn{ from{ opacity:0; transform:translateY(-4px); } to{ opacity:1; transform:none; } }

h1{ font-size:26px; margin:0 0 6px; font-weight:800; letter-spacing:-.02em; width:fit-content; max-width:100%; line-height:1.2;
  background:linear-gradient(110deg, var(--accent), var(--accent-dark), var(--accent)); background-size:200% 100%;
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:transparent; animation:tituloFlujo 8s ease-in-out infinite alternate; }
@keyframes tituloFlujo{ from{ background-position:0% 0; } to{ background-position:100% 0; } }
.auth-head h1{ background:none; -webkit-text-fill-color:#fff; color:#fff; animation:none; }
p.sub{ color:var(--muted); font-size:13.5px; line-height:1.55; margin:0 0 22px; }
.card{
  position:relative; background:var(--panel-glass, var(--panel)); border:1px solid var(--panel-edge); border-radius:18px; box-shadow:var(--shadow); padding:30px 28px;
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); transform-style: preserve-3d;
  transition:box-shadow .25s var(--ease), border-color .25s ease, background-color .25s ease, transform .1s linear; animation:pageIn .5s var(--ease) backwards;
}
.card::before{ content:''; position:absolute; left:0; right:0; top:-1px; height:3px; border-radius:18px 18px 0 0; background:var(--grad); opacity:.9; pointer-events:none; }
.card:hover{ box-shadow:var(--shadow-lg); border-color:color-mix(in srgb, var(--accent) 35%, var(--panel-edge)); }
.wrap > .card:nth-of-type(2){ animation-delay:.06s; } .wrap > .card:nth-of-type(3){ animation-delay:.12s; }
.row{ transition:transform .2s var(--ease), box-shadow .2s ease, border-color .2s ease, background-color .2s ease; }
.row:not(.open):hover{ transform:translateX(3px); border-color:color-mix(in srgb, var(--accent) 45%, var(--panel-edge)); }
.foot{ color:var(--muted); font-size:12px; text-align:center; margin-top:20px; opacity:.85; }

.flash{ display:flex; align-items:flex-start; gap:10px; border-radius:12px; padding:12px 14px; font-size:13.5px; margin-bottom:14px; border-left:3px solid transparent; box-shadow:var(--shadow); animation:panelIn .2s ease; }
.flash svg{ width:16px; height:16px; flex-shrink:0; margin-top:1px; }
.flash.error{ background:var(--danger-soft); color:var(--danger); border-left-color:var(--danger); }
.flash.ok{ background:var(--ok-soft); color:var(--ok); border-left-color:var(--ok); }
.toast{ background:var(--grad) !important; box-shadow:0 14px 30px -10px rgba(var(--accent-rgb), .7); }

/* ---- Cabecera Fija (Sticky) ---- */
.sticky-head {
  position: sticky; top: 0; z-index: 150;
  margin: 0 -20px 16px -16px; padding: 12px 20px 10px 16px;
  background: color-mix(in srgb, var(--bg) 85%, transparent);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255,255,255,0.04);
  box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15);
}
@media (max-width:900px){
  .sticky-head { top: 67px; margin: 0 -16px 16px -16px; padding: 12px 16px 10px 16px; }
}

/* ---------- 4) BOTONES ---------- */
button, .btn{
  position:relative; overflow:hidden; display:inline-flex; align-items:center; justify-content:center; gap:10px;
  background:var(--grad); background-size:170% 100%; background-position:0 0; color:#fff; font-family:var(--sans); font-weight:600; font-size:14.5px; letter-spacing:.01em;
  padding:13px 22px; border-radius:12px; cursor:pointer; text-decoration:none; border:1px solid rgba(255,255,255,.18);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.28), 0 8px 18px -8px rgba(var(--accent-rgb), .75), 0 1px 2px rgba(15,35,80,.16);
  transition:background-position .5s var(--ease), transform .18s var(--spring), box-shadow .22s ease, border-color .15s ease, color .15s ease, background-color .15s ease;
}
button svg, .btn svg{ width:18px; height:18px; flex-shrink:0; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
button:hover, .btn:hover{ background-position:100% 0; transform:translateY(-2px); box-shadow:inset 0 1px 0 rgba(255,255,255,.32), 0 16px 28px -10px rgba(var(--accent-rgb), .85), 0 2px 4px rgba(15,35,80,.16); }
button:active, .btn:active{ transform:translateY(0) scale(.97); box-shadow:inset 0 2px 4px rgba(0,0,0,.18), 0 3px 8px -4px rgba(var(--accent-rgb), .6); }
button:focus-visible, .btn:focus-visible{ outline:none; box-shadow:0 0 0 4px rgba(var(--accent-rgb), .28), 0 8px 18px -8px rgba(var(--accent-rgb), .75); }
button:disabled, .btn:disabled{ opacity:.5; cursor:not-allowed; transform:none; box-shadow:none; filter:grayscale(.25); }
button::after, .btn::after{ content:''; position:absolute; top:0; bottom:0; left:0; width:55%; pointer-events:none;
  background:linear-gradient(105deg, transparent 20%, rgba(255,255,255,.34) 50%, transparent 80%); transform:translateX(-130%) skewX(-12deg); transition:transform .7s ease; }
button:hover::after, .btn:hover::after{ transform:translateX(250%) skewX(-12deg); }

button.secondary, .btn.secondary{ background:var(--panel); color:var(--text); border:1px solid var(--panel-edge); box-shadow:0 1px 2px rgba(15,35,80,.06), inset 0 -2px 0 rgba(var(--accent-rgb), .05); }
button.secondary:hover, .btn.secondary:hover{ background:color-mix(in srgb, var(--accent) 9%, var(--panel)); color:var(--accent-dark); border-color:var(--accent); box-shadow:0 10px 20px -12px rgba(var(--accent-rgb), .6), 0 1px 2px rgba(15,35,80,.06); }
button.secondary:active, .btn.secondary:active{ box-shadow:inset 0 2px 4px rgba(15,35,80,.10); }
button.secondary.active, .btn.secondary.active{ background:var(--accent-soft); color:var(--accent-dark); border-color:var(--accent); }
button.danger, .btn.danger{ background:linear-gradient(135deg, #fb7185 0%, #e11d48 55%, #be123c 100%); background-size:170% 100%; box-shadow:inset 0 1px 0 rgba(255,255,255,.28), 0 8px 18px -8px rgba(225,29,72,.7); }
button.danger:hover, .btn.danger:hover{ box-shadow:inset 0 1px 0 rgba(255,255,255,.3), 0 16px 28px -10px rgba(225,29,72,.8); }
button.ghost, .btn.ghost{ background:transparent; color:var(--muted); border-color:transparent; box-shadow:none; }
button.ghost:hover, .btn.ghost:hover{ background:var(--accent-soft); color:var(--accent-dark); box-shadow:none; }
.btn-sm{ padding:9px 14px; font-size:13.5px; border-radius:10px; }
.full{ width:100%; margin-top:20px; padding:15px 22px; font-size:15.5px; border-radius:14px; }

/* botones pequeños / especiales: sin brillo ni relieve */
:is(.secondary, .iconbtn, .theme-toggle, .pw-toggle, .sb-close, .to-top, .tab, .chev, .mini, .en-ib, .en-em, .en-co, .en-gb, .sn-chip, .sn-card, .as-ib, #sbOpen, .plain, .ghost)::after{ display:none; }
button.plain{ background:none; border:0; box-shadow:none; color:inherit; padding:0; overflow:visible; font-weight:inherit; border-radius:0; }
button.plain:hover{ background:none; transform:none; box-shadow:none; }
.ripple{ position:absolute; border-radius:50%; background:rgba(255,255,255,.45); transform:scale(0); animation:ripple .55s ease-out; pointer-events:none; }
button.secondary .ripple, .btn.secondary .ripple, .ghost .ripple{ background:rgba(var(--accent-rgb), .25); }
@keyframes ripple{ to{ transform:scale(4); opacity:0; } }

/* Botones de icono con etiqueta (acciones de las filas) */
.iconbtn{ background:var(--panel); border:1px solid var(--panel-edge); color:var(--muted); min-width:36px; height:36px; border-radius:10px; padding:0; gap:7px; font-size:13px; font-weight:600; box-shadow:none; transition:border-color .15s ease, color .15s ease, transform .15s var(--spring), background-color .15s ease; }
.iconbtn:hover{ border-color:var(--accent); color:var(--accent-dark); background:var(--accent-soft); transform:translateY(-1px); box-shadow:none; }
.iconbtn:active{ transform:scale(.94); }
.iconbtn svg{ width:17px; height:17px; }
.iconbtn.lbl{ padding:0 13px; }
.iconbtn.on{ background:var(--accent-soft); color:var(--accent-dark); border-color:var(--accent); }
.iconbtn.warn:hover{ color:var(--danger); border-color:var(--danger); background:var(--danger-soft); }

/* ---------- 5) FORMULARIOS ---------- */
label{ display:block; font-size:13.5px; font-weight:700; color:var(--muted); margin:16px 0 8px; letter-spacing:.02em; text-transform:uppercase; }
input[type=text], input[type=password], input[type=number], input[type=email], select, textarea{
  width:100%; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--mono); font-size:16px; padding:13px 16px; border-radius:12px; outline:none;
  transition:border-color .15s ease, box-shadow .15s ease, background-color .2s ease;
}
input:hover, select:hover, textarea:hover{ border-color:color-mix(in srgb, var(--accent) 45%, var(--panel-edge)); }
input:focus, select:focus, textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 4px rgba(var(--accent-rgb), .16); background:var(--panel); }
input[type=file]{ width:100%; background:var(--panel-alt); border:1px dashed var(--panel-edge); color:var(--muted); font-family:var(--sans); font-size:14.5px; padding:12px 14px; border-radius:12px; transition:border-color .15s ease; }
input[type=file]:hover{ border-color:var(--accent); }
input[type=file]::file-selector-button{ background:var(--grad); color:#fff; border:none; font-weight:600; font-size:13.5px; padding:9px 14px; border-radius:10px; cursor:pointer; margin-right:12px; }
input[type=checkbox]{ accent-color:var(--accent); width:18px; height:18px; cursor:pointer; }
input[type=color]{ width:40px; height:34px; padding:0; border:1px solid var(--panel-edge); border-radius:10px; background:none; cursor:pointer; }

/* ---------- 6) MENÚ LATERAL Y NAVEGACIÓN MULTI-ESTILO (HIPER-TRANSPARENTE Y RESPLANDECIENTE) ---------- */
@keyframes navGlowPulse {
  0%, 100% {
    box-shadow:
      0 0 26px 3px rgba(var(--accent-rgb), 0.70),
      0 0 60px 8px rgba(var(--accent-rgb), 0.38),
      0 0 100px 14px rgba(var(--accent-rgb), 0.20),
      inset 0 0 26px rgba(var(--accent-rgb), 0.24),
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.60),
      0 28px 75px rgba(0, 0, 0, 0.75);
    border-color: rgba(var(--accent-rgb), 0.85);
  }
  50% {
    box-shadow:
      0 0 42px 7px rgba(var(--accent-rgb), 0.95),
      0 0 85px 14px rgba(var(--accent-rgb), 0.52),
      0 0 135px 22px rgba(var(--accent-rgb), 0.28),
      inset 0 0 35px rgba(var(--accent-rgb), 0.38),
      inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.85),
      0 28px 75px rgba(0, 0, 0, 0.75);
    border-color: var(--accent);
  }
}

.navbar{ display:flex; align-items:center; gap:14px; }
body:not(.guest) .navbar{
  position:fixed; top:12px; left:12px; bottom:12px; width:260px; margin:0; padding:18px 14px 14px; z-index:200;
  flex-direction:column; flex-wrap:nowrap; align-items:stretch;
  background:linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 40%, rgba(var(--accent-rgb), 0.08) 100%), rgba(8, 12, 20, 0.14) !important;
  backdrop-filter:blur(26px) saturate(200%);
  -webkit-backdrop-filter:blur(26px) saturate(200%);
  border:1.5px solid rgba(var(--accent-rgb), 0.85) !important;
  border-radius:24px;
  box-shadow:
    0 0 26px 3px rgba(var(--accent-rgb), 0.70),
    0 0 60px 8px rgba(var(--accent-rgb), 0.38),
    0 0 100px 14px rgba(var(--accent-rgb), 0.20),
    inset 0 0 26px rgba(var(--accent-rgb), 0.24),
    inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.60),
    0 28px 75px rgba(0, 0, 0, 0.75);
  animation:navGlowPulse 4s ease-in-out infinite alternate !important;
  transform:translateX(0);
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  transition:transform .32s cubic-bezier(0.16, 1, 0.3, 1), opacity .25s ease, box-shadow .3s ease, visibility .32s ease, width .3s ease, padding .3s ease;
}
:root[data-theme="oled"] body:not(.guest) .navbar{
  background:linear-gradient(165deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.01) 40%, rgba(var(--accent-rgb), 0.10) 100%), rgba(2, 4, 8, 0.16) !important;
  border:1.5px solid rgba(var(--accent-rgb), 0.95) !important;
  box-shadow:
    0 0 32px 5px rgba(var(--accent-rgb), 0.85),
    0 0 75px 12px rgba(var(--accent-rgb), 0.45),
    0 0 120px 20px rgba(var(--accent-rgb), 0.24),
    inset 0 0 30px rgba(var(--accent-rgb), 0.32),
    inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.75),
    0 28px 75px rgba(0, 0, 0, 0.95) !important;
}

/* ===== MODO 1: ZEN OCULTO (Off-Canvas Drawer) ===== */
:root[data-nav-style="oculto"] body:not(.guest){ padding:22px 24px 70px 24px !important; }
:root[data-nav-style="oculto"].sb-off body:not(.guest) .navbar{
  transform:translateX(calc(-100% - 40px)) !important;
  opacity:0 !important;
  visibility:hidden !important;
  pointer-events:none !important;
}
:root[data-nav-style="oculto"].sb-off #sbOpen{ display:inline-flex !important; }
:root[data-nav-style="oculto"]:not(.sb-off) .sb-backdrop{
  display:block !important; position:fixed !important; inset:0 !important; z-index:190 !important;
  background:rgba(5, 10, 25, 0.40) !important; backdrop-filter:blur(4px) !important; -webkit-backdrop-filter:blur(4px) !important;
  animation:pageIn .2s ease !important;
}

/* ===== MODO 2: MINI-DOCK CYBERPUNK AUTO-EXPANDIBLE (70px + HOVER / FLECHA) ===== */
:root[data-nav-style="dock"] body:not(.guest){ padding:22px 24px 70px 98px !important; }
:root[data-nav-style="dock"] #sbOpen{ display:none !important; }
:root[data-nav-style="dock"] .sb-backdrop{ display:none !important; }

/* El navbar inicia en 72px y se expande a 260px en hover o con clase .expanded */
:root[data-nav-style="dock"] body:not(.guest) .navbar{
  position:fixed !important; top:12px !important; bottom:12px !important; left:12px !important;
  width:72px !important; z-index:260 !important; padding:14px 6px 12px !important; align-items:center !important;
  transform:none !important; opacity:1 !important; visibility:visible !important; pointer-events:auto !important;
  border-radius:26px !important;
  background:linear-gradient(170deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 30%, rgba(var(--accent-rgb), 0.08) 100%), rgba(8, 12, 20, 0.14) !important;
  backdrop-filter:blur(26px) saturate(2) !important;
  -webkit-backdrop-filter:blur(26px) saturate(2) !important;
  border:1.5px solid rgba(var(--accent-rgb), 0.8) !important;
  box-shadow:0 0 25px 3px rgba(var(--accent-rgb), 0.65), 0 0 50px 6px rgba(var(--accent-rgb), 0.3), inset 0 0 20px rgba(var(--accent-rgb), 0.22), inset 0 1.5px 1px 0 rgba(255, 255, 255, 0.5) !important;
  transition:width .32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow .3s ease, background .3s ease, padding .3s ease !important;
}

/* EFECTO CRISTAL EXPANDIDO EN HOVER O PINNED */
:root[data-nav-style="dock"] body:not(.guest) .navbar:hover,
:root[data-nav-style="dock"] body:not(.guest) .navbar.expanded{
  width:260px !important;
  padding:18px 14px 14px !important;
  align-items:stretch !important;
  background:linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 35%, rgba(var(--accent-rgb), 0.08) 100%), rgba(8, 12, 20, 0.16) !important;
  backdrop-filter:blur(28px) saturate(2.1) !important;
  -webkit-backdrop-filter:blur(28px) saturate(2.1) !important;
  border-color:rgba(var(--accent-rgb), 0.95) !important;
  box-shadow:0 0 35px 5px rgba(var(--accent-rgb), 0.85), 0 0 75px 12px rgba(var(--accent-rgb), 0.45), inset 0 0 28px rgba(var(--accent-rgb), 0.3), inset 0 1.5px 1px 0 rgba(255, 255, 255, 0.65), 0 28px 80px rgba(0, 0, 0, 0.85) !important;
}

/* Brand colapsado vs expandido */
:root[data-nav-style="dock"] .brand{ width:100% !important; flex-shrink:0 !important; flex-direction:column !important; padding:2px 0 10px !important; gap:8px !important; border-bottom:none !important; }
:root[data-nav-style="dock"] .brand .brand-title{ display:none !important; }
:root[data-nav-style="dock"] .sb-close{ display:none !important; }

:root[data-nav-style="dock"] body:not(.guest) .navbar:hover .brand,
:root[data-nav-style="dock"] body:not(.guest) .navbar.expanded .brand{
