  <div class="git-modal-overlay" id="modalGitUpdate" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalGitTitle">
    <div class="cyber-modal-box">
      <!-- Encabezado del modal -->
      <div class="git-modal-head">
        <div style="display:flex; align-items:center; gap:12px;">
          <span id="modalGitIcon" style="font-size:26px; filter:drop-shadow(0 0 10px var(--accent));">🚀</span>
          <div>
            <h3 id="modalGitTitle" style="margin:0; font-size:16.5px; font-weight:800; color:var(--text); letter-spacing:-0.01em;">Actualizaciones en GitHub</h3>
            <small id="modalGitSubtitle" style="color:var(--muted); font-size:12px;">Nuevas mejoras listas para descargar e instalar</small>
          </div>
        </div>
        <button type="button" class="plain modal-close" id="btnCloseModalGit" aria-label="Cerrar" style="font-size:22px; cursor:pointer; color:var(--muted); padding:4px 8px; border-radius:8px; border:none; background:transparent;">&times;</button>
      </div>

      <!-- Cuerpo del modal -->
      <div class="git-modal-body">
        <!-- VISTA A: Hay cambios pendientes -->
        <div id="gitViewPending" style="display:block;">
          <div class="git-update-banner">
            <div class="gub-stat">
              <span class="gub-num" id="gitCommitsCount">0</span>
              <span class="gub-lbl">Mejoras</span>
            </div>
            <div class="gub-info">
              <div class="gub-branch">Rama: <strong id="gitBranchName" style="color:var(--accent);">main</strong></div>
              <div class="gub-desc">Al confirmar, el sistema guardará tus cambios locales (git stash), descargará las novedades de GitHub (git pull), actualizará dependencias y reiniciará el programa automáticamente.</div>
            </div>
          </div>

          <div style="margin: 14px 0 8px; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent);">
            📋 Lista de cambios y mejoras detectadas:
          </div>
          <div class="git-commits-list" id="gitCommitsList" style="max-height: 220px; overflow-y: auto;">
            <!-- Commits renderizados dinamicamente -->
          </div>
        </div>

        <!-- VISTA B: Ya está al día / No existen cambios -->
        <div id="gitViewUpToDate" style="display:none;">
          <div class="git-update-banner uptodate">
            <div class="gub-stat uptodate">
              <span class="gub-num">0</span>
              <span class="gub-lbl" style="color:#10b981;">Al Día</span>
            </div>
            <div class="gub-info">
              <div class="gub-branch" style="color:#10b981;">✅ Sistema Sincronizado y Estable</div>
              <div class="gub-desc">Tu versión actual (<%= typeof appVersion !== "undefined" ? appVersion : "v2.9.1" %>) cuenta con todas las mejoras y parches más recientes publicados en GitHub. No hay versiones ni cambios nuevos pendientes de descargar.</div>
            </div>
          </div>
          <div style="padding: 12px 14px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; font-size: 12.5px; color: var(--muted); line-height: 1.45;">
            💡 <strong>Tip:</strong> Si tú o tu equipo suben nuevos commits al repositorio de GitHub, podrás descargarlos aquí mismo con un solo clic en cualquier momento.
          </div>
        </div>

        <!-- VISTA C: Error de conexión -->
        <div id="gitViewError" style="display:none;">
          <div style="padding: 14px 16px; border-radius: 12px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.35); color: #f87171; font-size: 13px; line-height: 1.45;" id="gitErrorText">
            No se pudo conectar con GitHub. Verifica que tengas conexión a internet o acceso al repositorio.
          </div>
        </div>
      </div>

      <!-- Pie del modal / Botones de acción -->
      <div class="git-modal-foot">
        <div id="gitFootPending" style="display:flex; align-items:center; gap:10px;">
          <button type="button" class="secondary btn-sm" id="btnCancelGitUpdate">Posponer</button>
          <button type="button" class="btn-update-confirm" id="btnConfirmGitUpdate">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            <span>Descargar e Instalar Ahora</span>
          </button>
        </div>
        <div id="gitFootUpToDate" style="display:none;">
          <button type="button" class="btn-update-confirm" id="btnOkGitUpdate">
            <span>Entendido</span>
          </button>
        </div>
        <div id="gitFootError" style="display:none;">
          <button type="button" class="secondary btn-sm" id="btnErrorClose">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

