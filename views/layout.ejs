  background: var(--accent) !important;
  box-shadow: 0 0 8px var(--accent) !important;
  animation: bguSpin 1s infinite alternate !important;
}
.ha-step.done {
  color: #10b981 !important;
}
.ha-step.done .has-dot {
  background: #10b981 !important;
  box-shadow: 0 0 6px #10b981 !important;
}
.ha-step.done .has-check {
  display: inline !important;
}

/* Barra de progreso de estado */
.hud-act-status-bar {
  height: 6px !important;
  border-radius: 999px !important;
  background: rgba(255, 255, 255, 0.08) !important;
  overflow: hidden !important;
  position: relative !important;
  margin-bottom: 14px !important;
}
.hasb-fill {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  bottom: 0 !important;
  width: 40% !important;
  border-radius: 999px !important;
  background: linear-gradient(90deg, transparent, var(--accent), transparent) !important;
  animation: hasbProgress 1.6s infinite ease-in-out !important;
}
@keyframes hasbProgress {
  0% { left: -40%; }
  100% { left: 100%; }
}

.hud-act-telemetry {
  display: inline-flex !important;
  align-items: center !important;
  gap: 7px !important;
  font-size: 12.5px !important;
  color: var(--text) !important;
  margin-bottom: 12px !important;
}
.hat-dot {
  width: 7px !important;
  height: 7px !important;
  border-radius: 50% !important;
  background: #f59e0b !important;
  box-shadow: 0 0 8px #f59e0b !important;
  animation: hatBlink 1s infinite alternate !important;
}
@keyframes hatBlink {
  from { opacity: 0.4; }
  to { opacity: 1; }
}

.hud-act-warning {
  display: block !important;
  color: var(--muted) !important;
  font-size: 11px !important;
  line-height: 1.35 !important;
}

/* =====================================================================
   SEPARADORES DE GRUPOS EN NAVEGACIÓN (Gestión, Herramientas, Productividad)
   ===================================================================== */
.nav-group-sep {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  margin: 10px 0 4px;
  padding: 0 8px;
  box-sizing: border-box;
  flex-shrink: 0;
}
.nav-group-sep::before, .nav-group-sep::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--panel-edge);
  opacity: 0.7;
}
.nav-group-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  white-space: nowrap;
  user-select: none;
}

/* En Cyber-Dock Flotante: micro-separador vertical elegante */
:root[data-nav-style="cyber-dock"] .nav-tabs .nav-group-sep {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 26px !important;
  width: 1px !important;
  background: rgba(255, 255, 255, 0.18) !important;
  margin: 0 5px !important;
  padding: 0 !important;
  flex-shrink: 0 !important;
  box-shadow: 0 0 6px rgba(var(--accent-rgb), 0.25) !important;
}
:root[data-nav-style="cyber-dock"] .nav-tabs .nav-group-sep::before,
:root[data-nav-style="cyber-dock"] .nav-tabs .nav-group-sep::after {
  display: none !important;
}
:root[data-nav-style="cyber-dock"] .nav-tabs .nav-group-sep .nav-group-label {
  display: none !important;
}

/* En Isla Dinámica y Superior */
:root[data-nav-style="dynamic-island"] .nav-tabs .nav-group-sep,
:root[data-nav-style="superior"] .nav-tabs .nav-group-sep,
:root[data-nav-style="top"] .nav-tabs .nav-group-sep {
  display: inline-flex !important;
  height: 22px !important;
  width: 1px !important;
  background: rgba(255, 255, 255, 0.16) !important;
  margin: 0 4px !important;
  padding: 0 !important;
  flex-shrink: 0 !important;
}
:root[data-nav-style="dynamic-island"] .nav-tabs .nav-group-sep::before,
:root[data-nav-style="dynamic-island"] .nav-tabs .nav-group-sep::after,
:root[data-nav-style="superior"] .nav-tabs .nav-group-sep::before,
:root[data-nav-style="superior"] .nav-tabs .nav-group-sep::after,
:root[data-nav-style="top"] .nav-tabs .nav-group-sep::before,
:root[data-nav-style="top"] .nav-tabs .nav-group-sep::after,
:root[data-nav-style="dynamic-island"] .nav-tabs .nav-group-sep .nav-group-label,
:root[data-nav-style="superior"] .nav-tabs .nav-group-sep .nav-group-label,
:root[data-nav-style="top"] .nav-tabs .nav-group-sep .nav-group-label {
  display: none !important;
}

/* En Rueda Holográfica */
:root[data-nav-style="rueda"] .nav-tabs .nav-group-sep {
  display: none !important;
}

/* En Hex Matrix */
:root[data-nav-style="hex-matrix"] .nav-tabs .nav-group-sep {
  grid-column: 1 / -1 !important;
  width: 100% !important;
  margin: 8px 0 2px !important;
  padding: 0 4px !important;
}

/* Cuando la barra lateral está colapsada (iconos) */
body:not(.guest) .navbar.dock-collapsed .nav-group-sep .nav-group-label,
:root[data-nav-style="dock"]:not(:hover) .nav-group-sep .nav-group-label {
  display: none !important;
}
body:not(.guest) .navbar.dock-collapsed .nav-group-sep,
:root[data-nav-style="dock"]:not(:hover) .nav-group-sep {
  margin: 6px 0 !important;
  padding: 0 12px !important;
}


/* =====================================================================
   DROPDOWNS MODERNOS CYBERPUNK / GLASSMORPHISM (SELECTORES ELEGANTES)
   ===================================================================== */
.custom-select-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.custom-select-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 8px !important;
  padding: 6px 14px !important;
  min-height: 34px !important;
  border-radius: 999px !important;
  background: var(--panel-alt) !important;
  border: 1px solid var(--panel-edge) !important;
  color: var(--text) !important;
  font-size: 12.5px !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all .18s var(--ease) !important;
  box-shadow: 0 2px 8px rgba(0,0,0,0.18) !important;
}
.custom-select-btn:hover {
  border-color: var(--accent) !important;
  background: rgba(var(--accent-rgb), 0.12) !important;
  box-shadow: 0 0 14px -2px rgba(var(--accent-rgb), 0.4) !important;
  transform: translateY(-1px) !important;
}
.custom-select-btn.open {
  border-color: var(--accent) !important;
  box-shadow: 0 0 16px -2px rgba(var(--accent-rgb), 0.55) !important;
}
.custom-select-btn .cs-arrow {
  font-size: 10px;
  color: var(--muted);
  transition: transform .2s ease;
}
.custom-select-btn.open .cs-arrow {
  transform: rotate(180deg);
}
.custom-select-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 1000;
  min-width: 240px;
  max-width: 340px;
  background: var(--panel);
  border: 1px solid var(--panel-edge);
  border-radius: 14px;
  box-shadow: 0 18px 42px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.08);
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  animation: panelIn .16s var(--ease);
}
.custom-select-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent;
  color: var(--text);
  font-size: 12.5px;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  text-align: left;
  transition: all .12s ease;
  box-shadow: none;
}
.custom-select-item:hover {
  background: var(--accent-soft) !important;
  color: var(--accent-dark) !important;
  transform: none !important;
  box-shadow: none !important;
}
.custom-select-item.active {
  background: var(--accent) !important;
  color: #fff !important;
  font-weight: 700;
}
.custom-select-item .cs-check {
  font-size: 12px;
  font-weight: 800;
}


.pw-toggle .eye-off,
.field .pw-toggle .eye-off {
  display: none !important;
}
.pw-toggle.showing .eye,
.field .pw-toggle.showing .eye {
  display: none !important;
}
.pw-toggle.showing .eye-off,
.field .pw-toggle.showing .eye-off {
  display: block !important;
}
.pw-toggle.showing,
.field .pw-toggle.showing {
  color: var(--accent, #00f5ff) !important;
}

