/* ===== BOTÓN SELECTOR DE ESTILO EN EL TOPBAR ===== */
.btn-nav-modal{
  display:inline-flex;
  align-items:center;
  gap:9px;
  height:40px;
  padding:0 14px 0 10px;
  border-radius:12px;
  background:rgba(255, 255, 255, 0.05);
  border:1px solid rgba(var(--accent-rgb), 0.35);
  color:var(--text);
  font-family:var(--sans);
  cursor:pointer;
  box-shadow:0 4px 14px rgba(0,0,0,0.22), 0 0 12px -2px rgba(var(--accent-rgb), 0.25), inset 0 1px 0 rgba(255,255,255,0.12);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  transition:all .22s var(--spring);
  text-decoration:none;
  user-select:none;
}
.btn-nav-modal:hover{
  background:rgba(var(--accent-rgb), 0.15);
  border-color:var(--accent);
  color:#fff;
  transform:translateY(-1px) scale(1.02);
  box-shadow:0 8px 22px rgba(0,0,0,0.35), 0 0 20px 2px rgba(var(--accent-rgb), 0.55), inset 0 1px 0 rgba(255,255,255,0.25);
}
.bnm-icon{
  width:26px;
  height:26px;
  border-radius:8px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(var(--accent-rgb), 0.22);
  border:1px solid rgba(var(--accent-rgb), 0.45);
  color:var(--accent);
  flex-shrink:0;
  box-shadow:0 0 10px -1px rgba(var(--accent-rgb), 0.4);
  transition:all .2s ease;
}
.btn-nav-modal:hover .bnm-icon{
  background:var(--grad);
  border-color:rgba(255,255,255,0.5);
  color:#fff;
  box-shadow:0 0 14px 2px rgba(var(--accent-rgb), 0.7);
}
.bnm-icon svg{ width:15px; height:15px; stroke:currentColor; }
.bnm-text{ display:flex; align-items:center; gap:8px; line-height:1.2; }
.bnm-label{ font-size:12.5px; font-weight:600; color:rgba(255,255,255,0.85); letter-spacing:.01em; }
.bnm-pill{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:3px 9px;
  border-radius:999px;
  background:rgba(var(--accent-rgb), 0.22);
  border:1px solid rgba(var(--accent-rgb), 0.5);
  color:#fff;
  font-size:11px;
  font-weight:700;
  letter-spacing:.02em;
  box-shadow:0 0 10px rgba(var(--accent-rgb), 0.35);
}
.bnm-dot{
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--accent);
  box-shadow:0 0 8px var(--accent);
  display:inline-block;
  animation:bnmPulse 2s infinite ease-in-out;
}
@keyframes bnmPulse{
  0%,100%{ transform:scale(1); opacity:0.8; }
  50%{ transform:scale(1.3); opacity:1; filter:brightness(1.4); }
}
.bnm-caret{ width:14px; height:14px; stroke:rgba(255,255,255,0.6); margin-left:2px; transition:transform .2s ease, stroke .2s ease; }
.btn-nav-modal:hover .bnm-caret{ transform:translateY(2px); stroke:#fff; }

.pal-open-nav-modal-btn{
  width:100%;
  margin-top:10px;
  padding:9px 12px;
  border-radius:10px;
  background:rgba(var(--accent-rgb), 0.14);
  border:1px solid rgba(var(--accent-rgb), 0.35);
  color:var(--text);
  font-size:12px;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  cursor:pointer;
  transition:all .2s var(--spring);
}
.pal-open-nav-modal-btn:hover{
  background:rgba(var(--accent-rgb), 0.25);
  border-color:var(--accent);
  color:#fff;
  box-shadow:0 0 14px rgba(var(--accent-rgb), 0.4);
  transform:translateY(-1px);
}

/* ===== MODAL VISUAL SELECTOR DE NAVEGACIÓN ===== */
.nav-modal{
  position:fixed;
  inset:0;
  z-index:900;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(4, 6, 12, 0.78);
  backdrop-filter:blur(24px) saturate(180%);
  -webkit-backdrop-filter:blur(24px) saturate(180%);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .25s ease, visibility .25s ease;
}
.nav-modal.open{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
}
.nav-modal-box{
  position:relative;
  width:100%;
  max-width:1180px;
  max-height:92vh;
  overflow-y:auto;
  scrollbar-width:thin;
  background:linear-gradient(165deg, rgba(16, 22, 36, 0.96) 0%, rgba(9, 13, 22, 0.98) 100%);
  border:1px solid rgba(var(--accent-rgb), 0.45);
  border-radius:26px;
  padding:32px 34px 28px;
  box-shadow:0 30px 90px -10px rgba(0, 0, 0, 0.85), 0 0 50px -5px rgba(var(--accent-rgb), 0.3), inset 0 1px 1px rgba(255,255,255,0.22);
  transform:scale(0.94) translateY(16px);
  transition:transform .3s var(--spring);
}
.nav-modal.open .nav-modal-box{
  transform:scale(1) translateY(0);
}
.nav-modal-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:20px;
  margin-bottom:26px;
  border-bottom:1px solid rgba(255, 255, 255, 0.08);
  padding-bottom:18px;
}
.nav-modal-title-group{
  display:flex;
  flex-direction:column;
  gap:6px;
}
.nav-modal-tag{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:11px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--accent);
  background:rgba(var(--accent-rgb), 0.14);
  border:1px solid rgba(var(--accent-rgb), 0.35);
  padding:3px 10px;
  border-radius:999px;
  width:fit-content;
  box-shadow:0 0 12px rgba(var(--accent-rgb), 0.3);
}
.nav-modal-title{
  font-size:26px;
  font-weight:900;
  letter-spacing:-.025em;
  color:#fff;
  margin:0;
  line-height:1.2;
  display:flex;
  align-items:center;
  gap:10px;
  background:linear-gradient(135deg, #fff 40%, rgba(var(--accent-rgb), 0.9) 100%);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}
.nav-modal-subtitle{
  font-size:13.5px;
  color:rgba(255, 255, 255, 0.65);
  margin:0;
}
.nav-modal-close{
  width:38px;
  height:38px;
  border-radius:12px;
  background:rgba(255, 255, 255, 0.06);
  border:1px solid rgba(255, 255, 255, 0.12);
  color:rgba(255, 255, 255, 0.7);
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .2s var(--spring);
  flex-shrink:0;
}
.nav-modal-close:hover{
  background:rgba(225, 29, 72, 0.2);
  border-color:rgba(225, 29, 72, 0.5);
  color:#fff;
  transform:rotate(90deg) scale(1.08);
}
.nav-modal-close svg{
  width:18px;
  height:18px;
}

/* Grid con las 5 tarjetas */
.nav-modal-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:14px;
  margin-bottom:22px;
}
@media (max-width:1250px){
  .nav-modal-grid{ grid-template-columns:repeat(3, 1fr); gap:14px; }
}
@media (max-width:800px){
  .nav-modal-grid{ grid-template-columns:repeat(2, 1fr); gap:12px; }
}
@media (max-width:540px){
  .nav-modal-grid{ grid-template-columns:1fr; gap:12px; }
  .nav-modal-box{ padding:20px 16px; }
}

/* Tarjeta individual */
.nav-card{
  position:relative;
  background:rgba(255, 255, 255, 0.035);
  border:1px solid rgba(255, 255, 255, 0.08);
  border-radius:18px;
  padding:18px 16px 16px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  gap:14px;
  cursor:pointer;
  transition:all .25s var(--spring);
  user-select:none;
  overflow:hidden;
}
.nav-card::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb), 0.15), transparent 70%);
  opacity:0;
  transition:opacity .25s ease;
  pointer-events:none;
}
.nav-card:hover{
  background:rgba(255, 255, 255, 0.06);
  border-color:rgba(var(--accent-rgb), 0.55);
  transform:translateY(-4px);
  box-shadow:0 14px 34px -6px rgba(0, 0, 0, 0.6), 0 0 24px -2px rgba(var(--accent-rgb), 0.35);
}
.nav-card:hover::before{
  opacity:1;
}
.nav-card.active{
  background:rgba(var(--accent-rgb), 0.10);
  border-color:var(--accent);
  box-shadow:0 0 28px 0 rgba(var(--accent-rgb), 0.45), inset 0 0 18px rgba(var(--accent-rgb), 0.15);
  transform:translateY(-2px);
}
.nav-card.active::before{
  opacity:1;
}

.nc-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
}
.nc-tag{
  font-size:9.5px;
  font-weight:800;
  letter-spacing:.06em;
  text-transform:uppercase;
  padding:2px 8px;
  border-radius:6px;
  background:rgba(255, 255, 255, 0.08);
  color:rgba(255, 255, 255, 0.7);
  border:1px solid rgba(255, 255, 255, 0.1);
}
.nav-card.active .nc-tag{
  background:rgba(var(--accent-rgb), 0.25);
  border-color:var(--accent);
  color:#fff;
  box-shadow:0 0 10px rgba(var(--accent-rgb), 0.4);
}
.nc-radio{
  width:18px;
  height:18px;
  border-radius:50%;
  border:2px solid rgba(255, 255, 255, 0.3);
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .2s ease;
  flex-shrink:0;
}
.nav-card.active .nc-radio{
  border-color:var(--accent);
  box-shadow:0 0 10px var(--accent);
}
.nc-radio-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:transparent;
  transition:all .2s var(--spring);
}
.nc-radio-dot.checked,
.nav-card.active .nc-radio-dot{
  background:var(--accent);
  box-shadow:0 0 6px var(--accent);
  transform:scale(1.1);
}

.nc-info{ margin-top:2px; }
.nc-title{
  font-size:16px;
  font-weight:800;
  color:#fff;
  letter-spacing:-.01em;
  margin:0 0 4px;
  display:flex;
  align-items:center;
  gap:6px;
}
.nc-desc{
  font-size:12px;
  color:rgba(255, 255, 255, 0.6);
  margin:0;
  line-height:1.35;
}

/* Micro-Previsualizaciones CSS */
.nc-preview-frame{
