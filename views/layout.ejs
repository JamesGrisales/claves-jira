      function norm(s){ return String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
      function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]; }); }
      function puntaje(it, q){
        if (!q) return 1;
        var t = norm(it.t), k = norm(it.k || ''), i = t.indexOf(q);
        if (t === q) return 100; if (i === 0) return 80; if (i > 0) return 60 - i; if (k.indexOf(q) > -1) return 30;
        var j = 0; for (var c = 0; c < t.length && j < q.length; c++) if (t[c] === q[j]) j++;
        return j === q.length ? 10 : 0;
