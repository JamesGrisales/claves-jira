            <p class="nc-desc">Dial cibernético 180° con rayos láser y cristal transparente.</p>
          </div>
          <div class="nc-preview-frame">
            <div class="ncp-header">
              <span class="ncp-dot"></span><span class="ncp-dot"></span><span class="ncp-dot"></span>
            </div>
            <div class="ncp-body">
              <div class="ncp-rueda-dial"><div class="ncp-rueda-core"></div></div>
              <div class="ncp-rueda-nodes">
                <div class="ncp-rueda-node"><span class="ncp-rueda-beam"></span><span class="ncp-rueda-pill"></span></div>
                <div class="ncp-rueda-node"><span class="ncp-rueda-beam"></span><span class="ncp-rueda-pill active"></span></div>
                <div class="ncp-rueda-node"><span class="ncp-rueda-beam"></span><span class="ncp-rueda-pill"></span></div>
              </div>
              <div class="ncp-dock-content" style="margin-left:58px">
                <div class="ncp-zen-line w80"></div>
                <div class="ncp-zen-line w60"></div>
                <div class="ncp-zen-line w90"></div>
              </div>
            </div>
          </div>
          <ul class="nc-features">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Dial semicircular giratorio con telemetría HUD</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Despliegue radial con rayos láser conectores</span></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Tarjetas de cristal translúcido ultra-inmersivas</span></li>
          </ul>
          <button type="button" class="nc-select-btn">Seleccionar</button>
        </div>
      </div>

      <div class="nav-modal-foot">
        <div>💡 <b>Tip:</b> Puedes presionar <kbd>Esc</kbd> para cerrar o hacer clic en cualquier estilo para aplicarlo al instante.</div>
        <button type="button" class="nav-modal-btn-close" id="navModalCloseBtn">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Paleta de comandos (Ctrl + K  ó  /) -->
  <div class="cmdk" id="cmdk" aria-hidden="true">
    <div class="cmdk-box" role="dialog" aria-modal="true" aria-label="Buscador rápido">
      <div class="cmdk-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="cmdk-input" id="cmdInput" placeholder="Busca una página o una acción…" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="cmdList" aria-label="Buscar">
        <kbd class="kbd">Esc</kbd>
      </div>
      <div class="cmdk-list" id="cmdList" role="listbox"></div>
      <div class="cmdk-foot"><span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> moverse</span><span><kbd class="kbd">Enter</kbd> abrir</span><span class="sp"><kbd class="kbd">Ctrl K</kbd> o <kbd class="kbd">/</kbd> en cualquier página</span></div>
    </div>
  </div>

  <script>
  (function(){
    var root = document.documentElement, $ = function(id){ return document.getElementById(id); };
    function store(k, v){ try { localStorage.setItem(k, v); } catch (e) {} }
    function read(k, d){ try { return localStorage.getItem(k) || d; } catch (e) { return d; } }
    function rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h.replace(/./g, '$&$&'); var n = parseInt(h, 16); return (n >> 16) + ',' + ((n >> 8) & 255) + ',' + (n & 255); }

    /* ----- Reloj y fecha ----- */
    (function(){
      var H = $('ckH'), M = $('ckM'), S = $('ckS'), A = $('ckA'), D = $('ckD'), hh = $('ckHh'), hm = $('ckHm'), hs = $('ckHs');
      if (!H) return;
      var fecha = new Intl.DateTimeFormat('es-CO', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
      var ultimaFecha = '';
      function tick(){
        var d = new Date(), h = d.getHours(), m = d.getMinutes(), s = d.getSeconds();
        H.textContent = (h < 10 ? '0' : '') + h;
        M.textContent = (m < 10 ? '0' : '') + m;
        if (S) S.textContent = (s < 10 ? '0' : '') + s;
        if (A) A.textContent = '';
        if (hh) hh.setAttribute('transform', 'rotate(' + (((h % 12) + m / 60) * 30) + ' 22 22)');
        if (hm) hm.setAttribute('transform', 'rotate(' + ((m + s / 60) * 6) + ' 22 22)');
        if (hs) hs.setAttribute('transform', 'rotate(' + (s * 6) + ' 22 22)');
        var f = fecha.format(d); if (f !== ultimaFecha) { ultimaFecha = f; D.textContent = f.charAt(0).toUpperCase() + f.slice(1); }
      }
      tick(); setInterval(tick, 1000);
    })();

    /* ----- Volver arriba ----- */
    var top = $('toTop');
    window.addEventListener('scroll', function(){ top.classList.toggle('show', window.scrollY > 400); }, { passive:true });
    top.addEventListener('click', function(){ window.scrollTo({ top:0, behavior:'smooth' }); });

    /* ----- Efecto onda en botones ----- */
    document.addEventListener('click', function(e){
      var b = e.target.closest('button, .btn');
      if (!b || b.disabled || b.matches('.theme-toggle, .to-top, .iconbtn, .pw-toggle, .plain')) return;
      var r = b.getBoundingClientRect(), d = Math.max(r.width, r.height), s = document.createElement('span');
      s.className = 'ripple'; s.style.width = s.style.height = d + 'px';
      s.style.left = (e.clientX - r.left - d / 2) + 'px'; s.style.top = (e.clientY - r.top - d / 2) + 'px';
      b.appendChild(s); setTimeout(function(){ s.remove(); }, 600);
    });

    /* ----- Mostrar / ocultar contraseña ----- */
    document.addEventListener('click', function(e){
      var t = e.target.closest('.pw-toggle'); if (!t) return;
      var inp = t.parentNode.querySelector('input'); if (!inp) return;
      var ver = inp.type === 'password';
      inp.type = ver ? 'text' : 'password'; t.classList.toggle('on', ver);
      t.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña'); inp.focus();
    });

    /* ----- Aviso de Bloq Mayús ----- */
    function avisoMayus(e){
      if (!e.getModifierState || !e.target || !e.target.matches || !e.target.matches('.auth input[type=password], .auth .field input')) return;
      var caja = e.target.closest('.auth-main, .auth-body'), aviso = caja && caja.querySelector('.caps');
      if (aviso) aviso.classList.toggle('show', e.getModifierState('CapsLock'));
    }
    document.addEventListener('keydown', avisoMayus); document.addEventListener('keyup', avisoMayus);

    /* ----- Botón "cargando" en formularios de acceso ----- */
    document.addEventListener('submit', function(e){
      var f = e.target; if (!f.closest || !f.closest('.auth')) return;
      if (f.checkValidity && !f.checkValidity()) return;
      var b = f.querySelector('button[type=submit]'); if (!b) return;
      var s = b.querySelector('span'); if (s) { b.dataset.t = s.textContent; s.textContent = b.getAttribute('data-loading') || 'Procesando…'; }
      b.classList.add('loading'); setTimeout(function(){ b.disabled = true; }, 0);
    });
    window.addEventListener('pageshow', function(e){
      if (!e.persisted) return;
      Array.prototype.forEach.call(document.querySelectorAll('.auth button.loading'), function(b){
        b.classList.remove('loading'); b.disabled = false; var s = b.querySelector('span'); if (s && b.dataset.t) s.textContent = b.dataset.t;
      });
    });

    /* ----- Menú lateral (Navegación multi-estilo) ----- */
    var nb = document.querySelector('.navbar');
    function menu(oculto){
      var st = root.getAttribute('data-nav-style') || 'oculto';
      if ((st === 'dock' || st === 'rueda') && nb) {
        nb.classList.toggle('expanded', !oculto);
      } else {
        root.classList.toggle('sb-off', oculto);
      }
    }
    if ($('sbClose')) $('sbClose').addEventListener('click', function(e){
      if (e) e.stopPropagation();
      var st = root.getAttribute('data-nav-style') || 'oculto';
      if (st === 'dock' && nb) {
        nb.classList.add('dock-collapsed');
        nb.classList.remove('expanded');
      } else if ((st === 'hex-matrix' || st === 'rueda') && nb) {
        nb.classList.add('collapsed');
        nb.classList.remove('expanded');
      } else {
        menu(true);
      }
    });
    if (nb) {
      nb.addEventListener('mouseleave', function(){
        nb.classList.remove('dock-collapsed');
        nb.classList.remove('collapsed');
      });
    }
    if ($('sbOpen')) $('sbOpen').addEventListener('click', function(){ menu(false); });
    if ($('sbBackdrop')) $('sbBackdrop').addEventListener('click', function(){ menu(true); });
    if ($('hexMatrixHandle')) {
      $('hexMatrixHandle').addEventListener('click', function(e){
        e.stopPropagation();
        if (nb) nb.classList.toggle('expanded');
      });
      $('hexMatrixHandle').addEventListener('mouseenter', function(){
        if (nb) nb.classList.add('expanded');
      });
    }
    var hexHandle = $('hexMatrixHandle');
    if (hexHandle) {
      hexHandle.addEventListener('click', function(e){
        e.stopPropagation();
        if (nb) nb.classList.toggle('expanded');
      });
      hexHandle.addEventListener('mouseenter', function(){
        if (nb) nb.classList.add('expanded');
      });
    }
    if (nb) {
      nb.addEventListener('mouseleave', function(){
        var st = root.getAttribute('data-nav-style') || 'oculto';
        if (st === 'hex-matrix') {
          nb.classList.remove('expanded');
        }
      });
    }
    if ($('ruedaTriggerBadge')) $('ruedaTriggerBadge').addEventListener('click', function(e){
      e.stopPropagation();
      if (nb) nb.classList.toggle('expanded');
    });
    if ($('holoRadialWheel')) $('holoRadialWheel').addEventListener('click', function(e){
      if (e.target.closest('a, button, input')) return;
      var st = root.getAttribute('data-nav-style') || 'oculto';
      if (st === 'rueda' && nb) {
        nb.classList.toggle('expanded');
      }
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') {
        if (!root.classList.contains('sb-off')) menu(true);
        if (nb && nb.classList.contains('expanded')) nb.classList.remove('expanded');
      }
    });
    document.addEventListener('click', function(e){
      var st = root.getAttribute('data-nav-style') || 'oculto';
      if ((st === 'dock' || st === 'rueda') && nb && nb.classList.contains('expanded')) {
        if (!e.target.closest('.navbar')) nb.classList.remove('expanded');
      }
    });

    /* ----- Apariencia: modo, estilo de menú y paleta ----- */
    var panel = $('palPanel'), mq = window.matchMedia('(prefers-color-scheme: dark)');
    var navNames = {
      'oculto': 'Zen Oculto',
      'dock': 'Mini-Dock',
      'cyber-dock': 'Cyber-Dock Flotante',
      'hex-matrix': 'Matriz Hexagonal HUD',
      'dynamic-island': 'Isla Dinámica Táctica',
      'rueda': 'Rueda Holográfica',
      'fija': 'Barra Fija',
      'superior': 'Barra Superior'
    };
    function marcar(){
      var m = root.getAttribute('data-mode') || 'auto', p = root.getAttribute('data-palette') || 'db-engine', st = root.getAttribute('data-nav-style') || 'oculto';
      Array.prototype.forEach.call(panel.querySelectorAll('[data-mode]'), function(b){ b.classList.toggle('on', b.dataset.mode === m); });
      Array.prototype.forEach.call(panel.querySelectorAll('[data-pal]'), function(b){ b.classList.toggle('on', b.dataset.pal === p); });
      Array.prototype.forEach.call(panel.querySelectorAll('[data-nav]'), function(b){ b.classList.toggle('on', b.dataset.nav === st); });

      var spaBtn = $('swPlanetaDia');
      if (spaBtn) spaBtn.classList.toggle('on', p === 'planeta-dia');
      var spaDesc = $('spaDescText');
      if (spaDesc && window.PLANETAS_SISTEMA) {
        var plToday = window.PLANETAS_SISTEMA[new Date().getDay()] || window.PLANETAS_SISTEMA[2];
        spaDesc.textContent = 'Hoy: ' + plToday.dia + ' · ' + plToday.nombre + ' ' + plToday.icon + ' (' + plToday.desc + ')';
      }

      var bnmTxt = $('bnmActiveTxt');
      if (bnmTxt) bnmTxt.textContent = navNames[st] || 'Zen Oculto';

      var nm = $('navModal');
      if (nm) {
        Array.prototype.forEach.call(nm.querySelectorAll('.nav-card'), function(card){
          var isCurrent = (card.dataset.navTarget === st);
          card.classList.toggle('active', isCurrent);
          var btn = card.querySelector('.nc-select-btn');
          if (btn) {
            btn.innerHTML = isCurrent ? '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Activo' : 'Seleccionar';
          }
          var dot = card.querySelector('.nc-radio-dot');
          if (dot) dot.classList.toggle('checked', isCurrent);
        });
      }
    }
    function setNavStyle(st){
      root.setAttribute('data-nav-style', st);
      store('boveda-nav-style', st);
      if (st === 'oculto') {
        root.classList.add('sb-off');
      } else {
        root.classList.remove('sb-off');
      }
      marcar();
    }
    function setModo(m){
      store('boveda-theme', m);
      root.setAttribute('data-mode', m);
      var theme = m === 'oled' ? 'oled' : ((m === 'dark' || (m === 'auto' && mq.matches)) ? 'dark' : 'light');
      root.setAttribute('data-theme', theme);
      marcar();
    }
    function setPaleta(p, hex){
      root.setAttribute('data-palette', p);
      store('boveda-palette', p);
      if (p === 'planeta-dia') {
        var dayNum = new Date().getDay();
        var pl = (window.PLANETAS_SISTEMA && window.PLANETAS_SISTEMA[dayNum]) ? window.PLANETAS_SISTEMA[dayNum] : { c1: '#ff3b30', c2: '#b91c1c' };
        root.setAttribute('data-planet-active', pl.id);
        root.style.setProperty('--p1', pl.c1);
        root.style.setProperty('--p2', pl.c2);
        root.style.setProperty('--accent-rgb', rgb(pl.c1));
      } else if (p === 'custom') {
        hex = hex || read('boveda-custom', '#2563eb'); store('boveda-custom', hex);
        root.style.setProperty('--p1', hex); root.style.setProperty('--accent-rgb', rgb(hex));
        $('palCustom').value = hex; var sw = $('swCustom'); sw.style.setProperty('--a', hex); sw.style.setProperty('--b', hex);
      } else {
        root.style.removeProperty('--p1');
        root.style.removeProperty('--p2');
        root.style.removeProperty('--accent-rgb');
      }
      marcar();
    }
    (function(){ var h = read('boveda-custom', '#2563eb'); $('palCustom').value = h; $('swCustom').style.setProperty('--a', h); $('swCustom').style.setProperty('--b', h); })();
    marcar();
    if (mq.addEventListener) mq.addEventListener('change', function(){ if (root.getAttribute('data-mode') === 'auto') setModo('auto'); });

    panel.addEventListener('click', function(e){
      var m = e.target.closest('[data-mode]'), p = e.target.closest('[data-pal]'), n = e.target.closest('[data-nav]');
      if (m) setModo(m.dataset.mode);
      if (p) setPaleta(p.dataset.pal);
      if (n) setNavStyle(n.dataset.nav);
    });
    $('palCustom').addEventListener('input', function(){ setPaleta('custom', this.value); });
    $('palReset').addEventListener('click', function(){ setModo('oled'); setPaleta('lima'); setNavStyle('oculto'); });
    $('themeToggle').addEventListener('click', function(){ setModo(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'); });
    function posicionarPanelPaleta(){
      var btn = $('palBtn');
      if (!btn || !panel) return;
      var rect = btn.getBoundingClientRect();
      var navStyle = root.getAttribute('data-nav-style') || 'oculto';
      var panelWidth = 360;

      if (navStyle === 'superior') {
        panel.style.setProperty('position', 'fixed', 'important');
        panel.style.setProperty('top', '70px', 'important');
        panel.style.setProperty('right', '20px', 'important');
        panel.style.setProperty('left', 'auto', 'important');
        panel.style.setProperty('bottom', 'auto', 'important');
        panel.style.setProperty('max-height', 'calc(100vh - 90px)', 'important');
      } else if (navStyle === 'cyber-dock') {
        var left = rect.right - panelWidth + 14;
        if (left < 10) left = 10;
        if (left + panelWidth > window.innerWidth - 10) left = window.innerWidth - panelWidth - 10;
        panel.style.setProperty('position', 'fixed', 'important');
        panel.style.setProperty('top', Math.round(rect.bottom + 12) + 'px', 'important');
        panel.style.setProperty('left', Math.round(left) + 'px', 'important');
        panel.style.setProperty('bottom', 'auto', 'important');
        panel.style.setProperty('right', 'auto', 'important');
        panel.style.setProperty('max-height', 'calc(100vh - ' + Math.round(rect.bottom + 26) + 'px)', 'important');
      } else if (navStyle === 'dynamic-island') {
        var left = Math.max(10, Math.min(window.innerWidth - panelWidth - 10, rect.left - 180));
        panel.style.setProperty('position', 'fixed', 'important');
        panel.style.setProperty('top', Math.round(rect.bottom + 12) + 'px', 'important');
        panel.style.setProperty('left', Math.round(left) + 'px', 'important');
        panel.style.setProperty('bottom', 'auto', 'important');
        panel.style.setProperty('right', 'auto', 'important');
        panel.style.setProperty('max-height', 'calc(100vh - ' + Math.round(rect.bottom + 26) + 'px)', 'important');
      } else if (navStyle === 'dock' || navStyle === 'fija' || navStyle === 'rueda' || navStyle === 'oculto' || navStyle === 'hex-matrix') {
        var left = Math.round(rect.right + 12);
        if (left + panelWidth > window.innerWidth - 10) left = Math.max(10, window.innerWidth - panelWidth - 10);
        panel.style.setProperty('position', 'fixed', 'important');
        panel.style.setProperty('left', left + 'px', 'important');
        panel.style.setProperty('bottom', '16px', 'important');
        panel.style.setProperty('top', 'auto', 'important');
        panel.style.setProperty('right', 'auto', 'important');
        panel.style.setProperty('max-height', 'calc(100vh - 32px)', 'important');
      } else {
        if (rect.top > window.innerHeight / 2) {
          panel.style.setProperty('position', 'fixed', 'important');
          panel.style.setProperty('bottom', '16px', 'important');
          panel.style.setProperty('top', 'auto', 'important');
          panel.style.setProperty('left', Math.max(10, Math.min(window.innerWidth - panelWidth - 10, rect.left)) + 'px', 'important');
          panel.style.setProperty('right', 'auto', 'important');
          panel.style.setProperty('max-height', 'calc(100vh - 32px)', 'important');
        } else {
          panel.style.setProperty('position', 'fixed', 'important');
          panel.style.setProperty('top', Math.round(rect.bottom + 10) + 'px', 'important');
          panel.style.setProperty('bottom', 'auto', 'important');
          panel.style.setProperty('left', Math.max(10, Math.min(window.innerWidth - panelWidth - 10, rect.left - 180)) + 'px', 'important');
          panel.style.setProperty('right', 'auto', 'important');
          panel.style.setProperty('max-height', 'calc(100vh - ' + Math.round(rect.bottom + 24) + 'px)', 'important');
        }
      }
    }

    function togglePal(abrir){
      var isOpen = (typeof abrir === 'boolean') ? abrir : !panel.classList.contains('open');
      if (isOpen) {
        posicionarPanelPaleta();
      }
      panel.classList.toggle('open', isOpen);
      document.body.classList.toggle('pal-open', isOpen);
    }
    $('palBtn').addEventListener('click', function(e){ e.stopPropagation(); togglePal(); });
    document.addEventListener('click', function(e){ if (!e.target.closest('#palPanel, #palBtn, #palOpenNavModal')) togglePal(false); });

    /* ----- Modal Selector de Menú / Navegación ----- */
    var navModal = $('navModal');
    function openNavModal(){
      if (!navModal) return;
      marcar();
      navModal.classList.add('open');
      navModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeNavModal(){
      if (!navModal) return;
      navModal.classList.remove('open');
      navModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    if ($('btnOpenNavModal')) $('btnOpenNavModal').addEventListener('click', openNavModal);
    if ($('brandBadge')) { $('brandBadge').addEventListener('click', openNavModal); $('brandBadge').style.cursor = 'pointer'; $('brandBadge').setAttribute('title', 'Cambiar estilo de navegación y menú'); }
    if ($('palOpenNavModal')) $('palOpenNavModal').addEventListener('click', function(e){
      e.stopPropagation();
      togglePal(false);
      openNavModal();
    });
    if ($('navModalClose')) $('navModalClose').addEventListener('click', closeNavModal);
    if ($('navModalCloseBtn')) $('navModalCloseBtn').addEventListener('click', closeNavModal);
    if (navModal) {
      navModal.addEventListener('click', function(e){
        if (e.target === navModal) closeNavModal();
        var card = e.target.closest('.nav-card');
        if (card && card.dataset.navTarget) {
          setNavStyle(card.dataset.navTarget);
          setTimeout(closeNavModal, 300);
        }
      });
    }
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') {
        if (panel && panel.classList.contains('open')) togglePal(false);
        if (navModal && navModal.classList.contains('open')) closeNavModal();
      }
    });

    
    /* ===== SISTEMA DE TOOLTIPS HOLOGRÁFICOS CYBERPUNK (GLOBAL PARA TODOS LOS MÓDULOS) ===== */
    (function(){
      var tip = document.getElementById('cyberTooltip');
      if (!tip) {
        tip = document.createElement('div');
        tip.className = 'cyber-tooltip';
        tip.id = 'cyberTooltip';
        tip.setAttribute('aria-hidden', 'true');
        tip.innerHTML = '<div class="ct-head"><span class="ct-title"></span><span class="ct-badge"></span></div><div class="ct-desc"></div><div class="ct-arrow"></div>';
        document.body.appendChild(tip);
      }

      var titleEl = tip.querySelector('.ct-title');
      var descEl = tip.querySelector('.ct-desc');
      var badgeEl = tip.querySelector('.ct-badge');
      var arrowEl = tip.querySelector('.ct-arrow');
      var currentTarget = null;
      var hideTimer = null;

      function parseInfo(el) {
        var rawTitle = el.getAttribute('data-title') || el.getAttribute('data-tip-suppressed') || el.getAttribute('title') || el.getAttribute('aria-label') || '';
        var desc = el.getAttribute('data-desc') || '';
        var badge = el.getAttribute('data-badge') || '';

        rawTitle = (rawTitle || '').trim();

        if (el.closest('.nav-tabs') && !badge) {
          var orb = el.querySelector('.nav-db-side');
          if (orb) badge = orb.textContent.trim();
        }

        if (!badge) {
          var kbdMatch = rawTitle.match(/\s*\(((?:Ctrl|Alt|Shift|Cmd|Meta|Esc)[^)]*)\)\s*$/i);
          if (kbdMatch) {
            badge = kbdMatch[1].trim();
            rawTitle = rawTitle.substring(0, kbdMatch.index).trim();
          } else if (/^atajo:\s*(.+)$/i.test(rawTitle)) {
            var atajoMatch = rawTitle.match(/^atajo:\s*(.+)$/i);
            badge = atajoMatch[1].trim();
            var innerTxt = (el.textContent || '').trim();
            rawTitle = innerTxt && innerTxt.length < 30 ? innerTxt : 'Atajo';
          }
        }

        if (!desc) {
          if (rawTitle.includes(' · ')) {
            var parts = rawTitle.split(' · ');
            rawTitle = parts[0].trim();
            desc = parts.slice(1).join(' · ').trim();
          } else if (rawTitle.includes(': ') && !rawTitle.toLowerCase().startsWith('http')) {
            var colonIdx = rawTitle.indexOf(': ');
            var candidateTitle = rawTitle.substring(0, colonIdx).trim();
            var candidateDesc = rawTitle.substring(colonIdx + 2).trim();
            if (candidateTitle.length > 0 && candidateTitle.length < 30) {
              rawTitle = candidateTitle;
              desc = candidateDesc;
            }
          }
        }

        return { title: rawTitle, desc: desc, badge: badge };
      }

      function showTip(el){
        if (!el) return;
        currentTarget = el;
        clearTimeout(hideTimer);

        // Suprimir el tooltip nativo amarillo/negro del sistema operativo
        if (el.hasAttribute('title') && el.getAttribute('title')) {
          el.setAttribute('data-tip-suppressed', el.getAttribute('title'));
          el.removeAttribute('title');
        }

        var info = parseInfo(el);
        if (!info.title && !info.desc) return;

        titleEl.textContent = info.title;
        if (info.desc) {
          descEl.textContent = info.desc;
          descEl.style.display = 'block';
        } else {
          descEl.textContent = '';
          descEl.style.display = 'none';
        }

        if (info.badge) {
          badgeEl.textContent = info.badge;
          badgeEl.style.display = 'inline-block';
        } else {
          badgeEl.textContent = '';
          badgeEl.style.display = 'none';
        }

        tip.className = 'cyber-tooltip visible';

        var rect = el.getBoundingClientRect();
        var tipRect = tip.getBoundingClientRect();
        var x = 0, y = 0;
        var arrowClass = 'arrow-bottom';

        var isTopBar = !!el.closest('.topbar, .navbar, [data-nav-style="cyber-dock"] .navbar');

        if (isTopBar || rect.top < 70) {
          x = rect.left + (rect.width / 2) - (tipRect.width / 2);
          y = rect.bottom + 8;
          arrowClass = 'arrow-top';
        } else {
          x = rect.left + (rect.width / 2) - (tipRect.width / 2);
          y = rect.top - tipRect.height - 8;
          arrowClass = 'arrow-bottom';
          if (y < 8) {
            y = rect.bottom + 8;
            arrowClass = 'arrow-top';
          }
        }

        if (x < 10) x = 10;
        if (x + tipRect.width > window.innerWidth - 10) {
          x = window.innerWidth - tipRect.width - 10;
        }

        var arrowOffset = (rect.left + rect.width / 2) - x;
        if (arrowEl) {
          arrowEl.style.left = Math.max(14, Math.min(tipRect.width - 14, arrowOffset)) + 'px';
        }

        tip.style.left = Math.round(x) + 'px';
        tip.style.top = Math.round(y) + 'px';
        tip.className = 'cyber-tooltip visible ' + arrowClass;
      }

      function hideTip(){
        tip.classList.remove('visible');
        if (currentTarget && currentTarget.hasAttribute('data-tip-suppressed')) {
          currentTarget.setAttribute('title', currentTarget.getAttribute('data-tip-suppressed'));
          currentTarget.removeAttribute('data-tip-suppressed');
        }
        currentTarget = null;
      }

      // Selector global que cubre TODOS los módulos y botones con tooltip
      var selector = '[title], [data-title], [data-cyber-tip], [data-tip-suppressed], .nav-tabs a, .acc-actions a, .acc-actions button, .btn-nav-modal, .topbar-db-btn, #topbarThemeBtn, #cmdOpen, #as-trigger, .hex-matrix-handle, .v-icon-cluster button, .v-tb-btn, .v-tb-menu-item, .v-tb-drop-btn, .ew-pill-btn';

      document.addEventListener('mouseover', function(e){
        var target = e.target.closest(selector);
        if (target) {
