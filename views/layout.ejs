  border-color: rgba(0, 245, 255, 0.6);
  background: radial-gradient(circle at 30% 30%, rgba(14, 165, 233, 0.35), rgba(2, 132, 199, 0.15) 60%, rgba(4, 15, 30, 0.85));
}
.db-orb-pg:hover {
  transform: translateY(-2px) scale(1.18);
  border-color: #00f5ff;
  box-shadow: 0 0 24px rgba(0, 245, 255, 0.9), 0 0 42px rgba(2, 132, 199, 0.6), inset 0 0 14px rgba(0, 245, 255, 0.5);
