}
:root[data-nav-style="dock"] .nav-tabs a.active .nav-ic svg{ stroke:#fff !important; filter:drop-shadow(0 0 6px #fff) drop-shadow(0 0 10px var(--accent)) !important; }
@keyframes dockNeonGlow{ 0%,100%{ box-shadow:0 0 16px 1px rgba(var(--accent-rgb), 0.75), inset 0 1px 0 rgba(255,255,255,0.5); } 50%{ box-shadow:0 0 26px 4px rgba(var(--accent-rgb), 0.98), inset 0 1px 0 rgba(255,255,255,0.7); } }

:root[data-nav-style="dock"] .nav-tabs a .nav-ic svg{ margin:0 !important; width:20px !important; height:20px !important; }
:root[data-nav-style="dock"] .nav-tabs .tab-count{ position:absolute !important; top:3px !important; right:3px !important; min-width:16px !important; height:16px !important; padding:0 4px !important; font-size:9.5px !important; line-height:16px !important; }

/* En hover o expanded, las pestañas muestran sus nombres completos */
:root[data-nav-style="dock"] body:not(.guest) .navbar:hover .nav-tabs,
