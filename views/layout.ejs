:root[data-nav-style="dock"] body:not(.guest) .navbar:hover button.cmd-trigger,
:root[data-nav-style="dock"] body:not(.guest) .navbar.expanded button.cmd-trigger{
  width:100% !important; height:38px !important; padding:0 12px !important; justify-content:flex-start !important; gap:8px !important; margin:4px 0 10px !important; border-radius:12px !important;
}
:root[data-nav-style="dock"] body:not(.guest) .navbar:hover button.cmd-trigger span,
:root[data-nav-style="dock"] body:not(.guest) .navbar.expanded button.cmd-trigger span{
  display:inline !important; font-size:13px !important;
}
