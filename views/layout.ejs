    (function(){
      function mountActiveBadge(){
        if (document.body.classList.contains('guest')) return;
        var h1 = document.querySelector('.wrap h1, .main-content h1, .page-head h1, .top h1, h1');
        if (!h1) return;
        if (h1.closest('.modal, .nav-modal, .cmdk-box, .pal-panel')) return;
        if (document.getElementById('cyberActiveModuleBadge')) return;

        var modTitle = document.body.dataset.activeModuleTitle || 'Módulo';
        var modDesc = document.body.dataset.activeModuleDesc || '';
        var modIcon = document.body.dataset.activeModuleIcon || '⚡';
        var modCls = document.body.dataset.activeModuleCls || 'db-orb-pg';

        var badge = document.createElement('div');
        badge.className = 'cyber-active-module-badge';
        badge.id = 'cyberActiveModuleBadge';
        badge.title = 'Módulo en ejecución: ' + modTitle + (modDesc ? ' · ' + modDesc : '');
        badge.innerHTML = '<span class="camb-status-dot"></span>' +
          '<span class="camb-orb ' + modCls + '">' + modIcon + '</span>' +
          '<span class="camb-tag">MÓDULO ACTIVO</span>' +
          '<span class="camb-title">' + modTitle + '</span>' +
          (modDesc ? '<span class="camb-sep">·</span><span class="camb-desc">' + modDesc + '</span>' : '');

        var parent = h1.parentElement;
        if (!parent) return;

        // Si el contenedor padre es una barra horizontal flex (como .top, .cal-top, .page-head con acciones a la derecha)
        // creamos un contenedor vertical dedicado para que h1 quede arriba y la insignia directamente debajo:
        var cs = window.getComputedStyle(parent);
        var isFlexRow = (cs.display === 'flex' || cs.display === 'inline-flex') && (cs.flexDirection === 'row' || !cs.flexDirection);
        if (isFlexRow) {
          var titleWrap = document.createElement('div');
          titleWrap.className = 'cyber-title-group';
          titleWrap.style.display = 'flex';
          titleWrap.style.flexDirection = 'column';
          titleWrap.style.alignItems = 'flex-start';
          titleWrap.style.gap = '6px';
          titleWrap.style.minWidth = '0';

          parent.insertBefore(titleWrap, h1);
          h1.style.setProperty('margin', '0', 'important');
          h1.style.setProperty('display', 'block', 'important');
          titleWrap.appendChild(h1);
          titleWrap.appendChild(badge);
        } else {
          h1.style.setProperty('display', 'block', 'important');
          h1.style.setProperty('margin-bottom', '6px', 'important');
          h1.insertAdjacentElement('afterend', badge);
        }

        // 3. Comprobación automática y silenciosa al iniciar y periódicamente
        function autoVerificarGitHubEnSegundoPlano() {
          if (!window.fetch) return;
          fetch('/api/sistema/verificar-actualizacion')
            .then(function(r){ return r.json(); })
            .then(function(data){
              if (data && data.ok && data.hayCambios && data.numCambios > 0) {
                if (bguBadge) {
                  bguBadge.textContent = data.numCambios;
                  bguBadge.style.display = 'inline-block';
                }
                if (btn) {
                  btn.classList.add('bgu-has-updates');
                  btn.title = '¡Hay ' + data.numCambios + ' actualización(es) disponible(s) en GitHub! Haz clic para bajar cambios a la nueva versión';
                }
                if (bguTxt) {
                  bguTxt.textContent = 'Nueva Versión (' + data.numCambios + ')';
                }
              } else {
                if (bguBadge) bguBadge.style.display = 'none';
                if (btn) {
                  btn.classList.remove('bgu-has-updates');
                  btn.title = 'Buscar y descargar últimas mejoras desde GitHub';
                }
                if (bguTxt) bguTxt.textContent = 'Bajar Cambios';
              }
            })
            .catch(function(){});
        }

        // Ejecutar silenciosamente a los 2.5 segundos de cargar la página
        setTimeout(autoVerificarGitHubEnSegundoPlano, 2500);
        // Y revisar cada 3 minutos en segundo plano
        setInterval(autoVerificarGitHubEnSegundoPlano, 180000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountActiveBadge);
      } else {
        mountActiveBadge();
      }
    })();

