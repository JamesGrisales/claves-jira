  box-shadow:0 0 8px rgba(var(--card-neon-rgb), 0.35) !important;
  transition:all .2s ease !important;
}
:root[data-nav-style="rueda"] .nav-tabs a .nav-ic svg{
  width:14px !important;
  height:14px !important;
  stroke:var(--card-neon-color) !important;
  filter:drop-shadow(0 0 3px var(--card-neon-color)) !important;
}
:root[data-nav-style="rueda"] .nav-tabs a:hover .nav-ic{
  background:var(--card-neon-color) !important;
  border-color:#fff !important;
  box-shadow:0 0 16px var(--card-neon-color) !important;
}
:root[data-nav-style="rueda"] .nav-tabs a:hover .nav-ic svg{
  stroke:#070a12 !important;
  filter:drop-shadow(0 0 2px #fff) !important;
}

/* Texto de la tarjeta (Título en mayúsculas + Subtítulo con descripción) */
:root[data-nav-style="rueda"] .nav-tabs a .nav-txt{
  display:flex !important;
