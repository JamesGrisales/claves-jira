        if (q) vis.sort(function(a, b){ return b.s - a.s; });
        if (sel >= vis.length) sel = 0;
        if (!vis.length) { list.innerHTML = '<div class="cmdk-empty">Nada coincide con «' + esc(inp.value.trim()) + '».<br>Prueba con otra palabra.</div>'; return; }
        var h = '', g = '';
        vis.forEach(function(it, n){
          if (!q && it.g !== g) { g = it.g; h += '<div class="cmdk-group">' + esc(g) + '</div>'; }
          h += '<div class="cmdk-item" role="option" id="ck' + n + '" data-n="' + n + '"><span class="ci' + (it.dot ? ' dot' : '') + '"' + (it.dot ? ' style="background:' + it.dot + '"' : '') + '>' + (it.i || '') + '</span><span class="ct">' + resaltar(it.t, q) + '</span>' + (it.tag ? '<span class="ctag">' + esc(it.tag) + '</span>' : '') + '</div>';
