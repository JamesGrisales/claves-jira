.topbar-right{ display:flex; align-items:center; margin-left:auto; }
html.sb-off:root[data-nav-style="oculto"] .topbar-left{ margin-left:110px; }
.clock{ display:inline-flex; align-items:center; gap:12px; padding:6px 18px 6px 8px; border-radius:999px; background:var(--panel); border:1px solid var(--panel-edge); box-shadow:var(--shadow); color:var(--text); }
.clock svg.face{ width:34px; height:34px; flex-shrink:0; }
.clock .ring{ fill:var(--accent-soft); stroke:var(--accent); stroke-width:1.8; }
.clock .tick{ stroke:var(--accent); stroke-width:1.8; stroke-linecap:round; }
.clock .hand{ stroke:var(--text); stroke-linecap:round; } .clock .hand.s{ stroke:var(--accent); stroke-width:1.2; } .clock .pin{ fill:var(--accent); }
.clock-txt{ display:flex; align-items:center; gap:12px; min-width:0; line-height:1.1; }
.clock-time{ font-size:17px; font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; display:flex; align-items:baseline; gap:1px; white-space:nowrap; }
.clock-time i{ font-style:normal; animation:parpadeo 1s steps(2,jump-none) infinite; }
@keyframes parpadeo{ 50%{ opacity:.25; } }
.clock-time small{ font-size:10.5px; font-weight:700; margin-left:5px; color:var(--muted); letter-spacing:.03em; }
.clock-date{ font-size:12.5px; font-weight:500; color:var(--muted); padding-left:12px; border-left:1px solid var(--panel-edge); white-space:nowrap; }
body.guest .clock{ margin-right:0; }
@media (max-width:900px){ .topbar{ margin-top:-6px; } }
@media (max-width:580px){
  .topbar{ flex-direction:column; align-items:stretch; gap:10px; }
  .topbar-right{ justify-content:flex-end; }
  .clock-date{ display:none; }
  .clock{ padding-right:14px; }
  html.sb-off:root[data-nav-style="oculto"] .topbar-left{ margin-left:0; margin-top:42px; }
}

/* ---------- CUENTA DE USUARIO (menú lateral) ---------- */
body:not(.guest) .nav-account{ gap:10px; padding-top:14px; }
.user-card{
  display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:14px; min-width:0;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(var(--accent-rgb), .45);
  box-shadow:0 0 16px -2px rgba(var(--accent-rgb), .38), inset 0 1px 0 rgba(255,255,255,.15);
  transition:border-color .2s ease, box-shadow .25s ease, background-color .2s ease, transform .2s var(--ease);
}
.user-card:hover{
  border-color:var(--accent);
  background:rgba(var(--accent-rgb), .16);
  box-shadow:0 0 22px 2px rgba(var(--accent-rgb), .65), inset 0 1px 0 rgba(255,255,255,.25);
  transform:translateY(-1px);
}
:root[data-theme="oled"] .user-card{
  background:rgba(255,255,255,.04);
  border-color:rgba(var(--accent-rgb), .55);
  box-shadow:0 0 18px -2px rgba(var(--accent-rgb), .45);
}
:root[data-theme="oled"] .user-card:hover{
  border-color:var(--accent);
  box-shadow:0 0 24px 3px rgba(var(--accent-rgb), .75);
}
.user-card .avatar{
  width:38px; height:38px; font-size:16px; border-radius:12px; flex-shrink:0;
  background:rgba(var(--accent-rgb), .20);
  border:1.5px solid var(--accent);
  color:#fff;
  box-shadow:0 0 14px 1px rgba(var(--accent-rgb), .6), inset 0 1px 0 rgba(255,255,255,.3);
  transition:transform .25s var(--spring), box-shadow .25s ease, color .2s ease;
}
.user-card:hover .avatar{
  transform:scale(1.08) rotate(-4deg);
  background:var(--grad);
  color:#fff;
  border-color:rgba(255,255,255,.6);
  box-shadow:0 0 22px 3px rgba(var(--accent-rgb), .85);
}
body:not(.guest) .nav-account .user-card .avatar{
  background:rgba(var(--accent-rgb), .22);
  border:1.5px solid var(--accent);
  color:#fff;
  box-shadow:0 0 14px 1px rgba(var(--accent-rgb), .6);
}
.user-card .who{ min-width:0; }
.user-card b{ display:block; color:#fff; font-size:14px; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-shadow:0 1px 3px rgba(0,0,0,0.8); }
.user-card small{ display:flex; align-items:center; gap:6px; margin-top:2px; font-size:11.5px; color:rgba(255,255,255,.85); }
.user-card small::before{ content:''; width:7px; height:7px; border-radius:50%; background:#4ade80; box-shadow:0 0 0 2px rgba(74,222,128,.35), 0 0 10px #4ade80, 0 0 18px #4ade80; }
.acc-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.nav-account .acc-btn{
  display:flex; flex-direction:column; align-items:center; gap:7px; padding:12px 6px 10px; border-radius:12px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(var(--accent-rgb), .38);
  box-shadow:0 0 12px -2px rgba(var(--accent-rgb), .3);
  font-size:12px; font-weight:600; line-height:1.2; text-align:center; color:#fff; text-shadow:0 1px 2px rgba(0,0,0,0.85);
  transition:background-color .15s ease, transform .2s var(--spring), border-color .15s ease, box-shadow .2s ease;
}
.nav-account .acc-btn svg{
  width:19px; height:19px; fill:none; stroke:var(--accent); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;
  filter:drop-shadow(0 0 6px rgba(var(--accent-rgb), .75));
  transition:transform .2s var(--spring), stroke .15s ease, filter .2s ease;
}
.nav-account .acc-btn:hover{
  background:rgba(var(--accent-rgb), .20); border-color:var(--accent); color:#fff; transform:translateY(-2px);
  box-shadow:0 0 20px 2px rgba(var(--accent-rgb), .7);
}
.nav-account .acc-btn:hover svg{ stroke:#fff; transform:scale(1.1); filter:drop-shadow(0 0 8px var(--accent)) drop-shadow(0 0 3px #fff); }
.acc-foot{ display:flex; align-items:center; gap:8px; }
.nav-account .acc-out{ flex:1; display:flex; align-items:center; justify-content:center; gap:8px; padding:9px 10px; border-radius:11px; font-size:13px; font-weight:700; color:#ffd7de; background:rgba(225,29,72,.16); border:1px solid rgba(251,113,133,.5); box-shadow:0 0 14px -2px rgba(225,29,72,.45); transition:all .2s ease; text-shadow:0 1px 2px rgba(0,0,0,0.8); }
.nav-account .acc-out svg{ width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 0 6px rgba(251,113,133,.8)); }
.nav-account .acc-out:hover{ background:#e11d48; color:#fff; border-color:#e11d48; box-shadow:0 0 22px 3px rgba(225,29,72,.85); transform:translateY(-1px); }



/* ---------- 7) PANEL DE APARIENCIA ---------- */
.pal-panel{ display:none; position:fixed; z-index:750; width:330px; max-height:85vh; overflow-y:auto; scrollbar-width:thin; padding:16px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:16px; box-shadow:var(--shadow-lg); left:calc(var(--sb-w) + 10px); bottom:14px; }
.pal-panel.open{ display:block; animation:panelIn .2s var(--ease); }
body.guest .pal-panel{ left:50%; transform:translateX(-50%); right:auto; bottom:auto; top:75px; }
.pal-panel h4{ margin:0 0 2px; font-size:15px; font-weight:800; }
.pal-panel .hint{ margin:0 0 12px; font-size:12px; color:var(--muted); }
.pal-sec{ margin:14px 0 8px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
.seg{ display:grid; grid-template-columns:repeat(3,1fr); gap:4px; padding:4px; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:11px; }
.seg button.plain{ padding:7px 4px; border-radius:8px; font-size:12.5px; font-weight:600; color:var(--muted); display:flex; align-items:center; justify-content:center; gap:5px; transition:background-color .15s ease, color .15s ease; }
.seg button.plain:hover{ color:var(--text); }
.seg button.plain.on{ background:var(--panel); color:var(--accent-dark); box-shadow:0 1px 4px rgba(15,27,51,.14); }


/* =====================================================================
   MODO 6: DOCK FLOTANTE CYBER-GLASSMORPHIC (Estilo macOS + HUD Sci-Fi)
   ===================================================================== */
:root[data-nav-style="cyber-dock"] body:not(.guest) {
  padding: 22px 24px 105px 24px !important;
}
:root[data-nav-style="cyber-dock"] #sbOpen { display: none !important; }
:root[data-nav-style="cyber-dock"] .sb-backdrop { display: none !important; }

/* El navbar se convierte en una cápsula horizontal flotante en la parte inferior */
:root[data-nav-style="cyber-dock"] body:not(.guest) .navbar {
  position: fixed !important;
  bottom: 16px !important;
  left: 50% !important;
  top: auto !important;
  right: auto !important;
  transform: translateX(-50%) !important;
  width: auto !important;
  min-width: 320px !important;
  max-width: min(1100px, 96vw) !important;
  height: 64px !important;
  padding: 6px 14px !important;
  border-radius: 24px !important;
  background: rgba(9, 14, 25, 0.78) !important;
  backdrop-filter: blur(28px) saturate(2.0) !important;
  -webkit-backdrop-filter: blur(28px) saturate(2.0) !important;
  border: 1px solid rgba(var(--accent-rgb), 0.45) !important;
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.75), 0 0 30px rgba(var(--accent-rgb), 0.22), inset 0 1px 0 rgba(255,255,255,0.2) !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 6px !important;
  z-index: 450 !important;
  overflow: visible !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  transition: all 0.3s cubic-bezier(0.34, 1.3, 0.64, 1) !important;
}

:root[data-nav-style="cyber-dock"] .navbar:hover {
  border-color: var(--accent) !important;
  box-shadow: 0 20px 55px rgba(0, 0, 0, 0.85), 0 0 40px rgba(var(--accent-rgb), 0.35), inset 0 1px 0 rgba(255,255,255,0.3) !important;
}

/* Ocultar elementos innecesarios en el dock horizontal para mantenerlo limpio */
:root[data-nav-style="cyber-dock"] .brand,
:root[data-nav-style="cyber-dock"] .cmd-trigger,
:root[data-nav-style="cyber-dock"] .sb-close,
:root[data-nav-style="cyber-dock"] .user-card,
:root[data-nav-style="cyber-dock"] .acc-actions {
  display: none !important;
}

:root[data-nav-style="cyber-dock"] .nav-account {
  border: none !important;
  padding: 0 0 0 6px !important;
  margin: 0 0 0 4px !important;
  border-left: 1px solid rgba(255,255,255,0.12) !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 4px !important;
}

:root[data-nav-style="cyber-dock"] .acc-foot {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 4px !important;
}

:root[data-nav-style="cyber-dock"] .acc-out {
  width: 36px !important;
  height: 36px !important;
  border-radius: 12px !important;
  padding: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}
:root[data-nav-style="cyber-dock"] .acc-out span { display: none !important; }

/* Contenedor horizontal de pestañas */
:root[data-nav-style="cyber-dock"] .nav-tabs {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 4px !important;
  overflow-x: auto !important;
  overflow-y: visible !important;
  padding: 4px 2px !important;
  scrollbar-width: none !important;
}
:root[data-nav-style="cyber-dock"] .nav-tabs::-webkit-scrollbar { display: none !important; }

/* Icono individual en el Cyber-Dock con física de lupa (magnification) */
:root[data-nav-style="cyber-dock"] .nav-tabs a {
  position: relative !important;
  width: 44px !important;
  height: 44px !important;
  border-radius: 14px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: rgba(255, 255, 255, 0.04) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  padding: 0 !important;
  color: var(--text) !important;
  text-decoration: none !important;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.18s ease, border-color 0.18s ease, box-shadow 0.22s ease !important;
  flex-shrink: 0 !important;
}

:root[data-nav-style="cyber-dock"] .nav-tabs a .nav-txt {
  display: none !important;
}

:root[data-nav-style="cyber-dock"] .nav-tabs a .nav-ic {
  width: 22px !important;
  height: 22px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}
:root[data-nav-style="cyber-dock"] .nav-tabs a .nav-ic svg {
  width: 20px !important;
  height: 20px !important;
}

/* Efecto Lupa al posar el cursor sobre cada icono */
:root[data-nav-style="cyber-dock"] .nav-tabs a:hover {
  transform: translateY(-8px) scale(1.28) !important;
  z-index: 100 !important;
  background: rgba(var(--accent-rgb), 0.22) !important;
  border-color: var(--accent) !important;
  box-shadow: 0 12px 24px rgba(0,0,0,0.5), 0 0 18px var(--accent) !important;
}

:root[data-nav-style="cyber-dock"] .nav-tabs a.active {
  background: rgba(var(--accent-rgb), 0.18) !important;
  border-color: rgba(var(--accent-rgb), 0.7) !important;
  box-shadow: 0 0 14px rgba(var(--accent-rgb), 0.4) !important;
}

/* Micro-LED de telemetría inferior indicando pestaña activa */
:root[data-nav-style="cyber-dock"] .nav-tabs a.active::after {
  content: '' !important;
  position: absolute !important;
  bottom: 2px !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  width: 5px !important;
  height: 5px !important;
  border-radius: 50% !important;
  background: var(--accent) !important;
  box-shadow: 0 0 8px var(--accent), 0 0 14px var(--accent) !important;
}

/* Orbe de base de datos fijado en la esquina superior del icono */
:root[data-nav-style="cyber-dock"] .nav-tabs a .nav-db-side {
  position: absolute !important;
  top: -3px !important;
  right: -3px !important;
  width: 17px !important;
  height: 17px !important;
  font-size: 9.5px !important;
  border-radius: 50% !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.6) !important;
  border: 1px solid rgba(255,255,255,0.4) !important;
  z-index: 5 !important;
}

/* Tooltip elegante arriba del icono */
:root[data-nav-style="cyber-dock"] .nav-tabs a::before {
  content: attr(data-title) !important;
  position: absolute !important;
  bottom: calc(100% + 12px) !important;
  left: 50% !important;
  transform: translateX(-50%) translateY(4px) !important;
  padding: 4px 10px !important;
  border-radius: 8px !important;
  background: rgba(8, 14, 26, 0.94) !important;
  border: 1px solid rgba(var(--accent-rgb), 0.5) !important;
  color: #fff !important;
  font-family: var(--sans) !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.02em !important;
  white-space: nowrap !important;
  pointer-events: none !important;
  opacity: 0 !important;
  box-shadow: 0 8px 20px rgba(0,0,0,0.6), 0 0 12px rgba(var(--accent-rgb), 0.3) !important;
  transition: opacity 0.18s ease, transform 0.18s ease !important;
  z-index: 200 !important;
}
:root[data-nav-style="cyber-dock"] .nav-tabs a:hover::before {
  opacity: 1 !important;
  transform: translateX(-50%) translateY(0) !important;
}


