      var pal = $('palBtn');
      if (pal) attachPopover(pal, 'Apariencia y Colores', 'Elige tu paleta favorita');

      // Botón de alternar menú
      var sbc = $('sbClose');
      if (sbc) attachPopover(sbc, function(){ return root.classList.contains('sb-off') ? 'Expandir menú' : 'Ocultar menú'; }, '');

      document.addEventListener('scroll', function(){ navPop.classList.remove('show'); }, { passive:true });
    })();

    /* ----- Manejador de Motor de Base de Datos y Paleta Global ----- */
    (function(){
      var ENGINES = {
        postgres:  { name:'PostgreSQL 16', icon:'🐘', cls:'db-orb-pg', c1:'#00f5ff', c2:'#0284c7', rgb:'0, 245, 255' },
        oracle:    { name:'Oracle Enterprise', icon:'🏛️', cls:'db-orb-ora', c1:'#f59e0b', c2:'#d97706', rgb:'245, 158, 11' },
        sqlserver: { name:'SQL Server', icon:'🟦', cls:'db-orb-sql', c1:'#3b82f6', c2:'#1d4ed8', rgb:'59, 130, 246' },
        mysql:     { name:'MySQL / MariaDB', icon:'🐬', cls:'db-orb-my', c1:'#06b6d4', c2:'#0284c7', rgb:'6, 182, 212' },
        mongodb:   { name:'MongoDB Document', icon:'🍃', cls:'db-orb-mg', c1:'#10b981', c2:'#059669', rgb:'16, 185, 129' },
        redis:     { name:'Redis Cache', icon:'⚡', cls:'db-orb-rd', c1:'#ef4444', c2:'#b91c1c', rgb:'239, 68, 68' },
        sqlite:    { name:'SQLite Embedded', icon:'💾', cls:'db-orb-sqlite', c1:'#a855f7', c2:'#7c3aed', rgb:'168, 85, 247' }
      };

      var ENGINE_CLASSES = ['db-orb-pg', 'db-orb-ora', 'db-orb-sql', 'db-orb-my', 'db-orb-mg', 'db-orb-rd', 'db-orb-sqlite'];

      function actualizarOrbeElemento(orb, eng) {
        orb.textContent = eng.icon;
        ENGINE_CLASSES.forEach(function(c) { orb.classList.remove(c); });
        orb.classList.add(eng.cls);
        orb.title = 'Motor Activo: ' + eng.name;
      }

      window.setDbEngine = function(engineId) {
        var eng = ENGINES[engineId] || ENGINES.postgres;
        root.setAttribute('data-db-engine', engineId);
        root.style.setProperty('--p1', eng.c1);
        root.style.setProperty('--p2', eng.c2);
        root.style.setProperty('--accent-rgb', eng.rgb);
        store('boveda_db_engine', engineId);
        store('boveda_login_theme', engineId);

        var topOrb = $('topbarEngineOrb');
        var topName = $('topbarEngineName');
        if (topOrb) {
          actualizarOrbeElemento(topOrb, eng);
          topOrb.classList.add('db-orb-lg');
        }
        if (topName) topName.textContent = eng.name;

        document.querySelectorAll('.tbm-item').forEach(function(item) {
          item.classList.toggle('active', item.dataset.enginePick === engineId);
        });

        // Actualizar absolutamente TODOS los orbes de la interfaz (tablas, filas, menús, headers, modales)
        var orbs = document.querySelectorAll('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)');
        orbs.forEach(function(orb) {
          actualizarOrbeElemento(orb, eng);
        });
      };

      // Observador de mutaciones para asegurar que cualquier fila o modal nuevo tome el motor activo
      if (window.MutationObserver) {
        var orbObserver = new MutationObserver(function(muts) {
          var cur = localStorage.getItem('boveda_db_engine') || 'postgres';
          var eng = ENGINES[cur] || ENGINES.postgres;
          muts.forEach(function(m) {
            m.addedNodes.forEach(function(n) {
              if (n.nodeType === 1) {
                if (n.matches && n.matches('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)')) {
                  actualizarOrbeElemento(n, eng);
                }
                if (n.querySelectorAll) {
                  n.querySelectorAll('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)').forEach(function(orb) {
                    actualizarOrbeElemento(orb, eng);
                  });
                }
              }
            });
          });
        });
        orbObserver.observe(document.documentElement, { childList: true, subtree: true });
      }

      var curEng = localStorage.getItem('boveda_db_engine') || 'postgres';
      window.setDbEngine(curEng);

      var dbDrop = $('topbarDbDropdown');
      var dbBtn = $('btnTopbarDb');
      var dbMenu = $('topbarDbMenu');
      if (dbBtn && dbDrop) {
        dbBtn.addEventListener('click', function(e){
          e.stopPropagation();
          dbDrop.classList.toggle('open');
        });
        document.addEventListener('click', function(e){
          if (!dbDrop.contains(e.target)) dbDrop.classList.remove('open');
        });
      }
      if (dbMenu) {
        dbMenu.addEventListener('click', function(e){
          var item = e.target.closest('.tbm-item');
          if (!item) return;
          var pick = item.dataset.enginePick;
          if (pick) {
            window.setDbEngine(pick);
            if (dbDrop) dbDrop.classList.remove('open');
            aviso((ENGINES[pick] ? ENGINES[pick].icon + ' ' + ENGINES[pick].name : pick) + ' activado');
          }
        });
      }
    })();
  })();
  </script>
<% if (currentUser) { %><script src="/persistir.js"></script><% } %>
<% if (currentUser) { %><%- include('asistente-widget') %><% } %>
<% if (currentUser) { %><%- include('recordatorios-widget') %><% } %>

</body>
</html>
