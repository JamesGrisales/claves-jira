/* ==========================================================================
   ORBES Y MICRO-INSIGNIAS 3D ILUMINADAS DE MOTORES DE BD (SIN TEXTO)
   ========================================================================== */
.db-orb {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 9px;
  position: relative;
  font-size: 15px;
  line-height: 1;
  cursor: pointer;
  user-select: none;
  vertical-align: middle;
  transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 1px solid transparent;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.db-orb-lg {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  font-size: 18px;
}

.db-orb-sm {
  width: 22px;
  height: 22px;
  border-radius: 7px;
  font-size: 12px;
}

/* Efecto de resplandor neón pulsante */
@keyframes dbOrbPulse {
  0%, 100% {
    box-shadow: 0 0 10px var(--orb-glow), inset 0 0 7px var(--orb-inner);
    filter: drop-shadow(0 0 4px var(--orb-glow));
  }
  50% {
    box-shadow: 0 0 20px var(--orb-glow), 0 0 32px var(--orb-glow-soft), inset 0 0 11px var(--orb-inner);
    filter: drop-shadow(0 0 8px var(--orb-glow));
  }
}

.db-orb {
  animation: dbOrbPulse 3.5s ease-in-out infinite;
}

