/* Efecto hover sobre cualquier tarjeta */
:root[data-nav-style="rueda"] .nav-tabs a:hover{
  transform:translateX(8px) scale(1.02) !important;
  background:rgba(var(--card-neon-rgb), 0.22) !important;
  border-color:#ffffff !important;
  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.75),
    0 0 30px var(--card-neon-color),
    0 0 55px rgba(var(--card-neon-rgb), 0.4),
    inset 0 0 14px rgba(var(--card-neon-rgb), 0.45) !important;
}
:root[data-nav-style="rueda"] .nav-tabs a:hover::before{
  background:#ffffff !important;
  box-shadow:0 0 14px #ffffff, 0 0 30px var(--card-neon-color) !important;
  height:3px !important;
}
:root[data-nav-style="rueda"] .nav-tabs a:hover::after{
  transform:translateY(-50%) scale(1.5) !important;
  box-shadow:0 0 16px #ffffff, 0 0 35px var(--card-neon-color) !important;
}

/* Tarjeta activa */
:root[data-nav-style="rueda"] .nav-tabs a.active{
  background:rgba(var(--card-neon-rgb), 0.32) !important;
  border-color:#ffffff !important;
  box-shadow:
    0 0 28px var(--card-neon-color),
    0 0 60px rgba(var(--card-neon-rgb), 0.6),
    inset 0 0 16px rgba(255, 255, 255, 0.4) !important;
}
:root[data-nav-style="rueda"] .nav-tabs a.active::before{
  background:var(--card-neon-color) !important;
  height:3px !important;
  box-shadow:0 0 14px var(--card-neon-color) !important;
}
:root[data-nav-style="rueda"] .nav-tabs a.active::after{
  transform:translateY(-50%) scale(1.3) !important;
  box-shadow:0 0 14px #fff, 0 0 25px var(--card-neon-color) !important;
}

/* Icono dentro de la tarjeta */
:root[data-nav-style="rueda"] .nav-tabs a .nav-ic{
  width:26px !important;
  height:26px !important;
  margin:0 !important;
  border-radius:7px !important;
  background:rgba(var(--card-neon-rgb), 0.18) !important;
  border:1px solid var(--card-neon-color) !important;
  color:#fff !important;
  flex-shrink:0 !important;
  display:flex !important;
  align-items:center !important;
