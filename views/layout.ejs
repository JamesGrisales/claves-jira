  <script>
    /* =====================================================================
       LÓGICA DEL ACTUALIZADOR AUTOMÁTICO DESDE GITHUB
       ===================================================================== */
    (function(){
      function initGitUpdater(){
        var btn = document.getElementById('btnGitUpdate');
        var modal = document.getElementById('modalGitUpdate');
        var hud = document.getElementById('hudActualizando');
        if (!btn) return;

        var bguTxt = document.getElementById('bguTxt');
        var bguBadge = document.getElementById('bguBadge');

        var modalIcon = document.getElementById('modalGitIcon');
        var modalTitle = document.getElementById('modalGitTitle');
        var modalSubtitle = document.getElementById('modalGitSubtitle');

        var viewPending = document.getElementById('gitViewPending');
        var viewUpToDate = document.getElementById('gitViewUpToDate');
        var viewError = document.getElementById('gitViewError');
        var footPending = document.getElementById('gitFootPending');
        var footUpToDate = document.getElementById('gitFootUpToDate');
        var footError = document.getElementById('gitFootError');
        var errorText = document.getElementById('gitErrorText');

        function abrirModal(){
          if (!modal) return;
          modal.style.display = 'flex';
          modal.classList.add('open');
          modal.classList.add('show');
          document.body.style.overflow = 'hidden';
        }
        function cerrarModal(){
          if (!modal) return;
          modal.style.display = 'none';
          modal.classList.remove('open');
          modal.classList.remove('show');
          document.body.style.overflow = '';
        }

        var btnClose = document.getElementById('btnCloseModalGit');
        var btnCancel = document.getElementById('btnCancelGitUpdate');
        var btnOk = document.getElementById('btnOkGitUpdate');
        var btnErrClose = document.getElementById('btnErrorClose');
        if (btnClose) btnClose.addEventListener('click', cerrarModal);
        if (btnCancel) btnCancel.addEventListener('click', cerrarModal);
        if (btnOk) btnOk.addEventListener('click', cerrarModal);
        if (btnErrClose) btnErrClose.addEventListener('click', cerrarModal);

        if (modal) {
          modal.addEventListener('click', function(e){
            if (e.target === modal) cerrarModal();
          });
        }

        // 1. Clic en "Bajar Cambios": consulta GitHub
        btn.addEventListener('click', function(){
          if (btn.classList.contains('bgu-checking')) return;

          btn.classList.add('bgu-checking');
          if (bguTxt) bguTxt.textContent = 'Buscando...';

          fetch('/api/sistema/verificar-actualizacion')
            .then(function(res){ return res.json(); })
            .then(function(data){
              btn.classList.remove('bgu-checking');
              if (bguTxt) bguTxt.textContent = 'Bajar Cambios';

              if (!data.ok) {
                // Estado Error
                if (modalIcon) modalIcon.textContent = '⚠️';
                if (modalTitle) modalTitle.textContent = 'Consulta de Actualizaciones';
                if (modalSubtitle) modalSubtitle.textContent = 'No se pudo verificar el repositorio en este momento';
                if (errorText) errorText.textContent = data.error || 'No se pudo conectar con GitHub. Verifica tu conexión a internet.';
                if (viewPending) viewPending.style.display = 'none';
                if (viewUpToDate) viewUpToDate.style.display = 'none';
                if (viewError) viewError.style.display = 'block';
                if (footPending) footPending.style.display = 'none';
                if (footUpToDate) footUpToDate.style.display = 'none';
                if (footError) footError.style.display = 'flex';
                abrirModal();
                if (typeof window.aviso === 'function') window.aviso('Aviso: ' + (data.error || 'No se pudo conectar con GitHub'));
                return;
              }

              if (!data.hayCambios || data.numCambios === 0) {
                // Estado: Al día (0 cambios)
                if (bguBadge) bguBadge.style.display = 'none';
                if (modalIcon) modalIcon.textContent = '✨';
                if (modalTitle) modalTitle.textContent = 'Sistema al Día (' + (data.version ? 'v' + data.version : '<%= typeof appVersion !== "undefined" ? appVersion : "v2.9.1" %>') + (data.commit ? ' · ' + data.commit : '') + ')';
                if (modalSubtitle) modalSubtitle.textContent = 'No existen versiones o cambios nuevos disponibles';
                if (viewPending) viewPending.style.display = 'none';
                if (viewUpToDate) viewUpToDate.style.display = 'block';
                if (viewError) viewError.style.display = 'none';
                if (footPending) footPending.style.display = 'none';
                if (footUpToDate) footUpToDate.style.display = 'flex';
                if (footError) footError.style.display = 'none';
                abrirModal();
                if (typeof window.aviso === 'function') window.aviso('✨ Tu sistema ya está al día con la última versión');
                return;
              }

              // Estado: Hay cambios pendientes
              if (bguBadge) {
                bguBadge.textContent = data.numCambios;
                bguBadge.style.display = 'inline-block';
              }
              if (modalIcon) modalIcon.textContent = '🚀';
              if (modalTitle) modalTitle.textContent = 'Nueva Versión Lista en GitHub';
              if (modalSubtitle) modalSubtitle.textContent = 'Descarga e instala la nueva versión con 1 solo clic';
              if (viewPending) viewPending.style.display = 'block';
              if (viewUpToDate) viewUpToDate.style.display = 'none';
              if (viewError) viewError.style.display = 'none';
              if (footPending) footPending.style.display = 'flex';
              if (footUpToDate) footUpToDate.style.display = 'none';
              if (footError) footError.style.display = 'none';

              var cnt = document.getElementById('gitCommitsCount');
              if (cnt) cnt.textContent = data.numCambios;
              var br = document.getElementById('gitBranchName');
              if (br) br.textContent = data.branch || 'main';

              var listHtml = '';
              (data.commits || []).forEach(function(c){
                listHtml += '<div class="git-commit-item"><span class="gci-dot"></span><span class="gci-txt">' + (c || '').replace(/[&<>"']/g, '') + '</span></div>';
              });
              var cList = document.getElementById('gitCommitsList');
              if (cList) cList.innerHTML = listHtml || '<div style="color:var(--muted); font-size:12px;">Mejoras listas para descargar.</div>';

              abrirModal();
            })
            .catch(function(err){
              btn.classList.remove('bgu-checking');
              if (bguTxt) bguTxt.textContent = 'Bajar Cambios';
              if (modalIcon) modalIcon.textContent = '⚠️';
              if (modalTitle) modalTitle.textContent = 'Error de Conexión';
              if (modalSubtitle) modalSubtitle.textContent = 'No se pudo comunicar con el servicio';
              if (errorText) errorText.textContent = 'Error al consultar GitHub: ' + err.message;
              if (viewPending) viewPending.style.display = 'none';
              if (viewUpToDate) viewUpToDate.style.display = 'none';
              if (viewError) viewError.style.display = 'block';
              if (footPending) footPending.style.display = 'none';
              if (footUpToDate) footUpToDate.style.display = 'none';
              if (footError) footError.style.display = 'flex';
              abrirModal();
            });
        });

        // 2. Confirmar e instalar: activa el HUD y llama al endpoint de reinicio
        var btnConfirm = document.getElementById('btnConfirmGitUpdate');
        if (btnConfirm) {
          btnConfirm.addEventListener('click', function(){
            cerrarModal();

            // Mostrar HUD de instalación en pantalla completa
            if (hud) {
              hud.style.display = 'flex';
              hud.classList.add('show');
              hud.classList.add('open');
            }
            document.body.style.overflow = 'hidden';

            // Disparar proceso en el servidor
            fetch('/api/sistema/ejecutar-actualizacion', { method: 'POST' })
              .then(function(res){ return res.json(); })
              .then(function(resData){
                setTimeout(iniciarMonitoreoReconexion, 2000);
              })
              .catch(function(err){
                setTimeout(iniciarMonitoreoReconexion, 2000);
              });
          });
        }

        function iniciarMonitoreoReconexion(){
          var intentos = 0;
          var maxIntentos = 60; // 60 intentos * 1.5s = 90 segundos máx
          var step1 = document.getElementById('haStep1');
          var step2 = document.getElementById('haStep2');
          var step3 = document.getElementById('haStep3');
          var msg = document.getElementById('hudActMsg');

          var pollTimer = setInterval(function(){
            intentos++;
            if (msg) msg.textContent = 'Verificando reinicio del servidor (segundo ' + Math.round(intentos * 1.5) + ')...';

            if (intentos === 3 && step1 && step2) {
              step1.classList.remove('active');
              step1.classList.add('done');
              step2.classList.add('active');
            }
            if (intentos === 6 && step2 && step3) {
              step2.classList.remove('active');
              step2.classList.add('done');
              step3.classList.add('active');
            }

            // Sondeo de salud al servidor con timestamp anticaché
            fetch('/api/health?_t=' + Date.now())
              .then(function(r){
                if (r.ok) return r.json();
                throw new Error('Servidor aún reiniciando');
              })
              .then(function(data){
                if (data && data.ok) {
                  clearInterval(pollTimer);
                  if (step3) {
                    step3.classList.remove('active');
                    step3.classList.add('done');
                  }
                  if (msg) msg.textContent = '¡Actualización completada! Redirigiendo al login...';
                  setTimeout(function(){
                    window.location.href = '/login?actualizado=1';
                  }, 1200);
                }
              })
              .catch(function(){
                // Servidor aún en proceso de reinicio o git pull, continuar esperando
                if (intentos >= maxIntentos) {
                  clearInterval(pollTimer);
                  if (msg) msg.innerHTML = 'El servidor está tardando más de lo habitual. Puedes intentar recargar la página manualmente haciendo <a href="/login" style="color:var(--accent); text-decoration:underline;">clic aquí</a>.';
                }
              });
          }, 1500);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGitUpdater);
      } else {
        initGitUpdater();
      }
    })();

    /* ---------- VERIFICADOR AUTOMÁTICO DE TURNO DE DISPONIBILIDAD ---------- */
    (function(){
      if (!window.fetch) return;
      fetch('/api/disponibilidad/estado').then(function(r){ return r.json(); }).then(function(d){
        if (d && d.ok && d.enDisponibilidad && d.turno) {
          var t = d.turno;
          var bHeaders = document.querySelectorAll('.badge-disp-header');
          bHeaders.forEach(function(bh){
            bh.style.display = 'inline-flex';
            bh.onclick = function(){ mostrarModalDisp(t); };
          });
        }
      }).catch(function(){});

      function mostrarModalDisp(t) {
        var m = document.getElementById('modalDisponibilidadLogin');
        if (!m) return;
        var pIni = t.inicio.split('-'), pFin = t.fin.split('-');
        var meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
        var txtFechas = 'Del ' + (+pIni[2]) + ' de ' + meses[+pIni[1]-1] + ' al ' + (+pFin[2]) + ' de ' + meses[+pFin[1]-1] + ' de ' + pFin[0];
        var elF = document.getElementById('dispModalFechas');
        if (elF) elF.textContent = txtFechas;
        var elU = document.getElementById('dispModalUsuario');
        if (elU && t.usuario) elU.textContent = 'Turno oficial: ' + t.usuario + (t.celular ? ' · Cel: ' + t.celular : '');
        m.style.display = 'flex';
      }

      var btn = document.getElementById('btnConfirmarDisponibilidad');
      if (btn) {
        btn.addEventListener('click', function(){
          var m = document.getElementById('modalDisponibilidadLogin');
          if (m) m.style.display = 'none';
          sessionStorage.setItem('aviso_disponibilidad_mostrado', '1');
        });
      }
    })();

  </script>
</body>
</html>
