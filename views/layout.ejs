:root[data-nav-style="dock"] .nav-account .acc-out{ flex-shrink:0 !important; width:46px !important; height:40px !important; padding:0 !important; justify-content:center !important; border-radius:12px !important; border:none !important; box-shadow:0 4px 12px rgba(225,29,72,0.25), inset 0 1px 0 rgba(255,255,255,0.18) !important; flex:initial !important; }
:root[data-nav-style="dock"] .nav-account .acc-out span{ display:none !important; }
:root[data-nav-style="dock"] .acc-tools{ flex-shrink:0 !important; display:flex !important; gap:6px !important; }
:root[data-nav-style="dock"] .acc-tools .theme-toggle{ width:34px !important; height:34px !important; border-radius:11px !important; border:none !important; background:rgba(255, 255, 255, 0.06) !important; box-shadow:0 3px 10px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.15) !important; }
:root[data-nav-style="dock"] .pal-panel{ left:92px !important; bottom:16px !important; }

:root[data-nav-style="dock"] body:not(.guest) .navbar:hover .nav-account,
:root[data-nav-style="dock"] body:not(.guest) .navbar.expanded .nav-account{
  align-items:stretch !important; padding-top:12px !important; border-top:1px solid rgba(255,255,255,.10) !important;
