        neovim:    { name:'Neovim / Vim', icon:'🟢', cls:'db-orb-nvim', c1:'#22c55e', c2:'#15803d', rgb:'34, 197, 94' },
        python:    { name:'Python', icon:'🐍', cls:'db-orb-py', c1:'#eab308', c2:'#2563eb', rgb:'234, 179, 8' },
        javascript:{ name:'JavaScript / Node', icon:'🟨', cls:'db-orb-js', c1:'#facc15', c2:'#ca8a04', rgb:'250, 204, 21' },
        java:      { name:'Java JVM', icon:'☕', cls:'db-orb-java', c1:'#f97316', c2:'#c2410c', rgb:'249, 115, 22' },
        rust:      { name:'Rust Systems', icon:'🦀', cls:'db-orb-rust', c1:'#ea580c', c2:'#9a3412', rgb:'234, 88, 12' },
        golang:    { name:'Go / Golang', icon:'🩵', cls:'db-orb-go', c1:'#38bdf8', c2:'#0284c7', rgb:'56, 189, 248' }
      };

      var ENGINE_CLASSES = [
        'db-orb-pg', 'db-orb-ora', 'db-orb-sql', 'db-orb-my', 'db-orb-mg', 'db-orb-rd', 'db-orb-sqlite',
        'db-orb-cas', 'db-orb-neo', 'db-orb-vsc', 'db-orb-nvim', 'db-orb-py', 'db-orb-js', 'db-orb-java', 'db-orb-rust', 'db-orb-go'
      ];

      function actualizarOrbeElemento(orb, eng) {
        orb.textContent = eng.icon;
        ENGINE_CLASSES.forEach(function(c) { orb.classList.remove(c); });
        orb.classList.add(eng.cls);
        orb.title = 'Motor Activo: ' + eng.name;
      }

      window.setDbEngine = function(engineId) {
        var eng = ENGINES[engineId] || ENGINES.postgres;
        root.setAttribute('data-db-engine', engineId);
        root.style.setProperty('--p1', eng.c1);
        root.style.setProperty('--p2', eng.c2);
        root.style.setProperty('--accent-rgb', eng.rgb);
        store('boveda_db_engine', engineId);
        store('boveda_login_theme', engineId);

        var topOrb = $('topbarEngineOrb');
        var topName = $('topbarEngineName');
        if (topOrb) {
          actualizarOrbeElemento(topOrb, eng);
          topOrb.classList.add('db-orb-lg');
        }
        if (topName) topName.textContent = eng.name;

        document.querySelectorAll('.tbm-item').forEach(function(item) {
          item.classList.toggle('active', item.dataset.enginePick === engineId);
        });

        // Actualizar absolutamente TODOS los orbes de la interfaz (tablas, filas, menús, headers, modales)
        var orbs = document.querySelectorAll('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)');
        orbs.forEach(function(orb) {
          actualizarOrbeElemento(orb, eng);
        });
      };

      // Observador de mutaciones para asegurar que cualquier fila o modal nuevo tome el motor activo
      if (window.MutationObserver) {
        var orbObserver = new MutationObserver(function(muts) {
          var cur = localStorage.getItem('boveda_db_engine') || 'postgres';
          var eng = ENGINES[cur] || ENGINES.postgres;
          muts.forEach(function(m) {
            m.addedNodes.forEach(function(n) {
              if (n.nodeType === 1) {
                if (n.matches && n.matches('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)')) {
                  actualizarOrbeElemento(n, eng);
                }
                if (n.querySelectorAll) {
                  n.querySelectorAll('.db-orb:not(#topbarDbMenu .db-orb):not(.db-orb-fixed)').forEach(function(orb) {
                    actualizarOrbeElemento(orb, eng);
                  });
                }
              }
            });
          });
        });
        orbObserver.observe(document.documentElement, { childList: true, subtree: true });
      }

      var curEng = localStorage.getItem('boveda_db_engine') || 'postgres';
      window.setDbEngine(curEng);

      var dbDrop = $('topbarDbDropdown');
      var dbBtn = $('btnTopbarDb');
      var dbMenu = $('topbarDbMenu');
      if (dbBtn && dbDrop) {
        dbBtn.addEventListener('click', function(e){
          e.stopPropagation();
          dbDrop.classList.toggle('open');
        });
        document.addEventListener('click', function(e){
          if (!dbDrop.contains(e.target)) dbDrop.classList.remove('open');
        });
      }
      if (dbMenu) {
        dbMenu.addEventListener('click', function(e){
          var item = e.target.closest('.tbm-item');
          if (!item) return;
          var pick = item.dataset.enginePick;
          if (pick) {
            window.setDbEngine(pick);
            if (dbDrop) dbDrop.classList.remove('open');
            aviso((ENGINES[pick] ? ENGINES[pick].icon + ' ' + ENGINES[pick].name : pick) + ' activado');
          }
        });
      }
    })();
  })();
  </script>
<% if (currentUser) { %><script src="/persistir.js">
    /* ===== MOTOR UNIVERSAL DE SELECTORES CYBERPUNK (CYBER-SELECT) ===== */
    (function initCyberSelects(){
      function enhance(selectEl){
        if (selectEl.dataset.cyberEnhanced === 'true') return;
        if (selectEl.multiple || selectEl.size > 1) return;

        selectEl.dataset.cyberEnhanced = 'true';
        selectEl.style.position = 'absolute';
        selectEl.style.opacity = '0';
        selectEl.style.pointerEvents = 'none';
        selectEl.style.width = '0';
        selectEl.style.height = '0';
        selectEl.style.overflow = 'hidden';

        var wrap = document.createElement('div');
        wrap.className = 'cyber-select-wrap';
        if (selectEl.id) wrap.setAttribute('data-target-id', selectEl.id);
        if (selectEl.className) {
          var extra = selectEl.className.replace('cyber-enhanced', '').trim();
          if (extra) wrap.className += ' ' + extra;
        }

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cyber-select-btn';
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.setAttribute('aria-expanded', 'false');

        var labelSpan = document.createElement('span');
        labelSpan.className = 'cs-label';

        var arrowSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        arrowSvg.setAttribute('class', 'cs-arrow');
        arrowSvg.setAttribute('viewBox', '0 0 24 24');
        arrowSvg.innerHTML = '<path d="m6 9 6 6 6-6"/>';

        btn.appendChild(labelSpan);
        btn.appendChild(arrowSvg);

        var menu = document.createElement('div');
        menu.className = 'cyber-select-menu';
        menu.setAttribute('role', 'listbox');

        function rebuildOptions(){
          menu.innerHTML = '';
          var opts = Array.from(selectEl.options);
          var selectedOpt = selectEl.options[selectEl.selectedIndex] || opts[0];
          labelSpan.textContent = selectedOpt ? selectedOpt.textContent : '--';

          opts.forEach(function(opt){
            var item = document.createElement('div');
            item.className = 'cs-option' + (opt.selected ? ' selected' : '');
            item.setAttribute('data-value', opt.value);
            item.setAttribute('role', 'option');

            var txt = document.createElement('span');
            txt.textContent = opt.textContent;

            var chk = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            chk.setAttribute('class', 'cs-check');
            chk.setAttribute('viewBox', '0 0 24 24');
            chk.innerHTML = '<polyline points="20 6 9 17 4 12"/>';

            item.appendChild(txt);
            item.appendChild(chk);

            item.addEventListener('click', function(e){
              e.stopPropagation();
              selectEl.value = opt.value;
              selectEl.dispatchEvent(new Event('change', { bubbles: true }));
              closeMenu();
            });

            menu.appendChild(item);
          });
        }

        rebuildOptions();

        function openMenu(){
          document.querySelectorAll('.cyber-select-wrap.open').forEach(function(w){
            if (w !== wrap) w.classList.remove('open');
          });
          wrap.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');

          var rect = wrap.getBoundingClientRect();
          var spaceBelow = window.innerHeight - rect.bottom;
          if (spaceBelow < 280 && rect.top > 280) {
            wrap.classList.add('opens-up');
          } else {
            wrap.classList.remove('opens-up');
          }
        }

        function closeMenu(){
          wrap.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', function(e){
          e.stopPropagation();
          if (wrap.classList.contains('open')) {
            closeMenu();
          } else {
            openMenu();
          }
        });

        selectEl.addEventListener('change', function(){
          var opts = Array.from(selectEl.options);
          var current = opts[selectEl.selectedIndex];
          if (current) labelSpan.textContent = current.textContent;
          menu.querySelectorAll('.cs-option').forEach(function(it){
            var isSel = it.getAttribute('data-value') === selectEl.value;
            it.classList.toggle('selected', isSel);
          });
        });

        var obs = new MutationObserver(function(){
          rebuildOptions();
        });
        obs.observe(selectEl, { childList: true, subtree: true });

        wrap.appendChild(btn);
        wrap.appendChild(menu);
        selectEl.parentNode.insertBefore(wrap, selectEl.nextSibling);
      }

      function scan(){
        var selects = document.querySelectorAll(
          '#sortEmpresas, .efb-select, #orden, #selArchivo, #horaFormato, #ticket, #sep, #comillas, #parent, #union, #porLinea, #fTipo, #fAvisar, #fRep, #indent, #rpAlcance, #lsSep, #lsComillas, #lsParent, #mxOp, select.cyber-select'
        );
        selects.forEach(enhance);
      }

      document.addEventListener('click', function(e){
        if (!e.target.closest('.cyber-select-wrap')) {
          document.querySelectorAll('.cyber-select-wrap.open').forEach(function(w){
            w.classList.remove('open');
            var b = w.querySelector('.cyber-select-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
      });

      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') {
          document.querySelectorAll('.cyber-select-wrap.open').forEach(function(w){
            w.classList.remove('open');
            var b = w.querySelector('.cyber-select-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scan);
      } else {
        scan();
      }

      // Re-escanear por si modales o vistas inyectan selects dinámicamente
      window.refreshCyberSelects = scan;
    })();

  </script><% } %>
