      var PALS = [['azul','Azul','#2563eb','#4f46e5'],['cian','Cian','#0891b2','#2563eb'],['esmeralda','Esmeralda','#059669','#0d9488'],['lima','Lima Matrix','#84cc16','#22c55e'],['atardecer','Atardecer','#ea580c','#db2777'],['rosa','Rosa','#db2777','#9333ea'],['violeta','Violeta','#7c3aed','#4f46e5'],['grafito','Grafito','#475569','#1e293b']];
