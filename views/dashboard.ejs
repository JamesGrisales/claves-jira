<%
  var ahora = Date.now();
  var mesesNombres = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  var diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
  var mesesCompletos = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

  function parseEmpMeta(c) {
    var f = c.updated_at ? new Date(c.updated_at) : null;
    if (!f || isNaN(f.getTime())) {
      return {
        estado: 'sin-fecha',
        dias: 9999,
        timestamp: 0,
        fechaCorta: 'Sin fecha',
        fechaLarga: 'Sin fecha registrada',
        badgePill: 'Sin fecha',
        tooltip: 'Último cambio de clave: Sin registro · Se recomienda cambiar la clave para iniciar el ciclo mensual de 30 días.'
      };
    }

    var ts = f.getTime();
    var ahoraDate = new Date(ahora);
    var hoyCal = new Date(ahoraDate.getFullYear(), ahoraDate.getMonth(), ahoraDate.getDate());
    var fechaCal = new Date(f.getFullYear(), f.getMonth(), f.getDate());
    var diffDias = Math.round((hoyCal.getTime() - fechaCal.getTime()) / (1000 * 60 * 60 * 24));
    var dias = Math.max(0, diffDias);

    var diaStr = String(f.getDate()).padStart(2, '0');
    var mesStr = mesesNombres[f.getMonth()];
    var anioStr = f.getFullYear();
    var fechaCorta = diaStr + ' ' + mesStr + ' ' + anioStr;

    var horas = f.getHours();
    var mins = String(f.getMinutes()).padStart(2, '0');
    var ampm = horas >= 12 ? 'PM' : 'AM';
    horas = horas % 12 || 12;
    var horaStr = String(horas).padStart(2, '0') + ':' + mins + ' ' + ampm;
    var fechaLarga = diasSemana[f.getDay()] + ', ' + f.getDate() + ' de ' + mesesCompletos[f.getMonth()] + ' de ' + anioStr + ' · ' + horaStr;

    var estado = 'vigente';
    var badgePill = '';
    var tooltip = '';

    if (dias > 30) {
      estado = 'vencida';
      var diasVencida = dias - 30;
      badgePill = '⛔ Vencida (+' + diasVencida + 'd)';
      tooltip = 'Último cambio de clave: ' + fechaLarga + ' · ¡Vencida hace ' + diasVencida + ' día(s)! Las contraseñas de Jira vencen cada mes (30 días). Requiere cambio urgente.';
    } else if (dias >= 25) {
      estado = 'por-vencer';
      var restan = 30 - dias;
      badgePill = '⚠️ Vence en ' + restan + (restan === 1 ? ' día' : ' días');
      tooltip = 'Último cambio de clave: ' + fechaLarga + ' · Próxima a vencer en ' + restan + ' día(s). Antigüedad: ' + dias + ' días.';
    } else {
      estado = 'vigente';
      var restan = 30 - dias;
      if (dias === 0) {
        badgePill = '🟢 Cambiada hoy';
        tooltip = 'Último cambio de clave: ' + fechaLarga + ' · Cambiada hoy mismo. Vigente por 30 días más.';
      } else if (dias === 1) {
        badgePill = '🟢 Ayer · Vence en 29d';
        tooltip = 'Último cambio de clave: ' + fechaLarga + ' · Cambiada ayer. Le restan 29 días de vigencia mensual.';
      } else {
        badgePill = '🟢 Hace ' + dias + 'd · Vence en ' + restan + 'd';
        tooltip = 'Último cambio de clave: ' + fechaLarga + ' · Antigüedad: ' + dias + ' días. Le restan ' + restan + ' días antes de vencer.';
      }
    }

    return {
      estado: estado,
      dias: dias,
      timestamp: ts,
      fechaCorta: fechaCorta,
      fechaLarga: fechaLarga,
      badgePill: badgePill,
      tooltip: tooltip
    };
  }

  var stats = { total: companies.length, vigentes: 0, porVencer: 0, vencidas: 0, sinFecha: 0 };
  companies.forEach(function(c) {
    var meta = parseEmpMeta(c);
    c._meta = meta;
    if (meta.estado === 'vigente') stats.vigentes++;
    else if (meta.estado === 'por-vencer') stats.porVencer++;
    else if (meta.estado === 'vencida') stats.vencidas++;
    else stats.sinFecha++;
  });
%>

