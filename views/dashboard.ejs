// Generador para las filas de edición
// === CONTROLADORES DE VISIBILIDAD, ANIMACIÓN SCRAMBLE Y BARRA DE TIEMPO PARA EDITAR CLAVE ===
const editAnteriorTimers = {};
const editAnteriorState = {};
const editNuevaTimers = {};

function ocultarEditAnterior(id) {
  const box = document.getElementById('box-anterior-' + id);
  const inp = document.getElementById('edit-anterior-' + id);
  const eye = document.getElementById('eye-anterior-' + id);
  const timer = document.getElementById('timer-anterior-' + id);
  if (box) box.classList.remove('revealed', 'loading', 'bump');
  if (inp) {
    inp.type = 'password';
    if (editAnteriorState[id] && editAnteriorState[id].realVal) {
      inp.value = editAnteriorState[id].realVal;
    }
  }
  if (eye) {
    eye.classList.remove('on');
    const t = eye.querySelector('.t');
    if (t) t.textContent = 'Ver';
  }
  if (timer) {
    timer.style.transition = 'none';
    timer.style.width = '0%';
  }
  clearTimeout(editAnteriorTimers[id]);
}

async function toggleRevealEditAnterior(id) {
  const box = document.getElementById('box-anterior-' + id);
  const inp = document.getElementById('edit-anterior-' + id);
  const eye = document.getElementById('eye-anterior-' + id);
  const timer = document.getElementById('timer-anterior-' + id);
  if (!box || !inp) return;

  if (box.classList.contains('revealed')) {
    ocultarEditAnterior(id);
    return;
  }

  box.classList.add('loading');
  inp.type = 'text';
  inp.value = 'Descifrando...';

  let realPw = (editAnteriorState[id] && editAnteriorState[id].realVal) || (revealedState[id] && revealedState[id].value) || '';
  if (!realPw) {
    try {
      const res = await fetch('/empresa/' + id + '/clave');
      if (res.ok) {
        const data = await res.json();
        realPw = data.clave || '';
      }
    } catch (e) {
      console.error(e);
    }
  }

  box.classList.remove('loading');

  if (!realPw) {
    inp.value = 'Error al descifrar';
    setTimeout(() => ocultarEditAnterior(id), 1500);
    return;
  }

  editAnteriorState[id] = { realVal: realPw };
  revealedState[id] = { value: realPw };

  // Animación de caracteres (Matrix glyph scramble)
  const glyphs = 'ABCDEF0123456789!@#$%^&*<>?';
  let iter = 0;
  const maxIter = 12;
  const scramble = setInterval(() => {
    inp.value = realPw.split('').map((char, index) => {
      if (index < (iter / maxIter) * realPw.length) return char;
      return glyphs[Math.floor(Math.random() * glyphs.length)];
    }).join('');
    iter++;
    if (iter > maxIter) {
      clearInterval(scramble);
      inp.value = realPw;
    }
  }, 40);

  box.classList.add('revealed');
  box.classList.remove('bump');
  void box.offsetWidth;
  box.classList.add('bump');

  if (eye) {
    eye.classList.add('on');
    const t = eye.querySelector('.t');
    if (t) t.textContent = 'Ocultar';
  }

  if (timer) {
    timer.style.transition = 'none';
    timer.style.width = '100%';
    void timer.offsetWidth;
    timer.style.transition = 'width 10s linear';
    timer.style.width = '0%';
  }

  clearTimeout(editAnteriorTimers[id]);
  editAnteriorTimers[id] = setTimeout(() => {
    ocultarEditAnterior(id);
  }, 10000);
}

function ocultarEditNueva(id) {
  const box = document.getElementById('box-nueva-' + id);
  const inp = document.getElementById('edit-clave-' + id);
  const eye = document.getElementById('eye-nueva-' + id);
  const timer = document.getElementById('timer-nueva-' + id);
  if (box) box.classList.remove('revealed', 'loading', 'bump');
  if (inp) inp.type = 'password';
  if (eye) {
    eye.classList.remove('on');
    const t = eye.querySelector('.t');
    if (t) t.textContent = 'Ver';
  }
  if (timer) {
    timer.style.transition = 'none';
    timer.style.width = '0%';
  }
  clearTimeout(editNuevaTimers[id]);
}

function toggleRevealEditNueva(id) {
  const box = document.getElementById('box-nueva-' + id);
  const inp = document.getElementById('edit-clave-' + id);
  const eye = document.getElementById('eye-nueva-' + id);
  const timer = document.getElementById('timer-nueva-' + id);
