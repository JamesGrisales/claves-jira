<style>
.auth.single.security-screen {
  max-width: 600px;
  max-height: min(760px, calc(100vh - 48px));
  display: flex;
  flex-direction: column;
  margin: auto;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.65), 0 0 40px -5px rgba(var(--accent-rgb, 6, 182, 212), 0.25);
}

.auth.single.security-screen .auth-head {
  padding: 24px 30px;
  background: radial-gradient(110% 120% at 0% 0%, rgba(255,255,255,0.22) 0%, transparent 60%),
              linear-gradient(150deg, color-mix(in srgb, var(--p1, #06b6d4) 85%, #000), color-mix(in srgb, var(--p2, #3b82f6) 80%, #000));
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.auth.single.security-screen .auth-head .ico {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  flex-shrink: 0;
}

.auth.single.security-screen .auth-head h1 {
  margin: 0;
  font-size: 20px;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.01em;
}

.auth.single.security-screen .auth-head p {
  margin: 4px 0 0;
  font-size: 13px;
  opacity: 0.9;
  color: rgba(255, 255, 255, 0.9);
}

.auth.single.security-screen .auth-body {
  padding: 22px 28px 26px;
  overflow-y: auto;
  scrollbar-width: thin;
  flex: 1;
}

/* Tabs Switcher */
.sec-tab-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 5px;
  border-radius: 14px;
  background: rgba(0, 0, 0, 0.28);
  border: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 22px;
}

:root[data-theme="light"] .sec-tab-nav {
  background: rgba(0, 0, 0, 0.05);
  border-color: rgba(0, 0, 0, 0.08);
}

.sec-tab-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: var(--muted, #94a3b8);
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  user-select: none;
}

.sec-tab-btn svg {
  width: 17px;
  height: 17px;
  transition: transform 0.2s ease;
}

.sec-tab-btn:hover {
  color: var(--text, #fff);
  background: rgba(255, 255, 255, 0.05);
}

.sec-tab-btn.active {
  background: linear-gradient(135deg, var(--p1, #06b6d4), var(--p2, #3b82f6));
  color: #fff !important;
  box-shadow: 0 4px 14px rgba(var(--accent-rgb, 6, 182, 212), 0.35);
}

.sec-tab-btn.active svg {
  transform: scale(1.08);
}

.sec-tab-badge {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.2);
  font-weight: 800;
  letter-spacing: 0.3px;
}

.sec-tab-btn.active .sec-tab-badge {
  background: rgba(0, 0, 0, 0.22);
  color: #fff;
}

/* Paneles de Pestaña */
.sec-tab-panel {
  display: none;
  animation: panelSlideIn 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sec-tab-panel.active {
  display: block;
}

@keyframes panelSlideIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Tarjeta Huella Biometric Card */
.bio-dashboard-card {
  background: rgba(var(--accent-rgb, 6, 182, 212), 0.04);
  border: 1px solid rgba(var(--accent-rgb, 6, 182, 212), 0.2);
  border-radius: 18px;
  padding: 24px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.bio-scanner-visual {
  width: 82px;
  height: 82px;
  border-radius: 50%;
  margin: 0 auto 16px;
  background: rgba(var(--accent-rgb, 6, 182, 212), 0.1);
  border: 2px solid rgba(var(--accent-rgb, 6, 182, 212), 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: var(--accent, #06b6d4);
  box-shadow: 0 0 24px -2px rgba(var(--accent-rgb, 6, 182, 212), 0.28);
}

.bio-scanner-visual::before {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 1px dashed rgba(var(--accent-rgb, 6, 182, 212), 0.35);
  animation: bioOrbit 16s linear infinite;
}

@keyframes bioOrbit {
  to { transform: rotate(360deg); }
}

.bio-scanner-visual svg {
  width: 44px;
  height: 44px;
}

.bio-scanner-laser {
  position: absolute;
  left: 10%;
  right: 10%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #fff, var(--accent, #06b6d4), transparent);
  box-shadow: 0 0 10px #fff, 0 0 16px var(--accent, #06b6d4);
  border-radius: 2px;
  animation: bioLaserSweep 2.2s ease-in-out infinite alternate;
}

@keyframes bioLaserSweep {
  0% { top: 15%; opacity: 0.2; }
  50% { opacity: 1; }
  100% { top: 82%; opacity: 0.2; }
}

.bio-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 11.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}

.bio-status-badge.active {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.bio-status-badge.inactive {
  background: rgba(59, 130, 246, 0.15);
  color: #3b82f6;
  border: 1px solid rgba(59, 130, 246, 0.35);
}

.bio-feature-list {
  text-align: left;
  margin: 18px 0;
  padding: 14px 16px;
  border-radius: 12px;
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.06);
