  gap: 10px;
}

:root[data-theme="light"] .bio-feature-list {
  background: rgba(0, 0, 0, 0.03);
  border-color: rgba(0, 0, 0, 0.06);
}

.bio-feature-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--text, #e2e8f0);
}

.bio-feature-item svg {
  width: 16px;
  height: 16px;
  color: var(--accent, #06b6d4);
  flex-shrink: 0;
