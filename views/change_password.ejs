<script>
// --- MANEJO DE PESTAÑAS (CONTRASEÑA / HUELLA DIGITAL) ---
(function initSecurityTabs() {
  var tabBtns = document.querySelectorAll('.sec-tab-btn');
  var panels = {
    password: document.getElementById('panelPassword'),
    biometria: document.getElementById('panelBiometria')
  };

  function switchTab(name) {
    tabBtns.forEach(function(b) {
      var active = b.getAttribute('data-tab') === name;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    for (var key in panels) {
      if (panels[key]) {
        panels[key].classList.toggle('active', key === name);
      }
    }
  }

  tabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      switchTab(btn.getAttribute('data-tab'));
    });
  });

  // Si la URL contiene #huella o #biometria, abrir automáticamente la pestaña de huella
  if (window.location.hash.toLowerCase().indexOf('huella') !== -1 ||
      window.location.hash.toLowerCase().indexOf('bio') !== -1) {
    switchTab('biometria');
  }
})();

// --- VALIDACIÓN DE FORMULARIO DE CONTRASEÑA ---
(function(){
  var pw = document.getElementById('pw'), cf = document.getElementById('pw2'), bar = document.getElementById('meterBar'), txt = document.getElementById('meterTxt');
  var rl = document.getElementById('reqLen'), rm = document.getElementById('reqMatch');
  var nombres = ['', 'Débil', 'Aceptable', 'Buena', 'Excelente'];
  function revisar(){
    if (!pw || !cf || !bar || !txt) return;
    var v = pw.value, p = 0;
    if (v.length >= 6) p++; if (v.length >= 10) p++; if (/[a-z]/.test(v) && /[A-Z]/.test(v)) p++; if (/\d/.test(v)) p++; if (/[^A-Za-z0-9]/.test(v)) p++;
    var n = !v.length ? 0 : (p <= 1 ? 1 : (p === 2 ? 2 : (p === 3 ? 3 : 4)));
    bar.className = n ? 'l' + n : ''; txt.textContent = nombres[n];
    if (rl) rl.classList.toggle('ok', v.length >= 6);
    var igual = cf.value.length > 0 && cf.value === v;
    if (rm) rm.classList.toggle('ok', igual);
    cf.setCustomValidity(cf.value && cf.value !== v ? 'Las contraseñas no coinciden' : '');
  }
  if (pw && cf) {
    pw.addEventListener('input', revisar);
    cf.addEventListener('input', revisar);
    revisar();
  }
})();

// --- GESTIÓN BIOMÉTRICA (WINDOWS HELLO HUELLA DIGITAL) ---
(function initBioProfile() {
  if (typeof Biometria === 'undefined') return;

  var ipWarn = document.getElementById('ipWarningBanner');
  var btnLocal = document.getElementById('btnCambiarALocalhost');
  if (window.location.hostname === '127.0.0.1' || window.location.hostname === '::1') {
    if (ipWarn) ipWarn.style.display = 'block';
    if (btnLocal) {
      btnLocal.onclick = function() {
        window.location.href = window.location.href.replace('127.0.0.1', 'localhost');
      };
    }
  }

  var badgeBox = document.getElementById('bioStatusBadge');
  var badgeText = document.getElementById('bioBadgeText');
  var tabBadge = document.getElementById('tabBioBadge');
  var btnVincular = document.getElementById('btnVincularBio');
  var btnTxt = document.getElementById('btnVincularTxt');
  var linkedBox = document.getElementById('bioLinkedBox');
  var deviceName = document.getElementById('bioDeviceName');
  var regDate = document.getElementById('bioRegDate');
  var btnEliminar = document.getElementById('btnEliminarBio');

  async function actualizarEstado() {
    try {
      var compatible = await Biometria.esCompatible();
      if (!compatible) {
        badgeBox.className = 'bio-status-badge inactive';
        badgeText.textContent = 'Hardware no compatible';
        if (btnVincular) {
          btnVincular.disabled = true;
          btnTxt.textContent = 'Sensor no disponible en este navegador/equipo';
        }
        return;
      }

      var estado = await Biometria.obtenerEstado();

      if (estado.registrado && estado.credenciales && estado.credenciales.length > 0) {
        badgeBox.className = 'bio-status-badge active';
        badgeText.textContent = 'Huella Vinculada y Activa';
        if (tabBadge) {
          tabBadge.textContent = '✓ Activa';
          tabBadge.style.background = 'rgba(16, 185, 129, 0.25)';
          tabBadge.style.color = '#10b981';
        }

        if (btnVincular) btnVincular.style.display = 'none';
        if (linkedBox) linkedBox.style.display = 'flex';

        var cred = estado.credenciales[0];
        if (deviceName) deviceName.textContent = cred.dispositivo || 'Sensor de Huella (Windows Hello)';
        if (regDate) regDate.textContent = 'Vinculada el ' + new Date(cred.created_at).toLocaleDateString();

        if (btnEliminar) {
          btnEliminar.onclick = async function() {
            if (!confirm('¿Deseas desvincular tu huella digital de esta cuenta?')) return;
            btnEliminar.disabled = true;
            btnEliminar.textContent = 'Eliminando...';
            try {
              var res = await Biometria.eliminar(cred.id);
              if (res.ok) {
                alert('Huella biométrica eliminada exitosamente.');
                actualizarEstado();
              }
            } catch(e) {
              alert('Error al desvincular: ' + e.message);
            } finally {
              btnEliminar.disabled = false;
              btnEliminar.textContent = 'Desvincular';
            }
          };
        }
      } else {
        badgeBox.className = 'bio-status-badge inactive';
        badgeText.textContent = 'Sensor Disponible · Sin Huella';
        if (tabBadge) {
          tabBadge.textContent = 'Windows Hello';
          tabBadge.style.background = '';
          tabBadge.style.color = '';
        }

        if (btnVincular) {
          btnVincular.style.display = 'inline-flex';
          btnVincular.disabled = false;
          btnTxt.textContent = 'Vincular huella de esta laptop';
        }
        if (linkedBox) linkedBox.style.display = 'none';
      }
    } catch(err) {
      badgeBox.className = 'bio-status-badge inactive';
      badgeText.textContent = 'No se pudo verificar estado';
    }
  }

  if (btnVincular) {
    btnVincular.addEventListener('click', async function() {
      btnVincular.disabled = true;
      btnTxt.textContent = 'Toca el sensor de huella de tu laptop...';
      try {
        var res = await Biometria.vincular();
        if (res.ok) {
          alert('¡Huella digital vinculada exitosamente con Windows Hello!');
          actualizarEstado();
        }
      } catch(err) {
        alert(err.message || 'No se pudo vincular la huella digital.');
      } finally {
        btnVincular.disabled = false;
        btnTxt.textContent = 'Vincular huella de esta laptop';
      }
    });
  }

  actualizarEstado();
})();
</script>
