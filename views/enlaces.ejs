<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .chip{ display:inline-block; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; color:var(--accent-dark); background:var(--accent-soft); }
  .sub{ color:var(--muted); font-size:13.5px; margin:0 0 14px; }

  .en-tools{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:12px; }
  .en-tools input[type=text]{ flex:1; min-width:200px; font-family:var(--sans); font-size:14px; }
  .en-tools select{ background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13px; padding:7px 10px; border-radius:8px; height:36px; }
  .en-tools button{ padding:8px 14px; font-size:13px; }
  .en-groups{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }
  .en-groups:empty{ display:none; }
  .en-gb{ background:var(--panel-alt); color:var(--muted); border:1px solid var(--panel-edge); box-shadow:none; padding:5px 12px; font-size:12.5px; font-weight:600; border-radius:999px; }
  .en-gb.on{ background:var(--accent); color:#fff; border-color:var(--accent); }

  .en-sec{ margin:18px 0 8px; font-size:12px; font-weight:800; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .en-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:10px; }
  .en-card{ position:relative; background:var(--panel); border:1px solid var(--panel-edge); border-radius:14px; transition:transform .15s ease, border-color .15s ease, box-shadow .15s ease; }
  .en-card:hover{ transform:translateY(-2px); border-color:var(--accent); box-shadow:0 8px 20px -10px rgba(var(--accent-rgb),.5); }
  .en-card.sel{ outline:2px solid var(--accent); outline-offset:1px; }
  .en-link{ display:flex; align-items:center; gap:12px; padding:13px 14px; text-decoration:none; color:var(--text); border-radius:14px; }
  .en-ico{ flex-shrink:0; width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:22px; }
  .en-txt{ min-width:0; flex:1; }
  .en-nm{ font-weight:700; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .en-host{ font-size:12px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; }
  .en-pin{ position:absolute; top:7px; right:9px; font-size:12px; color:#f59e0b; pointer-events:none; }
  .en-act{ position:absolute; right:6px; bottom:6px; display:none; gap:2px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:9px; padding:2px; }
  .en-card:hover .en-act, .en-card:focus-within .en-act{ display:flex; }
  button.en-ib{ background:transparent; color:var(--muted); box-shadow:none; border:0; width:28px; height:28px; padding:0; font-size:13px; border-radius:7px; transform:none; display:inline-flex; align-items:center; justify-content:center; }
  button.en-ib:hover{ background:var(--accent-soft); color:var(--accent-dark); transform:none; box-shadow:none; }
  button.en-ib.del:hover{ background:var(--danger-soft); color:var(--danger); }
  .en-empty{ text-align:center; color:var(--muted); padding:34px 10px; font-size:14px; }
  .en-hint{ color:var(--muted); font-size:12px; text-align:center; margin:16px 0 0; }
  .en-hint kbd{ font-family:var(--mono); font-size:11px; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:4px; padding:1px 5px; }

  dialog.en-dlg{ background:var(--panel); color:var(--text); border:1px solid var(--panel-edge); border-radius:16px; padding:22px 22px 18px; width:min(480px, 92vw); box-shadow:0 24px 60px -20px rgba(0,0,0,.45); }
  dialog.en-dlg::backdrop{ background:rgba(6,11,25,.55); }
  .en-dlg h2{ margin:0 0 4px; font-size:18px; }
  .en-dlg label{ margin:12px 0 5px; }
  .en-dlg input[type=text], .en-dlg input[type=url]{ width:100%; font-family:var(--sans); font-size:14px; }
  .en-pick{ display:grid; grid-template-columns:repeat(auto-fill, 36px); gap:5px; }
  button.en-em{ width:36px; height:36px; padding:0; font-size:18px; background:var(--panel-alt); border:1px solid var(--panel-edge); box-shadow:none; border-radius:9px; color:var(--text); transform:none; }
  button.en-em:hover{ border-color:var(--accent); transform:none; }
  button.en-em.on{ border-color:var(--accent); background:var(--accent-soft); box-shadow:0 0 0 2px var(--accent-soft); }
  .en-cols{ display:flex; gap:8px; flex-wrap:wrap; }
  button.en-co{ width:26px; height:26px; padding:0; border-radius:50%; border:2px solid transparent; box-shadow:none; transform:none; }
  button.en-co:hover{ transform:scale(1.12); }
  button.en-co.on{ border-color:var(--text); }
  .en-prev{ display:flex; align-items:center; gap:10px; margin-top:12px; padding:10px 12px; background:var(--panel-alt); border:1px dashed var(--panel-edge); border-radius:12px; font-size:13px; }
  .en-chk{ display:flex; align-items:center; gap:8px; margin:14px 0 0; text-transform:none; letter-spacing:0; font-size:13px; color:var(--text); }
  .en-chk input{ width:auto; }
  .en-fe{ margin-top:10px; font-size:13px; color:var(--danger); background:var(--danger-soft); border-radius:8px; padding:8px 12px; display:none; }
  .en-btns{ display:flex; gap:8px; justify-content:flex-end; margin-top:16px; }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px); background:var(--accent); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:1000; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
</style>

<div class="top">
  <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
    <h1>Enlaces</h1>
    <span class="db-orb db-orb-pg" title="Persistencia en PostgreSQL">🐘</span>
  </div>
  <span class="chip" id="chip"></span>
</div>
<p class="sub">Guarda tus links con nombre, ícono y color para abrirlos con un clic. Se guardan en la base de datos, así que los tienes en cualquier navegador.</p>

<div class="card" style="padding:18px;">
  <div class="en-tools">
    <input type="text" id="buscar" placeholder="Buscar por nombre, grupo o dirección…  (tecla /)" autocomplete="off">
    <select id="orden" title="Ordenar">
      <option value="g">Por grupo</option>
      <option value="u">Más usados</option>
      <option value="r">Más recientes</option>
      <option value="a">A – Z</option>
    </select>
    <button type="button" id="bNuevo">＋ Nuevo enlace</button>
  </div>
  <div class="en-groups" id="grupos"></div>
  <div id="lista"></div>
  <p class="en-hint"><kbd>/</kbd> buscar · <kbd>n</kbd> nuevo · <kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd> moverse · <kbd>Enter</kbd> abrir · <kbd>e</kbd> editar</p>
</div>

<dialog class="en-dlg" id="dlg">
  <h2 id="dTitulo">Nuevo enlace</h2>
  <label for="fUrl">Dirección (URL)</label>
  <input type="text" id="fUrl" placeholder="https://miempresa.atlassian.net/jira" autocomplete="off" spellcheck="false">
  <label for="fNombre">Nombre</label>
  <input type="text" id="fNombre" placeholder="Ej: Jira producción" autocomplete="off" maxlength="120">
  <label for="fGrupo">Grupo (opcional)</label>
  <input type="text" id="fGrupo" list="dlGrupos" placeholder="Ej: Jira, Servidores, Reportes" autocomplete="off" maxlength="60">
  <datalist id="dlGrupos"></datalist>
  <label>Ícono</label>
  <div class="en-pick" id="fEmojis"></div>
  <input type="text" id="fIcono" placeholder="…o escribe/pega tu propio emoji o letras" maxlength="8" autocomplete="off" style="margin-top:8px;">
  <label>Color</label>
  <div class="en-cols" id="fColores"></div>
  <label class="en-chk"><input type="checkbox" id="fFijado"> ⭐ Fijar arriba</label>
  <div class="en-prev" id="fPrev"></div>
  <div class="en-fe" id="fErr"></div>
  <div class="en-btns">
    <button type="button" class="secondary" id="dCancelar">Cancelar</button>
    <button type="button" id="dGuardar">Guardar</button>
  </div>
</dialog>
<div class="toast" id="toast">Listo</div>

<script id="datos" type="application/json"><%- JSON.stringify(items || []).replace(/</g, '\\u003c') %></script>
<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var datos = []; try { datos = JSON.parse($('datos').textContent) || []; } catch (e) {}
  var EMOJIS = ['🔗','🌐','🏢','📊','📈','📁','📂','📝','📋','📅','📧','💬','🎫','🐞','🛠️','⚙️','🔐','🔑','🗄️','💾','☁️','🖥️','📡','🧪','🚀','🛒','💳','🧾','👥','🏦','📞','🎯','⭐','🔥','📚','🎓','🧩','🔧','📦','🗺️'];
  var COLORES = ['#2563eb','#4f46e5','#06b6d4','#10b981','#84cc16','#f59e0b','#f97316','#e11d48','#db2777','#7c3aed','#64748b','#0f172a'];
  var F = { q:'', grupo:null, orden:'g' }, edit = null, sel = -1, form = { icono:'🔗', color:COLORES[0] };

  function esc(t){ return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function toast(m){ var t = $('toast'); t.textContent = m; t.classList.add('show'); setTimeout(function(){ t.classList.remove('show'); }, 1600); }
  function host(u){ try { var x = new URL(u); return x.host + (x.pathname !== '/' ? x.pathname : ''); } catch (e) { return u; } }
  function norm(s){ return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }
  function tile(i){ return '<span class="en-ico" style="background:' + esc(i.color) + '22;color:' + esc(i.color) + ';border:1px solid ' + esc(i.color) + '55">' + esc(i.icono) + '</span>'; }

  function api(metodo, url, cuerpo){
    return fetch(url, { method:metodo, headers:{ 'Content-Type':'application/json' }, body: cuerpo ? JSON.stringify(cuerpo) : undefined })
      .then(function(r){ return r.json().catch(function(){ return { ok:false, error:'Respuesta inválida del servidor.' }; }); })
      .catch(function(){ return { ok:false, error:'No hay conexión con el servidor.' }; });
  }

  /* ---------- pantalla ---------- */
  function filtrados(){
    var q = norm(F.q).split(/\s+/).filter(Boolean);
    return datos.filter(function(i){
      if (F.grupo !== null && i.grupo !== F.grupo) return false;
      var t = norm(i.nombre + ' ' + i.grupo + ' ' + i.url);
      return q.every(function(w){ return t.indexOf(w) !== -1; });
    });
  }
  function tarjeta(i){
    return '<div class="en-card" data-id="' + i.id + '"><a class="en-link" href="' + esc(i.url) + '" target="_blank" rel="noopener noreferrer" title="' + esc(i.url) + '">' +
      tile(i) + '<span class="en-txt"><div class="en-nm">' + esc(i.nombre) + '</div><div class="en-host">' + esc(host(i.url)) + '</div></span></a>' +
      (i.fijado ? '<span class="en-pin" title="Fijado">⭐</span>' : '') +
      '<div class="en-act"><button type="button" class="en-ib" data-a="cp" title="Copiar enlace">⧉</button><button type="button" class="en-ib" data-a="ed" title="Editar">✎</button><button type="button" class="en-ib del" data-a="del" title="Eliminar">✕</button></div></div>';
  }
  function render(){
    $('chip').textContent = datos.length + (datos.length === 1 ? ' enlace' : ' enlaces');
    var gs = []; datos.forEach(function(i){ if (i.grupo && gs.indexOf(i.grupo) === -1) gs.push(i.grupo); });
    gs.sort(function(a, b){ return a.localeCompare(b, 'es'); });
    if (F.grupo !== null && gs.indexOf(F.grupo) === -1) F.grupo = null;
    $('grupos').innerHTML = gs.length ? '<button type="button" class="en-gb' + (F.grupo === null ? ' on' : '') + '" data-g="">Todos</button>' +
      gs.map(function(g){ return '<button type="button" class="en-gb' + (F.grupo === g ? ' on' : '') + '" data-g="' + esc(g) + '">' + esc(g) + '</button>'; }).join('') : '';
    $('dlGrupos').innerHTML = gs.map(function(g){ return '<option value="' + esc(g) + '">'; }).join('');

    var lista = filtrados(), h = '';
    var cmpNom = function(a, b){ return a.nombre.localeCompare(b.nombre, 'es'); };
    if (F.orden === 'g') {
      var bloques = {}, orden = [];
      lista.forEach(function(i){ var k = i.fijado ? '\u0000' : (i.grupo || '\uffff'); if (!bloques[k]) { bloques[k] = []; orden.push(k); } bloques[k].push(i); });
      orden.sort(function(a, b){ return a.localeCompare(b, 'es'); });
      orden.forEach(function(k){
        bloques[k].sort(cmpNom);
        h += '<div class="en-sec">' + (k === '\u0000' ? '⭐ Fijados' : k === '\uffff' ? 'Sin grupo' : esc(k)) + '</div><div class="en-grid">' + bloques[k].map(tarjeta).join('') + '</div>';
      });
      render.vis = orden.reduce(function(a, k){ return a.concat(bloques[k]); }, []);
    } else {
      lista.sort(F.orden === 'u' ? function(a, b){ return b.usos - a.usos || cmpNom(a, b); } : F.orden === 'r' ? function(a, b){ return b.id - a.id; } : cmpNom);
      h = '<div class="en-grid">' + lista.map(tarjeta).join('') + '</div>';
      render.vis = lista;
    }
    if (!lista.length) h = '<div class="en-empty">' + (datos.length ? 'Ningún enlace coincide con la búsqueda.' : 'Aún no tienes enlaces. Pulsa «Nuevo enlace» (o la tecla <b>n</b>) para guardar el primero.') + '</div>';
    $('lista').innerHTML = h; sel = -1;
  }
  function marcar(n){
    var c = $('lista').querySelectorAll('.en-card'); if (!c.length) return;
    sel = Math.max(0, Math.min(c.length - 1, n));
    Array.prototype.forEach.call(c, function(x, k){ x.classList.toggle('sel', k === sel); });
    c[sel].scrollIntoView({ block:'nearest' });
  }
  function porId(id){ return datos.filter(function(i){ return i.id === +id; })[0]; }

  /* ---------- formulario ---------- */
  function vistaPrevia(){
    var i = { icono: form.icono || '🔗', color: form.color, nombre: $('fNombre').value.trim() || 'Nombre del enlace', url: $('fUrl').value.trim() || 'https://…' };
    $('fPrev').innerHTML = tile(i) + '<span class="en-txt"><div class="en-nm">' + esc(i.nombre) + '</div><div class="en-host">' + esc(host(/^[a-z][a-z0-9+.-]*:\/\//i.test(i.url) ? i.url : 'https://' + i.url)) + '</div></span>';
  }
  function pintarSelectores(){
    Array.prototype.forEach.call($('fEmojis').children, function(b){ b.classList.toggle('on', b.getAttribute('data-e') === form.icono); });
    Array.prototype.forEach.call($('fColores').children, function(b){ b.classList.toggle('on', b.getAttribute('data-c') === form.color); });
    vistaPrevia();
  }
  $('fEmojis').innerHTML = EMOJIS.map(function(e){ return '<button type="button" class="en-em" data-e="' + e + '">' + e + '</button>'; }).join('');
  $('fColores').innerHTML = COLORES.map(function(c){ return '<button type="button" class="en-co" data-c="' + c + '" style="background:' + c + '" title="' + c + '"></button>'; }).join('');

  function abrirForm(i){
    edit = i || null;
    $('dTitulo').textContent = i ? 'Editar enlace' : 'Nuevo enlace';
    $('fUrl').value = i ? i.url : ''; $('fNombre').value = i ? i.nombre : ''; $('fGrupo').value = i ? i.grupo : (F.grupo || '');
    $('fFijado').checked = i ? i.fijado : false; $('fErr').style.display = 'none';
    form.icono = i ? i.icono : '🔗'; form.color = i ? i.color : COLORES[0]; $('fIcono').value = EMOJIS.indexOf(form.icono) === -1 ? form.icono : '';
    pintarSelectores(); $('dlg').showModal(); $('fUrl').focus();
  }
  $('fEmojis').addEventListener('click', function(e){ var b = e.target.closest('[data-e]'); if (!b) return; form.icono = b.getAttribute('data-e'); $('fIcono').value = ''; pintarSelectores(); });
  $('fColores').addEventListener('click', function(e){ var b = e.target.closest('[data-c]'); if (!b) return; form.color = b.getAttribute('data-c'); pintarSelectores(); });
  $('fIcono').addEventListener('input', function(){ form.icono = this.value.trim() || '🔗'; pintarSelectores(); });
  $('fNombre').addEventListener('input', function(){ this.setAttribute('data-manual', '1'); vistaPrevia(); });
  $('fUrl').addEventListener('input', function(){
    var n = $('fNombre');
    if (!n.getAttribute('data-manual') && !edit) { try { n.value = new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(this.value.trim()) ? this.value.trim() : 'https://' + this.value.trim()).hostname.replace(/^www\./, ''); } catch (x) { n.value = ''; } }
    vistaPrevia();
  });
  $('dCancelar').addEventListener('click', function(){ $('dlg').close(); });
  $('dlg').addEventListener('close', function(){ $('fNombre').removeAttribute('data-manual'); });

  function guardarForm(){
    var cuerpo = { nombre:$('fNombre').value, url:$('fUrl').value, grupo:$('fGrupo').value, icono:form.icono, color:form.color, fijado:$('fFijado').checked };
    var btn = $('dGuardar'); btn.disabled = true;
    (edit ? api('PUT', '/enlaces/api/' + edit.id, cuerpo) : api('POST', '/enlaces/api', cuerpo)).then(function(r){
      btn.disabled = false;
      if (!r.ok) { $('fErr').textContent = r.error || 'No se pudo guardar.'; $('fErr').style.display = 'block'; return; }
      if (edit) { var k = datos.indexOf(edit); r.item.usos = edit.usos; datos[k] = r.item; } else datos.push(r.item);
      $('dlg').close(); render(); toast(edit ? 'Enlace actualizado' : 'Enlace guardado');
    });
  }
  $('dGuardar').addEventListener('click', guardarForm);
  $('dlg').addEventListener('keydown', function(e){ if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.id !== 'fIcono') { e.preventDefault(); guardarForm(); } });

  /* ---------- eventos ---------- */
  $('bNuevo').addEventListener('click', function(){ abrirForm(null); });
  var temp; $('buscar').addEventListener('input', function(){ F.q = this.value; clearTimeout(temp); temp = setTimeout(render, 120); });
  $('orden').addEventListener('change', function(){ F.orden = this.value; render(); });
  $('grupos').addEventListener('click', function(e){ var b = e.target.closest('[data-g]'); if (!b) return; F.grupo = b.getAttribute('data-g') || null; render(); });
  $('lista').addEventListener('click', function(e){
    var card = e.target.closest('.en-card'); if (!card) return;
    var i = porId(card.getAttribute('data-id')), a = e.target.closest('[data-a]');
    if (a) {
      var acc = a.getAttribute('data-a');
      if (acc === 'ed') abrirForm(i);
      else if (acc === 'cp') { (navigator.clipboard ? navigator.clipboard.writeText(i.url) : Promise.reject()).then(function(){ toast('Enlace copiado'); }, function(){ toast('No se pudo copiar'); }); }
      else if (acc === 'del' && confirm('¿Eliminar «' + i.nombre + '»?')) {
        api('DELETE', '/enlaces/api/' + i.id).then(function(r){ if (r.ok) { datos.splice(datos.indexOf(i), 1); render(); toast('Enlace eliminado'); } else toast(r.error || 'No se pudo eliminar'); });
      }
      return;
    }
    if (e.target.closest('.en-link')) { i.usos++; fetch('/enlaces/api/' + i.id + '/abrir', { method:'POST', keepalive:true }).catch(function(){}); }
  });
  document.addEventListener('keydown', function(e){
    var tag = e.target.tagName;
    if (e.key === 'Escape' && /INPUT|SELECT/.test(tag) && !$('dlg').open) { e.target.blur(); return; }
    if ($('dlg').open || /INPUT|SELECT|TEXTAREA/.test(tag) || e.ctrlKey || e.metaKey || e.altKey) return;
    var k = e.key, cards = $('lista').querySelectorAll('.en-card');
    if (k === '/') { e.preventDefault(); $('buscar').focus(); $('buscar').select(); }
    else if (k === 'n') { e.preventDefault(); abrirForm(null); }
    else if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); marcar(sel + 1); }
    else if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); marcar(sel - 1); }
    else if (k === 'Enter' && sel >= 0) { var l = cards[sel].querySelector('.en-link'); if (l) l.click(); }
    else if (k === 'e' && sel >= 0) abrirForm(porId(cards[sel].getAttribute('data-id')));
  });
  render();
})();
</script>
