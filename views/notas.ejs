let nodoNotaOrig = {};
function pantallaCompleta(id){
  const wrap = document.getElementById('wrap-' + id);
  if (!wrap) return;
  const activa = !wrap.classList.contains('fullscreen');
  if (activa) {
    nodoNotaOrig[id] = { padre: wrap.parentNode, hermano: wrap.nextSibling };
    document.body.appendChild(wrap);
    wrap.classList.add('fullscreen');
    document.body.classList.add('has-fullscreen');
    document.body.style.overflow = 'hidden';
  } else {
    wrap.classList.remove('fullscreen');
    document.body.classList.remove('has-fullscreen');
    if (nodoNotaOrig[id] && nodoNotaOrig[id].padre) {
      nodoNotaOrig[id].padre.insertBefore(wrap, nodoNotaOrig[id].hermano);
    }
    document.body.style.overflow = '';
  }
}

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg || 'Copiado';
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 1400);
}

async function copiarAlPortapapeles(texto){
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(texto);
      return;
    }
  } catch (e) {}
  const ta = document.createElement('textarea');
  ta.value = texto;
  ta.style.position = 'fixed';
  ta.style.left = '-9999px';
  ta.style.top = '0';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  try { document.execCommand('copy'); } catch(e){}
  document.body.removeChild(ta);
}

async function copiarNota(id){
  let texto;
  const editPanel = document.getElementById('edit-' + id);
  const isEditing = editPanel && editPanel.classList.contains('open');
  const ta = isEditing ? editPanel.querySelector('textarea') : null;

  if (isEditing && ta) {
    const s = ta.selectionStart;
    const e = ta.selectionEnd;
    if (typeof s === 'number' && typeof e === 'number' && s !== e) {
      texto = ta.value.substring(s, e);
      const cantLineas = contarLineas(texto);
      await copiarAlPortapapeles(texto);
      showToast(cantLineas > 1 ? ('Selección copiada (' + cantLineas.toLocaleString('es-CO') + ' líneas)') : 'Selección copiada');
      return;
    }
    texto = ta.value;
    await copiarAlPortapapeles(texto);
    showToast('Contenido del editor copiado');
    return;
  }

  const sel = window.getSelection();
  const selText = sel ? sel.toString().trim() : '';
  const cont = document.getElementById('texto-' + id);

  if (selText && cont && sel.anchorNode && cont.contains(sel.anchorNode)) {
    texto = selText;
    const cantLineas = contarLineas(texto);
    await copiarAlPortapapeles(texto);
    showToast(cantLineas > 1 ? ('Selección copiada (' + cantLineas.toLocaleString('es-CO') + ' líneas)') : 'Selección copiada');
    return;
  }

  if (notasData[id].esExcel) {
    try { await cargarHoja(id); } catch (e) { showToast('No se pudo cargar'); return; }
    texto = tsvHoja(notasData[id].xl.hojas[notasData[id].xl.activa]);
  } else {
    try { await cargarContenido(id); } catch (e) { showToast('No se pudo cargar'); return; }
    texto = notasData[id].texto.replace(/^[ \t]*\[\[IMG:\d+\]\][ \t]*\n?/gm, '');
  }
  await copiarAlPortapapeles(texto);
  showToast('Toda la nota copiada');
}

