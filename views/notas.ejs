document.getElementById('toggleAddBtn').addEventListener('click', function(){
  document.getElementById('uploadCard').classList.remove('open');
  const add = document.getElementById('addCard');
  const isOpen = add.classList.toggle('open');
  if (isOpen) {
    const ta = add.querySelector('.nt-ed-input');
    if (ta) {
      actualizarEditorNota(ta);
      setTimeout(function(){ ta.focus(); }, 50);
    }
  }
});

document.getElementById('toggleUploadBtn').addEventListener('click', function(){
  document.getElementById('addCard').classList.remove('open');
  document.getElementById('uploadCard').classList.toggle('open');
});

const btnEliminarTodo = document.getElementById('btnEliminarTodo');
if (btnEliminarTodo) {
  btnEliminarTodo.addEventListener('click', function(){
    const ok = confirm(
      'Vas a mover a la papelera ' + <%- JSON.stringify(C.todos) %> + ' ' + filasCache.length + ' ' + <%- JSON.stringify(C.plural) %> + ' de esta sección.\n\n' +
      'No se borran de verdad: podrás restaurarlos desde 🗑 Papelera.\n\n¿Continuar?'
    );
    if (ok) document.getElementById('formEliminarTodo').submit();
  });
}

const inputArchivos = document.getElementById('inputArchivos');
inputArchivos.addEventListener('change', function(){
  const lista = document.getElementById('listaArchivos');
  lista.innerHTML = '';
  Array.from(inputArchivos.files).forEach(function(f){
    const mb = f.size / 1048576;
    const excede = mb > MAX_MB;
    lista.insertAdjacentHTML('beforeend',
      '<div class="file-item' + (excede ? ' bad' : '') + '"><span>' + escapeHtml(f.name) + '</span><span>' +
      (mb >= 1 ? mb.toFixed(1) + ' MB' : Math.max(1, Math.round(f.size / 1024)) + ' KB') +
      (excede ? ' — supera el límite de ' + MAX_MB + ' MB' : '') + '</span></div>');
  });
});

document.getElementById('formSubir').addEventListener('submit', function(e){
  const files = Array.from(inputArchivos.files);
  const grandes = files.filter(function(f){ return f.size > MAX_MB * 1048576; });
  if (grandes.length) {
    e.preventDefault();
    alert('Estos archivos superan el límite de ' + MAX_MB + ' MB:\n' + grandes.map(function(f){ return f.name; }).join('\n'));
    return;
  }
  if (files.length > 20) {
    e.preventDefault();
    alert('Máximo 20 archivos por vez.');
    return;
  }
  const b = document.getElementById('btnSubir');
  b.disabled = true;
  b.textContent = 'Subiendo… (los archivos grandes pueden tardar; no cierres la página)';
});
</script>
