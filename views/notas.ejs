    transition: background 0.12s ease;
  }
  .nt-ed-hl-line.active {
    background: rgba(245, 158, 11, 0.28);
    border-left: 4px solid #f59e0b;
    box-shadow: inset 0 0 12px rgba(245, 158, 11, 0.22);
  }

  /* Capa de palabras resaltadas de búsqueda (espejo idéntico al textarea) */
  .nt-ed-search-layer {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 12px 14px 24px 14px;
    overflow: hidden;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    tab-size: 4;
    white-space: pre;
    letter-spacing: normal;
    word-spacing: normal;
    background: transparent;
    border: 0;
    box-sizing: border-box;
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    z-index: 2;
  }
  .nt-ed-hl-word {
    display: inline;
    padding: 0;
    margin: 0;
    border: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    word-spacing: inherit;
    white-space: pre;
    background: rgba(255, 215, 0, 0.42);
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
    border-radius: 2px;
    outline: 1px solid rgba(255, 215, 0, 0.45);
    transition: background 0.1s ease, outline 0.1s ease;
  }
  .nt-ed-hl-word.active {
    background: rgba(255, 152, 0, 0.85) !important;
    outline: 1.5px solid #ffa726 !important;
    box-shadow: 0 0 10px rgba(255, 152, 0, 0.65) !important;
  }
  .nt-ed-input::selection,
  .nt-ed-box.plain .nt-ed-input::selection {
    background: #f59e0b !important;
    color: #000000 !important;
    -webkit-text-fill-color: #000000 !important;
  }

</style>

<% var C = (typeof cfg !== 'undefined') ? cfg : { base:'/notas', plural:'notas', titulo:'Notas y comandos', agregar:'+ Agregar nota', placeCat:'Ej: Ventoy USB', placeTit:'Ej: Preparar la USB', placeCont:'Pega aquí el comando, script o apunte…', vacio:'Todavía no hay notas guardadas. Agrega la primera arriba.', buscarDentro:'Buscar dentro de esta nota…', papeleraUno:'Mover esta nota a la papelera', el:'la nota', todos:'las' };
   var MAXMB = (typeof maxUploadMb !== 'undefined') ? maxUploadMb : 100;
   function fmtTam(n){ return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : (n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' car.'); } %>

<div x-data="notasAlpineApp()">
  <div class="top">
    <h1><%= C.titulo %></h1>
    <div style="display:flex; align-items:center; gap:10px;">
      <span class="db-orb db-orb-pg" title="Notas almacenadas en PostgreSQL">🐘</span>
      <span class="count" x-text="contadorTexto"><%= notas.length %> <%= C.plural %></span>
      <% if (notas.length > 0) { %>
      <form method="post" action="<%= C.base %>/eliminar-todo" id="formEliminarTodo">
        <button type="button" class="danger" id="btnEliminarTodo" title="Mueve todo a la papelera (se puede restaurar)">🗑 Eliminar todo</button>
      </form>
      <% } %>
    </div>
  </div>

    <div class="toolbar">
    <div class="search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
      <input type="text" id="searchInput" x-model="q" @input="alEscribir()" placeholder="Buscar por título o contenido…" autocomplete="off">
      <span class="buscando" id="estadoBusqueda"></span>
    </div>
    <button type="button" class="secondary" id="toggleAddBtn" @click="togglePanel('agregar')" :class="{ active: panelActivo === 'agregar' }"><%= C.agregar %></button>
    <button type="button" class="secondary" id="toggleUploadBtn" @click="togglePanel('subir')" :class="{ active: panelActivo === 'subir' }">⬆ Subir archivos</button>
  </div>

  <div class="tabs" id="tabs">
    <button type="button" class="tab" :class="{ active: catActiva === '__todas__' }" @click="setCategoria('__todas__')" data-cat="__todas__">Todas</button>
    <% 
      var LIMITE_PILLS = 6;
      var pillsVisibles = categorias.slice(0, LIMITE_PILLS);
      var pillsExtras = categorias.slice(LIMITE_PILLS);
    %>
    <% pillsVisibles.forEach(function(cat) { %>
      <button type="button" class="tab" :class="{ active: catActiva === '<%= cat.toLowerCase() %>' }" @click="setCategoria('<%= cat.toLowerCase() %>')" data-cat="<%= cat.toLowerCase() %>"><%= cat %></button>
    <% }); %>

    <% if (pillsExtras.length > 0) { %>
      <div class="cat-dropdown-wrap" x-data="{ dropAbierto: false, filtroDrop: '' }" @click.outside="dropAbierto = false">
        <button type="button" class="tab cat-more-btn" @click="dropAbierto = !dropAbierto" :class="{ active: esCatExtra(catActiva) }" title="Ver más categorías">
          <span x-text="nombreCatExtra(catActiva) || ('📂 Más categorías (<%= pillsExtras.length %>) ▾')">📂 Más categorías (<%= pillsExtras.length %>) ▾</span>
        </button>
        <div class="cat-dropdown-menu" x-show="dropAbierto" x-cloak style="display:none;">
          <div class="cat-dropdown-search">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" x-model="filtroDrop" placeholder="Buscar categoría..." @keydown.escape="dropAbierto = false">
            <button type="button" class="cat-dropdown-clear" x-show="filtroDrop" @click="filtroDrop = ''">×</button>
          </div>
          <div class="cat-dropdown-list">
            <% pillsExtras.forEach(function(cat) { %>
              <button type="button" 
                      class="cat-dropdown-item" 
                      :class="{ active: catActiva === '<%= cat.toLowerCase() %>' }"
                      x-show="!filtroDrop || '<%= cat.toLowerCase() %>'.includes(filtroDrop.toLowerCase())"
                      @click="setCategoria('<%= cat.toLowerCase() %>'); dropAbierto = false;">
                <span><%= cat %></span>
                <span class="cat-check" x-show="catActiva === '<%= cat.toLowerCase() %>'">✓</span>
              </button>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="card add-card" id="uploadCard" :class="{ open: panelActivo === 'subir' }">
  <p class="sub" style="margin:0 0 14px;">Sube uno o <strong>varios</strong> archivos a la vez (.txt, .sql, .docx, .pdf y Excel: .xlsx, .xls, .csv). Cada uno se guarda como una nota: se conserva el archivo original (lo puedes descargar), se limpia el texto y se traen las imágenes. Los archivos de Excel se muestran como una hoja de cálculo, con sus pestañas.</p>
  <form method="post" action="<%= C.base %>/subir" enctype="multipart/form-data" id="formSubir">
    <div class="fields">
      <div>
        <label>Apartado (categoría)</label>
        <input type="text" name="categoria" list="listaCategorias" placeholder="<%= C.placeCat %>" required>
      </div>
      <div><label>Título (opcional, solo si subes un archivo)</label><input type="text" name="titulo" placeholder="Si lo dejas vacío, se usa el nombre del archivo"></div>
    </div>
    <label>Archivos (puedes elegir varios — máx. <%= MAXMB %> MB cada uno)</label>
    <input type="file" name="archivos" id="inputArchivos" accept=".txt,.sql,.docx,.pdf,.xlsx,.xlsm,.xls,.csv" multiple required>
    <div class="file-list" id="listaArchivos"></div>
    <button class="full" type="submit" id="btnSubir">Subir y guardar</button>
  </form>
</div>

<div class="card add-card" id="addCard" :class="{ open: panelActivo === 'agregar' }">
  <form method="post" action="<%= C.base %>/agregar">
    <div class="fields">
      <div>
        <label>Apartado (categoría)</label>
        <input type="text" name="categoria" list="listaCategorias" placeholder="<%= C.placeCat %>" required>
        <datalist id="listaCategorias">
          <% categorias.forEach(function(cat) { %><option value="<%= cat %>"></option><% }); %>
        </datalist>
      </div>
      <div><label>Título</label><input type="text" name="titulo" placeholder="<%= C.placeTit %>" required></div>
      <div style="flex:0 0 230px; min-width:180px;">
        <label style="display:flex; justify-content:space-between; align-items:center;">
          Formato / Resaltado
          <span class="db-orb db-orb-sm db-orb-pg" title="Sintaxis PostgreSQL / SQL">🐘</span>
        </label>
        <select name="formato" style="font-family:var(--sans); font-size:13px;">
          <option value="sql" selected>🎨 Código / SQL / Comandos (en color)</option>
          <option value="texto">📄 Texto plano</option>
        </select>
      </div>
    </div>
    <label style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;"><span>Contenido (Editor con resaltado de sintaxis a color)</span><span style="font-size:11px; font-weight:normal; color:var(--muted); font-family:var(--mono);"><kbd style="font-family:var(--mono); font-size:10px; padding:1px 5px; border-radius:4px; border:1px solid var(--panel-edge); background:var(--panel);">Tab</kbd> para sangría · Mitad de pantalla</span></label>
    <div class="nt-ed-frame">
      <div class="nt-ed-toolbar">
        <div class="nt-ed-tit">
          <span class="nt-ed-dot"></span>
          <span>Editor de código SQL</span>
        </div>
        <div class="nt-ed-meta">
          <span class="nt-ed-status">1 línea</span>
          <span class="nt-ed-pos">Lín 1, Col 1</span>
        </div>
      </div>
      <div class="nt-ed-box">
        <div class="nt-ed-gut" aria-hidden="true"><div class="nt-ed-gut-in">1</div></div>
        <div class="nt-ed-code">
          <pre class="nt-ed-capa" aria-hidden="true"></pre>
          <textarea class="nt-ed-input" name="contenido" placeholder="<%= C.placeCont %>" required spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off"></textarea>
        </div>
      </div>
    </div>
    <button class="full" type="submit" style="margin-top:14px;">Guardar</button>
  </form>
</div>

<div id="results">
  <% notas.forEach(function(n) { %>
  <div class="row" data-id="<%= n.id %>" data-cat="<%= n.categoria.toLowerCase() %>" data-tit="<%= n.titulo.toLowerCase() %>" id="row-<%= n.id %>">
    <div class="main" onclick="toggleRow(<%= n.id %>)">
      <div class="name">
        <span class="cat-badge"><%= n.categoria %></span>
        <span class="titulo"><%= n.titulo %><% if (n.es_sql) { %> <span class="sql-badge">SQL</span><% } %><% if (n.es_excel) { %> <span class="excel-badge">EXCEL</span><% } %></span>
        <span class="meta"><% if (n.es_excel) { %>Hoja de cálculo<% } else { %><%= n.lineas.toLocaleString('es-CO') %> línea<%= n.lineas === 1 ? '' : 's' %> · <%= fmtTam(n.largo) %><% } %><% if (n.archivo_nombre) { %> · 📎 <%= n.archivo_nombre %><% } %></span>
      </div>
      <div class="actions">
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="m9 18 6-6-6-6"></path></svg>
      </div>
    </div>

    <div class="body-panel">
      <div class="content-wrap" id="wrap-<%= n.id %>">
        <div class="search-in-note">
          <input type="text" placeholder="<%= C.buscarDentro %>" oninput="buscarEnNota(<%= n.id %>, this.value)" onkeydown="teclaBusqueda(event, <%= n.id %>)" onclick="event.stopPropagation();">
          <span class="match-count" id="matches-<%= n.id %>"></span>
          <button type="button" class="iconbtn" title="Coincidencia anterior (Shift+Enter)" onclick="event.stopPropagation(); irACoincidencia(<%= n.id %>, -1)">▲</button>
          <button type="button" class="iconbtn" title="Siguiente coincidencia (Enter)" onclick="event.stopPropagation(); irACoincidencia(<%= n.id %>, 1)">▼</button>
          <button type="button" class="iconbtn" title="Pantalla completa (Esc para salir)" onclick="event.stopPropagation(); pantallaCompleta(<%= n.id %>)">⤢</button>
        </div>
        <div class="contenido" id="texto-<%= n.id %>" oncontextmenu="mostrarMenuContextual(event, <%= n.id %>)"><div class="cargando">Cargando contenido…</div></div>
      </div>

      <div class="body-actions">
        <button type="button" class="secondary" onclick="event.stopPropagation(); copiarNota(<%= n.id %>)">Copiar</button>
        <button type="button" class="secondary" onclick="event.stopPropagation(); toggleEdit(<%= n.id %>)">Editar</button>
        <button type="button" class="secondary btn-filtrar-ed" onclick="event.stopPropagation(); abrirEditarConFiltro(<%= n.id %>)" title="Abrir editor y filtrar líneas directamente">🔍 Filtrar / Editar</button>
        <% if (!n.es_excel) { %>
        <button type="button" class="secondary" id="btnModo-<%= n.id %>" onclick="event.stopPropagation(); alternarModoCodigo(<%= n.id %>)"><%= n.es_sql ? '📄 Ver como texto' : '🎨 Ver con colores' %></button>
        <% } %>
        <% if (n.archivo_nombre) { %>
        <a class="btn secondary" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"
           href="<%= C.base %>/<%= n.id %>/archivo" onclick="event.stopPropagation();" title="Descargar <%= n.archivo_nombre %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <%= n.archivo_nombre %>
        </a>
        <form method="post" action="<%= C.base %>/<%= n.id %>/quitar-archivo" style="display:inline;"
              onsubmit="event.stopPropagation(); return confirm('¿Quitar el archivo «<%= n.archivo_nombre %>»? El texto se conserva.');"
              onclick="event.stopPropagation();">
          <button type="submit" class="iconbtn" title="Quitar solo el archivo adjunto">
