<script type="application/json" id="notasMeta"><%- JSON.stringify(notas.map(function(n){ return { id: n.id, esSql: !!n.es_sql, esExcel: !!n.es_excel }; })) %></script>

<script>
/* ---------- Controlador Reactivo Alpine.js de Notas / Jaivaná ---------- */
window.notasAlpineApp = function() {
  return {
    q: '',
    catActiva: '__todas__',
    panelActivo: null,
    totalNotas: <%= notas.length %>,
    visibles: <%= notas.length %>,

    init() {
      window.addEventListener('keydown', (e) => {
        const t = e.target;
        const escribiendo = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
        if (e.key === '/' && !escribiendo && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          const inp = document.getElementById('searchInput');
          if (inp) { inp.focus(); inp.select(); }
        } else if (e.key === 'Escape') {
          if (this.panelActivo) {
            this.cerrarPaneles();
          } else if (t && t.id === 'searchInput') {
            this.q = '';
            this.alEscribir();
            t.blur();
          }
        }
      });
    },

    togglePanel(nombre) {
      if (this.panelActivo === nombre) {
        this.cerrarPaneles();
      } else {
        this.panelActivo = nombre;
        this.$nextTick(() => {
          const card = document.getElementById(nombre === 'agregar' ? 'addCard' : 'uploadCard');
          if (card) {
            const ta = card.querySelector('.nt-ed-input, input[type=text]');
            if (ta) {
              if (typeof actualizarEditorNota === 'function') actualizarEditorNota(ta);
              setTimeout(() => ta.focus(), 60);
            }
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }
    },

    cerrarPaneles() {
      this.panelActivo = null;
    },

        esCatExtra(cat) {
      if (!cat || cat === '__todas__') return false;
      const extras = <%- JSON.stringify(categorias.slice(6).map(function(c){ return { raw: c, low: c.toLowerCase() }; })) %>;
      return extras.some(e => e.low === cat);
    },

    nombreCatExtra(cat) {
      if (!cat || cat === '__todas__') return null;
      const extras = <%- JSON.stringify(categorias.slice(6).map(function(c){ return { raw: c, low: c.toLowerCase() }; })) %>;
      const m = extras.find(e => e.low === cat);
      return m ? ('📂 ' + m.raw + ' ▾') : null;
    },
    setCategoria(cat) {
      this.catActiva = cat;
      categoriaActiva = cat;
      if (typeof aplicarFiltros === 'function') {
        aplicarFiltros();
        this.actualizarVisibles();
      }
    },

    alEscribir() {
      textoBusqueda = (this.q || '').trim();
      if (typeof aplicarFiltros === 'function') {
        aplicarFiltros();
        this.actualizarVisibles();
      }
      clearTimeout(debounceBusqueda);
      debounceBusqueda = setTimeout(() => {
        if (typeof buscarEnServidor === 'function') buscarEnServidor(this.q);
      }, 180);
    },

    actualizarVisibles() {
      const rows = document.querySelectorAll('#results .row');
      let count = 0;
      rows.forEach(r => { if (r.style.display !== 'none') count++; });
      this.visibles = count;
    },

    get contadorTexto() {
      const plural = <%- JSON.stringify(C.plural) %>;
      if (this.q || this.catActiva !== '__todas__') {
        const suf = this.catActiva === '__todas__' ? '' : (' [' + this.catActiva.toUpperCase() + ']');
        return this.visibles + ' de ' + this.totalNotas + ' ' + plural + suf;
      }
      return this.totalNotas + ' ' + plural;
    }
  };
};

const RUTA_BASE = <%- JSON.stringify(C.base) %>;
const MAX_MB = <%= MAXMB %>;
const LOTE = 100;           // líneas que se dibujan por bloque (el resto se carga al desplazarse)
const MAX_LINEA = 20000;    // las líneas más largas se recortan, con botón para verlas completas
const SALTO = 120;          // si una coincidencia está más lejos que esto, se dibuja solo una ventana alrededor de ella
const AVISO_CARGAR_TODO = 60000; // "cargar todo" pide confirmación si faltan más líneas que esto

let categoriaActiva = '__todas__';
let textoBusqueda = '';
let idsCoinciden = null;
let seqBusqueda = 0;

const notasData = {};
JSON.parse(document.getElementById('notasMeta').textContent).forEach(function(n){
  notasData[n.id] = {
    esSql: n.esSql, esExcel: n.esExcel, xl: null, cargandoHoja: null, xlHits: [], xlHitSets: [], xlPorHoja: [], xlIdx: -1, xlTotal: 0, texto: null, lineas: null, clases: null, modo: 'auto',
    query: '', regex: null, usarCodigo: false, hasta: 0, estado: { bloque: false },
    expandidas: new Set(), coinc: [], idx: -1, cargando: null, desde: 0
  };
});

function escapeHtml(str){
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function escapeRegExp(str){
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// ---------------------------------------------------------------------------
// Imágenes: en el texto aparecen como una línea [[IMG:n]]
// ---------------------------------------------------------------------------
const RE_IMG = /^\s*\[\[IMG:(\d+)\]\]\s*$/;

function htmlImagen(id, n){
  const src = RUTA_BASE + '/' + id + '/imagen/' + n;
  return '<a class="img-wrap" href="' + src + '" target="_blank" rel="noopener" onclick="event.stopPropagation()"><img class="nota-img" loading="lazy" src="' + src + '" alt="Imagen ' + n + '"></a>';
}

// ---------------------------------------------------------------------------
// Resaltado de sintaxis SQL (estilo editor de código)
// ---------------------------------------------------------------------------
const SQL_KW = new Set(('select from where insert into values update set delete create alter drop table view index ' +
  'trigger procedure function database schema join inner left right full outer cross on and or not null is in like ilike ' +
  'between exists distinct as order by group having limit offset union all case when then else end begin commit rollback ' +
  'declare if while return returns primary key foreign references default constraint unique check add column modify rename ' +
  'to with grant revoke truncate merge using asc desc over partition exec execute cascade identity varchar char int integer ' +
  'bigint numeric decimal datetime timestamp boolean float money true false').split(' '));

const TOKEN_RE = /--.*|\/\/.*|#.*|'(?:[^'\n]|'')*'|"(?:[^"\n]|"")*"|`[^`\n]*`|[@:$][A-Za-z0-9_]+|\d+(?:\.\d+)?|[A-Za-z_][\w$#@]*|\s+|./y;

function tokenizarSqlLinea(linea, estado){
  const tokens = [];
  let i = 0;
  if (estado.bloque) {
    const fin = linea.indexOf('*/');
    if (fin === -1) { return [{ t: linea, c: 'cm' }]; }
    tokens.push({ t: linea.slice(0, fin + 2), c: 'cm' });
    estado.bloque = false;
    i = fin + 2;
  }
  while (i < linea.length) {
    if (linea.startsWith('/*', i)) {
      const fin = linea.indexOf('*/', i + 2);
      if (fin === -1) { tokens.push({ t: linea.slice(i), c: 'cm' }); estado.bloque = true; break; }
      tokens.push({ t: linea.slice(i, fin + 2), c: 'cm' });
      i = fin + 2;
      continue;
    }
    TOKEN_RE.lastIndex = i;
    const m = TOKEN_RE.exec(linea);
    if (!m) {
      tokens.push({ t: linea.slice(i), c: null });
      break;
    }
    const txt = m[0];
    let c = null;
    if (txt.startsWith('--') || txt.startsWith('//') || txt.startsWith('#')) c = 'cm';
    else if (txt[0] === "'" || txt[0] === '`') c = 'st';
    else if (txt[0] === '"') c = 'id';
    else if (txt[0] === '@' || txt[0] === ':' || (txt[0] === '$' && txt.length > 1)) c = 'pa';
    else if (/^\d/.test(txt)) c = 'nu';
    else if (/^[A-Za-z_]/.test(txt)) {
      if (SQL_KW.has(txt.toLowerCase())) c = 'kw';
      else if (linea[i + txt.length] === '(') c = 'fn';
      else c = 'id';
    }
    else if (!/^\s+$/.test(txt)) c = 'op';
    tokens.push({ t: txt, c: c });
    i += txt.length;
  }
  return tokens;
}

// ¿Esta línea (ya recortada) parece SQL o es texto/explicación?
const SQL_INICIO_LINEA = /^(select|insert\s+into|update|delete\s+from|create\s+(or\s+replace\s+)?(table|view|procedure|function|index|trigger)|alter\s+table|drop\s+(table|view|index)|truncate\s+table|merge\s+into|with|values|set|from|where|and|or|on|into|order\s+by|group\s+by|left\s+join|right\s+join|inner\s+join|join)\b/i;
const SQL_INICIO_SENTENCIA = /^(select|insert\s+into|update|delete\s+from|create\s|alter\s+table|drop\s|truncate\s|merge\s+into|with\s)/i;

function lineaPareceSql(t){
  if (/^--/.test(t) || /^\/\*/.test(t) || /\*\/$/.test(t)) return true;
  if (SQL_INICIO_LINEA.test(t)) return true;
  if (/;\s*$/.test(t)) return true;
  if (/=\s*'/.test(t) && /[(),]/.test(t)) return true;
  if (/\(.*\)/.test(t) && /,/.test(t)) return true;
  return false;
}

// Marca cada línea como SQL (true) o texto (false). Las líneas que siguen
// a una sentencia SQL sin terminar (sin ;) se consideran parte de ella.
function clasificarLineas(lineas){
  const res = new Array(lineas.length);
  let enSentencia = false;
  for (let i = 0; i < lineas.length; i++) {
    const linea = lineas[i];
    const t = (linea.length > 400 ? linea.slice(0, 400) : linea).replace(/^\s*[*•\-]\s+(?=\S)/, '').trim();
    if (!t) { res[i] = true; enSentencia = false; continue; }
    if (t.indexOf('[[IMG:') === 0 && RE_IMG.test(t)) { res[i] = true; continue; }
    let esSql = lineaPareceSql(t);
    if (SQL_INICIO_SENTENCIA.test(t)) enSentencia = true;
    else if (!esSql && enSentencia) esSql = true;
    if (/;\s*$/.test(linea.length > 400 ? linea.slice(-50) : t)) enSentencia = false;
    res[i] = esSql;
  }
  return res;
}

// Convierte tokens + rangos de coincidencia de búsqueda en HTML
function tokensAHtml(tokens, intervalos){
  if (!tokens || !tokens.length) return '';
  if (!intervalos || !intervalos.length) {
    let out = '';
    for (let j = 0; j < tokens.length; j++) {
      const tk = tokens[j];
      const esc = escapeHtml(tk.t);
      out += tk.c ? '<span class="tk-' + tk.c + '">' + esc + '</span>' : esc;
    }
    return out;
  }
  let out = '';
  let pos = 0;
  let k = 0;
  for (let j = 0; j < tokens.length; j++) {
    const tk = tokens[j];
    const ini = pos;
    const fin = pos + tk.t.length;
    let cursor = ini;
    let html = '';
    while (cursor < fin) {
      while (k < intervalos.length && intervalos[k][1] <= cursor) k++;
      const iv = intervalos[k];
      if (!iv || iv[0] >= fin) { html += escapeHtml(tk.t.slice(cursor - ini)); cursor = fin; }
      else if (iv[0] > cursor) { html += escapeHtml(tk.t.slice(cursor - ini, iv[0] - ini)); cursor = iv[0]; }
      else {
        const hasta = Math.min(iv[1], fin);
        html += '<mark>' + escapeHtml(tk.t.slice(cursor - ini, hasta - ini)) + '</mark>';
        cursor = hasta;
      }
    }
    out += tk.c ? '<span class="tk-' + tk.c + '">' + html + '</span>' : html;
    pos = fin;
  }
  return out;
}

function buscarIntervalos(linea, regex, qLow){
  const res = [];
  if (!regex || !linea) return res;
  if (qLow && linea.toLowerCase().indexOf(qLow) === -1) return res;
  regex.lastIndex = 0;
  let m;
  while ((m = regex.exec(linea)) !== null) {
    if (m[0] === '') { regex.lastIndex++; continue; }
    res.push([m.index, m.index + m[0].length]);
  }
  return res;
}

// ---------------------------------------------------------------------------
// Carga del contenido (se pide al servidor cuando se abre la nota)
// ---------------------------------------------------------------------------
function cargarContenido(id){
  const d = notasData[id];
  if (d.texto !== null) return Promise.resolve(d);
  if (d.cargando) return d.cargando;

  d.cargando = fetch(RUTA_BASE + '/' + id + '/contenido', { credentials: 'same-origin' })
    .then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
    .then(function(t){
      d.texto = t;
      d.lineas = t.split('\n');
      d.cargando = null;
      const ta = document.querySelector('#edit-' + id + ' textarea');
      if (ta) {
        ta.value = t;
        ta.readOnly = false;
        ta.placeholder = '';
      }
      const bt = document.querySelector('#edit-' + id + ' button[type=submit]');
      if (bt) bt.disabled = false;
      return d;
    })
    .catch(function(e){ d.cargando = null; throw e; });

  return d.cargando;
}

// ---------------------------------------------------------------------------
// Dibujo del contenido por bloques (soporta archivos con cientos de miles de líneas)
// ---------------------------------------------------------------------------
function htmlLinea(id, d, i){
  let linea = d.lineas[i];
  let cuerpo;
  const mi = (linea.indexOf('[[IMG:') !== -1) ? linea.match(RE_IMG) : null;

  if (mi) {
    cuerpo = htmlImagen(id, mi[1]);
  } else {
    const expandida = d.expandidas.has(i);
    let resto = 0;
    if (linea.length > MAX_LINEA && !expandida) {
      resto = linea.length - MAX_LINEA;
      linea = linea.slice(0, MAX_LINEA);
    }
    const intervalos = buscarIntervalos(linea, d.regex, d.queryLower);
    let tokens;
    if (d.usarCodigo) {
      if (linea.length >= MAX_LINEA || expandida) tokens = linea ? [{ t: linea, c: null }] : [];
      else tokens = d.clases[i] ? tokenizarSqlLinea(linea, d.estado) : (linea ? [{ t: linea, c: 'pl' }] : []);
    } else {
      tokens = linea ? [{ t: linea, c: null }] : [];
    }
    cuerpo = tokensAHtml(tokens, intervalos) || '&nbsp;';
    if (resto) {
      cuerpo += ' <a class="ver-mas" href="#" onclick="mostrarLineaCompleta(' + id + ',' + i + '); return false;">… +' + resto.toLocaleString('es-CO') + ' caracteres · mostrar línea completa</a>';
    }
  }

  if (d.usarCodigo) {
    return '<div class="code-line" data-i="' + i + '"><span class="ln">' + (i + 1) + '</span><span class="code-text">' + cuerpo + '</span></div>';
  }
  return '<div class="pl-line" data-i="' + i + '">' + cuerpo + '</div>';
}

function agregarLineas(id, n){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  if (!d || !cont || d.lineas === null || d.hasta >= d.lineas.length) return;

  const viejo = cont.querySelector('.mas-lineas');
  if (viejo) viejo.remove();

  const fin = Math.min(d.lineas.length, d.hasta + n);
  let html = '';
  for (let i = d.hasta; i < fin; i++) html += htmlLinea(id, d, i);
  d.hasta = fin;

  if (fin < d.lineas.length) {
    html += '<div class="mas-lineas">Mostrando ' + (d.desde > 0 ? 'las líneas ' + (d.desde + 1).toLocaleString('es-CO') + ' a ' : '') + fin.toLocaleString('es-CO') + ' de ' + d.lineas.length.toLocaleString('es-CO') +
      ' líneas — sigue bajando para cargar más · <a href="#" onclick="cargarTodo(' + id + '); return false;">cargar todo</a></div>';
  }
  cont.insertAdjacentHTML('beforeend', html);
}

function cargarTodo(id){
  const d = notasData[id];
  const faltan = d.lineas.length - d.hasta;
  if (faltan > AVISO_CARGAR_TODO && !confirm('Faltan ' + faltan.toLocaleString('es-CO') + ' líneas. Dibujarlas todas puede tardar y usar mucha memoria del navegador.\n\nPuedes usar el buscador para ir directo a lo que necesitas. ¿Cargar todo de todos modos?')) return;
  agregarLineas(id, faltan);
}

// Dibuja un bloque de líneas empezando en "desde" (para saltar lejos sin dibujar todo lo del medio)
function posicionarVentana(id, desde){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  if (!d || !cont || d.lineas === null) return;
  d.desde = desde;
  d.hasta = desde;
  d.estado = { bloque: false };
  cont.innerHTML = '';
  if (desde > 0) {
    cont.insertAdjacentHTML('beforeend', '<div class="mas-arriba">↑ No se muestran las primeras ' + desde.toLocaleString('es-CO') +
      ' líneas · <a href="#" onclick="verDesdeInicio(' + id + '); return false;">mostrar desde el inicio</a></div>');
  }
  agregarLineas(id, LOTE);
}

function verDesdeInicio(id){
  posicionarVentana(id, 0);
  const cont = document.getElementById('texto-' + id);
  if (cont) cont.scrollTop = 0;
}

function mostrarLineaCompleta(id, i){
  const d = notasData[id];
  d.expandidas.add(i);
  const cont = document.getElementById('texto-' + id);
  const el = cont.querySelector('[data-i="' + i + '"]');
  if (el) el.outerHTML = htmlLinea(id, d, i);
}

function renderContenido(id, query){
  const d = notasData[id];
  if (d && d.esExcel) { renderExcel(id, query); return; }
  if (!d || d.texto === null) return;
  const cont = document.getElementById('texto-' + id);
  if (!cont) return;

  d.query = query || '';
  d.queryLower = d.query ? d.query.toLowerCase() : '';
  d.regex = d.query ? new RegExp(escapeRegExp(d.query), 'gi') : null;
  d.usarCodigo = d.modo === 'codigo' || (d.modo === 'auto' && d.esSql);
  if (d.usarCodigo && !d.clases) d.clases = clasificarLineas(d.lineas);
  d.hasta = 0;
  d.desde = 0;
  d.estado = { bloque: false };

  cont.classList.toggle('code-block', d.usarCodigo);
  cont.classList.toggle('contenido', !d.usarCodigo);
  const btnModo = document.getElementById('btnModo-' + id);
  if (btnModo) btnModo.textContent = d.usarCodigo ? '📄 Ver como texto' : '🎨 Ver con colores';

  if (!cont.dataset.scroll) {
    cont.dataset.scroll = '1';
    cont.addEventListener('scroll', function(){
      if (cont.scrollTop + cont.clientHeight > cont.scrollHeight - 500) agregarLineas(id, LOTE);
    });
  }

  calcularCoincidencias(id, false);

  if (d.coinc && d.coinc.length > 0) {
    const primera = d.coinc[0];
    const inicio = primera > 20 ? Math.max(0, primera - 15) : 0;
    posicionarVentana(id, inicio);
    d.idx = 0;
    actualizarContadorCoincidencias(id);
    const el = cont.querySelector('[data-i="' + primera + '"]');
    if (el) {
      el.classList.add('cur-line');
      el.scrollIntoView({ block: 'center' });
    }
  } else {
    posicionarVentana(id, 0);
  }
}

// ---------------------------------------------------------------------------
// Hojas de cálculo: se dibujan como una hoja de Excel (letras, números, pestañas)
// ---------------------------------------------------------------------------
const XL_LOTE = 250; // filas que se dibujan por bloque (el resto al desplazarse)
const RE_NUM = /^[-+(]?[$€]?\s?\d[\d.,:\/\-]*\s?%?\)?$/;

function letraColumna(n){
  let s = '';
  n++;
  while (n > 0) {
    const m = (n - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    n = Math.floor((n - 1) / 26);
  }
  return s;
}

function tsvHoja(h){
  return h.filas.map(function(f){
    return f.map(function(t){ return t.replace(/[\t\r\n]+/g, ' '); }).join('\t');
  }).join('\n');
}

function cargarHoja(id){
  const d = notasData[id];
  if (d.xl) return Promise.resolve(d);
  if (d.cargandoHoja) return d.cargandoHoja;

  d.cargandoHoja = fetch(RUTA_BASE + '/' + id + '/hoja', { credentials: 'same-origin' })
    .then(function(r){
      return r.json().then(function(j){
        if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
        return j;
      });
    })
    .then(function(j){
      d.xl = { hojas: j.hojas, activa: 0, dibujadas: 0 };
      d.cargandoHoja = null;
      return d;
    })
    .catch(function(e){ d.cargandoHoja = null; throw e; });

  return d.cargandoHoja;
}

// Celdas combinadas: la de arriba a la izquierda se estira, las demás no se dibujan
function mapaCombinadas(h){
  if (h._mm) return h._mm;
  const origen = new Map();
  const cubiertas = new Set();
  (h.combinadas || []).forEach(function(m){
    origen.set(m[0] * 128 + m[1], [m[2] - m[0] + 1, m[3] - m[1] + 1]);
    for (let r = m[0]; r <= m[2]; r++) {
      for (let c = m[1]; c <= m[3]; c++) {
        if (r !== m[0] || c !== m[1]) cubiertas.add(r * 128 + c);
      }
    }
  });
  h._mm = { origen: origen, cubiertas: cubiertas };
  return h._mm;
}

function construirExcel(id, cont){
  cont.className = 'xl-box';
  cont.innerHTML =
    '<div class="xl-barra"><div class="xl-ref" id="xlref-' + id + '">A1</div><div class="xl-fx">fx</div><div class="xl-valor" id="xlval-' + id + '"></div></div>' +
    '<div class="xl-aviso" id="xlaviso-' + id + '" style="display:none"></div>' +
    '<div class="xl-scroll"></div>' +
    '<div class="xl-hojas"></div>';

  const sc = cont.querySelector('.xl-scroll');
  sc.addEventListener('scroll', function(){
    if (sc.scrollTop + sc.clientHeight > sc.scrollHeight - 600) agregarFilasExcel(id, XL_LOTE);
  });
  sc.addEventListener('click', function(e){
    const td = e.target.closest ? e.target.closest('td[data-r]') : null;
    if (td) seleccionarCelda(id, Number(td.dataset.r), Number(td.dataset.c), td);
  });
}

function seleccionarCelda(id, r, c, td){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  cont.querySelectorAll('.xl-sel').forEach(function(e){ e.classList.remove('xl-sel'); });
  if (td) td.classList.add('xl-sel');
  const h = d.xl.hojas[d.xl.activa];
  document.getElementById('xlref-' + id).textContent = letraColumna(c) + (r + 1);
  document.getElementById('xlval-' + id).textContent = (h.filas[r] && h.filas[r][c]) || '';
}

function htmlFilaExcel(h, mm, hits, r){
  const f = h.filas[r];
  let s = '<tr><td class="xl-rh">' + (r + 1) + '</td>';
  for (let c = 0; c < h.nCols; c++) {
    const k = r * 128 + c;
    if (mm.cubiertas.has(k)) continue;
    const m = mm.origen.get(k);
    const t = f[c] || '';
    let cls = '';
    if (t && RE_NUM.test(t)) cls = 'xl-n';
    if (hits && hits.has(k)) cls += ' xl-hit';
    s += '<td data-r="' + r + '" data-c="' + c + '"' + (cls ? ' class="' + cls.trim() + '"' : '') +
      (m ? ' rowspan="' + m[0] + '" colspan="' + m[1] + '"' : '') + '>' + escapeHtml(t) + '</td>';
  }
  return s + '</tr>';
}

function agregarFilasExcel(id, n){
  const d = notasData[id];
  const x = d.xl;
  const cont = document.getElementById('texto-' + id);
  const tb = cont ? cont.querySelector('.xl-scroll tbody') : null;
  if (!x || !tb) return;
  const h = x.hojas[x.activa];
  if (x.dibujadas >= h.filas.length) return;

  const mm = mapaCombinadas(h);
  const hits = d.xlHitSets[x.activa];
  const fin = Math.min(h.filas.length, x.dibujadas + n);
  let html = '';
  for (let r = x.dibujadas; r < fin; r++) html += htmlFilaExcel(h, mm, hits, r);
  tb.insertAdjacentHTML('beforeend', html);
  x.dibujadas = fin;
}

function dibujarHoja(id){
  const d = notasData[id];
  const x = d.xl;
  const cont = document.getElementById('texto-' + id);
  const sc = cont.querySelector('.xl-scroll');
  const h = x.hojas[x.activa];

  const aviso = document.getElementById('xlaviso-' + id);
  if (h.truncada) {
    aviso.style.display = '';
    aviso.textContent = 'La hoja es muy grande y se recortó para mostrarla (' + h.filas.length.toLocaleString('es-CO') +
      ' filas × ' + h.nCols + ' columnas). Descarga el archivo original para verla completa.';
  } else {
    aviso.style.display = 'none';
  }

  document.getElementById('xlref-' + id).textContent = 'A1';
  document.getElementById('xlval-' + id).textContent = '';
  x.dibujadas = 0;

  if (!h.filas.length) {
    sc.innerHTML = '<div class="cargando" style="color:#666; padding:14px;">Esta hoja está vacía.</div>';
    return;
  }

  let cols = '<col style="width:46px">';
  let ancho = 46;
  let cab = '<tr><th class="xl-esq"></th>';
  for (let c = 0; c < h.nCols; c++) {
    const w = Math.round(((h.anchos && h.anchos[c]) || 11) * 7 + 10);
    cols += '<col style="width:' + w + 'px">';
    ancho += w;
    cab += '<th>' + letraColumna(c) + '</th>';
  }
  cab += '</tr>';

  sc.innerHTML = '<table class="xl-table" style="width:' + ancho + 'px"><colgroup>' + cols + '</colgroup><thead>' + cab + '</thead><tbody></tbody></table>';
  sc.scrollTop = 0;
  sc.scrollLeft = 0;
  agregarFilasExcel(id, XL_LOTE);
}

function dibujarPestanasExcel(id){
  const d = notasData[id];
  const x = d.xl;
  const cont = document.getElementById('texto-' + id);
  const barra = cont.querySelector('.xl-hojas');
  barra.innerHTML = x.hojas.map(function(h, i){
    const n = d.xlPorHoja[i] || 0;
    return '<div class="xl-hoja' + (i === x.activa ? ' activa' : '') + '" onclick="event.stopPropagation(); cambiarHojaExcel(' + id + ',' + i + ')">' +
      escapeHtml(h.nombre) + (n ? '<span class="xl-cuenta">' + n.toLocaleString('es-CO') + '</span>' : '') + '</div>';
  }).join('');
}

function cambiarHojaExcel(id, i){
  const x = notasData[id].xl;
  if (!x || i === x.activa) return;
  x.activa = i;
  dibujarHoja(id);
  dibujarPestanasExcel(id);
}

function calcularHitsExcel(d, q){
  d.xlHits = [];
  d.xlHitSets = [];
  d.xlPorHoja = [];
  d.xlIdx = -1;
  d.xlTotal = 0;
  if (!q) return;
  const ql = q.toLowerCase();
  d.xl.hojas.forEach(function(h, hi){
    const set = new Set();
    let cuenta = 0;
    h.filas.forEach(function(f, r){
      for (let c = 0; c < f.length; c++) {
        const t = f[c];
        if (t && t.length >= ql.length && t.toLowerCase().indexOf(ql) !== -1) {
          set.add(r * 128 + c);
          cuenta++;
          if (d.xlHits.length < 20000) d.xlHits.push([hi, r, c]);
        }
      }
    });
    d.xlHitSets[hi] = set;
    d.xlPorHoja[hi] = cuenta;
    d.xlTotal += cuenta;
  });
}

function actualizarContadorExcel(id){
  const d = notasData[id];
  const el = document.getElementById('matches-' + id);
  if (!el) return;
  if (!d.query) { el.textContent = ''; return; }
  if (!d.xlHits.length) { el.textContent = 'Sin resultados'; return; }
  el.textContent = (d.xlIdx + 1) + ' de ' + d.xlTotal.toLocaleString('es-CO') + (d.xlTotal === 1 ? ' celda' : ' celdas');
}

function renderExcel(id, query){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  if (!d || !d.xl || !cont) return;

  if (!cont.querySelector('.xl-scroll')) construirExcel(id, cont);

  d.query = query || '';
  calcularHitsExcel(d, d.query);
  if (d.xlHits.length) d.xl.activa = d.xlHits[0][0]; // abre en la primera hoja con coincidencias

  dibujarHoja(id);
  dibujarPestanasExcel(id);

  if (d.xlHits.length) irACoincidenciaExcel(id, 0, true);
  else actualizarContadorExcel(id);
}

function irACoincidenciaExcel(id, dir, inicial){
  const d = notasData[id];
  if (!d || !d.xl || !d.xlHits.length) return;
  d.xlIdx = inicial ? 0 : (d.xlIdx + dir + d.xlHits.length) % d.xlHits.length;
  const hit = d.xlHits[d.xlIdx];
  const cont = document.getElementById('texto-' + id);

  if (hit[0] !== d.xl.activa) {
    d.xl.activa = hit[0];
    dibujarHoja(id);
    dibujarPestanasExcel(id);
  }
  if (hit[1] >= d.xl.dibujadas) agregarFilasExcel(id, hit[1] - d.xl.dibujadas + XL_LOTE);

  cont.querySelectorAll('.xl-cur').forEach(function(e){ e.classList.remove('xl-cur'); });
  const td = cont.querySelector('td[data-r="' + hit[1] + '"][data-c="' + hit[2] + '"]');
  if (td) {
    td.classList.add('xl-cur');
    seleccionarCelda(id, hit[1], hit[2], td);
    td.scrollIntoView({ block: 'center', inline: 'nearest' });
  }
  actualizarContadorExcel(id);
}

// ---------------------------------------------------------------------------
// Búsqueda dentro de la nota
// ---------------------------------------------------------------------------
function actualizarContadorCoincidencias(id){
  const d = notasData[id];
  const el = document.getElementById('matches-' + id);
  if (!el) return;
  if (!d.coinc || !d.coinc.length) {
    el.textContent = d.query ? 'Sin resultados' : '';
    return;
  }
  if (d.idx >= 0 && d.coinc.length > 1) {
    el.textContent = (d.idx + 1) + ' de ' + d.coinc.length + ' líneas' + (d.totalTexto ? ' (' + d.totalTexto + ')' : '');
  } else {
    el.textContent = d.totalTexto || '';
  }
}

function calcularCoincidencias(id, autoNavegar){
  const d = notasData[id];
  d.coinc = [];
  d.idx = -1;

  if (!d.query) {
    actualizarContadorCoincidencias(id);
    return;
  }

  let total = 0;
  const qLow = d.queryLower || d.query.toLowerCase();
  const qLen = qLow.length;
  const lineas = d.lineas;
  const len = lineas.length;

  for (let i = 0; i < len; i++) {
    const l = lineas[i];
    if (l.length < qLen) continue;
    const lLow = l.toLowerCase();
    let p = lLow.indexOf(qLow);
    if (p === -1) continue;
    d.coinc.push(i);
    let c = 0;
    while (p !== -1) {
      c++;
      p = lLow.indexOf(qLow, p + qLen);
    }
    total += c;
  }

  d.totalTexto = total
    ? total.toLocaleString('es-CO') + (total === 1 ? ' resultado' : ' resultados')
    : '';

  actualizarContadorCoincidencias(id);

  if (autoNavegar && d.coinc.length) irACoincidencia(id, 0, true);
}

function irACoincidencia(id, dir, inicial){
  const d = notasData[id];
  if (d && d.esExcel) { irACoincidenciaExcel(id, dir, inicial); return; }
  if (!d || !d.coinc || !d.coinc.length) return;
  d.idx = inicial ? 0 : (d.idx + dir + d.coinc.length) % d.coinc.length;
  const linea = d.coinc[d.idx];
  const cont = document.getElementById('texto-' + id);
  if (!cont) return;

  actualizarContadorCoincidencias(id);

  if (d.lineas[linea].length > MAX_LINEA && !d.expandidas.has(linea)) {
    d.expandidas.add(linea);
    const previo = cont.querySelector('[data-i="' + linea + '"]');
    if (previo) previo.outerHTML = htmlLinea(id, d, linea);
  }

  let el = cont.querySelector('[data-i="' + linea + '"]');
  if (!el) {
    if (linea < d.desde || linea >= d.hasta + SALTO) {
      posicionarVentana(id, Math.max(0, linea - 15));
    } else if (linea >= d.hasta) {
      agregarLineas(id, Math.min(LOTE, linea - d.hasta + 25));
    }
    el = cont.querySelector('[data-i="' + linea + '"]');
  }

  cont.querySelectorAll('.cur-line').forEach(function(e){ e.classList.remove('cur-line'); });
  if (el) {
    el.classList.add('cur-line');
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
}

const debounceEnNota = {};
function buscarEnNota(id, query){
  clearTimeout(debounceEnNota[id]);
  debounceEnNota[id] = setTimeout(function(){
    renderContenido(id, query.trim());
  }, 120);
}

function teclaBusqueda(e, id){
  if (e.key === 'Enter') {
    e.preventDefault();
    e.stopPropagation();
    irACoincidencia(id, e.shiftKey ? -1 : 1);
  }
}

