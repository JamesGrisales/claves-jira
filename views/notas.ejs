<style>
  .top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
  .top h1{ margin:0; }
  .top .count{ color:var(--accent-dark); background:var(--accent-soft); font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; }
  .toolbar{ display:flex; gap:10px; margin-bottom:14px; }
  .toolbar .search-wrap{ position:relative; flex:1; }
  .toolbar .search-wrap input{ padding-left:38px; font-family:var(--sans); font-size:14.5px; }
  .toolbar .search-wrap svg{ position:absolute; left:12px; top:50%; transform:translateY(-50%); width:16px; height:16px; stroke:var(--muted); pointer-events:none; }
  .toolbar button{ white-space:nowrap; }

  .tabs{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
  .tab{ background:var(--panel); border:1px solid var(--panel-edge); color:var(--muted); font-size:12.5px; font-weight:600; padding:7px 14px; border-radius:999px; cursor:pointer; transition:border-color .15s ease, color .15s ease, background-color .15s ease, transform .12s cubic-bezier(.34,1.56,.64,1), box-shadow .15s ease; }
  .tab:hover{ border-color:var(--accent); color:var(--accent-dark); transform:translateY(-1px); box-shadow:0 2px 8px rgba(20,30,45,.08); }
  .tab:active{ transform:translateY(0) scale(.96); }
  .tab.active{ background:linear-gradient(135deg, var(--accent), var(--accent-dark)); border-color:var(--accent); color:#fff; box-shadow:0 2px 8px rgba(47,158,143,.3); }

  #results{ display:flex; flex-direction:column; gap:8px; }
  .row{ background:var(--panel); border:1px solid var(--panel-edge); border-radius:12px; padding:13px 15px; box-shadow:var(--shadow); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease, background-color .2s ease; }
  .row:hover{ border-color:var(--accent); transform:translateY(-1px); box-shadow:0 4px 14px rgba(20,30,45,.08), 0 1px 2px rgba(20,30,45,.05); }
  .row .main{ display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer; }
  .row .name{ display:flex; flex-direction:column; gap:3px; min-width:0; }
  .row .name .titulo{ font-size:14.5px; font-weight:600; overflow-wrap:anywhere; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .row .name .meta{ font-size:11.5px; color:var(--muted); overflow-wrap:anywhere; }
  .row .name .cat-badge{ font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--accent-dark); background:var(--accent-soft); display:inline-block; padding:2px 8px; border-radius:6px; width:fit-content; transition:background-color .18s ease, color .18s ease; }
  .row:hover .cat-badge{ background:var(--accent); color:#fff; }
  .row .actions{ display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .iconbtn{ background:transparent; border:1px solid var(--panel-edge); color:var(--muted); width:30px; height:30px; border-radius:7px; padding:0; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:border-color .15s ease, color .15s ease, transform .12s cubic-bezier(.34,1.56,.64,1), background-color .15s ease; flex-shrink:0; }
  .iconbtn:hover{ border-color:var(--accent); color:var(--accent-dark); background:var(--accent-soft); transform:translateY(-1px); }
  .iconbtn:active{ transform:translateY(0) scale(.92); }
  .iconbtn svg{ width:14px; height:14px; }
  .chev{ transition: transform .2s cubic-bezier(.34,1.56,.64,1); color:var(--muted); }
  .row:hover .chev{ color:var(--accent-dark); }
  .row.open .chev{ transform:rotate(90deg); color:var(--accent-dark); }

  @keyframes panelIn{ from{ opacity:0; transform:translateY(-4px); } to{ opacity:1; transform:translateY(0); } }
  .body-panel{ display:none; margin-top:12px; padding-top:12px; border-top:1px dashed var(--panel-edge); }
  .row.open .body-panel{ display:block; animation:panelIn .18s ease; }
  .contenido{ background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:9px; padding:12px 14px; font-family:var(--mono); font-size:13px; line-height:1.55; color:var(--text); margin:0; max-height:68vh; min-height:80px; overflow:auto; resize:vertical; tab-size:4; }
  .content-wrap{ margin-bottom:10px; }
  .body-actions{ display:flex; gap:8px; margin-bottom:10px; flex-wrap:wrap; }

  .sql-badge{ font-size:10.5px; font-weight:800; letter-spacing:.05em; color:#fff; background:linear-gradient(135deg, var(--accent), var(--accent-dark)); padding:2px 7px; border-radius:5px; }
  .search-in-note{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }
  .search-in-note input{
    flex:1; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text);
    font-family:var(--sans); font-size:13px; padding:8px 11px; border-radius:8px; outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .search-in-note input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .search-in-note .match-count{ font-size:11.5px; color:var(--muted); white-space:nowrap; flex-shrink:1; min-width:0; max-width:38%; overflow:hidden; text-overflow:ellipsis; text-align:right; }
  div.contenido mark, .code-text mark{ background:#ffe58a; color:#1c2530; border-radius:2px; padding:0 1px; }
  :root[data-theme="dark"] div.contenido mark, :root[data-theme="dark"] .code-text mark{ background:#8a6d1f; color:#fff; }

  /* Bloque de código estilo editor (siempre oscuro, como VS Code) */
  .code-block{ background:#1e1e1e; color:#d4d4d4; border:1px solid #2d2d2d; border-radius:9px; padding:10px 0; font-family:var(--mono); font-size:13px; line-height:1.6; margin:0; max-height:68vh; min-height:80px; overflow:auto; resize:vertical; cursor:context-menu; tab-size:4; }
  .code-line{ display:flex; }
  .code-line:hover{ background:rgba(255,255,255,.04); }
  .code-line .ln{ flex-shrink:0; width:46px; text-align:right; padding-right:12px; margin-right:12px; color:#6e7681; border-right:1px solid #333; user-select:none; }
  .code-line .code-text{ flex:1; min-width:0; white-space:pre-wrap; word-break:break-word; padding-right:14px; }
  .tk-kw{ color:#569cd6; font-weight:600; }
  .tk-fn{ color:#dcdcaa; }
  .tk-st{ color:#ce9178; }
  .tk-nu{ color:#b5cea8; }
  .tk-id{ color:#9cdcfe; }
  .tk-cm{ color:#7f8c8d; font-style:italic; }
  .tk-op{ color:#d4d4d4; }
  .tk-pl{ color:#4ade80; font-style:italic; }
  .code-block mark{ background:#ffd54a; color:#1e1e1e; border-radius:2px; padding:0 1px; }
  .img-wrap{ display:block; margin:6px 0; }
  .nota-img{ display:block; max-width:100%; max-height:460px; border-radius:6px; border:1px solid var(--panel-edge); background:#fff; }

  .ctx-menu{
    position:fixed; display:none; flex-direction:column; gap:2px; background:var(--panel); border:1px solid var(--panel-edge);
    border-radius:10px; box-shadow:var(--shadow-lg); padding:6px; z-index:1000; min-width:220px;
  }
  .ctx-menu button{
    background:transparent; color:var(--text); border:none; text-align:left; font-size:13px; font-weight:500;
    padding:9px 11px; border-radius:7px; box-shadow:none; transform:none; width:100%;
  }
  .ctx-menu button:hover{ background:var(--accent-soft); color:var(--accent-dark); filter:none; transform:none; box-shadow:none; }
  .ctx-menu button:active{ transform:none; }
  .ctx-hint{ font-size:11px; color:var(--muted); text-align:center; margin-top:4px; }

  .edit-panel{ display:none; margin-top:10px; padding-top:10px; border-top:1px dashed var(--panel-edge); }
  .edit-panel.open{ display:block; animation:panelIn .18s ease; }
  .edit-panel .fields{ display:flex; gap:10px; flex-wrap:wrap; }
  .edit-panel .fields > div{ flex:1; min-width:150px; }
  .edit-panel label{ margin-top:0; }
  .edit-panel textarea{
    width:100%; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text);
    font-family:var(--mono); font-size:13.5px; padding:11px 13px; border-radius:9px; min-height:160px;
    outline:none; resize:vertical; transition:border-color .15s, box-shadow .15s;
  }
  .edit-panel textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .edit-panel .actions{ display:flex; gap:8px; margin-top:12px; }
  .edit-panel .actions form{ display:inline; }

  .empty{ color:var(--muted); font-size:13.5px; text-align:center; padding:30px 0; }
  .add-card{ margin-bottom:16px; display:none; }
  .add-card.open{ display:block; animation:panelIn .18s ease; }
  .add-card .fields{ display:flex; gap:10px; flex-wrap:wrap; }
  .add-card .fields > div{ flex:1; min-width:160px; }
  .add-card label{ margin-top:0; }
  .add-card textarea{
    width:100%; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text);
    font-family:var(--mono); font-size:13.5px; padding:11px 13px; border-radius:9px; min-height:160px;
    outline:none; resize:vertical; transition:border-color .15s, box-shadow .15s;
  }
  .add-card textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .22s ease, transform .22s cubic-bezier(.34,1.56,.64,1); box-shadow:0 6px 20px rgba(20,30,45,.18); }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  .toolbar .search-wrap .buscando{ position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:11.5px; color:var(--muted); pointer-events:none; }
  .pl-line{ white-space:pre-wrap; word-break:break-word; min-height:1.55em; }
  .cargando{ color:var(--muted); font-family:var(--sans); font-size:13px; padding:6px 2px; }
  .cargando.error{ color:var(--danger); }
  .mas-lineas{ text-align:center; font-family:var(--sans); font-size:12px; color:var(--muted); padding:10px 8px 4px; }
  .mas-arriba{ padding:8px 14px; font-size:12px; color:var(--muted); font-style:italic; }
  .code-block .mas-arriba{ color:#8b949e; }
  .code-block .mas-arriba a{ color:#4fc1ff; }
  .code-block .mas-lineas{ color:#8b949e; }
  .code-block .mas-lineas a{ color:#4fc1ff; }
  .ver-mas{ color:var(--accent-dark); font-style:italic; text-decoration:none; }
  .code-block .ver-mas{ color:#4fc1ff; }
  .cur-line{ outline:1px solid #ffd54a; outline-offset:-1px; background:rgba(255,213,74,.09); }
  .row.open, .row.open:hover{ transform:none; }
  .search-in-note .iconbtn{ width:30px; height:30px; font-size:11px; flex-shrink:0; }
  .content-wrap.fullscreen{ position:fixed; inset:0; z-index:900; background:var(--bg); padding:14px 20px; margin:0; display:flex; flex-direction:column; }
  .content-wrap.fullscreen .contenido, .content-wrap.fullscreen .code-block{ flex:1; max-height:none; min-height:0; resize:none; }
  .file-list{ margin-top:8px; display:flex; flex-direction:column; gap:4px; }
  .file-item{ display:flex; justify-content:space-between; gap:12px; font-size:12.5px; color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:7px; padding:6px 10px; }
  .file-item.bad{ color:var(--danger); border-color:var(--danger); }
</style>

<% var C = (typeof cfg !== 'undefined') ? cfg : { base:'/notas', plural:'notas', titulo:'Notas y comandos', agregar:'+ Agregar nota', placeCat:'Ej: Ventoy USB', placeTit:'Ej: Preparar la USB', placeCont:'Pega aquí el comando, script o apunte…', vacio:'Todavía no hay notas guardadas. Agrega la primera arriba.', buscarDentro:'Buscar dentro de esta nota…', papeleraUno:'Mover esta nota a la papelera', el:'la nota', todos:'las' };
   var MAXMB = (typeof maxUploadMb !== 'undefined') ? maxUploadMb : 100;
   function fmtTam(n){ return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : (n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' car.'); } %>

<div class="top">
  <h1><%= C.titulo %></h1>
  <div style="display:flex; align-items:center; gap:10px;">
    <span class="count"><%= notas.length %> <%= C.plural %></span>
    <% if (notas.length > 0) { %>
    <form method="post" action="<%= C.base %>/eliminar-todo" id="formEliminarTodo">
      <button type="button" class="danger" id="btnEliminarTodo" title="Mueve todo a la papelera (se puede restaurar)">🗑 Eliminar todo</button>
    </form>
    <% } %>
  </div>
</div>

<div class="toolbar">
  <div class="search-wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <input type="text" id="searchInput" placeholder="Buscar por título o contenido…" autocomplete="off">
    <span class="buscando" id="estadoBusqueda"></span>
  </div>
  <button type="button" class="secondary" id="toggleAddBtn"><%= C.agregar %></button>
  <button type="button" class="secondary" id="toggleUploadBtn">⬆ Subir archivos</button>
</div>

<div class="tabs" id="tabs">
  <button type="button" class="tab active" data-cat="__todas__">Todas</button>
  <% categorias.forEach(function(cat) { %>
    <button type="button" class="tab" data-cat="<%= cat.toLowerCase() %>"><%= cat %></button>
  <% }); %>
</div>

<div class="card add-card" id="uploadCard">
  <p class="sub" style="margin:0 0 14px;">Sube uno o <strong>varios</strong> archivos a la vez (.txt, .sql, .docx, .pdf). Cada uno se guarda como una nota: se conserva el archivo original (lo puedes descargar), se limpia el texto y se traen las imágenes.</p>
  <form method="post" action="<%= C.base %>/subir" enctype="multipart/form-data" id="formSubir">
    <div class="fields">
      <div>
        <label>Apartado (categoría)</label>
        <input type="text" name="categoria" list="listaCategorias" placeholder="<%= C.placeCat %>" required>
      </div>
      <div><label>Título (opcional, solo si subes un archivo)</label><input type="text" name="titulo" placeholder="Si lo dejas vacío, se usa el nombre del archivo"></div>
    </div>
    <label>Archivos (puedes elegir varios — máx. <%= MAXMB %> MB cada uno)</label>
    <input type="file" name="archivos" id="inputArchivos" accept=".txt,.sql,.docx,.pdf" multiple required>
    <div class="file-list" id="listaArchivos"></div>
    <button class="full" type="submit" id="btnSubir">Subir y guardar</button>
  </form>
</div>

<div class="card add-card" id="addCard">
  <form method="post" action="<%= C.base %>/agregar">
    <div class="fields">
      <div>
        <label>Apartado (categoría)</label>
        <input type="text" name="categoria" list="listaCategorias" placeholder="<%= C.placeCat %>" required>
        <datalist id="listaCategorias">
          <% categorias.forEach(function(cat) { %><option value="<%= cat %>"></option><% }); %>
        </datalist>
      </div>
      <div><label>Título</label><input type="text" name="titulo" placeholder="<%= C.placeTit %>" required></div>
    </div>
    <label>Contenido</label>
    <textarea name="contenido" placeholder="<%= C.placeCont %>" required></textarea>
    <button class="full" type="submit">Guardar</button>
  </form>
</div>

<div id="results">
  <% notas.forEach(function(n) { %>
  <div class="row" data-id="<%= n.id %>" data-cat="<%= n.categoria.toLowerCase() %>" id="row-<%= n.id %>">
    <div class="main" onclick="toggleRow(<%= n.id %>)">
      <div class="name">
        <span class="cat-badge"><%= n.categoria %></span>
        <span class="titulo"><%= n.titulo %><% if (n.es_sql) { %> <span class="sql-badge">SQL</span><% } %></span>
        <span class="meta"><%= n.lineas.toLocaleString('es-CO') %> línea<%= n.lineas === 1 ? '' : 's' %> · <%= fmtTam(n.largo) %><% if (n.archivo_nombre) { %> · 📎 <%= n.archivo_nombre %><% } %></span>
      </div>
      <div class="actions">
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="m9 18 6-6-6-6"></path></svg>
      </div>
    </div>

    <div class="body-panel">
      <div class="content-wrap" id="wrap-<%= n.id %>">
        <div class="search-in-note">
          <input type="text" placeholder="<%= C.buscarDentro %>" oninput="buscarEnNota(<%= n.id %>, this.value)" onkeydown="teclaBusqueda(event, <%= n.id %>)" onclick="event.stopPropagation();">
          <span class="match-count" id="matches-<%= n.id %>"></span>
          <button type="button" class="iconbtn" title="Coincidencia anterior (Shift+Enter)" onclick="event.stopPropagation(); irACoincidencia(<%= n.id %>, -1)">▲</button>
          <button type="button" class="iconbtn" title="Siguiente coincidencia (Enter)" onclick="event.stopPropagation(); irACoincidencia(<%= n.id %>, 1)">▼</button>
          <button type="button" class="iconbtn" title="Pantalla completa (Esc para salir)" onclick="event.stopPropagation(); pantallaCompleta(<%= n.id %>)">⤢</button>
        </div>
        <div class="contenido" id="texto-<%= n.id %>" oncontextmenu="mostrarMenuContextual(event, <%= n.id %>)"><div class="cargando">Cargando contenido…</div></div>
      </div>

      <div class="body-actions">
        <button type="button" class="secondary" onclick="event.stopPropagation(); copiarNota(<%= n.id %>)">Copiar</button>
        <button type="button" class="secondary" onclick="event.stopPropagation(); toggleEdit(<%= n.id %>)">Editar</button>
        <% if (n.archivo_nombre) { %>
        <a class="btn secondary" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;"
           href="<%= C.base %>/<%= n.id %>/archivo" onclick="event.stopPropagation();" title="Descargar <%= n.archivo_nombre %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <%= n.archivo_nombre %>
        </a>
        <form method="post" action="<%= C.base %>/<%= n.id %>/quitar-archivo" style="display:inline;"
              onsubmit="event.stopPropagation(); return confirm('¿Quitar el archivo «<%= n.archivo_nombre %>»? El texto se conserva.');"
              onclick="event.stopPropagation();">
          <button type="submit" class="iconbtn" title="Quitar solo el archivo adjunto">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </form>
        <% } %>
        <form method="post" action="<%= C.base %>/<%= n.id %>/eliminar" style="margin-left:auto; display:inline;"
              onsubmit="event.stopPropagation(); return confirm('¿Mover <%= C.el %> «<%= n.titulo.replace(/'/g, "\\'") %>» a la papelera? Podrás restaurarla desde 🗑 Papelera.');"
              onclick="event.stopPropagation();">
          <button type="submit" class="danger" title="<%= C.papeleraUno %>">🗑 Eliminar</button>
        </form>
      </div>

      <div class="edit-panel" id="edit-<%= n.id %>">
        <form method="post" action="<%= C.base %>/<%= n.id %>/actualizar">
          <div class="fields">
            <div><label>Apartado (categoría)</label><input type="text" name="categoria" value="<%= n.categoria %>" required></div>
            <div><label>Título</label><input type="text" name="titulo" value="<%= n.titulo %>" required></div>
          </div>
          <label>Contenido</label>
          <textarea name="contenido" required readonly placeholder="Cargando contenido…"></textarea>
          <div class="actions">
            <button type="submit" disabled>Guardar cambios</button>
            <button type="button" class="secondary" onclick="event.stopPropagation(); toggleEdit(<%= n.id %>)">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <% }); %>
  <% if (notas.length === 0) { %>
    <div class="empty"><%= C.vacio %></div>
  <% } %>
</div>
<div class="empty" id="sinResultados" style="display:none;">Ninguna coincidencia con la búsqueda.</div>

<div class="ctx-menu" id="ctxMenu">
  <button type="button" onclick="formatearNota(ctxMenuNotaId)">🎨 Vista de código (resaltar SQL)</button>
  <button type="button" onclick="deshacerFormato(ctxMenuNotaId)">↩ Ver como texto normal</button>
  <div class="ctx-hint">Lo que no es SQL se muestra en verde</div>
</div>

<div class="toast" id="toast">Copiado</div>

<script type="application/json" id="notasMeta"><%- JSON.stringify(notas.map(function(n){ return { id: n.id, esSql: !!n.es_sql }; })) %></script>

<script>
const RUTA_BASE = <%- JSON.stringify(C.base) %>;
const MAX_MB = <%= MAXMB %>;
const LOTE = 1500;          // líneas que se dibujan por bloque (el resto se carga al desplazarse)
const MAX_LINEA = 20000;    // las líneas más largas se recortan, con botón para verlas completas
const SALTO = 4000;         // si una coincidencia está más lejos que esto, se dibuja solo una ventana alrededor de ella
const AVISO_CARGAR_TODO = 60000; // "cargar todo" pide confirmación si faltan más líneas que esto

let categoriaActiva = '__todas__';
let textoBusqueda = '';
let idsCoinciden = null;
let seqBusqueda = 0;

const notasData = {};
JSON.parse(document.getElementById('notasMeta').textContent).forEach(function(n){
  notasData[n.id] = {
    esSql: n.esSql, texto: null, lineas: null, clases: null, modo: 'auto',
    query: '', regex: null, usarCodigo: false, hasta: 0, estado: { bloque: false },
    expandidas: new Set(), coinc: [], idx: -1, cargando: null, desde: 0
  };
});

function escapeHtml(str){
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function escapeRegExp(str){
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// ---------------------------------------------------------------------------
// Imágenes: en el texto aparecen como una línea [[IMG:n]]
// ---------------------------------------------------------------------------
const RE_IMG = /^\s*\[\[IMG:(\d+)\]\]\s*$/;

function htmlImagen(id, n){
  const src = RUTA_BASE + '/' + id + '/imagen/' + n;
  return '<a class="img-wrap" href="' + src + '" target="_blank" rel="noopener" onclick="event.stopPropagation()"><img class="nota-img" loading="lazy" src="' + src + '" alt="Imagen ' + n + '"></a>';
}

// ---------------------------------------------------------------------------
// Resaltado de sintaxis SQL (estilo editor de código)
// ---------------------------------------------------------------------------
const SQL_KW = new Set(('select from where insert into values update set delete create alter drop table view index ' +
  'trigger procedure function database schema join inner left right full outer cross on and or not null is in like ilike ' +
  'between exists distinct as order by group having limit offset union all case when then else end begin commit rollback ' +
  'declare if while return returns primary key foreign references default constraint unique check add column modify rename ' +
  'to with grant revoke truncate merge using asc desc over partition exec execute cascade identity varchar char int integer ' +
  'bigint numeric decimal datetime timestamp boolean float money').split(' '));

const TOKEN_RE = /--.*|'(?:[^'\n]|'')*'|"[^"\n]*"|\d+(?:\.\d+)?|[A-Za-z_][\w$#@]*|\s+|./y;

function tokenizarSqlLinea(linea, estado){
  const tokens = [];
  let i = 0;
  if (estado.bloque) {
    const fin = linea.indexOf('*/');
    if (fin === -1) { return [{ t: linea, c: 'cm' }]; }
    tokens.push({ t: linea.slice(0, fin + 2), c: 'cm' });
    estado.bloque = false;
    i = fin + 2;
  }
  while (i < linea.length) {
    if (linea.startsWith('/*', i)) {
      const fin = linea.indexOf('*/', i + 2);
      if (fin === -1) { tokens.push({ t: linea.slice(i), c: 'cm' }); estado.bloque = true; break; }
      tokens.push({ t: linea.slice(i, fin + 2), c: 'cm' });
      i = fin + 2;
      continue;
    }
    TOKEN_RE.lastIndex = i;
    const m = TOKEN_RE.exec(linea);
    const txt = m[0];
    let c = null;
    if (txt.startsWith('--')) c = 'cm';
    else if (txt[0] === "'") c = 'st';
    else if (txt[0] === '"') c = 'id';
    else if (/^\d/.test(txt)) c = 'nu';
    else if (/^[A-Za-z_]/.test(txt)) {
      if (SQL_KW.has(txt.toLowerCase())) c = 'kw';
      else if (linea[i + txt.length] === '(') c = 'fn';
    }
    else if (!/^\s+$/.test(txt)) c = 'op';
    tokens.push({ t: txt, c: c });
    i += txt.length;
  }
  return tokens;
}

// ¿Esta línea (ya recortada) parece SQL o es texto/explicación?
const SQL_INICIO_LINEA = /^(select|insert\s+into|update|delete\s+from|create\s+(or\s+replace\s+)?(table|view|procedure|function|index|trigger)|alter\s+table|drop\s+(table|view|index)|truncate\s+table|merge\s+into|with|values|set|from|where|and|or|on|into|order\s+by|group\s+by|left\s+join|right\s+join|inner\s+join|join)\b/i;
const SQL_INICIO_SENTENCIA = /^(select|insert\s+into|update|delete\s+from|create\s|alter\s+table|drop\s|truncate\s|merge\s+into|with\s)/i;

function lineaPareceSql(t){
  if (/^--/.test(t) || /^\/\*/.test(t) || /\*\/$/.test(t)) return true;
  if (SQL_INICIO_LINEA.test(t)) return true;
  if (/;\s*$/.test(t)) return true;
  if (/=\s*'/.test(t) && /[(),]/.test(t)) return true;
  if (/\(.*\)/.test(t) && /,/.test(t)) return true;
  return false;
}

// Marca cada línea como SQL (true) o texto (false). Las líneas que siguen
// a una sentencia SQL sin terminar (sin ;) se consideran parte de ella.
function clasificarLineas(lineas){
  const res = new Array(lineas.length);
  let enSentencia = false;
  for (let i = 0; i < lineas.length; i++) {
    const linea = lineas[i];
    const t = (linea.length > 400 ? linea.slice(0, 400) : linea).replace(/^\s*[*•\-]\s+(?=\S)/, '').trim();
    if (!t) { res[i] = true; enSentencia = false; continue; }
    if (t.indexOf('[[IMG:') === 0 && RE_IMG.test(t)) { res[i] = true; continue; }
    let esSql = lineaPareceSql(t);
    if (SQL_INICIO_SENTENCIA.test(t)) enSentencia = true;
    else if (!esSql && enSentencia) esSql = true;
    if (/;\s*$/.test(linea.length > 400 ? linea.slice(-50) : t)) enSentencia = false;
    res[i] = esSql;
  }
  return res;
}

// Convierte tokens + rangos de coincidencia de búsqueda en HTML
function tokensAHtml(tokens, intervalos){
  let out = '';
  let pos = 0;
  let k = 0;
  tokens.forEach(function(tk){
    const ini = pos;
    const fin = pos + tk.t.length;
    let cursor = ini;
    let html = '';
    while (cursor < fin) {
      while (k < intervalos.length && intervalos[k][1] <= cursor) k++;
      const iv = intervalos[k];
      if (!iv || iv[0] >= fin) { html += escapeHtml(tk.t.slice(cursor - ini)); cursor = fin; }
      else if (iv[0] > cursor) { html += escapeHtml(tk.t.slice(cursor - ini, iv[0] - ini)); cursor = iv[0]; }
      else {
        const hasta = Math.min(iv[1], fin);
        html += '<mark>' + escapeHtml(tk.t.slice(cursor - ini, hasta - ini)) + '</mark>';
        cursor = hasta;
      }
    }
    out += tk.c ? '<span class="tk-' + tk.c + '">' + html + '</span>' : html;
    pos = fin;
  });
  return out;
}

function buscarIntervalos(linea, regex){
  const res = [];
  if (!regex) return res;
  regex.lastIndex = 0;
  let m;
  while ((m = regex.exec(linea)) !== null) {
    if (m[0] === '') { regex.lastIndex++; continue; }
    res.push([m.index, m.index + m[0].length]);
  }
  return res;
}

// ---------------------------------------------------------------------------
// Carga del contenido (se pide al servidor cuando se abre la nota)
// ---------------------------------------------------------------------------
function cargarContenido(id){
  const d = notasData[id];
  if (d.texto !== null) return Promise.resolve(d);
  if (d.cargando) return d.cargando;

  d.cargando = fetch(RUTA_BASE + '/' + id + '/contenido', { credentials: 'same-origin' })
    .then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
    .then(function(t){
      d.texto = t;
      d.lineas = t.split('\n');
      d.cargando = null;
      const ta = document.querySelector('#edit-' + id + ' textarea');
      if (ta) { ta.value = t; ta.readOnly = false; ta.placeholder = ''; }
      const bt = document.querySelector('#edit-' + id + ' button[type=submit]');
      if (bt) bt.disabled = false;
      return d;
    })
    .catch(function(e){ d.cargando = null; throw e; });

  return d.cargando;
}

// ---------------------------------------------------------------------------
// Dibujo del contenido por bloques (soporta archivos con cientos de miles de líneas)
// ---------------------------------------------------------------------------
function htmlLinea(id, d, i){
  let linea = d.lineas[i];
  let cuerpo;
  const mi = (linea.indexOf('[[IMG:') !== -1) ? linea.match(RE_IMG) : null;

  if (mi) {
    cuerpo = htmlImagen(id, mi[1]);
  } else {
    const expandida = d.expandidas.has(i);
    let resto = 0;
    if (linea.length > MAX_LINEA && !expandida) {
      resto = linea.length - MAX_LINEA;
      linea = linea.slice(0, MAX_LINEA);
    }
    const intervalos = buscarIntervalos(linea, d.regex);
    let tokens;
    if (d.usarCodigo) {
      if (linea.length >= MAX_LINEA || expandida) tokens = linea ? [{ t: linea, c: null }] : [];
      else tokens = d.clases[i] ? tokenizarSqlLinea(linea, d.estado) : (linea ? [{ t: linea, c: 'pl' }] : []);
    } else {
      tokens = linea ? [{ t: linea, c: null }] : [];
    }
    cuerpo = tokensAHtml(tokens, intervalos) || '&nbsp;';
    if (resto) {
      cuerpo += ' <a class="ver-mas" href="#" onclick="mostrarLineaCompleta(' + id + ',' + i + '); return false;">… +' + resto.toLocaleString('es-CO') + ' caracteres · mostrar línea completa</a>';
    }
  }

  if (d.usarCodigo) {
    return '<div class="code-line" data-i="' + i + '"><span class="ln">' + (i + 1) + '</span><span class="code-text">' + cuerpo + '</span></div>';
  }
  return '<div class="pl-line" data-i="' + i + '">' + cuerpo + '</div>';
}

function agregarLineas(id, n){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  if (!d || !cont || d.lineas === null || d.hasta >= d.lineas.length) return;

  const viejo = cont.querySelector('.mas-lineas');
  if (viejo) viejo.remove();

  const fin = Math.min(d.lineas.length, d.hasta + n);
  let html = '';
  for (let i = d.hasta; i < fin; i++) html += htmlLinea(id, d, i);
  d.hasta = fin;

  if (fin < d.lineas.length) {
    html += '<div class="mas-lineas">Mostrando ' + (d.desde > 0 ? 'las líneas ' + (d.desde + 1).toLocaleString('es-CO') + ' a ' : '') + fin.toLocaleString('es-CO') + ' de ' + d.lineas.length.toLocaleString('es-CO') +
      ' líneas — sigue bajando para cargar más · <a href="#" onclick="cargarTodo(' + id + '); return false;">cargar todo</a></div>';
  }
  cont.insertAdjacentHTML('beforeend', html);
}

function cargarTodo(id){
  const d = notasData[id];
  const faltan = d.lineas.length - d.hasta;
  if (faltan > AVISO_CARGAR_TODO && !confirm('Faltan ' + faltan.toLocaleString('es-CO') + ' líneas. Dibujarlas todas puede tardar y usar mucha memoria del navegador.\n\nPuedes usar el buscador para ir directo a lo que necesitas. ¿Cargar todo de todos modos?')) return;
  agregarLineas(id, faltan);
}

// Dibuja un bloque de líneas empezando en "desde" (para saltar lejos sin dibujar todo lo del medio)
function posicionarVentana(id, desde){
  const d = notasData[id];
  const cont = document.getElementById('texto-' + id);
  if (!d || !cont || d.lineas === null) return;
  d.desde = desde;
  d.hasta = desde;
  d.estado = { bloque: false };
  cont.innerHTML = '';
  if (desde > 0) {
    cont.insertAdjacentHTML('beforeend', '<div class="mas-arriba">↑ No se muestran las primeras ' + desde.toLocaleString('es-CO') +
      ' líneas · <a href="#" onclick="verDesdeInicio(' + id + '); return false;">mostrar desde el inicio</a></div>');
  }
  agregarLineas(id, LOTE);
}

function verDesdeInicio(id){
  posicionarVentana(id, 0);
  const cont = document.getElementById('texto-' + id);
  if (cont) cont.scrollTop = 0;
}

function mostrarLineaCompleta(id, i){
  const d = notasData[id];
  d.expandidas.add(i);
  const cont = document.getElementById('texto-' + id);
  const el = cont.querySelector('[data-i="' + i + '"]');
  if (el) el.outerHTML = htmlLinea(id, d, i);
}

function renderContenido(id, query){
  const d = notasData[id];
  if (!d || d.texto === null) return;
  const cont = document.getElementById('texto-' + id);
  if (!cont) return;

  d.query = query || '';
  d.regex = d.query ? new RegExp(escapeRegExp(d.query), 'gi') : null;
  d.usarCodigo = d.modo === 'codigo' || (d.modo === 'auto' && d.esSql);
  if (d.usarCodigo && !d.clases) d.clases = clasificarLineas(d.lineas);
  d.hasta = 0;
  d.desde = 0;
  d.estado = { bloque: false };

  cont.innerHTML = '';
  cont.classList.toggle('code-block', d.usarCodigo);
  cont.classList.toggle('contenido', !d.usarCodigo);

  if (!cont.dataset.scroll) {
    cont.dataset.scroll = '1';
    cont.addEventListener('scroll', function(){
      if (cont.scrollTop + cont.clientHeight > cont.scrollHeight - 800) agregarLineas(id, LOTE);
    });
  }

  agregarLineas(id, LOTE);
  calcularCoincidencias(id);
}

// ---------------------------------------------------------------------------
// Búsqueda dentro de la nota
// ---------------------------------------------------------------------------
function calcularCoincidencias(id){
  const d = notasData[id];
  const el = document.getElementById('matches-' + id);
  d.coinc = [];
  d.idx = -1;

  if (!d.regex) { if (el) el.textContent = ''; return; }

  let total = 0;
  const r = d.regex;
  for (let i = 0; i < d.lineas.length; i++) {
    const l = d.lineas[i];
    if (l.length < d.query.length) continue;
    r.lastIndex = 0;
    let m;
    let c = 0;
    while ((m = r.exec(l)) !== null) { c++; if (m[0] === '') r.lastIndex++; }
    if (c) { d.coinc.push(i); total += c; }
  }

  if (el) {
    d.totalTexto = total
      ? total.toLocaleString('es-CO') + (total === 1 ? ' resultado' : ' resultados')
      : '';
    el.textContent = d.totalTexto || 'Sin resultados';
  }

  if (d.coinc.length) irACoincidencia(id, 0, true);
}

function irACoincidencia(id, dir, inicial){
  const d = notasData[id];
  if (!d || !d.coinc.length) return;
  d.idx = inicial ? 0 : (d.idx + dir + d.coinc.length) % d.coinc.length;
  const linea = d.coinc[d.idx];
  const cont = document.getElementById('texto-' + id);

  const elContador = document.getElementById('matches-' + id);
  if (elContador && d.coinc.length > 1) {
    elContador.textContent = (d.idx + 1) + ' de ' + d.coinc.length +
      (d.coinc.length === 1 ? ' línea' : ' líneas') +
      (d.totalTexto ? ' (' + d.totalTexto + ')' : '');
  }

  if (d.lineas[linea].length > MAX_LINEA && !d.expandidas.has(linea)) {
    d.expandidas.add(linea);
    const previo = cont.querySelector('[data-i="' + linea + '"]');
    if (previo) previo.outerHTML = htmlLinea(id, d, linea);
  }
  if (linea < d.desde || linea >= d.hasta + SALTO) {
    // salto largo: se dibuja solo una ventana alrededor de la coincidencia
    posicionarVentana(id, linea - 300 < 1000 ? 0 : linea - 300);
  } else if (linea >= d.hasta) {
    agregarLineas(id, linea - d.hasta + LOTE);
  }

  cont.querySelectorAll('.cur-line').forEach(function(e){ e.classList.remove('cur-line'); });
  const el = cont.querySelector('[data-i="' + linea + '"]');
  if (el) {
    el.classList.add('cur-line');
    el.scrollIntoView({ block: 'center' });
  }
}

const debounceEnNota = {};
function buscarEnNota(id, query){
  clearTimeout(debounceEnNota[id]);
  debounceEnNota[id] = setTimeout(function(){
    renderContenido(id, query.trim());
  }, 150);
}

function teclaBusqueda(e, id){
  if (e.key === 'Enter') {
    e.preventDefault();
    e.stopPropagation();
    irACoincidencia(id, e.shiftKey ? -1 : 1);
  }
}

// ---------------------------------------------------------------------------
// Abrir / cerrar / editar / copiar / pantalla completa
// ---------------------------------------------------------------------------
function toggleRow(id){
  const fila = document.getElementById('row-' + id);
  const seAbre = !fila.classList.contains('open');
  fila.classList.toggle('open');
  if (!seAbre) return;

  const consulta = textoBusqueda || '';
  const buscador = fila.querySelector('.search-in-note input');
  if (buscador) buscador.value = consulta;

  const cont = document.getElementById('texto-' + id);
  cargarContenido(id)
    .then(function(){ renderContenido(id, consulta); })
    .catch(function(e){
      cont.innerHTML = '<div class="cargando error">No se pudo cargar el contenido (' + escapeHtml(e.message) + '). Recarga la página.</div>';
    });
}

function toggleEdit(id){
  document.getElementById('edit-' + id).classList.toggle('open');
}

function pantallaCompleta(id){
  const wrap = document.getElementById('wrap-' + id);
  const activa = wrap.classList.toggle('fullscreen');
  document.body.style.overflow = activa ? 'hidden' : '';
}

let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg || 'Copiado';
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 1400);
}

async function copiarNota(id){
  try { await cargarContenido(id); } catch (e) { showToast('No se pudo cargar'); return; }
  const texto = notasData[id].texto.replace(/^[ \t]*\[\[IMG:\d+\]\][ \t]*\n?/gm, '');
  try {
    await navigator.clipboard.writeText(texto);
  } catch (e) {
    const ta = document.createElement('textarea');
    ta.value = texto;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
  }
  showToast();
}

// ---------------------------------------------------------------------------
// Menú contextual (clic derecho) sobre el contenido de una nota
// ---------------------------------------------------------------------------
let ctxMenuNotaId = null;

function mostrarMenuContextual(e, id){
  e.preventDefault();
  e.stopPropagation();
  ctxMenuNotaId = id;
  const menu = document.getElementById('ctxMenu');
  const x = Math.min(e.clientX, window.innerWidth - 260);
  const y = Math.min(e.clientY, window.innerHeight - 120);
  menu.style.left = x + 'px';
  menu.style.top = y + 'px';
  menu.style.display = 'flex';
}

function ocultarMenuContextual(){
  const menu = document.getElementById('ctxMenu');
  if (menu) menu.style.display = 'none';
}

document.addEventListener('click', ocultarMenuContextual);
document.addEventListener('scroll', ocultarMenuContextual, true);
document.addEventListener('keydown', function(e){
  if (e.key !== 'Escape') return;
  ocultarMenuContextual();
  const fs = document.querySelector('.content-wrap.fullscreen');
  if (fs) { fs.classList.remove('fullscreen'); document.body.style.overflow = ''; }
});

function cambiarModoNota(id, modo){
  ocultarMenuContextual();
  const d = notasData[id];
  if (!d || d.texto === null) return;
  d.modo = modo;
  const fila = document.getElementById('row-' + id);
  const buscador = fila ? fila.querySelector('.search-in-note input') : null;
  renderContenido(id, buscador ? buscador.value.trim() : '');
}

function formatearNota(id){ cambiarModoNota(id, 'codigo'); }
function deshacerFormato(id){ cambiarModoNota(id, 'plano'); }

// ---------------------------------------------------------------------------
// Filtros de la lista: apartados (pestañas) + búsqueda en el servidor
// ---------------------------------------------------------------------------
const filasCache = Array.from(document.querySelectorAll('#results .row'));

function aplicarFiltros(){
  let visibles = 0;
  filasCache.forEach(function(row){
    const okCat = categoriaActiva === '__todas__' || row.dataset.cat === categoriaActiva;
    const okTxt = idsCoinciden === null || idsCoinciden.has(Number(row.dataset.id));
    const ver = okCat && okTxt;
    row.style.display = ver ? '' : 'none';
    if (ver) visibles++;
  });
  document.getElementById('sinResultados').style.display = (filasCache.length && !visibles) ? 'block' : 'none';
}

function buscarEnServidor(q){
  textoBusqueda = q;
  const estado = document.getElementById('estadoBusqueda');

  if (!q) {
    seqBusqueda++;
    idsCoinciden = null;
    estado.textContent = '';
    aplicarFiltros();
    return;
  }

  const mi = ++seqBusqueda;
  estado.textContent = 'Buscando…';

  fetch(RUTA_BASE + '/buscar?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (mi !== seqBusqueda) return;
      idsCoinciden = d.ids ? new Set(d.ids) : null;
      estado.textContent = '';
      aplicarFiltros();
    })
    .catch(function(){ if (mi === seqBusqueda) estado.textContent = 'Error al buscar'; });
}

let debounceBusqueda;
document.getElementById('searchInput').addEventListener('input', function(e){
  const valor = e.target.value.trim();
  clearTimeout(debounceBusqueda);
  debounceBusqueda = setTimeout(function(){ buscarEnServidor(valor); }, 250);
});

document.querySelectorAll('#tabs .tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('#tabs .tab').forEach(function(t){ t.classList.remove('active'); });
    tab.classList.add('active');
    categoriaActiva = tab.dataset.cat;
    aplicarFiltros();
  });
});

// ---------------------------------------------------------------------------
// Paneles de agregar / subir, eliminar todo
// ---------------------------------------------------------------------------
document.getElementById('toggleAddBtn').addEventListener('click', function(){
  document.getElementById('uploadCard').classList.remove('open');
  document.getElementById('addCard').classList.toggle('open');
});

document.getElementById('toggleUploadBtn').addEventListener('click', function(){
  document.getElementById('addCard').classList.remove('open');
  document.getElementById('uploadCard').classList.toggle('open');
});

const btnEliminarTodo = document.getElementById('btnEliminarTodo');
if (btnEliminarTodo) {
  btnEliminarTodo.addEventListener('click', function(){
    const ok = confirm(
      'Vas a mover a la papelera ' + <%- JSON.stringify(C.todos) %> + ' ' + filasCache.length + ' ' + <%- JSON.stringify(C.plural) %> + ' de esta sección.\n\n' +
      'No se borran de verdad: podrás restaurarlos desde 🗑 Papelera.\n\n¿Continuar?'
    );
    if (ok) document.getElementById('formEliminarTodo').submit();
  });
}

const inputArchivos = document.getElementById('inputArchivos');
inputArchivos.addEventListener('change', function(){
  const lista = document.getElementById('listaArchivos');
  lista.innerHTML = '';
  Array.from(inputArchivos.files).forEach(function(f){
    const mb = f.size / 1048576;
    const excede = mb > MAX_MB;
    lista.insertAdjacentHTML('beforeend',
      '<div class="file-item' + (excede ? ' bad' : '') + '"><span>' + escapeHtml(f.name) + '</span><span>' +
      (mb >= 1 ? mb.toFixed(1) + ' MB' : Math.max(1, Math.round(f.size / 1024)) + ' KB') +
      (excede ? ' — supera el límite de ' + MAX_MB + ' MB' : '') + '</span></div>');
  });
});

document.getElementById('formSubir').addEventListener('submit', function(e){
  const files = Array.from(inputArchivos.files);
  const grandes = files.filter(function(f){ return f.size > MAX_MB * 1048576; });
  if (grandes.length) {
    e.preventDefault();
    alert('Estos archivos superan el límite de ' + MAX_MB + ' MB:\n' + grandes.map(function(f){ return f.name; }).join('\n'));
    return;
  }
  if (files.length > 20) {
    e.preventDefault();
    alert('Máximo 20 archivos por vez.');
    return;
  }
  const b = document.getElementById('btnSubir');
  b.disabled = true;
  b.textContent = 'Subiendo… (los archivos grandes pueden tardar; no cierres la página)';
});
</script>
