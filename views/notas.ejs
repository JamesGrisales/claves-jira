// ---------------------------------------------------------------------------
// Filtros de la lista: apartados (pestañas) + búsqueda en el servidor
// ---------------------------------------------------------------------------
const filasCache = Array.from(document.querySelectorAll('#results .row')).map(function(row){
  return {
    el: row,
    id: Number(row.dataset.id),
    cat: row.dataset.cat || '',
    tit: (row.dataset.tit || (row.querySelector('.titulo') ? row.querySelector('.titulo').textContent : '')).toLowerCase()
  };
});

function aplicarFiltros(){
  let visibles = 0;
  const q = (textoBusqueda || '').toLowerCase().trim();
  for (let i = 0; i < filasCache.length; i++) {
    const row = filasCache[i];
    const okCat = categoriaActiva === '__todas__' || row.cat === categoriaActiva;
    const okLocal = !q || row.tit.indexOf(q) !== -1 || row.cat.indexOf(q) !== -1;
    const okServer = idsCoinciden !== null && idsCoinciden.has(row.id);
    const ver = okCat && (okLocal || okServer);
    row.el.style.display = ver ? '' : 'none';
    if (ver) visibles++;
  }
  document.getElementById('sinResultados').style.display = (filasCache.length && !visibles) ? 'block' : 'none';
}

function buscarEnServidor(q){
  textoBusqueda = q;
  const estado = document.getElementById('estadoBusqueda');

  if (!q) {
    seqBusqueda++;
    idsCoinciden = null;
    estado.textContent = '';
    aplicarFiltros();
    return;
  }

  // Filtrado instantáneo local de inmediato (0ms)
  aplicarFiltros();

  const mi = ++seqBusqueda;
  estado.textContent = 'Buscando…';

  fetch(RUTA_BASE + '/buscar?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (mi !== seqBusqueda) return;
      idsCoinciden = d.ids ? new Set(d.ids) : null;
      estado.textContent = '';
      aplicarFiltros();
    })
    .catch(function(){ if (mi === seqBusqueda) estado.textContent = 'Error al buscar'; });
}

let debounceBusqueda;
document.getElementById('searchInput').addEventListener('input', function(e){
  const valor = e.target.value.trim();
  textoBusqueda = valor;
  // Filtrado local instantáneo mientras se escribe
  aplicarFiltros();
  clearTimeout(debounceBusqueda);
  debounceBusqueda = setTimeout(function(){ buscarEnServidor(valor); }, 180);
});

document.querySelectorAll('#tabs .tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('#tabs .tab').forEach(function(t){ t.classList.remove('active'); });
    tab.classList.add('active');
    categoriaActiva = tab.dataset.cat;
    aplicarFiltros();
  });
});

