function toggleRow(id){
  const fila = document.getElementById('row-' + id);
  const seAbre = !fila.classList.contains('open');
  fila.classList.toggle('open');
  if (!seAbre) return;

  const consulta = textoBusqueda || '';
  const buscador = fila.querySelector('.search-in-note input');
  if (buscador) buscador.value = consulta;

  const cont = document.getElementById('texto-' + id);
  const cargas = notasData[id].esExcel
    ? Promise.all([cargarContenido(id), cargarHoja(id)])
    : cargarContenido(id);
  cargas
    .then(function(){ renderContenido(id, consulta); })
    .catch(function(e){
      cont.innerHTML = '<div class="cargando error">No se pudo cargar el contenido (' + escapeHtml(e.message) + '). Recarga la página.</div>';
    });
}

// ---------------------------------------------------------------------------
// Editor interactivo en vivo (resaltado SQL + números de línea sincronizados)
// ---------------------------------------------------------------------------
const LIMITE_RESALTADO_NOTA = 50000;

function contarLineas(val){
  if (!val) return 0;
  let c = 1;
  for (let i = 0; i < val.length; i++) {
    if (val.charCodeAt(i) === 10) c++;
  }
  return c;
}

function resaltarTextoNota(texto){
  if (!texto) return ' ';
  const lineas = texto.split('\n');
  const estado = { bloque: false };
  const res = [];
  for (let i = 0; i < lineas.length; i++) {
    const l = lineas[i];
    if (l === '') {
      res.push('');
    } else {
      const tokens = tokenizarSqlLinea(l, estado);
      res.push(tokensAHtml(tokens, []));
    }
  }
  return res.join('\n') + ' ';
}

function obtenerPosCursor(ta){
  const pos = (ta && typeof ta.selectionStart === 'number') ? ta.selectionStart : 0;
  const val = ta ? ta.value || '' : '';
  let linea = 1;
  let ultimoSalto = -1;
  for (let i = 0; i < pos; i++) {
    if (val.charCodeAt(i) === 10) {
      linea++;
      ultimoSalto = i;
    }
  }
  return { linea: linea, col: pos - ultimoSalto };
}

let timerEditorHighlight = null;

function actualizarEditorNota(ta, diferido){
  if (!ta) return;
  const frame = ta.closest('.nt-ed-frame');
  if (!frame) return;
  const box = frame.querySelector('.nt-ed-box');
  const capa = frame.querySelector('.nt-ed-capa');
  const gut = frame.querySelector('.nt-ed-gut');
  const gutIn = frame.querySelector('.nt-ed-gut-in');
  const statusEl = frame.querySelector('.nt-ed-status');
  const posEl = frame.querySelector('.nt-ed-pos');

  const val = ta.value || '';
  const nLineas = contarLineas(val);

  if (statusEl) {
    statusEl.textContent = nLineas.toLocaleString('es-CO') + (nLineas === 1 ? ' línea' : ' líneas');
  }

  if (posEl) {
    const pos = obtenerPosCursor(ta);
    posEl.textContent = 'Lín ' + pos.linea + ', Col ' + pos.col;
  }

  if (gutIn) {
    if (gutIn._lastCount !== nLineas) {
      gutIn._lastCount = nLineas;
      let gutText = '';
      for (let i = 1; i <= nLineas; i++) {
        gutText += i + '\n';
      }
      gutIn.textContent = gutText;
    }
    if (gut) {
      const digitos = Math.max(2, String(nLineas).length);
      gut.style.width = (digitos * 8 + 26) + 'px';
    }
  }

  if (box && capa) {
    if (val.length > LIMITE_RESALTADO_NOTA) {
      box.classList.add('plain');
      capa.textContent = '';
      if (statusEl && !statusEl.textContent.includes('modo rápido')) {
        statusEl.textContent += ' · modo rápido';
      }
    } else {
      box.classList.remove('plain');
      if (diferido) {
        clearTimeout(timerEditorHighlight);
        timerEditorHighlight = setTimeout(function(){
          if (ta && capa) capa.innerHTML = resaltarTextoNota(ta.value || '');
        }, 120);
      } else {
        capa.innerHTML = resaltarTextoNota(val);
      }
    }
  }

  sincronizarScrollEditor(ta);
}

function sincronizarScrollEditor(ta){
  if (!ta) return;
  const frame = ta.closest('.nt-ed-frame');
  if (!frame) return;
  const capa = frame.querySelector('.nt-ed-capa');
  const gutIn = frame.querySelector('.nt-ed-gut-in');
  const searchLines = frame.querySelector('.nt-ed-search-lines');
  const searchLayer = frame.querySelector('.nt-ed-search-layer');

  if (capa) {
    capa.scrollTop = ta.scrollTop;
    capa.scrollLeft = ta.scrollLeft;
  }
  if (gutIn) {
    gutIn.style.transform = 'translateY(' + (-ta.scrollTop) + 'px)';
  }
  if (searchLines) {
    searchLines.style.transform = 'translateY(' + (-ta.scrollTop) + 'px)';
  }
  if (searchLayer) {
    searchLayer.scrollTop = ta.scrollTop;
    searchLayer.scrollLeft = ta.scrollLeft;
  }
}

// =========================================================================
// FILTRADO Y BÚSQUEDA INTERACTIVA CON RESALTADO EN EL EDITOR DE CÓDIGO
// =========================================================================
const editorSearchState = {};

function getEditorSearchState(id) {
  if (!editorSearchState[id]) {
    editorSearchState[id] = { query: '', matches: [], idx: -1 };
  }
  return editorSearchState[id];
}

function abrirEditarConFiltro(id) {
  const p = document.getElementById('edit-' + id);
  if (!p || !p.classList.contains('open')) {
    toggleEdit(id);
  }
  setTimeout(function() {
    const inp = document.getElementById('filtroEd-' + id);
    if (inp) {
      inp.focus();
      inp.select();
    }
  }, 120);
}

function buildHighlightedText(val, matches, activeIdx, maxLimit) {
  if (!matches || matches.length === 0) return '';
  const limit = maxLimit || 500;
  let subMatches = matches;
  if (matches.length > limit) {
    if (activeIdx < limit) {
      subMatches = matches.slice(0, limit);
    } else {
      subMatches = matches.slice(0, limit - 1).concat([matches[activeIdx]]);
      subMatches.sort(function(a, b) { return a.start - b.start; });
    }
  }

  let html = '';
  let lastIdx = 0;
  for (let i = 0; i < subMatches.length; i++) {
    const m = subMatches[i];
    if (m.start < lastIdx) continue;
    html += escapeHtml(val.slice(lastIdx, m.start));
    const isCurrent = (m.origIdx !== undefined ? m.origIdx === activeIdx : i === activeIdx);
    html += '<mark class="nt-ed-hl-word' + (isCurrent ? ' active' : '') + '">' + escapeHtml(val.slice(m.start, m.end)) + '</mark>';
    lastIdx = m.end;
  }
  html += escapeHtml(val.slice(lastIdx));
  return html;
}

function filtrarEnEditor(id, query) {
  const st = getEditorSearchState(id);
  st.query = (query || '').trim();
  st.matches = [];
  st.idx = -1;

  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  const val = ta.value || '';
  const countEl = document.getElementById('countEd-' + id);
  const badgeEl = document.getElementById('badgeEd-' + id);
  const resultsList = document.getElementById('resultsList-' + id);

  if (!st.query) {
    if (countEl) countEl.textContent = '';
    if (badgeEl) { badgeEl.style.display = 'none'; badgeEl.textContent = '0'; }
    if (resultsList) resultsList.innerHTML = '<div class="nt-ed-no-res">Escribe para filtrar líneas o buscar texto...</div>';
    actualizarResaltadosEditor(id);
    return;
  }

  const queryLower = st.query.toLowerCase();
  const lines = val.split('\n');
  let currentOffset = 0;

  lines.forEach(function(lineText, lineIdx) {
    const lineNum = lineIdx + 1;
    const lineLower = lineText.toLowerCase();
    let colIdx = 0;

    if (lineLower.includes(queryLower)) {
      let searchPos = 0;
      while ((colIdx = lineLower.indexOf(queryLower, searchPos)) !== -1) {
        st.matches.push({
          origIdx: st.matches.length,
          start: currentOffset + colIdx,
          end: currentOffset + colIdx + queryLower.length,
          lineNum: lineNum,
          lineText: lineText.trim() || '(Línea vacía)'
        });
        searchPos = colIdx + Math.max(1, queryLower.length);
      }
    } else if (String(lineNum) === st.query) {
      st.matches.push({
        origIdx: st.matches.length,
        start: currentOffset,
        end: currentOffset + lineText.length,
        lineNum: lineNum,
        lineText: lineText.trim() || '(Línea vacía)'
      });
    }

    currentOffset += lineText.length + 1;
  });

  const total = st.matches.length;
  if (badgeEl) {
    badgeEl.textContent = total;
    badgeEl.style.display = total > 0 ? 'inline-flex' : 'none';
  }

  if (resultsList) {
    if (total === 0) {
      resultsList.innerHTML = '<div class="nt-ed-no-res">No se encontraron líneas con «' + escapeHtml(st.query) + '»</div>';
    } else {
      let html = '';
      const linesMap = new Map();
      st.matches.forEach(function(m) {
        if (!linesMap.has(m.lineNum)) {
          linesMap.set(m.lineNum, { mIdx: m.origIdx, lineNum: m.lineNum, lineText: m.lineText });
        }
      });

      linesMap.forEach(function(item) {
        html += '<div class="nt-ed-rp-item" onclick="saltarAMatchEditor(' + id + ', ' + item.mIdx + ', true)">' +
          '<span class="nt-ed-item-ln">Lín ' + item.lineNum + '</span>' +
          '<span class="nt-ed-item-txt">' + resaltarCoincidenciaItem(item.lineText, st.query) + '</span>' +
        '</div>';
      });
      resultsList.innerHTML = html;
    }
  }

  if (total > 0) {
    st.idx = 0;
    if (countEl) countEl.textContent = '1 / ' + total;
  } else {
    if (countEl) countEl.textContent = '0 encontrados';
  }

  // Renderizar resaltados visuales milimétricos en el editor
  actualizarResaltadosEditor(id);
}

function actualizarResaltadosEditor(id) {
  const st = getEditorSearchState(id);
  const searchContent = document.getElementById('searchContent-' + id);
  const searchLines = document.getElementById('searchLines-' + id);
  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  if (!st.query || !st.matches || st.matches.length === 0) {
    if (searchContent) searchContent.innerHTML = '';
    if (searchLines) searchLines.innerHTML = '';
    return;
  }

  const val = ta.value || '';
  const currentIdx = st.idx;

  // 1. Renderizar líneas de coincidencia en capa searchLines
  if (searchLines) {
    let linesHtml = '';
    const linesRendered = new Set();
    const maxLines = 150;
    let lineCount = 0;

    for (let i = 0; i < st.matches.length && lineCount < maxLines; i++) {
      const m = st.matches[i];
      if (!linesRendered.has(m.lineNum)) {
        linesRendered.add(m.lineNum);
        lineCount++;
        const isCurrent = (currentIdx >= 0 && st.matches[currentIdx] && st.matches[currentIdx].lineNum === m.lineNum);
        const top = 12 + (m.lineNum - 1) * 20.8;
        linesHtml += '<div class="nt-ed-hl-line' + (isCurrent ? ' active' : '') + '" style="top:' + top + 'px;"></div>';
      }
    }

    if (currentIdx >= 0 && st.matches[currentIdx]) {
      const curMatch = st.matches[currentIdx];
      if (!linesRendered.has(curMatch.lineNum)) {
        const top = 12 + (curMatch.lineNum - 1) * 20.8;
        linesHtml += '<div class="nt-ed-hl-line active" style="top:' + top + 'px;"></div>';
      }
    }
    searchLines.innerHTML = linesHtml;
  }

  // 2. Renderizar palabras resaltadas con precisión milimétrica en el <pre> espejo
  if (searchContent) {
    searchContent.innerHTML = buildHighlightedText(val, st.matches, currentIdx, 500);
  }

  sincronizarScrollEditor(ta);
}

function resaltarCoincidenciaItem(text, query) {
  if (!text || !query) return escapeHtml(text || '');
  const t = escapeHtml(text);
  const q = escapeHtml(query);
  const idx = t.toLowerCase().indexOf(q.toLowerCase());
  if (idx === -1) return t;
  return t.slice(0, idx) + '<mark>' + t.slice(idx, idx + q.length) + '</mark>' + t.slice(idx + q.length);
}

function irCoincidenciaEditor(id, dir, enfocar) {
  const st = getEditorSearchState(id);
  if (!st.matches || st.matches.length === 0) return;

  st.idx = (st.idx + dir + st.matches.length) % st.matches.length;
  saltarAMatchEditor(id, st.idx, enfocar);
}

function saltarAMatchEditor(id, matchIdx, enfocar) {
  const st = getEditorSearchState(id);
  if (!st.matches || !st.matches[matchIdx]) return;
  st.idx = matchIdx;

  const match = st.matches[matchIdx];
  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  const countEl = document.getElementById('countEd-' + id);
  if (countEl) {
    countEl.textContent = (st.idx + 1) + ' / ' + st.matches.length;
  }

  // Desplazar el textarea a la línea exacta
  const lineHeight = 20.8;
  const targetScroll = Math.max(0, (match.lineNum - 1) * lineHeight - (ta.clientHeight / 2) + 20);
  ta.scrollTop = targetScroll;

  // Actualizar resaltado activo
  actualizarResaltadosEditor(id);

  sincronizarScrollEditor(ta);
  actualizarEditorNota(ta);

  // Solo enfocar y seleccionar en el textarea si se solicita explícitamente (Enter, botón o clic)
  if (enfocar) {
    ta.focus();
    ta.setSelectionRange(match.start, match.end);
  }

  const resultsList = document.getElementById('resultsList-' + id);
  if (resultsList) {
    resultsList.querySelectorAll('.nt-ed-rp-item').forEach(function(el) {
      el.classList.toggle('active', el.textContent.includes('Lín ' + match.lineNum));
    });
  }
}

function saltarALineaEditor(id, numStr) {
  const lineNum = parseInt(numStr, 10);
  if (isNaN(lineNum) || lineNum < 1) return;

  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  const val = ta.value || '';
  const lines = val.split('\n');
  if (lineNum > lines.length) {
    alert('El documento tiene ' + lines.length + ' líneas.');
    return;
  }

  let offset = 0;
  for (let i = 0; i < lineNum - 1; i++) {
    offset += lines[i].length + 1;
  }
  const endOffset = offset + lines[lineNum - 1].length;

  ta.focus();
  ta.setSelectionRange(offset, endOffset);

  const lineHeight = 20.8;
  const targetScroll = Math.max(0, (lineNum - 1) * lineHeight - (ta.clientHeight / 2) + 20);
  ta.scrollTop = targetScroll;
  sincronizarScrollEditor(ta);
  actualizarEditorNota(ta);
}

function alternarListaFiltradas(id, forzar) {
  const panel = document.getElementById('resultsPanel-' + id);
  if (!panel) return;
  const nuevoEstado = (typeof forzar === 'boolean') ? forzar : (panel.style.display === 'none');
  panel.style.display = nuevoEstado ? 'block' : 'none';
  const btn = document.getElementById('btnListEd-' + id);
  if (btn) btn.classList.toggle('active', nuevoEstado);
}

function alternarReemplazarEditor(id) {
  const row = document.getElementById('repBar-' + id);
  if (!row) return;
  const abierto = row.style.display !== 'none';
  row.style.display = abierto ? 'none' : 'flex';
  const btn = document.getElementById('btnRepEd-' + id);
  if (btn) btn.classList.toggle('active', !abierto);
  if (!abierto) {
    const inp = document.getElementById('repInput-' + id);
    if (inp) inp.focus();
  }
}

function reemplazarActualEditor(id) {
  const st = getEditorSearchState(id);
  if (!st.matches || st.idx < 0 || !st.matches[st.idx]) return;

  const repInp = document.getElementById('repInput-' + id);
  const nuevoTexto = repInp ? repInp.value : '';

  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  const match = st.matches[st.idx];
  const s = match.start, e = match.end;

  if (document.execCommand) {
    ta.focus();
    ta.setSelectionRange(s, e);
    document.execCommand('insertText', false, nuevoTexto);
  } else {
    ta.setRangeText(nuevoTexto, s, e, 'end');
  }

  actualizarEditorNota(ta);
  filtrarEnEditor(id, st.query);
}

function reemplazarTodoEditor(id) {
  const st = getEditorSearchState(id);
  if (!st.query) return;

  const repInp = document.getElementById('repInput-' + id);
  const nuevoTexto = repInp ? repInp.value : '';

  const panel = document.getElementById('edit-' + id);
  if (!panel) return;
  const ta = panel.querySelector('.nt-ed-input');
  if (!ta) return;

  const val = ta.value || '';
  const regex = new RegExp(st.query.replace(/[-[\]{}()*+?.,\\^$|#\s]/g, '\\$&'), 'gi');
  const count = (val.match(regex) || []).length;
  if (count === 0) {
    alert('No se encontraron coincidencias para reemplazar.');
    return;
  }

  if (!confirm('¿Reemplazar ' + count + ' coincidencia(s) en todo el texto?')) return;

  ta.value = val.replace(regex, nuevoTexto);
  actualizarEditorNota(ta);
  filtrarEnEditor(id, st.query);
  alert('Se reemplazaron ' + count + ' coincidencia(s).');
}

function teclaFiltroEditor(e, id) {
  if (e.key === 'Enter') {
    e.preventDefault();
    irCoincidenciaEditor(id, e.shiftKey ? -1 : 1, true);
  } else if (e.key === 'Escape') {
    alternarListaFiltradas(id, false);
    const panel = document.getElementById('edit-' + id);
    if (panel) {
      const ta = panel.querySelector('.nt-ed-input');
      if (ta) ta.focus();
    }
  }
}

// Atajo Ctrl+F y Ctrl+G en los textareas del editor
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
    const ta = e.target;
    if (ta && ta.classList && ta.classList.contains('nt-ed-input')) {
      const panel = ta.closest('.edit-panel');
      if (panel) {
        e.preventDefault();
        const idMatch = panel.id.match(/^edit-(\d+)$/);
        if (idMatch) {
          const id = idMatch[1];
          const filtroInp = document.getElementById('filtroEd-' + id);
          if (filtroInp) {
            const sel = ta.value.substring(ta.selectionStart, ta.selectionEnd).trim();
            if (sel && sel.length < 60) {
              filtroInp.value = sel;
              filtrarEnEditor(id, sel);
            }
            filtroInp.focus();
            filtroInp.select();
          }
        }
      }
    }
  } else if ((e.ctrlKey || e.metaKey) && (e.key === 'g' || e.key === 'G')) {
    const ta = e.target;
    if (ta && ta.classList && ta.classList.contains('nt-ed-input')) {
      const panel = ta.closest('.edit-panel');
      if (panel) {
        e.preventDefault();
        const idMatch = panel.id.match(/^edit-(\d+)$/);
        if (idMatch) {
          const id = idMatch[1];
          const gotoInp = document.getElementById('gotoEd-' + id);
          if (gotoInp) {
            gotoInp.focus();
            gotoInp.select();
          }
        }
      }
    }
  }
});


