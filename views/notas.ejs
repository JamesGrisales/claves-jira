<style>
  .top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
  .top h1{ margin:0; }
  .top .count{ color:var(--accent-dark); background:var(--accent-soft); font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; }
  .toolbar{ display:flex; gap:10px; margin-bottom:14px; }
  .toolbar .search-wrap{ position:relative; flex:1; }
  .toolbar .search-wrap input{ padding-left:38px; font-family:var(--sans); font-size:14.5px; }
  .toolbar .search-wrap svg{ position:absolute; left:12px; top:50%; transform:translateY(-50%); width:16px; height:16px; stroke:var(--muted); pointer-events:none; }
  .toolbar button{ white-space:nowrap; }

  .tabs{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
  .tab{ background:var(--panel); border:1px solid var(--panel-edge); color:var(--muted); font-size:12.5px; font-weight:600; padding:7px 14px; border-radius:999px; cursor:pointer; transition:border-color .15s ease, color .15s ease, background-color .15s ease, transform .12s cubic-bezier(.34,1.56,.64,1), box-shadow .15s ease; }
  .tab:hover{ border-color:var(--accent); color:var(--accent-dark); transform:translateY(-1px); box-shadow:0 2px 8px rgba(20,30,45,.08); }
  .tab:active{ transform:translateY(0) scale(.96); }
  .tab.active{ background:linear-gradient(135deg, var(--accent), var(--accent-dark)); border-color:var(--accent); color:#fff; box-shadow:0 2px 8px rgba(47,158,143,.3); }

  #results{ display:flex; flex-direction:column; gap:8px; }
  .row{ position:relative; overflow:hidden; background:var(--panel); border:1px solid var(--panel-edge); border-radius:12px; padding:13px 15px; box-shadow:var(--shadow); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease, background-color .2s ease; }
  .row:hover{ border-color:var(--accent); transform:translateY(-1px); box-shadow:0 0 16px -2px rgba(var(--accent-rgb), 0.35), var(--shadow); }
  .row .main{ display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer; }
  .row .name{ display:flex; flex-direction:column; gap:3px; min-width:0; }
  .row .name .titulo{ font-size:14.5px; font-weight:600; overflow-wrap:anywhere; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .row .name .meta{ font-size:11.5px; color:var(--muted); overflow-wrap:anywhere; }
  .row .name .cat-badge{ font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.03em; color:var(--accent-dark); background:var(--accent-soft); display:inline-block; padding:2px 8px; border-radius:6px; width:fit-content; transition:background-color .18s ease, color .18s ease; }
  .row:hover .cat-badge{ background:var(--accent); color:#fff; }
  .row .actions{ display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .iconbtn{ background:transparent; border:1px solid var(--panel-edge); color:var(--muted); width:30px; height:30px; border-radius:7px; padding:0; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:border-color .15s ease, color .15s ease, transform .12s cubic-bezier(.34,1.56,.64,1), background-color .15s ease; flex-shrink:0; }
  .iconbtn:hover{ border-color:var(--accent); color:var(--accent-dark); background:var(--accent-soft); transform:translateY(-1px); }
  .iconbtn:active{ transform:translateY(0) scale(.92); }
  .iconbtn svg{ width:14px; height:14px; }
  .chev{ transition: transform .2s cubic-bezier(.34,1.56,.64,1); color:var(--muted); }
  .row:hover .chev{ color:var(--accent-dark); }
  .row.open .chev{ transform:rotate(90deg); color:var(--accent-dark); }

  @keyframes panelIn{ from{ opacity:0; transform:translateY(-4px); } to{ opacity:1; transform:translateY(0); } }
  .body-panel{ display:none; margin-top:12px; padding-top:12px; border-top:1px dashed var(--panel-edge); }
  .row.open .body-panel{ display:block; animation:panelIn .18s ease; }
  .contenido{ background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:9px; padding:12px 14px; font-family:var(--mono); font-size:13px; line-height:1.55; color:var(--text); margin:0; height:48vh; min-height:420px; max-height:80vh; overflow:auto; resize:vertical; tab-size:4; box-sizing:border-box; }
  .content-wrap{ margin-bottom:10px; }
  .body-actions{ display:flex; gap:8px; margin-bottom:10px; flex-wrap:wrap; }

  .sql-badge{ font-size:10.5px; font-weight:800; letter-spacing:.05em; color:#fff; background:linear-gradient(135deg, var(--accent), var(--accent-dark)); padding:2px 7px; border-radius:5px; }
  .search-in-note{ display:flex; align-items:center; gap:8px; margin-bottom:8px; }
  .search-in-note input{
    flex:1; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text);
    font-family:var(--sans); font-size:13px; padding:8px 11px; border-radius:8px; outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .search-in-note input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .search-in-note .match-count{ font-size:11.5px; color:var(--muted); white-space:nowrap; flex-shrink:1; min-width:0; max-width:38%; overflow:hidden; text-overflow:ellipsis; text-align:right; }
  div.contenido mark, .code-text mark{ background:#ffe58a; color:#1c2530; border-radius:2px; padding:0 1px; }
  :root[data-theme="dark"] div.contenido mark, :root[data-theme="dark"] .code-text mark{ background:#8a6d1f; color:#fff; }

  /* Bloque de código estilo editor (siempre oscuro, como VS Code) */
  .code-block{ background:#1e1e1e; color:#d4d4d4; border:1px solid #2d2d2d; border-radius:9px; padding:10px 0; font-family:var(--mono); font-size:13px; line-height:1.6; margin:0; height:48vh; min-height:420px; max-height:80vh; overflow:auto; resize:vertical; cursor:context-menu; tab-size:4; box-sizing:border-box; }
  .code-line{ display:flex; contain:layout style; }
  .code-line:hover{ background:rgba(255,255,255,.04); }
  .code-line .ln{ flex-shrink:0; width:46px; text-align:right; padding-right:12px; margin-right:12px; color:#6e7681; border-right:1px solid #333; user-select:none; }
  .code-line .code-text{ flex:1; min-width:0; white-space:pre-wrap; word-break:break-word; padding-right:14px; user-select:text; }
  .tk-kw{ color:#569cd6; font-weight:600; }
  .tk-fn{ color:#dcdcaa; }
  .tk-st{ color:#ce9178; }
  .tk-nu{ color:#b5cea8; }
  .tk-id{ color:#9cdcfe; }
  .tk-cm{ color:#7f8c8d; font-style:italic; }
  .tk-op{ color:#d4d4d4; }
  .tk-pl{ color:#4ade80; font-style:italic; }
  .tk-pa{ color:#fb923c; font-weight:600; }
  .code-block mark{ background:#ffd54a; color:#1e1e1e; border-radius:2px; padding:0 1px; }
  .img-wrap{ display:block; margin:6px 0; }
  .nota-img{ display:block; max-width:100%; max-height:460px; border-radius:6px; border:1px solid var(--panel-edge); background:#fff; }

  .ctx-menu{
    position:fixed; display:none; flex-direction:column; gap:2px; background:var(--panel); border:1px solid var(--panel-edge);
    border-radius:10px; box-shadow:var(--shadow-lg); padding:6px; z-index:1000; min-width:220px;
  }
  .ctx-menu button{
    background:transparent; color:var(--text); border:none; text-align:left; font-size:13px; font-weight:500;
    padding:9px 11px; border-radius:7px; box-shadow:none; transform:none; width:100%;
  }
  .ctx-menu button:hover{ background:var(--accent-soft); color:var(--accent-dark); filter:none; transform:none; box-shadow:none; }
  .ctx-menu button:active{ transform:none; }
  .ctx-hint{ font-size:11px; color:var(--muted); text-align:center; margin-top:4px; }

  .edit-panel{ display:none; margin-top:10px; padding-top:10px; border-top:1px dashed var(--panel-edge); }
  .edit-panel.open{ display:block; animation:panelIn .18s ease; }
  .edit-panel .fields{ display:flex; gap:10px; flex-wrap:wrap; }
  .edit-panel .fields > div{ flex:1; min-width:150px; }
  .edit-panel label{ margin-top:0; }
  /* ---------- Editor estilo VS Code con resaltado SQL y números de línea ---------- */
  .nt-ed-frame{
    display:flex;
    flex-direction:column;
    background:#1e1e1e;
    border:1px solid #2d2d2d;
    border-radius:9px;
    overflow:hidden;
    box-shadow:0 4px 16px rgba(0,0,0,.22);
    transition:border-color .15s ease, box-shadow .15s ease;
    margin-top:6px;
  }
  .nt-ed-frame:focus-within{
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(var(--accent-rgb),.22);
  }
  .nt-ed-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:6px 12px;
    background:#252526;
    border-bottom:1px solid #2d2d2d;
    font-size:11.5px;
    color:#858585;
    user-select:none;
  }
  .nt-ed-tit{
    display:flex;
    align-items:center;
    gap:7px;
    font-weight:600;
    color:#cccccc;
  }
  .nt-ed-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#569cd6;
    box-shadow:0 0 6px rgba(86,156,214,.6);
  }
  .nt-ed-meta{
    display:flex;
    align-items:center;
    gap:12px;
    font-family:var(--mono);
    font-size:11px;
    color:#858585;
  }
  .nt-ed-status{
    color:#9cdcfe;
  }
  .nt-ed-pos{
    color:#858585;
  }
  .nt-ed-box{
    display:flex;
    position:relative;
    background:#1e1e1e;
    height:48vh;
    min-height:420px;
    max-height:80vh;
    resize:vertical;
    overflow:hidden;
  }
  .nt-ed-gut{
    position:relative;
    overflow:hidden;
    flex-shrink:0;
    width:48px;
    background:#181818;
    border-right:1px solid #2d2d2d;
    color:#6e7681;
    user-select:none;
  }
  .nt-ed-gut-in{
    position:absolute;
    left:0;
    right:0;
    top:0;
    padding:12px 10px 24px 6px;
    text-align:right;
    white-space:pre;
    font-family:var(--mono);
    font-size:13px;
    line-height:1.6;
    color:#6e7681;
    will-change:transform;
  }
  .nt-ed-code{
    position:relative;
    flex:1;
    min-width:0;
    height:100%;
    background:#1e1e1e;
    overflow:hidden;
  }
  .nt-ed-capa{
    position:absolute;
    inset:0;
    z-index:3;
    margin:0;
    padding:12px 14px 24px 14px;
    overflow:hidden;
    pointer-events:none;
    color:#d4d4d4;
    font-family:var(--mono);
    font-size:13px;
    line-height:1.6;
    tab-size:4;
    white-space:pre;
    letter-spacing:normal;
    word-spacing:normal;
    background:transparent;
    border:0;
    box-sizing:border-box;
  }
  .nt-ed-input{
    position:relative;
    z-index:4 !important;
    display:block;
    width:100% !important;
    height:100% !important;
    min-height:100% !important;
    max-height:100% !important;
    margin:0;
    padding:12px 14px 24px 14px;
    background:transparent !important;
    color:transparent !important;
    -webkit-text-fill-color:transparent !important;
    caret-color:#569cd6;
    border:0 !important;
    border-radius:0 !important;
    box-shadow:none !important;
    outline:none !important;
    font-family:var(--mono);
    font-size:13px;
    line-height:1.6;
    tab-size:4;
    white-space:pre;
    letter-spacing:normal;
    word-spacing:normal;
    overflow:auto;
    box-sizing:border-box;
    resize:none !important;
  }
  .nt-ed-input::placeholder{
    color:#5a5a5a;
  }
  .nt-ed-input::selection{
    background:rgba(38, 79, 120, 0.65) !important;
    color:transparent !important;
  }
  .nt-ed-box.plain .nt-ed-input{
    color:#d4d4d4 !important;
    -webkit-text-fill-color:#d4d4d4 !important;
  }
  .nt-ed-box.plain .nt-ed-input::selection{
    background:rgba(38, 79, 120, 0.65) !important;
    color:#ffffff !important;
    -webkit-text-fill-color:#ffffff !important;
  }
  .nt-ed-box.plain .nt-ed-capa{
    display:none;
  }
  .nt-ed-input::-webkit-scrollbar, .nt-ed-gut::-webkit-scrollbar, .code-block::-webkit-scrollbar{
    width:10px; height:10px;
  }
  .nt-ed-input::-webkit-scrollbar-track, .nt-ed-gut::-webkit-scrollbar-track, .code-block::-webkit-scrollbar-track{
    background:#1e1e1e;
  }
  .nt-ed-input::-webkit-scrollbar-thumb, .nt-ed-gut::-webkit-scrollbar-thumb, .code-block::-webkit-scrollbar-thumb{
    background:#3e3e42; border-radius:5px; border:2px solid #1e1e1e;
  }
  .nt-ed-input::-webkit-scrollbar-thumb:hover, .nt-ed-gut::-webkit-scrollbar-thumb:hover, .code-block::-webkit-scrollbar-thumb:hover{
    background:#55555d;
  }
  .edit-panel .actions{ display:flex; gap:8px; margin-top:12px; }
  .edit-panel .actions form{ display:inline; }

  .empty{ color:var(--muted); font-size:13.5px; text-align:center; padding:30px 0; }
  .add-card{ margin-bottom:16px; display:none; }
  .add-card.open{ display:block; animation:panelIn .18s ease; }
  .add-card .fields{ display:flex; gap:10px; flex-wrap:wrap; }
  .add-card .fields > div{ flex:1; min-width:160px; }
  .add-card label{ margin-top:0; }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .22s ease, transform .22s cubic-bezier(.34,1.56,.64,1); box-shadow:0 6px 20px rgba(20,30,45,.18); }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  .toolbar .search-wrap .buscando{ position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:11.5px; color:var(--muted); pointer-events:none; }
  .pl-line{ white-space:pre-wrap; word-break:break-word; min-height:1.55em; }
  .cargando{ color:var(--muted); font-family:var(--sans); font-size:13px; padding:6px 2px; }
  .cargando.error{ color:var(--danger); }
  .mas-lineas{ text-align:center; font-family:var(--sans); font-size:12px; color:var(--muted); padding:10px 8px 4px; }
  .mas-arriba{ padding:8px 14px; font-size:12px; color:var(--muted); font-style:italic; }
  .code-block .mas-arriba{ color:#8b949e; }
  .code-block .mas-arriba a{ color:#4fc1ff; }
  .code-block .mas-lineas{ color:#8b949e; }
  .code-block .mas-lineas a{ color:#4fc1ff; }
  .ver-mas{ color:var(--accent-dark); font-style:italic; text-decoration:none; }
  .code-block .ver-mas{ color:#4fc1ff; }
  .cur-line{ outline:1px solid #ffd54a; outline-offset:-1px; background:rgba(255,213,74,.09); }
  .row.open, .row.open:hover{ transform:none; }
  .content-wrap.fullscreen{ position:fixed; inset:0; z-index:999999; background:var(--bg); padding:16px 24px; margin:0; display:flex; flex-direction:column; }
  .content-wrap.fullscreen .contenido, .content-wrap.fullscreen .code-block{ flex:1; max-height:none; min-height:0; resize:none; }
  .file-list{ margin-top:8px; display:flex; flex-direction:column; gap:4px; }
  .file-item{ display:flex; justify-content:space-between; gap:12px; font-size:12.5px; color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:7px; padding:6px 10px; }
  .file-item.bad{ color:var(--danger); border-color:var(--danger); }

  /* ---------- Hojas de cálculo (se ven como Excel) ---------- */
  .excel-badge{ font-size:10.5px; font-weight:800; letter-spacing:.05em; color:#fff; background:linear-gradient(135deg,#21a366,#107c41); padding:2px 7px; border-radius:5px; }
  .xl-box{ display:flex; flex-direction:column; background:#fff; color:#1f2328; border:1px solid #bfc5cc; border-radius:9px; overflow:hidden; max-height:68vh; min-height:120px; resize:vertical; font-family:Calibri,'Segoe UI',Arial,sans-serif; font-size:13px; }
  .xl-barra{ display:flex; align-items:center; gap:8px; background:#f3f3f3; border-bottom:1px solid #d0d0d0; padding:5px 8px; flex-shrink:0; }
  .xl-ref{ min-width:58px; text-align:center; background:#fff; border:1px solid #c6c6c6; padding:2px 8px; font-size:12px; }
  .xl-fx{ color:#7a7a7a; font-style:italic; font-family:'Times New Roman',serif; font-size:13px; }
  .xl-valor{ flex:1; min-width:0; background:#fff; border:1px solid #c6c6c6; padding:2px 8px; height:20px; line-height:20px; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .xl-aviso{ background:#fff8e1; color:#6b5300; font-size:12px; padding:4px 10px; border-bottom:1px solid #f0e2a8; flex-shrink:0; }
  .xl-scroll{ flex:1; min-height:60px; overflow:auto; background:#fff; }
  .xl-table{ border-collapse:separate; border-spacing:0; table-layout:fixed; }
  .xl-table th, .xl-table td{ border-right:1px solid #d9d9d9; border-bottom:1px solid #d9d9d9; padding:2px 5px; height:21px; line-height:17px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; background:#fff; }
  .xl-table thead th{ position:sticky; top:0; z-index:2; background:#f3f3f3; color:#444; font-weight:400; text-align:center; border-right:1px solid #c8c8c8; border-bottom:1px solid #c8c8c8; }
  .xl-table thead th.xl-esq{ left:0; z-index:3; }
  .xl-table td.xl-rh{ position:sticky; left:0; z-index:1; background:#f3f3f3; color:#444; text-align:center; padding:2px 0; border-right:1px solid #c8c8c8; user-select:none; }
  .xl-table td.xl-n{ text-align:right; }
  .xl-table td.xl-hit{ background:#fff2a8; }
  .xl-table td.xl-cur{ background:#ffe566; }
  .xl-table td.xl-sel, .xl-table td.xl-cur{ outline:2px solid #107c41; outline-offset:-2px; }
  .xl-hojas{ display:flex; gap:2px; background:#f3f3f3; border-top:1px solid #c8c8c8; padding:0 6px; overflow-x:auto; flex-shrink:0; }
  .xl-hoja{ color:#444; font-size:12.5px; padding:6px 14px; cursor:pointer; white-space:nowrap; border-bottom:2px solid transparent; user-select:none; }
  .xl-hoja:hover{ background:#e4e4e4; }
  .xl-hoja.activa{ background:#fff; color:#107c41; font-weight:700; border-bottom-color:#107c41; }
  .xl-cuenta{ background:#ffd54a; color:#1c2530; font-size:10.5px; font-weight:700; border-radius:8px; padding:0 6px; margin-left:4px; }
  .content-wrap.fullscreen .xl-box{ flex:1; max-height:none; min-height:0; resize:none; }
  .solo-texto-oculto{ display:none; }

  /* Dropdown inteligente para categorías en Notas / Jaivaná */
  .cat-dropdown-wrap { position: relative; display: inline-block; }
  .cat-more-btn { display: inline-flex !important; align-items: center !important; gap: 6px !important; background: var(--panel-alt) !important; border: 1px dashed var(--panel-edge) !important; }
  .cat-more-btn:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
  .cat-more-btn.active { background: var(--accent) !important; border: 1px solid var(--accent) !important; color: #fff !important; box-shadow: 0 4px 14px rgba(var(--accent-rgb), 0.35) !important; }
  .cat-dropdown-menu {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 1000;
    min-width: 250px; max-width: 320px; max-height: 380px;
    background: var(--panel); border: 1px solid var(--panel-edge); border-radius: 14px;
    box-shadow: 0 16px 36px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06);
    padding: 8px; display: flex; flex-direction: column; gap: 6px;
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .cat-dropdown-search { display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: var(--panel-alt); border: 1px solid var(--panel-edge); border-radius: 9px; }
  .cat-dropdown-search input { flex: 1; background: transparent; border: none; outline: none; font-size: 12.5px; color: var(--text); font-family: var(--sans); }
  .cat-dropdown-clear { background: transparent; border: none; color: var(--muted); cursor: pointer; padding: 0 4px; font-size: 14px; line-height: 1; }
  .cat-dropdown-list { overflow-y: auto; max-height: 280px; display: flex; flex-direction: column; gap: 2px; padding-right: 2px; }
  .cat-dropdown-item {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%;
    padding: 7px 10px; border: none; background: transparent; color: var(--text);
    font-size: 12.5px; font-weight: 600; border-radius: 8px; cursor: pointer; text-align: left;
    transition: all .12s ease;
  }
  .cat-dropdown-item:hover { background: var(--accent-soft) !important; color: var(--accent-dark) !important; transform: none !important; box-shadow: none !important; }
  .cat-dropdown-item.active { background: var(--accent) !important; color: #fff !important; font-weight: 700; }
  .cat-check { font-size: 12px; font-weight: 800; }


  /* ==========================================================================
     BARRA DE FILTRADO, BÚSQUEDA Y NAVEGACIÓN EN EL EDITOR DE CÓDIGO (JAIVANÁ/NOTAS)
     ========================================================================== */
  .nt-ed-filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    background: #1f1f20;
    border-bottom: 1px solid #333333;
    font-size: 12px;
    color: #cccccc;
    flex-wrap: wrap;
