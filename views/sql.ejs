    <button type="button" class="secondary" id="btnSN" title="Todas las sentencias de SQL listas para insertar (Ctrl+J)">🧩 Sentencias SQL</button>
    <span class="sp"></span>
    <label class="btn secondary" for="archivo">⬆ Abrir archivo</label>
    <input type="file" id="archivo" accept=".sql,.txt,.psql,.pgsql" style="display:none;">
    <button type="button" class="secondary" id="btnAmpliarEntrada" title="Pantalla completa (Esc para salir)">⤢ Ampliar</button>
    <button type="button" class="secondary" id="btnLimpiar">Limpiar</button>
  </div>
  <div class="rp" id="rp">
    <div class="rp-row">
      <input type="text" id="rpBuscar" placeholder="Buscar…" autocomplete="off" spellcheck="false">
      <input type="text" id="rpReemplazar" placeholder="Reemplazar por…" autocomplete="off" spellcheck="false">
      <select id="rpAlcance" title="Dónde se busca y reemplaza">
        <option value="todo">En todo el texto</option>
        <option value="datos">Solo dentro de datos ('...')</option>
