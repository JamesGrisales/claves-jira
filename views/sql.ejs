<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .chip{ display:inline-block; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; color:var(--accent-dark); background:var(--accent-soft); }
  .chip.bad{ color:var(--danger); background:var(--danger-soft); }
  .chip.info{ color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); font-weight:600; }

  .q-opts{ display:flex; gap:14px 18px; flex-wrap:wrap; align-items:flex-end; margin-bottom:12px; }
  .q-opt{ display:flex; flex-direction:column; gap:5px; }
  .q-opt > span{ font-size:11px; font-weight:700; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .q-opt input[type=number], .q-opt select{
    background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans);
    font-size:13px; padding:7px 10px; border-radius:8px; outline:none; height:34px;
  }
  .q-opt input[type=number]{ width:74px; }
  .q-opt input:focus, .q-opt select:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }

  .v-toolbar{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .v-toolbar .sp{ flex:1; }
  .v-toolbar button, .v-toolbar label.btn{ padding:8px 13px; font-size:13px; }
  label.btn{ display:inline-flex; align-items:center; gap:6px; cursor:pointer; margin:0; text-transform:none; letter-spacing:0; }
  .seg{ display:inline-flex; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:999px; padding:3px; }
  .seg button{ background:transparent; color:var(--muted); box-shadow:none; border:none; padding:6px 13px; font-size:12.5px; border-radius:999px; transform:none; }
  .seg button:hover{ color:var(--accent-dark); transform:none; box-shadow:none; filter:none; }
  .seg button.active{ background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; }

  #entrada{
    width:100%; min-height:200px; max-height:60vh; resize:vertical; background:var(--panel-alt); border:1px solid var(--panel-edge);
    color:var(--text); font-family:var(--mono); font-size:13px; line-height:1.5; padding:12px 14px; border-radius:10px; outline:none;
    white-space:pre; overflow:auto; tab-size:4; transition:border-color .15s ease, box-shadow .15s ease;
  }
  #entrada:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  #entrada.drag{ border-color:var(--accent); background:var(--accent-soft); }
  .hint{ font-size:12px; color:var(--muted); margin-top:6px; }

  #salida{ margin-top:16px; display:none; }
  #salida.on{ display:block; }
  .v-status{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .aviso{ font-size:12.5px; background:var(--danger-soft); color:var(--danger); border-radius:8px; padding:8px 12px; margin-bottom:10px; }
  .aviso ul{ margin:4px 0 0; padding-left:18px; }

  .code-block{ background:#1e1e1e; color:#d4d4d4; border:1px solid #2d2d2d; border-radius:9px; padding:10px 0; font-family:var(--mono); font-size:13px; line-height:1.6; margin:0; max-height:70vh; min-height:80px; overflow:auto; resize:vertical; tab-size:4; }
  .code-line{ display:flex; min-width:max-content; }
  .code-line:hover{ background:rgba(255,255,255,.04); }
  .code-line .ln{ position:sticky; left:0; background:#1e1e1e; flex-shrink:0; width:52px; text-align:right; padding-right:12px; margin-right:12px; color:#6e7681; border-right:1px solid #333; user-select:none; }
  .code-line .code-text{ white-space:pre; padding-right:16px; }
  .tk-kw{ color:#569cd6; } .tk-st{ color:#ce9178; } .tk-nu{ color:#b5cea8; } .tk-cm{ color:#6a9955; font-style:italic; } .tk-qi{ color:#9cdcfe; }

  .rp{ border:1px solid var(--panel-edge); background:var(--panel-alt); border-radius:10px; padding:10px 12px; margin-bottom:10px; display:none; }
  .rp.on{ display:block; }
  .rp-row{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .rp-row + .rp-row{ margin-top:8px; }
  .rp input[type=text]{ flex:1; min-width:140px; font-size:13px; padding:7px 10px; }
  .rp label.chk{ display:inline-flex; align-items:center; gap:5px; margin:0; font-size:12.5px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; }
  .rp button{ padding:7px 12px; font-size:12.5px; }
  .rp .cnt{ font-size:12px; color:var(--muted); min-width:90px; }
  .rp .presets{ font-size:12px; color:var(--muted); font-weight:600; }
  .tk-sp{ background:rgba(255,167,38,.5); box-shadow:inset 0 -2px 0 #ffa726; border-radius:2px; }
  .aviso.dato{ background:#fff4e0; color:#8a5300; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  :root[data-theme="dark"] .aviso.dato{ background:#3a2c12; color:#ffc46b; }
  .aviso.dato button{ padding:6px 11px; font-size:12.5px; }
  .rp select{ background:var(--panel); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:12.5px; padding:6px 8px; border-radius:8px; }
  .more{ margin:10px 12px 2px; }

  #lsEntrada{
    width:100%; height:110px; resize:vertical; background:var(--panel); border:1px solid var(--panel-edge);
    color:var(--text); font-family:var(--mono); font-size:13px; line-height:1.5; padding:9px 12px; border-radius:8px; outline:none;
    white-space:pre; overflow:auto;
  }
  #lsEntrada:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .ls-prev{ flex:1; min-width:200px; font-family:var(--mono); font-size:12px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ls-hint{ font-size:12px; color:var(--muted); margin-top:8px; }
  .ls-hint code{ background:var(--panel); border:1px solid var(--panel-edge); border-radius:4px; padding:0 4px; }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:1200; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  /* Pantalla completa (ampliar) y filtro de líneas */
  .ed-wrap.fullscreen{ position:fixed; inset:0; z-index:900; background:var(--bg); padding:14px 20px; margin:0; display:flex; flex-direction:column; overflow:auto; }
  .ed-wrap.fullscreen > *{ flex-shrink:0; }
  .ed-wrap.fullscreen #entrada{ flex:1 1 0; max-height:none; min-height:0; resize:none; }
  .ed-wrap.fullscreen .code-block{ flex:1 1 0; min-height:0; max-height:none; resize:none; }
  .f-input{ flex:1; min-width:180px; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13px; padding:7px 10px; border-radius:8px; outline:none; }
  .f-input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .f-cnt{ font-size:12px; color:var(--muted); white-space:nowrap; }
  .code-block mark{ background:#ffd54a; color:#1e1e1e; border-radius:2px; padding:0 1px; }
  .sin-res{ padding:14px 16px; color:#8b949e; font-family:var(--sans); font-size:13px; }

  /* =====================================================================
     EDITOR ESTILO pgAdmin: colores, números de línea, sugerencias y sentencias
     ===================================================================== */
  .ed-frame, .code-block, .sn-prev{
    --ed-bg:#ffffff; --ed-fg:#1e293b; --ed-gut-bg:#f3f6fc; --ed-gut-fg:#9aa8c4; --ed-gut-edge:#dfe7f5;
    --ed-cur:rgba(37,99,235,.07); --ed-sel:rgba(37,99,235,.26);
    --ed-brk:rgba(37,99,235,.16); --ed-brk-line:rgba(37,99,235,.7); --ed-brk-mal:rgba(225,29,72,.16); --ed-brk-mal-line:rgba(225,29,72,.75);
    --ed-ph:rgba(245,158,11,.20); --ed-ph-line:rgba(217,119,6,.75); --ed-mark:#fde68a; --ed-mark-fg:#1e293b;
    --t-kw:#1d4ed8; --t-ty:#0e7490; --t-fn:#a21caf; --t-st:#b91c1c; --t-nu:#047857; --t-cm:#15803d; --t-qi:#6d28d9; --t-pa:#c2410c;
  }
  :root[data-theme="dark"] .ed-frame, :root[data-theme="dark"] .code-block, :root[data-theme="dark"] .sn-prev{
    --ed-bg:#0a1124; --ed-fg:#d6e0f5; --ed-gut-bg:#080e1d; --ed-gut-fg:#4d6190; --ed-gut-edge:#17244a;
    --ed-cur:rgba(79,143,247,.09); --ed-sel:rgba(79,143,247,.34);
    --ed-brk:rgba(79,143,247,.22); --ed-brk-line:rgba(120,170,255,.85); --ed-brk-mal:rgba(251,113,133,.2); --ed-brk-mal-line:rgba(251,113,133,.85);
    --ed-ph:rgba(251,191,36,.18); --ed-ph-line:rgba(251,191,36,.7); --ed-mark:#a16207; --ed-mark-fg:#fff;
    --t-kw:#6cb0ff; --t-ty:#4ec9b0; --t-fn:#e5c07b; --t-st:#ce9178; --t-nu:#b5cea8; --t-cm:#6a9955; --t-qi:#9cdcfe; --t-pa:#fb923c;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .ed-frame, :root:not([data-theme="light"]) .code-block, :root:not([data-theme="light"]) .sn-prev{
      --ed-bg:#0a1124; --ed-fg:#d6e0f5; --ed-gut-bg:#080e1d; --ed-gut-fg:#4d6190; --ed-gut-edge:#17244a;
      --ed-cur:rgba(79,143,247,.09); --ed-sel:rgba(79,143,247,.34);
      --ed-brk:rgba(79,143,247,.22); --ed-brk-line:rgba(120,170,255,.85); --ed-brk-mal:rgba(251,113,133,.2); --ed-brk-mal-line:rgba(251,113,133,.85);
      --ed-ph:rgba(251,191,36,.18); --ed-ph-line:rgba(251,191,36,.7); --ed-mark:#a16207; --ed-mark-fg:#fff;
      --t-kw:#6cb0ff; --t-ty:#4ec9b0; --t-fn:#e5c07b; --t-st:#ce9178; --t-nu:#b5cea8; --t-cm:#6a9955; --t-qi:#9cdcfe; --t-pa:#fb923c;
    }
  }
  .tk-kw{ color:var(--t-kw); font-weight:600; } .tk-ty{ color:var(--t-ty); } .tk-fn{ color:var(--t-fn); }
  .tk-st{ color:var(--t-st); } .tk-nu{ color:var(--t-nu); } .tk-cm{ color:var(--t-cm); font-style:italic; }
  .tk-qi{ color:var(--t-qi); } .tk-pa{ color:var(--t-pa); }

  /* marco del editor */
  .ed-frame{ border:1px solid var(--panel-edge); border-radius:14px; overflow:hidden; background:var(--ed-bg); display:flex; flex-direction:column;
    transition:border-color .2s ease, box-shadow .2s ease; }
  .ed-frame:focus-within{ border-color:var(--accent); box-shadow:0 0 0 4px rgba(var(--accent-rgb),.14); }
  .ed-box{ display:flex; position:relative; background:var(--ed-bg); }
  .ed-code{ position:relative; flex:1; min-width:0; background:var(--ed-bg); }
  .gut{ position:relative; overflow:hidden; flex-shrink:0; background:var(--ed-gut-bg); border-right:1px solid var(--ed-gut-edge); color:var(--ed-gut-fg); user-select:none; }
  .gut-in{ position:absolute; left:0; right:0; top:0; padding:12px 10px 28px 8px; text-align:right; white-space:pre; font-family:var(--mono); font-size:13px; line-height:1.5; will-change:transform; }
  #capa{ position:absolute; inset:0; margin:0; padding:12px 28px 28px 14px; overflow:hidden; pointer-events:none; color:var(--ed-fg);
    font-family:var(--mono); font-size:13px; line-height:1.5; tab-size:4; white-space:pre; letter-spacing:normal; word-spacing:normal; background:transparent; border:0; box-sizing:border-box; }
  #entrada{ position:relative; z-index:2; display:block; width:100%; min-height:240px; max-height:60vh; resize:vertical; overflow:auto; margin:0;
    background:transparent; color:transparent; caret-color:var(--ed-fg); border:0; border-radius:0; box-shadow:none; outline:none;
    padding:12px 14px; font-family:var(--mono); font-size:13px; line-height:1.5; tab-size:4; white-space:pre; letter-spacing:normal; word-spacing:normal; box-sizing:border-box; }
  #entrada:focus{ border:0; box-shadow:none; background:transparent; }
  #entrada.drag{ background:rgba(var(--accent-rgb),.10); }
  #entrada::placeholder{ color:var(--ed-gut-fg); }
  #entrada::selection{ background:var(--ed-sel); color:transparent; }
  .ed-box.plain #entrada{ color:var(--ed-fg); } .ed-box.plain #capa{ display:none; }
  .curline{ position:absolute; left:0; right:0; z-index:0; background:var(--ed-cur); pointer-events:none; display:none; }
  .brk, .ph{ position:absolute; z-index:1; pointer-events:none; border-radius:3px; display:none; }
  .brk{ background:var(--ed-brk); box-shadow:inset 0 0 0 1px var(--ed-brk-line); } .brk.mal{ background:var(--ed-brk-mal); box-shadow:inset 0 0 0 1px var(--ed-brk-mal-line); }
  .ph{ background:var(--ed-ph); box-shadow:inset 0 0 0 1px var(--ed-ph-line); }
  .ed-estado{ display:flex; justify-content:space-between; gap:6px 16px; flex-wrap:wrap; padding:6px 12px; font-size:11.5px; color:var(--muted); background:var(--ed-gut-bg); border-top:1px solid var(--ed-gut-edge); }
  .ed-estado b{ color:var(--text); font-weight:700; } .ed-estado kbd{ font-family:var(--mono); font-size:10.5px; padding:0 5px; border-radius:4px; border:1px solid var(--panel-edge); background:var(--panel); color:var(--text); }

  /* salida con los mismos colores */
  .code-block{ background:var(--ed-bg); color:var(--ed-fg); border:1px solid var(--panel-edge); border-radius:14px; }
  .code-line:hover{ background:var(--ed-cur); }
  .code-line .ln{ background:var(--ed-gut-bg); color:var(--ed-gut-fg); border-right:1px solid var(--ed-gut-edge); }
  .code-block mark{ background:var(--ed-mark); color:var(--ed-mark-fg); }
  .sin-res{ color:var(--muted); }

  /* pantalla completa con el nuevo editor */
  .ed-wrap.fullscreen .ed-frame{ flex:1 1 0; min-height:0; }
  .ed-wrap.fullscreen .ed-box{ flex:1 1 0; min-height:0; }
  .ed-wrap.fullscreen #entrada{ height:100%; max-height:none; min-height:0; resize:none; }
  .ed-wrap.fullscreen .ed-code{ display:flex; }

  /* sugerencias al escribir (como pgAdmin) */
  .ac{ position:absolute; z-index:6; display:none; min-width:250px; max-width:440px; max-height:236px; overflow:auto; padding:4px; background:var(--panel); border:1px solid var(--panel-edge);
    border-radius:12px; box-shadow:var(--shadow-lg); font-family:var(--mono); font-size:12.5px; animation:panelIn .12s ease; }
  .ac-it{ display:flex; align-items:center; gap:9px; padding:5px 8px; border-radius:8px; cursor:pointer; color:var(--text); }
  .ac-it.sel{ background:var(--accent-soft); box-shadow:inset 0 0 0 1px rgba(var(--accent-rgb),.35); }
  .ac-it:hover{ background:var(--accent-soft); }
  .ac-k{ width:22px; height:22px; border-radius:6px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-family:var(--sans); font-size:11px; font-weight:800; color:#fff; }
  .ac-k.kw{ background:#2563eb; } .ac-k.ty{ background:#0e7490; } .ac-k.fn{ background:#a21caf; } .ac-k.sn{ background:#f59e0b; } .ac-k.id{ background:#64748b; }
  .ac-t{ font-weight:700; white-space:nowrap; } .ac-d{ margin-left:auto; padding-left:12px; color:var(--muted); font-family:var(--sans); font-size:11.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:190px; }
  .ac-pie{ padding:5px 8px 3px; font-family:var(--sans); font-size:10.5px; color:var(--muted); border-top:1px solid var(--panel-edge); margin-top:3px; }

  /* panel de sentencias */
  .sn-head{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .sn-head .f-input{ flex:1; min-width:220px; }
  .sn-cats{ display:flex; gap:6px; flex-wrap:wrap; margin:10px 0; }
  .sn-chip{ padding:5px 11px !important; font-size:12px !important; border-radius:999px !important; box-shadow:none !important; background:var(--panel) !important; color:var(--muted) !important; border:1px solid var(--panel-edge) !important; transform:none !important; }
  .sn-chip:hover{ color:var(--accent-dark) !important; border-color:var(--accent) !important; }
  .sn-chip.on{ background:var(--grad) !important; color:#fff !important; border-color:transparent !important; box-shadow:0 6px 14px -6px rgba(var(--accent-rgb),.7) !important; }
  .sn-chip small{ opacity:.75; margin-left:4px; font-weight:700; }
  .sn-body{ display:grid; grid-template-columns:minmax(0,1fr) 380px; gap:12px; align-items:start; }
  .sn-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(205px, 1fr)); gap:8px; max-height:312px; overflow:auto; padding:2px 4px 2px 2px; align-content:start; }
  .sn-card{ text-align:left !important; display:flex !important; flex-direction:column; gap:3px; padding:9px 11px !important; border-radius:11px !important; background:var(--panel) !important; color:var(--text) !important;
    border:1px solid var(--panel-edge) !important; box-shadow:0 1px 2px rgba(15,35,80,.05) !important; font-weight:400 !important; transition:transform .18s var(--ease), border-color .18s ease, box-shadow .18s ease !important; }
  .sn-card:hover, .sn-card:focus-visible{ transform:translateY(-2px) !important; border-color:var(--accent) !important; box-shadow:0 10px 20px -12px rgba(var(--accent-rgb),.65) !important; }
  .sn-card b{ font-size:12.8px; font-family:var(--mono); font-weight:700; color:var(--accent-dark); line-height:1.25; }
  .sn-card span{ font-size:11.6px; color:var(--muted); line-height:1.3; white-space:normal; }
  .sn-card .tag{ align-self:flex-start; margin-top:2px; font-size:10px; font-weight:700; padding:1px 7px; border-radius:99px; background:var(--accent-soft); color:var(--accent-dark); }
  .sn-prev{ position:sticky; top:0; border:1px solid var(--panel-edge); border-radius:12px; background:var(--ed-bg); overflow:hidden; display:flex; flex-direction:column; min-height:120px; }
  .sn-prev h4{ margin:0; padding:9px 12px; font-size:12.5px; background:var(--ed-gut-bg); border-bottom:1px solid var(--ed-gut-edge); display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--text); }
  .sn-prev h4 em{ font-style:normal; font-weight:500; color:var(--muted); font-size:11.5px; }
  .sn-prev pre{ margin:0; padding:10px 12px; max-height:220px; overflow:auto; font-family:var(--mono); font-size:12px; line-height:1.55; color:var(--ed-fg); white-space:pre; }
  .sn-prev pre u{ text-decoration:none; background:var(--ed-ph); box-shadow:inset 0 0 0 1px var(--ed-ph-line); border-radius:3px; padding:0 2px; }
  .sn-prev .vacio{ padding:16px 14px; font-size:12.5px; color:var(--muted); line-height:1.5; }
  .sn-prev .acc{ display:flex; gap:8px; padding:8px 10px; border-top:1px solid var(--ed-gut-edge); background:var(--ed-gut-bg); }
  .sn-prev .acc button{ padding:6px 11px; font-size:12px; }
  .sn-vacio{ grid-column:1/-1; padding:22px 10px; text-align:center; color:var(--muted); font-size:13px; }
  .sn-tip{ margin-top:8px; font-size:12px; color:var(--muted); }
  @media (max-width:1050px){ .sn-body{ grid-template-columns:1fr; } .sn-prev{ position:static; } }
</style>

<div class="top">
  <h1>Formateador SQL</h1>
  <span class="chip info" id="chipVacio">Pega o abre un archivo</span>
</div>
<p class="sub">Pega tu SQL y se limpia solo: quita espacios, tabs y saltos de línea que sobran, cada cláusula queda en su línea y las listas de datos se parten en filas de máximo N datos (como en pgAdmin). Todo se procesa en tu navegador: no se guarda ni se envía nada.</p>

<div class="card" style="padding:18px;">
  <div class="q-opts">
    <div class="q-opt">
      <span>Palabras clave</span>
      <div class="seg" id="segKw">
        <button type="button" class="active" data-v="upper">MAYÚS</button>
        <button type="button" data-v="lower">minús</button>
        <button type="button" data-v="keep">Igual</button>
      </div>
    </div>
    <div class="q-opt">
      <span>Datos por fila</span>
      <input type="number" id="perRow" min="1" max="1000" value="10">
    </div>
    <div class="q-opt">
      <span>Columnas del SELECT</span>
      <div class="seg" id="segSel">
        <button type="button" class="active" data-v="one">Una por línea</button>
        <button type="button" data-v="group">Por filas</button>
      </div>
    </div>
    <div class="q-opt">
      <span>Sangría</span>
      <select id="indent">
        <option value="4">4 espacios</option>
        <option value="2">2 espacios</option>
        <option value="tab">Tab</option>
      </select>
    </div>
  </div>

 <div class="ed-wrap" id="edEntrada">
  <div class="v-toolbar">
    <button type="button" id="btnFormatear" title="Atajo: Ctrl+Shift+F">Formatear</button>
    <button type="button" class="secondary" id="btnRP" title="Atajo: Ctrl+H">🔎 Buscar y reemplazar</button>
