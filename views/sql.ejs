/* ---------- editor estilo pgAdmin ---------- */
var capa = $('capa'), gut = $('gut'), gutIn = $('gutIn'), curl = $('curline'), brk1 = $('brk1'), brk2 = $('brk2'), phs = $('phs'), acBox = $('ac'), edEstado = $('edEstadoPos'), edBox = $('edBox');
var capaTexto = null, rafCapa = 0, rafDec = 0, LIMITE_CAPA = 120000, gutLineas = 0, met = null;
