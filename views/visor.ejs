async function ejecutarExtraccionWms() {
  var pedido = inputWmsPedido.value.trim();
  var campo = (inputWmsCampo.value || 'numero_pedido').trim();
  var exacto = chkWmsExacto.checked;
  var soloJson = chkWmsSoloJson.checked;

  if (!pedido) {
    alert('Por favor escribe el número de pedido a buscar (ej: 90396).');
    inputWmsPedido.focus();
    return;
  }

  wmsProgresoBox.style.display = 'flex';
  wmsProgresoTxt.textContent = 'Iniciando escaneo para pedido ' + pedido + '…';
  btnWmsExtraer.disabled = true;

  try {
    var regex;
    if (exacto) {
      regex = new RegExp('"' + escapeRegExp(campo) + '"\\s*:\\s*"?' + escapeRegExp(pedido) + '"?\\b', 'i');
    } else {
      regex = new RegExp(escapeRegExp(pedido), 'i');
    }

    var tInicio = performance.now();
    var rawLines = [];
    var jsonBloques = [];
    var lineCount = 0;

    if (wmsArchivoSeleccionado) {
      var file = wmsArchivoSeleccionado;
      var chunkSize = 4 * 1024 * 1024; // 4MB
      var offset = 0;
      var leftover = '';

      while (offset < file.size) {
        var slice = file.slice(offset, offset + chunkSize);
        var textChunk = await leerBloqueComoTexto(slice);
        offset += chunkSize;

        var fullText = leftover + textChunk;
        var lines = fullText.split(/\r?\n/);
        leftover = lines.pop();

        for (var i = 0; i < lines.length; i++) {
          lineCount++;
          var l = lines[i];
          if (regex.test(l)) {
            rawLines.push(l);
            var parsed = extraerJsonDeLinea(l);
            if (parsed) jsonBloques.push({ lineNum: lineCount, data: parsed });
          }
        }

        var pct = Math.min(100, Math.round((offset / file.size) * 100));
        wmsProgresoTxt.textContent = 'Analizando ' + pct + '% (' + lineCount.toLocaleString('es-CO') + ' líneas, ' + rawLines.length + ' encontradas)…';
      }

      if (leftover) {
        lineCount++;
        if (regex.test(leftover)) {
          rawLines.push(leftover);
          var parsedLast = extraerJsonDeLinea(leftover);
          if (parsedLast) jsonBloques.push({ lineNum: lineCount, data: parsedLast });
        }
      }

    } else {
      var textoActual = entrada.value;
      if (!textoActual.trim()) {
        wmsProgresoBox.style.display = 'none';
        btnWmsExtraer.disabled = false;
        alert('Por favor selecciona un archivo .log (o pega contenido en el visor) antes de extraer.');
        return;
      }
      var lineasEntrada = textoActual.split(/\r?\n/);
      for (var j = 0; j < lineasEntrada.length; j++) {
        lineCount++;
        var curLine = lineasEntrada[j];
        if (regex.test(curLine)) {
          rawLines.push(curLine);
          var pCur = extraerJsonDeLinea(curLine);
          if (pCur) jsonBloques.push({ lineNum: lineCount, data: pCur });
        }
      }
    }

    var duracion = ((performance.now() - tInicio) / 1000).toFixed(2);
    wmsUltimosResultados = { pedido: pedido, rawLines: rawLines, jsonBloques: jsonBloques };

    if (rawLines.length === 0) {
      wmsEstadoChip.className = 'chip warn';
      wmsEstadoChip.textContent = '0 coincidencias (' + duracion + 's)';
      wmsProgresoBox.style.display = 'none';
      btnWmsDescargarLog.disabled = true;
      btnWmsDescargarJson.disabled = true;
      alert('No se encontraron coincidencias exactas para el pedido [' + pedido + '] en ' + lineCount.toLocaleString('es-CO') + ' líneas analizadas (' + duracion + 's).');
      return;
    }

    wmsEstadoChip.className = 'chip ok';
    wmsEstadoChip.textContent = rawLines.length + ' coincidencia(s) en ' + duracion + 's';
    btnWmsDescargarLog.disabled = false;
    btnWmsDescargarJson.disabled = jsonBloques.length === 0;

    if (soloJson && jsonBloques.length > 0) {
      if (jsonBloques.length === 1) {
        entrada.value = JSON.stringify(jsonBloques[0].data, null, 2);
      } else {
        entrada.value = JSON.stringify(jsonBloques.map(function(item){ return item.data; }), null, 2);
      }
    } else {
      entrada.value = rawLines.join('\n');
    }

    procesar();

    wmsProgresoTxt.textContent = '¡Listo! ' + rawLines.length + ' coincidencia(s) extraída(s) con éxito en ' + duracion + 's.';
    setTimeout(function(){ wmsProgresoBox.style.display = 'none'; }, 4000);

  } catch(err) {
    console.error('Error al extraer pedido:', err);
    alert('Ocurrió un error al procesar el archivo: ' + err.message);
    wmsProgresoBox.style.display = 'none';
  } finally {
    btnWmsExtraer.disabled = false;
  }
}

function leerBloqueComoTexto(blob) {
  return new Promise(function(resolve, reject){
    var fr = new FileReader();
    fr.onload = function(){ resolve(fr.result); };
    fr.onerror = function(){ reject(fr.error); };
    fr.readAsText(blob, 'utf-8');
  });
}

function extraerJsonDeLinea(linea) {
  var start = linea.indexOf('{');
  var end = linea.lastIndexOf('}');
  if (start !== -1 && end > start) {
    try {
      return JSON.parse(linea.slice(start, end + 1));
    } catch(e) {
      return null;
    }
  }
  return null;
}

