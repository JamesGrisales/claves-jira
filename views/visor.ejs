function actualizarStatsPanel(lado) {
  var ed = $('diffEntrada' + lado);
  if (ed && ed._actualizarSintaxis) ed._actualizarSintaxis();
  var txt = ed ? ed.value : '';
  var spanStats = $('diffStats' + lado);
