  spanStats.textContent = tDetect + ' · ' + fmtNum(lineas) + ' líneas · ' + tamStr;
}

// 4. PARSER UNIVERSAL ROBUSTO PARA XML & JSON
function xmlNodeToCleanObj(node) {
  if (node.nodeType === 3) return node.nodeValue.trim();
  if (node.nodeType === 4) return node.nodeValue;
  var obj = {};
  if (node.attributes && node.attributes.length > 0) {
    for (var i = 0; i < node.attributes.length; i++) {
      var attr = node.attributes[i];
      obj['@' + attr.name] = attr.value;
    }
  }
  var textAccum = '';
  var hasElementChildren = false;
  if (node.childNodes && node.childNodes.length > 0) {
    for (var j = 0; j < node.childNodes.length; j++) {
      var child = node.childNodes[j];
      if (child.nodeType === 1) {
        hasElementChildren = true;
        var name = child.nodeName;
        var childVal = xmlNodeToCleanObj(child);
        if (obj[name] !== undefined) {
          if (!Array.isArray(obj[name])) obj[name] = [obj[name]];
          obj[name].push(childVal);
        } else {
          obj[name] = childVal;
        }
      } else if (child.nodeType === 3 || child.nodeType === 4) {
        textAccum += child.nodeValue;
      }
    }
  }
  if (!hasElementChildren) {
    var tr = textAccum.trim();
    if (Object.keys(obj).length === 0) return tr;
    if (tr) obj['#text'] = tr;
  }
  return obj;
}

function formatearXmlCanonico(doc) {
  var lineas = [];
  emitXmlDoc(doc, '', 0, lineas);
  return lineas.map(function(l){
    return new Array(l.ind + 1).join('  ') + l.toks.map(function(tk){ return tk.t; }).join('');
  }).join('\n');
}

function sortKeysRecursivo(item) {
  if (Array.isArray(item)) return item.map(sortKeysRecursivo);
  if (item !== null && typeof item === 'object') {
    var sorted = {};
    Object.keys(item).sort().forEach(function(k) {
      sorted[k] = sortKeysRecursivo(item[k]);
    });
    return sorted;
  }
  return item;
}

function prepararParaDiff(rawTxt, modoForzado) {
  var t = (rawTxt || '').replace(/^\uFEFF/, '').trim();
  if (!t) return { ok: false, error: 'Documento vacío', tipo: 'vacio', lineas: [], textoFormateado: '', objeto: null };

  var esXml = (modoForzado === 'xml') || (modoForzado !== 'json' && (t.charAt(0) === '<' || /^\s*<\?xml/i.test(t) || /<\/?[a-z_0-9]+(\s|:[a-z_0-9]+|>)/i.test(t)));

  if (esXml) {
    var analXml = analizarXml(t);
    if (analXml.ok) {
      var doc = analXml.doc;
      var objXml = doc.documentElement ? xmlNodeToCleanObj(doc.documentElement) : {};
      var rootTag = doc.documentElement ? doc.documentElement.nodeName : 'root';
      var wrappedObj = {};
      wrappedObj[rootTag] = objXml;
      var fmtXml = formatearXmlCanonico(doc);
      return {
        ok: true,
        tipo: 'xml',
        doc: doc,
        objeto: wrappedObj,
        textoFormateado: fmtXml,
        lineas: fmtXml.split(/\r?\n/)
      };
    } else {
      var fmtFallback = prettyPrintXml(t, '  ');
      return {
        ok: true,
        tipo: 'xml',
        doc: null,
        objeto: null,
        textoFormateado: fmtFallback,
        lineas: fmtFallback.split(/\r?\n/)
      };
    }
  }

  // Intento 1: JSON Estándar
  try {
    var objStd = JSON.parse(t);
    var fmtStd = JSON.stringify(objStd, null, 2);
    return {
      ok: true,
      tipo: 'json',
      objeto: objStd,
      textoFormateado: fmtStd,
      lineas: fmtStd.split(/\r?\n/)
    };
  } catch(eStd) {
    // Intento 2: NDJSON / Múltiples JSON por línea
    if (t.indexOf('\n') !== -1 && !/^\s*\[/.test(t)) {
      var lineasCrudas = t.split(/\r?\n/).map(function(l){ return l.trim(); }).filter(Boolean);
      var arrayNd = [];
      var esNdjson = true;
      for (var i = 0; i < lineasCrudas.length; i++) {
        var row = lineasCrudas[i];
        var sIdx = row.indexOf('{');
        var eIdx = row.lastIndexOf('}');
        if (sIdx !== -1 && eIdx > sIdx) {
          try { arrayNd.push(JSON.parse(row.slice(sIdx, eIdx + 1))); }
          catch(e){ esNdjson = false; break; }
        } else { esNdjson = false; break; }
      }
      if (esNdjson && arrayNd.length > 0) {
        var fmtNd = JSON.stringify(arrayNd, null, 2);
        return {
          ok: true,
          tipo: 'json',
          subtipo: 'ndjson',
          objeto: arrayNd,
          textoFormateado: fmtNd,
          lineas: fmtNd.split(/\r?\n/)
        };
      }
    }

    // Intento 3: Loose JSON / JSON con claves sin comillas o comillas simples
    try {
      var saneado = t
        .replace(/\/\/.*$/gm, '')
        .replace(/\/\*[\s\S]*?\*\//g, '')
        .replace(/([{,]\s*)([a-zA-Z0-9_$]+)\s*:/g, '$1"$2":')
        .replace(/'([^'\\]*(?:\\.[^'\\]*)*)'/g, '"$1"')
        .replace(/,\s*([}\]])/g, '$1');
      var objLoose = JSON.parse(saneado);
      var fmtLoose = JSON.stringify(objLoose, null, 2);
      return {
        ok: true,
        tipo: 'json',
        subtipo: 'loose',
        objeto: objLoose,
        textoFormateado: fmtLoose,
        lineas: fmtLoose.split(/\r?\n/)
      };
    } catch(eLoose) {
      // Intento 4: Si no se intentó XML antes, probar XML
      if (!esXml) {
        var altXml = analizarXml(t);
        if (altXml.ok) {
          var docAlt = altXml.doc;
          var objAltXml = docAlt.documentElement ? xmlNodeToCleanObj(docAlt.documentElement) : {};
          var rTag = docAlt.documentElement ? docAlt.documentElement.nodeName : 'root';
          var wrapAlt = {}; wrapAlt[rTag] = objAltXml;
          var fmtAlt = formatearXmlCanonico(docAlt);
          return {
            ok: true,
            tipo: 'xml',
            doc: docAlt,
            objeto: wrapAlt,
            textoFormateado: fmtAlt,
            lineas: fmtAlt.split(/\r?\n/)
          };
        }
      }

      // Si todo falla, texto plano
      return {
        ok: true,
        tipo: 'texto',
        objeto: null,
        textoFormateado: t,
        lineas: t.split(/\r?\n/)
      };
    }
  }
}

// 5. ANALIZADOR DE DIFERENCIAS SEMÁNTICAS (Claves, Propiedades, Valores)
function deepAnalyzeDiff(valA, valB, path, diffs) {
  if (valA === valB) return;

  var typeA = Array.isArray(valA) ? 'array' : (valA !== null && typeof valA === 'object' ? 'object' : typeof valA);
  var typeB = Array.isArray(valB) ? 'array' : (valB !== null && typeof valB === 'object' ? 'object' : typeof valB);

  if (typeA !== typeB) {
    diffs.push({
      type: 'mod',
      path: path || 'raíz',
      valA: formatValSimple(valA),
      valB: formatValSimple(valB),
      desc: 'Cambio de tipo o estructura (' + typeA + ' → ' + typeB + ')'
    });
    return;
  }

  if (typeA === 'object') {
    var keysA = Object.keys(valA);
    var keysB = Object.keys(valB);
    var allKeys = Array.from(new Set(keysA.concat(keysB))).sort();

    allKeys.forEach(function(k) {
      var subPath = path ? path + '.' + k : k;
      if (!(k in valA)) {
        diffs.push({
          type: 'add',
          path: subPath,
          valA: '— (No presente en A)',
          valB: formatValSimple(valB[k]),
          desc: 'Propiedad agregada en B'
        });
      } else if (!(k in valB)) {
        diffs.push({
          type: 'del',
          path: subPath,
          valA: formatValSimple(valA[k]),
          valB: '— (Eliminado en B)',
          desc: 'Propiedad eliminada en B'
        });
      } else {
        deepAnalyzeDiff(valA[k], valB[k], subPath, diffs);
      }
    });
    return;
  }

  if (typeA === 'array') {
    var maxLen = Math.max(valA.length, valB.length);
    for (var i = 0; i < maxLen; i++) {
      var arrPath = (path || 'lista') + '[' + i + ']';
      if (i >= valA.length) {
        diffs.push({
          type: 'add',
          path: arrPath,
          valA: '— (No presente en A)',
          valB: formatValSimple(valB[i]),
          desc: 'Elemento agregado en la lista'
        });
      } else if (i >= valB.length) {
        diffs.push({
          type: 'del',
          path: arrPath,
          valA: formatValSimple(valA[i]),
          valB: '— (Eliminado en B)',
          desc: 'Elemento eliminado de la lista'
        });
      } else {
        deepAnalyzeDiff(valA[i], valB[i], arrPath, diffs);
      }
    }
    return;
  }

  // Primitivos distintos
  diffs.push({
    type: 'mod',
    path: path || 'valor',
    valA: formatValSimple(valA),
    valB: formatValSimple(valB),
    desc: 'Valor modificado'
  });
}

function formatValSimple(v) {
  if (v === undefined) return 'undefined';
  if (v === null) return 'null';
  if (typeof v === 'object') {
    try {
      var s = JSON.stringify(v);
      return s.length > 100 ? s.slice(0, 100) + '…' : s;
    } catch(e) { return String(v); }
  }
  return String(v);
}

// 6. MOTOR DE DIFERENCIAS LÍNEA POR LÍNEA (MYERS DIFF / LCS)
function computeMyersDiff(linesA, linesB, opt) {
  function norm(str) {
    var s = str || '';
    if (opt.trim) s = s.trim();
    if (opt.case) s = s.toLowerCase();
    return s;
  }

  var n = linesA.length;
  var m = linesB.length;
  if (n === 0 && m === 0) return [];
  if (n === 0) {
    return linesB.map(function(l, i) { return { type: 'add', lineA: null, lineB: i + 1, textA: '', textB: l }; });
  }
  if (m === 0) {
    return linesA.map(function(l, i) { return { type: 'del', lineA: i + 1, lineB: null, textA: l, textB: '' }; });
  }

  var max = n + m;
  var v = new Int32Array(2 * max + 1);
  var trace = [];
  var found = false;

  for (var d = 0; d <= max; d++) {
    var vCopy = new Int32Array(v);
    trace.push(vCopy);
    for (var k = -d; k <= d; k += 2) {
      var x;
      if (k === -d || (k !== d && v[k - 1 + max] < v[k + 1 + max])) {
        x = v[k + 1 + max];
      } else {
        x = v[k - 1 + max] + 1;
      }
      var y = x - k;
      while (x < n && y < m && norm(linesA[x]) === norm(linesB[y])) {
        x++;
        y++;
      }
      v[k + max] = x;
      if (x >= n && y >= m) {
        found = true;
        break;
      }
    }
    if (found) break;
  }

  var script = [];
  var currX = n;
  var currY = m;

  for (var step = trace.length - 1; step > 0; step--) {
    var k = currX - currY;
    var prevV = trace[step - 1];
    var prevK = (k === -step || (k !== step && prevV[k - 1 + max] < prevV[k + 1 + max])) ? k + 1 : k - 1;
    var prevX = prevV[prevK + max];
    var prevY = prevX - prevK;

    while (currX > prevX && currY > prevY) {
      script.unshift({ type: 'equal', lineA: currX, lineB: currY, textA: linesA[currX - 1], textB: linesB[currY - 1] });
      currX--;
      currY--;
    }
    if (step > 0) {
      if (currX === prevX) {
        script.unshift({ type: 'add', lineA: null, lineB: currY, textA: '', textB: linesB[currY - 1] });
        currY--;
      } else {
        script.unshift({ type: 'del', lineA: currX, lineB: null, textA: linesA[currX - 1], textB: '' });
        currX--;
      }
    }
  }
  while (currX > 0 && currY > 0) {
    script.unshift({ type: 'equal', lineA: currX, lineB: currY, textA: linesA[currX - 1], textB: linesB[currY - 1] });
    currX--;
    currY--;
  }
  while (currX > 0) {
    script.unshift({ type: 'del', lineA: currX, lineB: null, textA: linesA[currX - 1], textB: '' });
    currX--;
  }
  while (currY > 0) {
    script.unshift({ type: 'add', lineA: null, lineB: currY, textA: '', textB: linesB[currY - 1] });
    currY--;
  }

  // Emparejar eliminaciones y adiciones contiguas como modificaciones (mod)
  var paired = [];
  var p = 0;
  while (p < script.length) {
    if (script[p].type === 'del') {
      var dels = [];
      while (p < script.length && script[p].type === 'del') { dels.push(script[p]); p++; }
      var adds = [];
      while (p < script.length && script[p].type === 'add') { adds.push(script[p]); p++; }

      var minL = Math.min(dels.length, adds.length);
      for (var i = 0; i < minL; i++) {
        paired.push({
          type: 'mod',
          lineA: dels[i].lineA,
          lineB: adds[i].lineB,
          textA: dels[i].textA,
          textB: adds[i].textB
        });
      }
      for (var i = minL; i < dels.length; i++) paired.push(dels[i]);
      for (var i = minL; i < adds.length; i++) paired.push(adds[i]);
    } else {
      paired.push(script[p]);
      p++;
    }
  }

  return paired;
}

// Resaltador de diferencias de palabras / tokens dentro de una línea modificada
function highlightWordDiff(strA, strB) {
  var tokA = strA.match(/([A-Za-z0-9_]+|[^\sA-Za-z0-9_]|\s+)/g) || [strA];
  var tokB = strB.match(/([A-Za-z0-9_]+|[^\sA-Za-z0-9_]|\s+)/g) || [strB];

  // Si son muy diferentes o largos, escape directo
  if (tokA.length > 150 || tokB.length > 150) {
    return {
      htmlA: '<mark class="diff-token-del">' + escapeHtml(strA) + '</mark>',
      htmlB: '<mark class="diff-token-add">' + escapeHtml(strB) + '</mark>'
    };
  }

  // LCS de tokens
  var n = tokA.length, m = tokB.length;
  var dp = [];
  for (var i = 0; i <= n; i++) {
    dp[i] = new Int16Array(m + 1);
  }
  for (var i = 1; i <= n; i++) {
    for (var j = 1; j <= m; j++) {
      if (tokA[i - 1] === tokB[j - 1]) dp[i][j] = dp[i - 1][j - 1] + 1;
      else dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
    }
  }

  var htmlA = '', htmlB = '';
  var ci = n, cj = m;
  var revA = [], revB = [];

  while (ci > 0 || cj > 0) {
    if (ci > 0 && cj > 0 && tokA[ci - 1] === tokB[cj - 1]) {
      revA.unshift(escapeHtml(tokA[ci - 1]));
      revB.unshift(escapeHtml(tokB[cj - 1]));
      ci--; cj--;
    } else if (cj > 0 && (ci === 0 || dp[ci][cj - 1] >= dp[ci - 1][cj])) {
      revB.unshift('<mark class="diff-token-add">' + escapeHtml(tokB[cj - 1]) + '</mark>');
      cj--;
    } else if (ci > 0) {
      revA.unshift('<mark class="diff-token-del">' + escapeHtml(tokA[ci - 1]) + '</mark>');
      ci--;
    }
  }

  return { htmlA: revA.join(''), htmlB: revB.join('') };
}

// 7. EJECUCIÓN PRINCIPAL DE LA COMPARACIÓN
function ejecutarComparacion() {
  var rawA = $('diffEntradaA').value;
  var rawB = $('diffEntradaB').value;

  if (!rawA.trim() && !rawB.trim()) {
    alert('Por favor ingresa o carga al menos un archivo en el Documento A o Documento B para comparar.');
    return;
  }

  var chkTrim = $('chkDiffTrim').checked;
  var chkSortKeys = $('chkDiffSortKeys').checked;
  var chkCross = $('chkDiffCross').checked;
  var chkCase = $('chkDiffCase').checked;

  var prepA = prepararParaDiff(rawA, diffState.modoA);
  var prepB = prepararParaDiff(rawB, diffState.modoB);

  diffState.resParsedA = prepA;
  diffState.resParsedB = prepB;

  // Detección de Modo Cruzado (XML vs JSON)
  var esCruzado = chkCross && ((prepA.tipo === 'xml' && prepB.tipo === 'json') || (prepA.tipo === 'json' && prepB.tipo === 'xml'));
  var crossBanner = $('diffCrossBanner');
  var crossBannerTxt = $('diffCrossBannerTxt');

  if (esCruzado) {
    crossBanner.style.display = 'flex';
    crossBannerTxt.innerHTML = '<b>💡 Modo Cruzado Inteligente Activo:</b> Se detectó un <b>' + prepA.tipo.toUpperCase() + '</b> en el Documento A y un <b>' + prepB.tipo.toUpperCase() + '</b> en el Documento B. Se normalizaron sus estructuras y datos a formato canónico para comparar los valores y propiedades directamente sin falsos positivos de sintaxis.';
  } else {
    crossBanner.style.display = 'none';
  }

  // Si ambos tienen objetos parseados y se seleccionó ordenar claves
  var objA = prepA.objeto;
  var objB = prepB.objeto;

  var lineasParaDiffA = prepA.lineas;
  var lineasParaDiffB = prepB.lineas;

  if (esCruzado && objA && objB) {
    var aNorm = chkSortKeys ? sortKeysRecursivo(objA) : objA;
    var bNorm = chkSortKeys ? sortKeysRecursivo(objB) : objB;
    lineasParaDiffA = JSON.stringify(aNorm, null, 2).split(/\r?\n/);
    lineasParaDiffB = JSON.stringify(bNorm, null, 2).split(/\r?\n/);
  } else if (chkSortKeys) {
    if (prepA.tipo === 'json' && objA) {
      lineasParaDiffA = JSON.stringify(sortKeysRecursivo(objA), null, 2).split(/\r?\n/);
    }
    if (prepB.tipo === 'json' && objB) {
      lineasParaDiffB = JSON.stringify(sortKeysRecursivo(objB), null, 2).split(/\r?\n/);
    }
  }

  // 1. Análisis de Diferencias Semánticas
  var semanticDiffs = [];
  if (objA && objB) {
    deepAnalyzeDiff(objA, objB, '', semanticDiffs);
  }
  diffState.semanticDiffs = semanticDiffs;

  // 2. Myers Diff línea por línea
  var diffRows = computeMyersDiff(lineasParaDiffA, lineasParaDiffB, {
    trim: chkTrim,
    case: chkCase
  });
  diffState.diffRows = diffRows;

  // 3. Contabilización de métricas
  var delCount = 0, addCount = 0, modCount = 0, eqCount = 0;
  diffState.diffLineIndices = [];

  diffRows.forEach(function(row, idx){
    if (row.type === 'del') { delCount++; diffState.diffLineIndices.push(idx); }
    else if (row.type === 'add') { addCount++; diffState.diffLineIndices.push(idx); }
    else if (row.type === 'mod') { modCount++; diffState.diffLineIndices.push(idx); }
    else { eqCount++; }
  });

  var totalDiffs = delCount + addCount + modCount;

  // 4. Actualización de Alertas y Veredicto
  var salidaBox = $('diffSalidaBox');
  var alertIdentical = $('diffAlertIdentical');
  var alertDiffs = $('diffAlertDiffs');
  var cardDesglose = $('cardDesgloseDiffs');

  salidaBox.style.display = 'block';

  if (totalDiffs === 0) {
    alertIdentical.style.display = 'flex';
    alertDiffs.style.display = 'none';
    cardDesglose.style.display = 'none';
  } else {
    alertIdentical.style.display = 'none';
    alertDiffs.style.display = 'flex';
    cardDesglose.style.display = 'block';

    $('chipDelCount').textContent = '🔴 ' + fmtNum(delCount) + ' eliminadas';
    $('chipAddCount').textContent = '🟢 ' + fmtNum(addCount) + ' agregadas';
    $('chipModCount').textContent = '🟡 ' + fmtNum(modCount) + ' modificadas';
    $('chipEqCount').textContent  = '⚪ ' + fmtNum(eqCount)  + ' coincidentes';

    $('diffResumenTitulo').textContent = 'Se ' + (totalDiffs === 1 ? 'encontró 1 diferencia' : 'encontraron ' + fmtNum(totalDiffs) + ' diferencias') + ' entre ambos documentos';
    $('diffResumenSub').textContent = 'Revisa la tabla de diferencias específicas y el visor comparativo a continuación.';
  }

  // 5. Renderizado de Tabla de Diferencias
  renderTablaDiferencias();

  // 6. Renderizado del Visor Visual de Código
  diffState.curDiffIdx = -1;
  renderVisualDiff();

  // Scroll suave al resultado
  salidaBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

var btnEjecutarDiff = $('btnEjecutarDiff');
if (btnEjecutarDiff) btnEjecutarDiff.addEventListener('click', ejecutarComparacion);

// 8. RENDERIZADO DE TABLA DE DIFERENCIAS
function renderTablaDiferencias() {
  var tbody = $('tbodyDiffs');
  tbody.innerHTML = '';

  var list = [];
  if (diffState.semanticDiffs && diffState.semanticDiffs.length > 0) {
    list = diffState.semanticDiffs;
  } else {
    diffState.diffRows.forEach(function(row){
      if (row.type !== 'equal') {
        var path = (row.lineA ? 'Línea ' + row.lineA : '') + (row.lineA && row.lineB ? ' ⇄ ' : '') + (row.lineB ? 'Línea ' + row.lineB : '');
        list.push({
          type: row.type,
          path: path,
          valA: row.textA || '—',
          valB: row.textB || '—',
          desc: row.type === 'del' ? 'Línea eliminada en B' : (row.type === 'add' ? 'Línea agregada en B' : 'Línea modificada')
        });
      }
    });
  }

  var cntTodos = list.length;
  var cntDel = list.filter(function(x){ return x.type === 'del'; }).length;
  var cntAdd = list.filter(function(x){ return x.type === 'add'; }).length;
  var cntMod = list.filter(function(x){ return x.type === 'mod'; }).length;

  $('cntFiltroTodos').textContent = cntTodos;
  $('cntFiltroDel').textContent = cntDel;
  $('cntFiltroAdd').textContent = cntAdd;
  $('cntFiltroMod').textContent = cntMod;

  var filtradas = list.filter(function(item){
    if (diffState.filtro === 'todos') return true;
    return item.type === diffState.filtro;
  });

  if (filtradas.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:18px; color:var(--muted); font-family:var(--sans); font-size:13px;">No hay diferencias en esta categoría.</td></tr>';
    return;
  }

  filtradas.forEach(function(item, idx){
    var tr = document.createElement('tr');
    var badgeClass = item.type === 'del' ? 'tag-del' : (item.type === 'add' ? 'tag-add' : 'tag-mod');
    var badgeTxt = item.type === 'del' ? '🔴 ELIMINADO' : (item.type === 'add' ? '🟢 AGREGADO' : '🟡 MODIFICADO');

    tr.innerHTML = '<td>' + (idx + 1) + '</td>' +
      '<td><span class="' + badgeClass + '">' + badgeTxt + '</span></td>' +
      '<td><b style="color:var(--text);">' + escapeHtml(item.path) + '</b><br><small style="color:var(--muted); font-family:var(--sans);">' + escapeHtml(item.desc || '') + '</small></td>' +
      '<td><span class="diff-val-preview" title="' + escapeAttr(item.valA) + '">' + escapeHtml(item.valA) + '</span></td>' +
      '<td><span class="diff-val-preview" title="' + escapeAttr(item.valB) + '">' + escapeHtml(item.valB) + '</span></td>' +
      '<td style="text-align:center;"><button type="button" class="secondary" style="padding:4px 9px; font-size:11px;">🔍 Ver</button></td>';

    tr.addEventListener('click', function(){
      saltarADiferenciaRelativa(item);
    });

    tbody.appendChild(tr);
  });
}

// Filtros de la tabla
var segFiltroDiffs = $('segFiltroDiffs');
if (segFiltroDiffs) {
  segFiltroDiffs.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      segFiltroDiffs.querySelectorAll('button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      diffState.filtro = btn.dataset.filtro;
      renderTablaDiferencias();
    });
  });
}

// 9. RENDERIZADO VISUAL DEL DIFF (SIDE BY SIDE & UNIFIED)
function renderVisualDiff() {
  var wrap = $('diffViewerWrap');
  wrap.innerHTML = '';
  var rows = diffState.diffRows;

  if (diffState.vista === 'side') {
    renderSideBySide(wrap, rows);
  } else {
    renderUnified(wrap, rows);
  }

  actualizarContadorDiffNav();
}

function renderSideBySide(container, rows) {
  var sideWrap = document.createElement('div');
  sideWrap.className = 'diff-side-by-side';

  var colA = document.createElement('div');
  colA.className = 'diff-col';
  colA.id = 'diffColA';
  colA.innerHTML = '<div class="diff-col-header"><span>DOCUMENTO A (BASE)</span><span style="font-size:10.5px;">Rojo = Eliminado / Modificado</span></div>';

  var colB = document.createElement('div');
  colB.className = 'diff-col';
  colB.id = 'diffColB';
  colB.innerHTML = '<div class="diff-col-header"><span>DOCUMENTO B (COMPARADO)</span><span style="font-size:10.5px;">Verde = Agregado / Modificado</span></div>';

  rows.forEach(function(row, rIdx){
    var rowClsA = '', rowClsB = '';
    var textHtmlA = '', textHtmlB = '';

    if (row.type === 'equal') {
      textHtmlA = highlightCodeTokens(row.textA, diffState.modoA) || '&nbsp;';
      textHtmlB = highlightCodeTokens(row.textB, diffState.modoB) || '&nbsp;';
    } else if (row.type === 'del') {
      rowClsA = ' diff-row-del';
      rowClsB = ' diff-row-empty';
      textHtmlA = '<mark class="diff-token-del">- ' + (highlightCodeTokens(row.textA, diffState.modoA) || '&nbsp;') + '</mark>';
      textHtmlB = '&nbsp;';
    } else if (row.type === 'add') {
      rowClsA = ' diff-row-empty';
      rowClsB = ' diff-row-add';
      textHtmlA = '&nbsp;';
      textHtmlB = '<mark class="diff-token-add">+ ' + (highlightCodeTokens(row.textB, diffState.modoB) || '&nbsp;') + '</mark>';
    } else if (row.type === 'mod') {
      rowClsA = ' diff-row-mod';
      rowClsB = ' diff-row-mod';
      var highlighted = highlightWordDiff(row.textA, row.textB);
      textHtmlA = '~ ' + highlighted.htmlA;
      textHtmlB = '~ ' + highlighted.htmlB;
    }

    var divA = document.createElement('div');
    divA.className = 'diff-line-row' + rowClsA;
    divA.dataset.diffrow = rIdx;
    divA.innerHTML = '<span class="diff-ln">' + (row.lineA !== null ? row.lineA : '') + '</span><span class="diff-content">' + textHtmlA + '</span>';

    var divB = document.createElement('div');
    divB.className = 'diff-line-row' + rowClsB;
    divB.dataset.diffrow = rIdx;
    divB.innerHTML = '<span class="diff-ln">' + (row.lineB !== null ? row.lineB : '') + '</span><span class="diff-content">' + textHtmlB + '</span>';

    colA.appendChild(divA);
    colB.appendChild(divB);
  });

  sideWrap.appendChild(colA);
  sideWrap.appendChild(colB);
  container.appendChild(sideWrap);

  // Scroll sincronizado entre columnas A y B
  var syncing = false;
  colA.addEventListener('scroll', function() {
    if (syncing) return;
    syncing = true;
    colB.scrollTop = colA.scrollTop;
    colB.scrollLeft = colA.scrollLeft;
    syncing = false;
  });
  colB.addEventListener('scroll', function() {
    if (syncing) return;
    syncing = true;
    colA.scrollTop = colB.scrollTop;
    colA.scrollLeft = colB.scrollLeft;
    syncing = false;
  });
}

function renderUnified(container, rows) {
  var unifWrap = document.createElement('div');
  unifWrap.style.minWidth = '100%';

  rows.forEach(function(row, rIdx){
    if (row.type === 'equal') {
      var d = document.createElement('div');
      d.className = 'diff-line-row';
      d.dataset.diffrow = rIdx;
      d.innerHTML = '<span class="diff-ln">' + row.lineA + '</span><span class="diff-ln" style="border-left:1px solid #333;">' + row.lineB + '</span><span class="diff-content" style="color:var(--text);">' + (highlightCodeTokens(row.textA, diffState.modoA) || '&nbsp;') + '</span>';
      unifWrap.appendChild(d);
    } else if (row.type === 'del') {
      var d = document.createElement('div');
      d.className = 'diff-line-row diff-row-del';
      d.dataset.diffrow = rIdx;
      d.innerHTML = '<span class="diff-ln">' + row.lineA + '</span><span class="diff-ln" style="border-left:1px solid #333;"></span><span class="diff-content"><mark class="diff-token-del">- ' + (highlightCodeTokens(row.textA, diffState.modoA) || '&nbsp;') + '</mark></span>';
      unifWrap.appendChild(d);
    } else if (row.type === 'add') {
      var d = document.createElement('div');
      d.className = 'diff-line-row diff-row-add';
      d.dataset.diffrow = rIdx;
      d.innerHTML = '<span class="diff-ln"></span><span class="diff-ln" style="border-left:1px solid #333;">' + row.lineB + '</span><span class="diff-content"><mark class="diff-token-add">+ ' + (highlightCodeTokens(row.textB, diffState.modoB) || '&nbsp;') + '</mark></span>';
      unifWrap.appendChild(d);
    } else if (row.type === 'mod') {
      var highlighted = highlightWordDiff(row.textA, row.textB);
      var d1 = document.createElement('div');
      d1.className = 'diff-line-row diff-row-del';
      d1.dataset.diffrow = rIdx;
      d1.innerHTML = '<span class="diff-ln">' + row.lineA + '</span><span class="diff-ln" style="border-left:1px solid #333;"></span><span class="diff-content">- ' + highlighted.htmlA + '</span>';
      var d2 = document.createElement('div');
      d2.className = 'diff-line-row diff-row-add';
      d2.dataset.diffrow = rIdx;
      d2.innerHTML = '<span class="diff-ln"></span><span class="diff-ln" style="border-left:1px solid #333;">' + row.lineB + '</span><span class="diff-content">+ ' + highlighted.htmlB + '</span>';
      unifWrap.appendChild(d1);
      unifWrap.appendChild(d2);
    }
  });

  container.appendChild(unifWrap);
}

