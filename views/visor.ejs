/* Pantalla completa (ampliar), igual que en Notas / Jaivaná. Esc para salir */
var nodosOrig = {};
function ampliar(wrapId, btnId){
  var w = $(wrapId), on = !w.classList.contains('fullscreen');
  salirAmpliado();
  if (on) {
    nodosOrig[wrapId] = { padre: w.parentNode, hermano: w.nextSibling };
    document.body.appendChild(w);
    
    w.classList.add('fullscreen');
    document.body.style.overflow = 'hidden';
    $(btnId).textContent = '⤡ Salir';
    if (wrapId === 'edEntrada') entrada.focus();
  }
}
function salirAmpliado(){
  Array.prototype.forEach.call(document.querySelectorAll('.ed-wrap.fullscreen'), function(w){ 
    w.classList.remove('fullscreen'); 
    if (nodosOrig[w.id] && nodosOrig[w.id].padre) {
      nodosOrig[w.id].padre.insertBefore(w, nodosOrig[w.id].hermano);
    }
  });
  document.body.style.overflow = '';
  $('btnAmpliarEntrada').textContent = '⤢ Ampliar';
  $('btnAmpliarSalida').textContent = '⤢ Ampliar';
}
$('btnAmpliarEntrada').addEventListener('click', function(){ ampliar('edEntrada', 'btnAmpliarEntrada'); });
$('btnAmpliarSalida').addEventListener('click', function(){ ampliar('resultado', 'btnAmpliarSalida'); });
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') salirAmpliado(); });

