var diffState = {
  modoA: 'auto',
  modoB: 'auto',
  vista: 'side', // 'side' o 'unified'
  filtro: 'todos', // 'todos', 'del', 'add', 'mod'
  resParsedA: null,
  resParsedB: null,
  diffRows: [],
  semanticDiffs: [],
  curDiffIdx: -1,
  diffLineIndices: []
};

// 1. Conmutador de secciones principales (Visor vs Comparador)
var tabModoVisor = $('tabModoVisor');
var tabModoComparador = $('tabModoComparador');
var seccionVisor = $('seccionVisor');
var seccionComparador = $('seccionComparador');
var txtSeccionInfo = $('txtSeccionInfo');
var btnEnviarAComparar = $('btnEnviarAComparar');

function activarSeccion(seccion) {
  if (seccion === 'comparador') {
    if (tabModoComparador) tabModoComparador.classList.add('active');
    if (tabModoVisor) tabModoVisor.classList.remove('active');
    if (seccionVisor) seccionVisor.style.display = 'none';
    if (seccionComparador) seccionComparador.style.display = 'block';
    if (txtSeccionInfo) txtSeccionInfo.textContent = 'Comparador inteligente de diferencias (Diff)';
    var edA = $('diffEntradaA'), edB = $('diffEntradaB');
    if (edA && edA._actualizarSintaxis) edA._actualizarSintaxis();
    if (edB && edB._actualizarSintaxis) edB._actualizarSintaxis();
  } else {
    if (tabModoVisor) tabModoVisor.classList.add('active');
    if (tabModoComparador) tabModoComparador.classList.remove('active');
    if (seccionComparador) seccionComparador.style.display = 'none';
    if (seccionVisor) seccionVisor.style.display = 'block';
    if (txtSeccionInfo) txtSeccionInfo.textContent = 'Analizador y visor en vivo';
    var ed = $('entrada');
    if (ed && ed._actualizarSintaxis) ed._actualizarSintaxis();
  }
}

if (tabModoVisor) tabModoVisor.addEventListener('click', function(){ activarSeccion('visor'); });
if (tabModoComparador) tabModoComparador.addEventListener('click', function(){ activarSeccion('comparador'); });

