// 10. NAVEGACIÓN ENTRE DIFERENCIAS
function saltarADiferencia(idx) {
  var lines = diffState.diffLineIndices;
  if (!lines || !lines.length) return;
  diffState.curDiffIdx = (idx + lines.length) % lines.length;
  var targetRowIdx = lines[diffState.curDiffIdx];

  var wrap = $('diffViewerWrap');
  wrap.querySelectorAll('.diff-cur-focus').forEach(function(el){ el.classList.remove('diff-cur-focus'); });

  var matching = wrap.querySelectorAll('[data-diffrow="' + targetRowIdx + '"]');
  if (matching.length > 0) {
    matching.forEach(function(el){ el.classList.add('diff-cur-focus'); });
    matching[0].scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  actualizarContadorDiffNav();
}

function saltarADiferenciaRelativa(item) {
  var rows = diffState.diffRows;
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    if (r.type === item.type) {
      if ((item.valA && r.textA && r.textA.indexOf(item.valA) !== -1) ||
          (item.valB && r.textB && r.textB.indexOf(item.valB) !== -1) ||
          (item.path && String(r.lineA).indexOf(item.path) !== -1)) {
        var dIdx = diffState.diffLineIndices.indexOf(i);
        if (dIdx !== -1) { saltarADiferencia(dIdx); return; }
      }
    }
  }
  for (var j = 0; j < diffState.diffLineIndices.length; j++) {
    var rIdx = diffState.diffLineIndices[j];
    if (rows[rIdx].type === item.type) {
      saltarADiferencia(j);
      return;
    }
  }
  if (diffState.diffLineIndices.length > 0) saltarADiferencia(0);
}

function actualizarContadorDiffNav() {
  var cnt = $('diffNavCounter');
  if (!cnt) return;
  var total = diffState.diffLineIndices.length;
  if (!total) {
    cnt.textContent = '0 de 0';
    return;
  }
  var cur = diffState.curDiffIdx === -1 ? 0 : diffState.curDiffIdx + 1;
  cnt.textContent = cur + ' de ' + fmtNum(total);
}

var bDiffFirst = $('bDiffFirst');
var bDiffPrev  = $('bDiffPrev');
var bDiffNext  = $('bDiffNext');
var bDiffLast  = $('bDiffLast');

if (bDiffFirst) bDiffFirst.addEventListener('click', function(){ saltarADiferencia(0); });
if (bDiffPrev)  bDiffPrev.addEventListener('click', function(){ saltarADiferencia(diffState.curDiffIdx - 1); });
if (bDiffNext)  bDiffNext.addEventListener('click', function(){ saltarADiferencia(diffState.curDiffIdx + 1); });
if (bDiffLast)  bDiffLast.addEventListener('click', function(){ saltarADiferencia(diffState.diffLineIndices.length - 1); });

// 11. COPIAR Y DESCARGAR REPORTE
function generarReporteTexto() {
  var ahora = new Date().toLocaleString('es-CO');
  var lineasRep = [];
  lineasRep.push('=====================================================');
  lineasRep.push('  REPORTE DE DIFERENCIAS — COMPARADOR XML / JSON');
  lineasRep.push('  Fecha: ' + ahora);
  lineasRep.push('=====================================================');
  lineasRep.push('');

  var tA = diffState.resParsedA ? diffState.resParsedA.tipo.toUpperCase() : 'DESCONOCIDO';
  var tB = diffState.resParsedB ? diffState.resParsedB.tipo.toUpperCase() : 'DESCONOCIDO';

  lineasRep.push('Documento A: ' + tA + ' (' + $('diffEntradaA').value.split('\n').length + ' líneas)');
  lineasRep.push('Documento B: ' + tB + ' (' + $('diffEntradaB').value.split('\n').length + ' líneas)');
  lineasRep.push('');

  var total = diffState.diffLineIndices.length;
  if (total === 0) {
    lineasRep.push('RESULTADO: LOS ARCHIVOS SON 100% IDÉNTICOS.');
    lineasRep.push('No se encontraron diferencias en la estructura ni en los datos.');
    return lineasRep.join('\n');
  }

  lineasRep.push('RESULTADO: ' + total + ' diferencias detectadas.');
  lineasRep.push('');
  lineasRep.push('--- DETALLE DE DIFERENCIAS ---');

  if (diffState.semanticDiffs && diffState.semanticDiffs.length > 0) {
    diffState.semanticDiffs.forEach(function(d, i){
      var tNom = d.type === 'del' ? '[ELIMINADO]' : (d.type === 'add' ? '[AGREGADO]' : '[MODIFICADO]');
      lineasRep.push((i + 1) + '. ' + tNom + ' ' + d.path);
      if (d.type === 'mod') {
        lineasRep.push('   - En A: ' + d.valA);
        lineasRep.push('   + En B: ' + d.valB);
      } else if (d.type === 'del') {
        lineasRep.push('   - Valor en A: ' + d.valA);
      } else if (d.type === 'add') {
        lineasRep.push('   + Valor en B: ' + d.valB);
      }
    });
  } else {
    diffState.diffRows.forEach(function(r, i){
      if (r.type !== 'equal') {
        lineasRep.push((i + 1) + '. [' + r.type.toUpperCase() + '] Línea A: ' + (r.lineA || '—') + ' | Línea B: ' + (r.lineB || '—'));
        if (r.textA) lineasRep.push('   - ' + r.textA);
        if (r.textB) lineasRep.push('   + ' + r.textB);
      }
    });
  }

  lineasRep.push('');
  lineasRep.push('=====================================================');
  return lineasRep.join('\n');
}

