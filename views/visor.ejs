$('btnMinificar').addEventListener('click', function(){
  var val = entrada.value.trim();
  if(!val) return;
  try {
    if (val.startsWith('{') || val.startsWith('[')) {
      entrada.value = JSON.stringify(JSON.parse(val));
    } else if (val.startsWith('<')) {
      entrada.value = val.replace(/>\s+</g, '><').trim();
    }
    if (entrada._actualizarSintaxis) entrada._actualizarSintaxis();
    procesar();
    toast('Código minificado');
  } catch(e) {
    alert('El código debe ser válido para minificarlo.');
