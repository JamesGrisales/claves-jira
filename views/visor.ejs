<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .chip{ display:inline-block; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px; color:var(--accent-dark); background:var(--accent-soft); }
  .chip.ok{ color:#14683a; background:#dff5e7; }
  .chip.bad{ color:var(--danger); background:var(--danger-soft); }
  .chip.info{ color:var(--muted); background:var(--panel-alt); border:1px solid var(--panel-edge); font-weight:600; }
  :root[data-theme="dark"] .chip.ok{ color:#6ee7a1; background:#173a28; }

  .v-toolbar{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .seg{ display:inline-flex; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:999px; padding:3px; }
  .seg button{ background:transparent; color:var(--muted); box-shadow:none; border:none; padding:6px 13px; font-size:12.5px; border-radius:999px; transform:none; }
  .seg button:hover{ color:var(--accent-dark); transform:none; box-shadow:none; filter:none; }
  .seg button.active{ background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; }
  .v-toolbar .sp{ flex:1; }
  .v-toolbar button, .v-toolbar label.btn{ padding:8px 13px; font-size:13px; }
  label.btn{ display:inline-flex; align-items:center; gap:6px; cursor:pointer; margin:0; text-transform:none; letter-spacing:0; }
  #entrada{
    width:100%; min-height:190px; max-height:60vh; resize:vertical;
    background:transparent !important; background-color:transparent !important;
    border:none !important; outline:none !important; box-shadow:none !important;
    color:transparent !important; -webkit-text-fill-color:transparent !important; caret-color:#38bdf8 !important;
    font-family:var(--mono); font-size:13px; line-height:1.5; padding:12px 14px; border-radius:0;
    white-space:pre; overflow:auto; tab-size:4; box-sizing:border-box !important;
  }
  #entrada:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  #entrada.drag{ border-color:var(--accent); background:var(--accent-soft); }
  .hint{ font-size:12px; color:var(--muted); margin-top:6px; }

  #salida{ margin-top:16px; display:none; }
  #salida.on{ display:block; }
  .v-status{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .aviso{ font-size:12.5px; background:var(--accent-soft); color:var(--accent-dark); border-radius:8px; padding:7px 11px; margin-bottom:10px; }

  .errbox{ border:1px solid var(--danger); background:var(--danger-soft); color:var(--text); border-radius:10px; padding:12px 14px; margin-bottom:10px; }
  .errbox .t{ color:var(--danger); font-weight:700; font-size:13.5px; margin-bottom:4px; }
  .errbox .m{ font-size:13px; overflow-wrap:anywhere; }
  .errbox pre{ margin:10px 0 0; background:#1e1e1e; color:#d4d4d4; border-radius:8px; padding:8px 0; font-family:var(--mono); font-size:12.5px; line-height:1.55; overflow:auto; }
  .errbox pre .l{ display:block; padding:0 12px; white-space:pre-wrap; word-break:break-word; }
  .errbox pre .l.bad{ background:rgba(209,72,58,.28); }
  .errbox pre .n{ color:#6e7681; display:inline-block; width:44px; user-select:none; }
  .errbox button{ margin-top:10px; padding:7px 12px; font-size:12.5px; }

  .v-tabs{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:8px; }
  .v-tabs .sp{ flex:1; }
  .vsearch{ display:flex; align-items:center; gap:6px; }
  .vsearch input{ width:220px; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13px; padding:7px 10px; border-radius:8px; outline:none; }
  .vsearch input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .vsearch .cnt{ font-size:11.5px; color:var(--muted); white-space:nowrap; min-width:64px; }
  .mini{ background:transparent; border:1px solid var(--panel-edge); color:var(--muted); width:30px; height:30px; border-radius:7px; padding:0; box-shadow:none; font-size:11px; transform:none; }
  .mini:hover{ border-color:var(--accent); color:var(--accent-dark); background:var(--accent-soft); transform:none; box-shadow:none; filter:none; }

  /* Código estilo editor */
  .code-block{ background:#1e1e1e; color:#d4d4d4; border:1px solid #2d2d2d; border-radius:9px; padding:10px 0; font-family:var(--mono); font-size:13px; line-height:1.6; margin:0; max-height:70vh; min-height:120px; overflow:auto; resize:vertical; tab-size:4; }
  :root[data-theme="oled"] .code-block{ background:#050608; border-color:rgba(255,255,255,0.08); color:#f1f5f9; }
  :root[data-theme="oled"] .code-line .ln{ border-right-color:rgba(255,255,255,0.08); color:#475569; }
  :root[data-theme="oled"] #entrada{ background:transparent !important; border:none !important; color:transparent !important; -webkit-text-fill-color:transparent !important; }
  .code-line{ display:flex; contain:layout style; }
  .code-line:hover{ background:rgba(255,255,255,.04); }
  .code-line .ln{ flex-shrink:0; width:52px; text-align:right; padding-right:12px; margin-right:12px; color:#6e7681; border-right:1px solid #333; user-select:none; }
  .code-line .code-text{ flex:1; min-width:0; white-space:pre-wrap; word-break:break-word; padding-right:14px; }
  .tk-tg{ color:#38bdf8; font-weight:600; } .tk-an{ color:#7dd3fc; } .tk-av{ color:#fb923c; } .tk-pn{ color:#94a3b8; } .tk-tx{ color:#f8fafc; }
  .tk-cd{ color:#fde047; } .tk-pi{ color:#c084fc; } .tk-cm{ color:#4ade80; font-style:italic; }
  .tk-jk{ color:#38bdf8; font-weight:600; } .tk-js{ color:#fb923c; } .tk-jn{ color:#4ade80; } .tk-jb{ color:#a855f7; } .tk-jl{ color:#ec4899; font-style:italic; }
  :root[data-theme="oled"] .tk-tg{ color:#38bdf8; font-weight:600; } :root[data-theme="oled"] .tk-an{ color:#22d3ee; } :root[data-theme="oled"] .tk-jk{ color:#38bdf8; font-weight:600; }
  :root[data-theme="oled"] .tk-js{ color:#fb923c; } :root[data-theme="oled"] .tk-jn{ color:#4ade80; } :root[data-theme="oled"] .tk-jb{ color:#a855f7; }
  .code-block mark{ background:#ffd54a; color:#1e1e1e; border-radius:2px; padding:0 1px; }
  .cur-line{ outline:1px solid #ffd54a; outline-offset:-1px; background:rgba(255,213,74,.09); }
  .mas-lineas{ text-align:center; font-family:var(--sans); font-size:12px; color:#8b949e; padding:10px 8px 4px; }
  .mas-lineas a{ color:#4fc1ff; }
  .ver-mas{ color:#4fc1ff; font-style:italic; text-decoration:none; }

  /* Árbol */
  #vista-arbol{ display:none; border:1px solid var(--panel-edge); background:var(--panel-alt); border-radius:9px; padding:10px 8px; font-family:var(--mono); font-size:13px; line-height:1.55; max-height:70vh; overflow:auto; resize:vertical; }
  .tn > .tc{ display:none; margin-left:10px; padding-left:12px; border-left:1px solid var(--panel-edge); }
  .tn.open > .tc{ display:block; }
  .tr{ display:flex; align-items:baseline; gap:6px; padding:1px 6px; border-radius:6px; cursor:default; }
  .tr:hover{ background:var(--accent-soft); }
  .tr.sel{ background:var(--accent-soft); outline:1px solid var(--accent); }
  .tr .tg{ width:14px; flex-shrink:0; color:var(--muted); font-size:10px; text-align:center; transition:transform .12s; user-select:none; }
  .tn.open > .tr .tg{ transform:rotate(90deg); }
  .tn.hoja > .tr .tg{ visibility:hidden; }
  .tn.hijos > .tr{ cursor:pointer; }
  .tr .et{ overflow-wrap:anywhere; min-width:0; }
  .tr .nn{ color:var(--muted); font-size:11.5px; font-family:var(--sans); margin-left:4px; }
  #vista-arbol .tk-tg{ color:#0b5cad; } #vista-arbol .tk-an{ color:#1f6f8b; } #vista-arbol .tk-av{ color:#a3391f; } #vista-arbol .tk-pn{ color:#888; }
  #vista-arbol .tk-tx{ color:var(--text); } #vista-arbol .tk-cd{ color:#8a6d00; } #vista-arbol .tk-cm{ color:#3c7d3c; } #vista-arbol .tk-pi{ color:#8f3fa0; }
  #vista-arbol .tk-jk{ color:#1f6f8b; } #vista-arbol .tk-js{ color:#a3391f; } #vista-arbol .tk-jn{ color:#1b7a48; } #vista-arbol .tk-jb, #vista-arbol .tk-jl{ color:#0b5cad; }
  :root[data-theme="dark"] #vista-arbol .tk-tg{ color:#569cd6; } :root[data-theme="dark"] #vista-arbol .tk-an{ color:#9cdcfe; } :root[data-theme="dark"] #vista-arbol .tk-av{ color:#ce9178; }
  :root[data-theme="dark"] #vista-arbol .tk-cd{ color:#dcdcaa; } :root[data-theme="dark"] #vista-arbol .tk-cm{ color:#6a9955; } :root[data-theme="dark"] #vista-arbol .tk-pi{ color:#c586c0; }
  :root[data-theme="dark"] #vista-arbol .tk-jk{ color:#9cdcfe; } :root[data-theme="dark"] #vista-arbol .tk-js{ color:#ce9178; } :root[data-theme="dark"] #vista-arbol .tk-jn{ color:#b5cea8; }
  :root[data-theme="dark"] #vista-arbol .tk-jb, :root[data-theme="dark"] #vista-arbol .tk-jl{ color:#569cd6; }
  .masbtn{ font-family:var(--sans); font-size:12px; color:var(--accent-dark); cursor:pointer; padding:2px 6px; }
  .pathbar{ display:none; align-items:center; gap:8px; margin-top:8px; font-size:12.5px; }
  .pathbar.on{ display:flex; }
  .pathbar code{ flex:1; min-width:0; overflow-wrap:anywhere; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:7px; padding:6px 9px; font-family:var(--mono); }
  .pathbar button{ padding:6px 11px; font-size:12px; }
  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .22s ease, transform .22s cubic-bezier(.34,1.56,.64,1); box-shadow:0 6px 20px rgba(20,30,45,.18); z-index:1200; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  /* Pantalla completa (ampliar) y filtro de líneas */
  .ed-wrap.fullscreen{ position:fixed; inset:0; z-index:900; background:var(--bg); padding:14px 20px; margin:0; display:flex; flex-direction:column; overflow:auto; }
  .ed-wrap.fullscreen > *{ flex-shrink:0; }
  .ed-wrap.fullscreen #entrada{ flex:1 1 0; max-height:none; min-height:0; resize:none; }
  .ed-wrap.fullscreen .code-block, .ed-wrap.fullscreen #vista-arbol{ flex:1 1 0; min-height:0; max-height:none; resize:none; }
  .chk{ display:inline-flex; align-items:center; gap:5px; margin:0; font-size:12.5px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; white-space:nowrap; }
  .chk-highlight{ color:#38bdf8 !important; font-weight:700 !important; }
  .chk-highlight input{ accent-color:#0284c7; }
  .vsearch-modes{ display:inline-flex; align-items:center; gap:8px; margin-left:6px; padding-left:8px; border-left:1px solid var(--panel-edge); }

  /* Bloque JSON contenedor destacado */
  .json-block-banner{ display:flex; align-items:center; gap:8px; margin:7px 0 2px 0; padding:6px 12px; background:linear-gradient(90deg, rgba(56,189,248,0.18) 0%, rgba(56,189,248,0.03) 100%); border-top:1px solid rgba(56,189,248,0.35); border-bottom:1px solid rgba(56,189,248,0.2); border-left:4px solid #38bdf8; border-radius:0 6px 6px 0; font-family:var(--sans); font-size:11.5px; color:#e2e8f0; user-select:none; }
  :root[data-theme="oled"] .json-block-banner{ background:linear-gradient(90deg, rgba(56,189,248,0.25) 0%, rgba(56,189,248,0.05) 100%); border-top-color:rgba(56,189,248,0.45); border-bottom-color:rgba(56,189,248,0.25); }
  .json-block-banner .jbb-pill{ background:#0284c7; color:#fff; font-weight:800; font-size:10px; letter-spacing:0.5px; padding:2px 7px; border-radius:4px; text-transform:uppercase; display:inline-flex; align-items:center; gap:4px; box-shadow:0 0 8px rgba(56,189,248,0.4); }
  .json-block-banner .jbb-title{ font-weight:700; color:#38bdf8; font-family:var(--mono); font-size:12px; }
  .json-block-banner .jbb-count{ color:#94a3b8; font-size:11.5px; }
  .json-block-banner .jbb-copy{ margin-left:auto; background:rgba(56,189,248,0.15); border:1px solid rgba(56,189,248,0.4); color:#38bdf8; padding:3px 9px; border-radius:5px; font-size:11px; font-weight:600; cursor:pointer; transition:all 0.15s ease; }
  .json-block-banner .jbb-copy:hover{ background:#0284c7; color:#fff; border-color:#38bdf8; box-shadow:0 0 10px rgba(56,189,248,0.5); transform:translateY(-1px); }

  .code-line.json-block-matched{ background:rgba(56,189,248,0.07) !important; border-left:3px solid #38bdf8 !important; }
  :root[data-theme="oled"] .code-line.json-block-matched{ background:rgba(56,189,248,0.11) !important; border-left:3px solid #38bdf8 !important; }
  .code-line.json-block-matched:hover{ background:rgba(56,189,248,0.15) !important; }
  .code-line.json-block-first{ border-top:1px solid rgba(56,189,248,0.25); }
  .code-line.json-block-last{ border-bottom:1px solid rgba(56,189,248,0.25); margin-bottom:5px; }
  .code-line.json-block-dimmed{ opacity:0.35; filter:grayscale(60%); transition:opacity 0.2s ease, filter 0.2s ease; }
  .code-line.json-block-dimmed:hover{ opacity:0.95; filter:none; }
  .code-line.cur-line{ outline:2px solid #ffd54a !important; outline-offset:-2px; background:rgba(255,213,74,0.22) !important; }
  .code-line.cur-line .ln{ color:#ffd54a !important; font-weight:700; }

  /* Estilos del Extractor de Pedidos WMS */
  .wms-extractor-card { background:linear-gradient(180deg, var(--panel) 0%, var(--panel-alt) 100%); border:1px solid var(--accent); border-radius:14px; padding:16px 20px; margin-bottom:16px; box-shadow:0 8px 25px rgba(0,0,0,0.25); }
  .wms-grid { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:12px; background:rgba(0,0,0,0.2); padding:12px 14px; border-radius:10px; border:1px solid var(--panel-edge); }
  .wms-input-num { width:135px; font-weight:800; font-family:var(--mono); font-size:14px; color:#38bdf8 !important; background:var(--panel) !important; border:1px solid var(--panel-edge) !important; padding:7px 10px !important; border-radius:8px !important; outline:none; }
  .wms-input-num:focus { border-color:var(--accent) !important; box-shadow:0 0 0 3px var(--accent-soft) !important; }
  .wms-input-field { width:130px; font-size:12.5px; font-family:var(--mono); color:var(--text) !important; background:var(--panel) !important; border:1px solid var(--panel-edge) !important; padding:7px 10px !important; border-radius:8px !important; outline:none; }
  .wms-input-field:focus { border-color:var(--accent) !important; box-shadow:0 0 0 3px var(--accent-soft) !important; }
  .wms-btn-extract { font-weight:700; background:linear-gradient(135deg, #0284c7, #0369a1); color:#fff; border:none; padding:8px 18px; border-radius:8px; cursor:pointer; font-size:13px; display:inline-flex; align-items:center; gap:6px; box-shadow:0 2px 10px rgba(2,132,199,0.35); transition:all .15s ease; }
  .wms-btn-extract:hover { transform:translateY(-1px); box-shadow:0 4px 14px rgba(2,132,199,0.5); }
  .wms-tag { font-size:11px; padding:2px 8px; border-radius:999px; background:rgba(56,189,248,0.15); color:#38bdf8; font-weight:700; }
  
  /* ======================================================================
     ESTILOS DEL COMPARADOR UNIVERSAL XML / JSON (DIFF)
     ====================================================================== */
  .diff-badge-new { background:linear-gradient(135deg, #10b981, #059669); color:#fff; font-size:10px; font-weight:800; padding:2px 7px; border-radius:999px; letter-spacing:0.3px; box-shadow:0 0 8px rgba(16,185,129,0.35); }
  .diff-main-card { background:linear-gradient(180deg, var(--panel) 0%, var(--panel-alt) 100%); border:1px solid var(--panel-edge); border-radius:14px; padding:16px 20px; margin-bottom:16px; box-shadow:0 8px 25px rgba(0,0,0,0.22); }
  .diff-options-bar { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:12px; padding:10px 14px; border-radius:10px; background:rgba(0,0,0,0.2); border:1px solid var(--panel-edge); font-size:12px; }
  .diff-grid-inputs { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:14px; align-items:stretch; }
  @media (max-width: 900px) { .diff-grid-inputs { grid-template-columns:1fr; } }
  .diff-panel-box { background:var(--panel); border:1px solid var(--panel-edge); border-radius:10px; padding:12px; display:flex; flex-direction:column; min-width:0; height:100%; box-sizing:border-box; }
  .diff-panel-topbar { display:flex; align-items:center; justify-content:space-between; gap:6px; margin-bottom:8px; flex-wrap:nowrap; min-height:38px; }
  .diff-panel-topbar .btn, .diff-panel-topbar button { padding:5px 9px; font-size:11.5px; white-space:nowrap; }
  .diff-badge-doc { font-weight:800; font-size:11px; padding:3px 9px; border-radius:6px; letter-spacing:0.5px; white-space:nowrap; flex-shrink:0; }
  .diff-badge-doc.doc-a { background:rgba(56,189,248,0.18); color:#38bdf8; border:1px solid rgba(56,189,248,0.35); }
  .diff-badge-doc.doc-b { background:rgba(168,85,247,0.18); color:#c084fc; border:1px solid rgba(168,85,247,0.35); }
  
  #wrapDiffA, #wrapDiffB {
    height:320px; min-height:280px; flex:1 1 auto; resize:vertical;
  }
  #diffEntradaA, #diffEntradaB {
    height:100% !important; min-height:100% !important; max-height:none !important; resize:none !important;
  }
  .diff-textarea {
    width:100%; height:100% !important; min-height:260px; resize:none !important;
    background:transparent !important; background-color:transparent !important;
    border:none !important; outline:none !important; box-shadow:none !important;
    caret-color:#38bdf8 !important;
    font-family:var(--mono); font-size:12.5px; line-height:1.55;
    padding:10px 12px; border-radius:0; white-space:pre; overflow:auto;
    tab-size:2; box-sizing:border-box !important;
  }
  :root[data-theme="oled"] .diff-textarea { background:transparent !important; border:none !important; }
  .diff-textarea.drag { border-color:var(--accent); background:var(--accent-soft); }
  .diff-footer-stats { display:flex; align-items:center; justify-content:space-between; margin-top:6px; font-size:11.5px; color:var(--muted); }
  
  .diff-btn-compare {
    font-weight:700; background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff;
    border:none; padding:9px 22px; border-radius:9px; cursor:pointer; font-size:13.5px;
    display:inline-flex; align-items:center; gap:8px; box-shadow:0 3px 12px rgba(var(--accent-rgb),0.35);
    transition:all .15s ease;
  }
  .diff-btn-compare:hover { transform:translateY(-1px); box-shadow:0 5px 16px rgba(var(--accent-rgb),0.5); }
  .diff-btn-compare:disabled { opacity:0.6; cursor:not-allowed; transform:none; }

  /* Alertas de resultado */
  .diff-alert-identical {
    background:linear-gradient(90deg, rgba(16,185,129,0.18) 0%, rgba(16,185,129,0.05) 100%);
    border:1px solid #10b981; border-left:5px solid #10b981; border-radius:10px;
    padding:14px 18px; display:flex; align-items:center; gap:14px; margin-bottom:14px;
    animation: fadeIn 0.3s ease;
  }
  .diff-alert-diffs {
    background:linear-gradient(90deg, rgba(245,158,11,0.18) 0%, rgba(245,158,11,0.05) 100%);
    border:1px solid #f59e0b; border-left:5px solid #f59e0b; border-radius:10px;
    padding:14px 18px; display:flex; align-items:center; gap:14px; margin-bottom:14px;
    animation: fadeIn 0.3s ease;
  }
  .diff-cross-banner {
    background:linear-gradient(90deg, rgba(56,189,248,0.18) 0%, rgba(56,189,248,0.04) 100%);
    border:1px solid rgba(56,189,248,0.35); border-left:4px solid #38bdf8; border-radius:8px;
    padding:8px 14px; margin-bottom:14px; font-size:12.5px; color:#e0f2fe; display:flex; align-items:center; gap:8px;
  }

  .diff-stat-chip { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:700; padding:4px 10px; border-radius:999px; }
  .diff-chip-add { background:rgba(16,185,129,0.18); color:#10b981; border:1px solid rgba(16,185,129,0.3); }
  .diff-chip-del { background:rgba(239,68,68,0.18); color:#ef4444; border:1px solid rgba(239,68,68,0.3); }
  .diff-chip-mod { background:rgba(245,158,11,0.18); color:#f59e0b; border:1px solid rgba(245,158,11,0.3); }
  .diff-chip-eq  { background:rgba(148,163,184,0.15); color:var(--muted); border:1px solid var(--panel-edge); }

  /* Tabla de resumen de diferencias */
  .diff-table-wrap { max-height:360px; overflow-y:auto; border:1px solid var(--panel-edge); border-radius:9px; margin-bottom:16px; background:var(--panel-alt); }
  .diff-table { width:100%; border-collapse:collapse; font-size:12px; font-family:var(--sans); }
