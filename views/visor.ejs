      <span>👁️</span> Visor e Inspección
    </button>
    <button type="button" id="tabModoComparador" data-seccion="comparador" style="font-weight:700; display:inline-flex; align-items:center; gap:6px;">
      <span>⚖️</span> Comparar XML / JSON
      <span class="diff-badge-new">DIFF</span>
    </button>
  </div>
  <div style="font-size:12.5px; color:var(--muted); display:flex; align-items:center; gap:6px;">
    <span id="txtSeccionInfo">Analizador y visor en vivo</span>
