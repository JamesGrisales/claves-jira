</div>

<!-- SECCIÓN 1: VISOR ORIGINAL (Extractor + Entrada + Salida) -->
<div id="seccionVisor">


<!-- Extractor de Pedidos WMS en Logs / JSON -->
<div class="card wms-extractor-card" id="cardExtractorWms">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
    <div style="display:flex; align-items:center; gap:10px;">
      <span style="font-size:22px;">📦</span>
      <div>
        <div style="display:flex; align-items:center; gap:8px;">
          <strong style="font-size:15px; color:var(--text); letter-spacing:-0.01em;">Extractor de Pedidos WMS en Logs / JSON</strong>
          <span class="wms-tag">Filtro Exacto</span>
        </div>
        <span style="font-size:12px; color:var(--muted); display:block;">Busca archivos grandes (.log de 90+ MB) y extrae únicamente la estructura JSON del pedido deseado sin falsos positivos.</span>
      </div>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
      <span class="chip info" id="wmsEstadoChip" style="font-size:11.5px;">Listo para filtrar</span>
      <button type="button" class="secondary" id="btnToggleWmsCard" style="padding:4px 9px; font-size:12px;" title="Minimizar panel">▲</button>
    </div>
  </div>

  <div id="wmsPanelBody">
    <div class="wms-grid">
      <!-- Selector de archivo Log -->
      <div>
        <label class="btn secondary" for="inputWmsFile" style="display:inline-flex; align-items:center; gap:6px; font-size:12.5px; padding:7px 14px; cursor:pointer; font-weight:700; margin:0;" title="Selecciona tu archivo .log (ej: pmv_ferricentro_wms.log)">
          <span>📁</span> <span id="lblWmsFileName">Elegir archivo .log / .txt</span>
        </label>
        <input type="file" id="inputWmsFile" accept=".log,.txt,.json,.out" style="display:none;">
      </div>

      <!-- Inputs de Pedido y Campo -->
      <div style="display:inline-flex; align-items:center; gap:6px;">
        <label for="inputWmsPedido" style="font-size:12px; font-weight:700; color:var(--text); white-space:nowrap;">N° Pedido:</label>
        <input type="text" id="inputWmsPedido" class="wms-input-num" placeholder="Ej: 90396" autocomplete="off">
      </div>

      <div style="display:inline-flex; align-items:center; gap:6px;">
        <label for="inputWmsCampo" style="font-size:12px; color:var(--muted); white-space:nowrap;">Campo:</label>
        <input type="text" id="inputWmsCampo" class="wms-input-field" value="numero_pedido" title="Nombre del atributo en el JSON">
      </div>

      <label class="chk chk-highlight" style="font-size:12px; cursor:pointer;" title="Busca coincidencia exacta con límites de palabra para evitar que 90396 coincida con 990396 o códigos de barras">
        <input type="checkbox" id="chkWmsExacto" checked> <b>Exacto</b>
      </label>

      <label class="chk" style="font-size:12px; cursor:pointer;" title="Extrae el bloque JSON formateado limpio en el editor">
        <input type="checkbox" id="chkWmsSoloJson" checked> Formatear JSON
