// 2. Selectores de modo individual (Auto / JSON / XML)
function setupModoSeg(segId, lado) {
  var seg = $(segId);
  if (!seg) return;
  seg.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      seg.querySelectorAll('button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      var m = btn.dataset.mododiff;
      if (lado === 'A') diffState.modoA = m;
      else diffState.modoB = m;
      actualizarStatsPanel(lado);
    });
  });
}
setupModoSeg('segModoA', 'A');
setupModoSeg('segModoB', 'B');

// 3. Apertura de archivos para A y B
function bindFileInput(inputId, textareaId, lado) {
  var inp = $(inputId);
  var txt = $(textareaId);
  if (!inp || !txt) return;
  inp.addEventListener('change', function(e){
    var file = e.target.files && e.target.files[0];
    if (!file) return;
    var fr = new FileReader();
    fr.onload = function(){
      txt.value = decodificar(fr.result);
      autoFormatearSiMinificado(txt, lado);
      if (txt._actualizarSintaxis) txt._actualizarSintaxis();
      actualizarStatsPanel(lado);
      toast('Archivo cargado en Documento ' + lado + ': ' + file.name);
    };
    fr.readAsArrayBuffer(file);
    inp.value = '';
  });
}
bindFileInput('inputDiffFileA', 'diffEntradaA', 'A');
bindFileInput('inputDiffFileB', 'diffEntradaB', 'B');

// Drag & drop en textareas de Diff
function bindDragDrop(textareaId, lado) {
  var t = $(textareaId);
  if (!t) return;
  t.addEventListener('dragover', function(e){ e.preventDefault(); t.classList.add('drag'); });
  t.addEventListener('dragleave', function(){ t.classList.remove('drag'); });
  t.addEventListener('drop', function(e){
    e.preventDefault();
    t.classList.remove('drag');
    var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) {
      var fr = new FileReader();
      fr.onload = function(){
        t.value = decodificar(fr.result);
        autoFormatearSiMinificado(t, lado);
        if (t._actualizarSintaxis) t._actualizarSintaxis();
        actualizarStatsPanel(lado);
        toast('Archivo cargado en Documento ' + lado + ': ' + file.name);
      };
      fr.readAsArrayBuffer(file);
    }
  });
  t.addEventListener('input', function(){
    actualizarStatsPanel(lado);
  });
}
bindDragDrop('diffEntradaA', 'A');
bindDragDrop('diffEntradaB', 'B');

