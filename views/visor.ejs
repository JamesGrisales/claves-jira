// Sincronizar altura idéntica entre Documento A y Documento B
(function() {
  var wA = $('wrapDiffA'), wB = $('wrapDiffB');
  if (!wA || !wB || !window.ResizeObserver) return;
  var sincronizando = false;
  var ro = new ResizeObserver(function(entries) {
    if (sincronizando) return;
    for (var entry of entries) {
      var target = entry.target;
      var other = target === wA ? wB : wA;
      var h = entry.contentRect.height;
      if (h > 50 && Math.abs(other.clientHeight - target.clientHeight) > 2) {
        sincronizando = true;
        other.style.height = target.clientHeight + 'px';
        setTimeout(function(){ sincronizando = false; }, 30);
      }
    }
  });
  ro.observe(wA);
  ro.observe(wB);
})();

// Pegar y Limpiar
function bindQuickButtons(lado) {
  var btnPegar = $('btnPegar' + lado);
  var btnLimpiar = $('btnLimpiar' + lado);
  var btnFmt = $('btnFmt' + lado);
  var txtArea = $('diffEntrada' + lado);

  if (btnPegar) {
    btnPegar.addEventListener('click', async function(){
      try {
        var clip = await navigator.clipboard.readText();
        if (clip) {
          txtArea.value = clip;
          autoFormatearDocumento(txtArea, lado, true);
          if (txtArea._actualizarSintaxis) txtArea._actualizarSintaxis();
          actualizarStatsPanel(lado);
          toast('Pegado y estructurado en Documento ' + lado);
        }
      } catch(err) {
        toast('Usa Ctrl+V directamente en la caja');
      }
    });
  }

  if (btnLimpiar) {
    btnLimpiar.addEventListener('click', function(){
      txtArea.value = '';
      if (txtArea._actualizarSintaxis) txtArea._actualizarSintaxis();
      actualizarStatsPanel(lado);
      toast('Documento ' + lado + ' limpiado');
    });
  }

  if (btnFmt) {
    btnFmt.addEventListener('click', function(){
      var raw = txtArea.value;
      if (!raw.trim()) { toast('Documento ' + lado + ' está vacío'); return; }
      var ok = autoFormatearDocumento(txtArea, lado, true);
      if (ok) {
        toast('Documento ' + lado + ' estructurado e indentado');
      } else {
        toast('No se pudo formatear el contenido');
      }
    });
  }
}
