<script>
/* ---------- Controlador Reactivo Alpine.js de Visor ---------- */
window.visorAlpineApp = function() {
  return {
    copiadoFmt: false,
    copiadoMin: false,
    copiadoRuta: false,
    copiadoValor: false,

    copiarConFeedback(tipo) {
      if (tipo === 'fmt') {
        this.copiadoFmt = true;
        setTimeout(() => this.copiadoFmt = false, 1800);
      } else if (tipo === 'min') {
        this.copiadoMin = true;
        setTimeout(() => this.copiadoMin = false, 1800);
      } else if (tipo === 'ruta') {
        this.copiadoRuta = true;
        setTimeout(() => this.copiadoRuta = false, 1800);
      } else if (tipo === 'valor') {
        this.copiadoValor = true;
        setTimeout(() => this.copiadoValor = false, 1800);
      }
    }
  };
};

(function(){
'use strict';

var LOTE = 120;           // líneas dibujadas por bloque (liviano y rápido)
var MAX_LINEA = 20000;    // líneas más largas se recortan (con botón para ver completa)
var LIMITE_NODOS_EXPANDIR = 20000;

var $ = function(id){ return document.getElementById(id); };
var entrada = $('entrada');
var modoSel = 'auto';
var vistaSel = 'codigo';
var estado = null;   // resultado del último análisis
var temporizador;

function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escapeRegExp(s){ return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
function fmtNum(n){ return Number(n).toLocaleString('es-CO'); }
function fmtTam(n){ return n >= 1048576 ? (n/1048576).toFixed(1) + ' MB' : (n >= 1024 ? (n/1024).toFixed(1) + ' KB' : n + ' caracteres'); }
function esc(t){ return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escAttr(t){ return esc(t).replace(/"/g,'&quot;'); }

/* ======================================================================
   RESALTADOR DE SINTAXIS Y FORMATEADOR UNIVERSAL EN VIVO (XML & JSON)
   ====================================================================== */
function detectarTipoDocumento(str) {
  if (!str) return 'json';
  var s = str.replace(/^\uFEFF/, '').trim();
  if (s.startsWith('<') || /^\s*<\?xml/i.test(s) || /^\s*<!--/i.test(s) || /^\s*<!DOCTYPE/i.test(s)) return 'xml';
  if (s.startsWith('{') || s.startsWith('[')) return 'json';
  if (/<[a-zA-Z0-9_:\.\-]+[^>]*>/.test(s)) return 'xml';
  return 'json';
}

function highlightCodeTokens(code, modo) {
  if (!code) return '';
  var isXml = modo === 'xml' || (modo !== 'json' && detectarTipoDocumento(code) === 'xml');

  if (isXml) {
    var xmlRegex = /(<!--[\s\S]*?-->)|(<!\[CDATA\[[\s\S]*?\]\]>)|(<\?[\s\S]*?\?>)|(<!DOCTYPE[\s\S]*?>)|(<\/?)([a-zA-Z0-9_:\.\-]+)((?:\s+[a-zA-Z0-9_:\.\-]+(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+))?)*\s*)(\/?>)|([^<]+)/g;
    return code.replace(xmlRegex, function(m, comment, cdata, pi, doctype, tagBracket, tagName, attrs, tagClose, text) {
      if (comment) return '<span class="tk-cm">' + escapeHtml(comment) + '</span>';
      if (cdata) {
        var inner = cdata.slice(9, -3);
        return '<span class="tk-pn">&lt;![CDATA[</span><span class="tk-cd">' + escapeHtml(inner) + '</span><span class="tk-pn">]]&gt;</span>';
      }
      if (pi || doctype) return '<span class="tk-pi">' + escapeHtml(m) + '</span>';
      if (tagBracket) {
        var hTag = '<span class="tk-pn">' + escapeHtml(tagBracket) + '</span><span class="tk-tg">' + escapeHtml(tagName) + '</span>';
        var hAttrs = '';
        if (attrs) {
          hAttrs = attrs.replace(/([a-zA-Z0-9_:\.\-]+)(\s*=\s*)("[^"]*"|'[^']*'|[^\s>]+)/g, function(ma, aName, eq, aVal) {
            return '<span class="tk-an">' + escapeHtml(aName) + '</span><span class="tk-pn">' + escapeHtml(eq) + '</span><span class="tk-av">' + escapeHtml(aVal) + '</span>';
          });
        }
        var hClose = tagClose ? '<span class="tk-pn">' + escapeHtml(tagClose) + '</span>' : '';
        return hTag + hAttrs + hClose;
      }
      if (text) return '<span class="tk-tx">' + escapeHtml(text) + '</span>';
      return escapeHtml(m);
    });
  } else {
    // JSON Highlighting
    var jsonRegex = /(\/\/.*$|\/\*[\s\S]*?\*\/)|("([^"\\]*(\\.[^"\\]*)*)"\s*:)|("([^"\\]*(\\.[^"\\]*)*)")|(-?\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b)|(\b(?:true|false)\b)|(\bnull\b)|([{}[],:])|([^"'/{}[],:\s]+|\s+)/gm;
    return code.replace(jsonRegex, function(m, comment, keyFull, k1, k2, strFull, s1, s2, num, bool, nill, punct, other) {
      if (comment) return '<span class="tk-cm">' + escapeHtml(m) + '</span>';
      if (keyFull) {
        var colonIdx = m.lastIndexOf(':');
        var kStr = m.slice(0, colonIdx);
        var colon = m.slice(colonIdx);
        return '<span class="tk-jk">' + escapeHtml(kStr) + '</span><span class="tk-pn">' + escapeHtml(colon) + '</span>';
      }
      if (strFull) return '<span class="tk-js">' + escapeHtml(strFull) + '</span>';
      if (num) return '<span class="tk-jn">' + escapeHtml(num) + '</span>';
      if (bool) return '<span class="tk-jb">' + escapeHtml(bool) + '</span>';
      if (nill) return '<span class="tk-jl">' + escapeHtml(nill) + '</span>';
      if (punct) return '<span class="tk-pn">' + escapeHtml(punct) + '</span>';
      return escapeHtml(m);
    });
  }
}

/* Fallback de formateo XML basado en tokens puro (indestructible ante XML minificados o fragmentos) */
function formatXmlTokensFallback(xml, indent) {
  indent = indent || '  ';
  xml = (xml || '').replace(/^\uFEFF/, '').trim();
  if (!xml) return '';

  var regex = /(<!--[\s\S]*?-->)|(<!\[CDATA\[[\s\S]*?\]\]>)|(<\?[\s\S]*?\?>)|(<!DOCTYPE[\s\S]*?>)|(<\/?[a-zA-Z0-9_:\.\-]+(?:\s+[^>]*?)?\/?>)|([^<]+)/g;
  
  var tokens = [];
  var match;
  while ((match = regex.exec(xml)) !== null) {
    if (match[6]) {
      var trimmed = match[6].trim();
      if (trimmed) tokens.push({ type: 'text', value: trimmed });
    } else if (match[1]) {
      tokens.push({ type: 'comment', value: match[1].trim() });
    } else if (match[2]) {
      tokens.push({ type: 'cdata', value: match[2].trim() });
    } else if (match[3] || match[4]) {
      tokens.push({ type: 'declaration', value: (match[3] || match[4]).trim() });
    } else if (match[5]) {
      var tag = match[5].trim();
      if (tag.startsWith('</')) {
        tokens.push({ type: 'close', value: tag });
      } else if (tag.endsWith('/>')) {
        tokens.push({ type: 'selfclose', value: tag });
      } else {
        tokens.push({ type: 'open', value: tag });
      }
    }
  }

  var lines = [];
  var pad = 0;
  for (var i = 0; i < tokens.length; i++) {
    var tk = tokens[i];
    if (tk.type === 'close') {
      pad = Math.max(0, pad - 1);
    }
    
    var currentIndent = pad;
    
    // Si abre un tag y lo siguiente es texto y luego cierra el mismo tag: <tag>texto</tag> en una sola línea
    if (tk.type === 'open' && i + 2 < tokens.length && tokens[i+1].type === 'text' && tokens[i+2].type === 'close') {
      var openName = (tk.value.match(/^<([a-zA-Z0-9_:\.\-]+)/) || [])[1];
      var closeName = (tokens[i+2].value.match(/^<\/([a-zA-Z0-9_:\.\-]+)/) || [])[1];
      if (openName && openName === closeName && tokens[i+1].value.length < 120 && tokens[i+1].value.indexOf('\n') === -1) {
        lines.push({ indent: currentIndent, text: tk.value + tokens[i+1].value + tokens[i+2].value });
        i += 2;
        continue;
      }
    }

    lines.push({ indent: currentIndent, text: tk.value });
    
    if (tk.type === 'open') {
      pad++;
    }
  }

  return lines.map(function(l) {
    var indStr = '';
    for (var k = 0; k < l.indent; k++) indStr += indent;
    return indStr + l.text;
  }).join('\n');
}

function prettyPrintXml(str, indent) {
  indent = indent || '  ';
  var t = (str || '').replace(/^\uFEFF/, '').trim();
  if (!t) return '';

  if (typeof DOMParser !== 'undefined') {
    try {
      var doc = new DOMParser().parseFromString(t, 'application/xml');
      if (!doc.getElementsByTagName('parsererror').length && typeof formatearXmlCanonico === 'function') {
        var fmtC = formatearXmlCanonico(doc);
        if (fmtC && fmtC.trim()) return fmtC;
      }
    } catch(e) {}

    // Intentar envolver fragmentos XML sin raíz única (ej: <item>1</item><item>2</item>)
    try {
      var wrapped = '<__root_wrapper__>' + t + '</__root_wrapper__>';
      var docWrap = new DOMParser().parseFromString(wrapped, 'application/xml');
      if (!docWrap.getElementsByTagName('parsererror').length && typeof formatearXmlCanonico === 'function') {
        var fmtW = formatearXmlCanonico(docWrap);
        var subLines = fmtW.split(/\r?\n/).filter(function(l){ return !/<(\/)?__root_wrapper__>/.test(l); });
        var cleanW = subLines.map(function(l){ return l.replace(/^ {2}/, ''); }).join('\n').trim();
        if (cleanW) return cleanW;
      }
    } catch(e2) {}
  }

  return formatXmlTokensFallback(t, indent);
}

function formatearDocumentoUniversal(txt, modo) {
  var t = (txt || '').replace(/^\uFEFF/, '').trim();
  if (!t) return { ok: false, texto: '', tipo: 'vacio' };

  var esXml = (modo === 'xml') || (modo !== 'json' && (/^\s*<|^\s*<\?xml|<\/?[a-zA-Z0-9_:\.\-]+(\s|>|\/)/i.test(t)));

  if (esXml) {
    var fmtX = prettyPrintXml(t, '  ');
    if (fmtX) return { ok: true, texto: fmtX, tipo: 'xml' };
  }

  // Intentar JSON estándar
  try {
    var objJ = JSON.parse(t);
    return { ok: true, texto: JSON.stringify(objJ, null, 2), tipo: 'json' };
  } catch(eJ) {}

  // Intentar NDJSON (múltiples objetos por línea)
  if (t.indexOf('\n') !== -1 && !/^\s*\[/.test(t)) {
    var lns = t.split(/\r?\n/).map(function(l){ return l.trim(); }).filter(Boolean);
    var arrNd = [];
    var okNd = true;
    for (var ni = 0; ni < lns.length; ni++) {
      try { arrNd.push(JSON.parse(lns[ni])); } catch(e){ okNd = false; break; }
    }
    if (okNd && arrNd.length) return { ok: true, texto: JSON.stringify(arrNd, null, 2), tipo: 'json' };
  }

  // Intentar Loose JSON
  try {
    var saneado = t
      .replace(/\/\/.*$/gm, '')
      .replace(/\/\*[\s\S]*?\*\//g, '')
      .replace(/([{,]\s*)([a-zA-Z0-9_$]+)\s*:/g, '$1"$2":')
      .replace(/:\s*'([^']*)'/g, ':"$1"')
      .replace(/,\s*([}\]])/g, '$1');
    var objL = JSON.parse(saneado);
    return { ok: true, texto: JSON.stringify(objL, null, 2), tipo: 'json' };
  } catch(eL) {}

  // Fallback XML si tenía etiquetas
  var fbX = formatXmlTokensFallback(t, '  ');
  if (fbX && fbX !== t) return { ok: true, texto: fbX, tipo: 'xml' };

  return { ok: false, texto: t, tipo: 'texto' };
}

function formatearCualquierDocumento(txt, modo) {
  var t = (txt || '').replace(/^\uFEFF/, '').trim();
  if (!t) return { ok: false, texto: '', tipo: 'vacio' };

  // 1. Intentar con analizar() del visor (soporta XML, SOAP, JSON, NDJSON)
  try {
    if (typeof analizar === 'function') {
      var r = analizar(t, modo || 'auto');
      if (r && r.ok && r.lineas && r.lineas.length > 0) {
        var fmtLines = r.lineas.map(function(l){
          return new Array(l.ind + 1).join('  ') + (l.toks || []).map(function(x){ return x.t; }).join('');
        }).join('\n');
        if (fmtLines && fmtLines.trim()) {
          return { ok: true, texto: fmtLines, tipo: r.tipo };
        }
      }
    }
  } catch(e) {}

  // 2. Intentar formatearDocumentoUniversal (prettyPrintXml + JSON.stringify)
  return formatearDocumentoUniversal(t, modo || 'auto');
}

function autoFormatearDocumento(txtArea, lado, forzar) {
  if (!txtArea) return false;
  var val = (txtArea.value || '').trim();
  if (!val || val.length < 10) return false;

  var m = lado ? (lado === 'A' ? diffState.modoA : diffState.modoB) : (typeof modoSel !== 'undefined' ? modoSel : 'auto');
  var res = formatearCualquierDocumento(val, m);
  if (res && res.ok && res.texto && (forzar || res.texto !== val)) {
    txtArea.value = res.texto;
    if (lado && res.tipo && m === 'auto' && typeof fijarModoDiff === 'function') {
      fijarModoDiff(lado, res.tipo);
    } else if (!lado && res.tipo && typeof fijarModo === 'function') {
      if (typeof modoSel !== 'undefined' && modoSel === 'auto') fijarModo(res.tipo);
    }
    if (txtArea._actualizarSintaxis) txtArea._actualizarSintaxis();
    if (lado && typeof actualizarStatsPanel === 'function') actualizarStatsPanel(lado);
    return true;
  }
  return false;
}

function autoFormatearSiMinificado(txtArea, lado) {
  return autoFormatearDocumento(txtArea, lado, false);
}

function enlazarAutoFormateoAlPegar(txtArea, lado) {
  if (!txtArea) return;
  txtArea.addEventListener('paste', function(e) {
    var clipboardText = '';
    if (e.clipboardData && e.clipboardData.getData) {
      clipboardText = e.clipboardData.getData('text/plain');
    }
    if (clipboardText && clipboardText.trim().length > 10) {
      var m = lado ? (lado === 'A' ? diffState.modoA : diffState.modoB) : (typeof modoSel !== 'undefined' ? modoSel : 'auto');
      var res = formatearCualquierDocumento(clipboardText, m);
      if (res && res.ok && res.texto) {
        e.preventDefault();
        // Si el textarea estaba vacío o todo seleccionado, reemplaza todo
        if (!txtArea.value.trim() || (txtArea.selectionStart === 0 && txtArea.selectionEnd === txtArea.value.length)) {
          txtArea.value = res.texto;
        } else {
          var s = txtArea.selectionStart, end = txtArea.selectionEnd;
          txtArea.value = txtArea.value.substring(0, s) + res.texto + txtArea.value.substring(end);
          txtArea.selectionStart = txtArea.selectionEnd = s + res.texto.length;
        }
        if (lado && res.tipo && m === 'auto' && typeof fijarModoDiff === 'function') {
          fijarModoDiff(lado, res.tipo);
        } else if (!lado && res.tipo && typeof fijarModo === 'function') {
          if (typeof modoSel !== 'undefined' && modoSel === 'auto') fijarModo(res.tipo);
        }
        if (txtArea._actualizarSintaxis) txtArea._actualizarSintaxis();
        if (lado && typeof actualizarStatsPanel === 'function') actualizarStatsPanel(lado);
        else if (!lado && typeof procesar === 'function') {
          clearTimeout(temporizador);
          temporizador = setTimeout(procesar, 40);
        }
        toast('Estructurado e indentado como ' + (res.tipo || 'código').toUpperCase());
        return;
      }
    }
    // Fallback tras pegado nativo
    setTimeout(function(){
      autoFormatearDocumento(txtArea, lado, false);
      if (txtArea._actualizarSintaxis) txtArea._actualizarSintaxis();
      if (lado && typeof actualizarStatsPanel === 'function') actualizarStatsPanel(lado);
      else if (!lado && typeof procesar === 'function') {
        clearTimeout(temporizador);
        temporizador = setTimeout(procesar, 40);
      }
    }, 40);
  });
}

function bindToggleColor(btnId, wrapId) {
  var btn = $(btnId);
  var wrap = $(wrapId);
  if (!btn || !wrap) return;
  btn.addEventListener('click', function(){
    if (wrap.classList.contains('force-plain')) {
      wrap.classList.remove('force-plain');
      wrap.classList.add('has-syntax');
      btn.textContent = '🌈 Colores';
      btn.title = 'Colores de sintaxis activos';
      toast('Colores de sintaxis activados');
    } else {
      wrap.classList.add('force-plain');
      wrap.classList.remove('has-syntax');
      btn.textContent = '⚪ Plano';
      btn.title = 'Modo plano (sin colores)';
      toast('Modo blanco y negro activado');
    }
  });
}

function vincularEditorConSintaxis(textareaId, codeId, obtenerModo) {
  var t = $(textareaId);
  var c = $(codeId);
  if (!t || !c) return;
  var p = c.parentElement;
  var wrap = t.closest('.syntax-editor-container');

  function sincronizarScroll() {
    if (p) {
      p.scrollTop = t.scrollTop;
      p.scrollLeft = t.scrollLeft;
    }
  }

  function actualizar() {
    var val = t.value || '';
    if (!val.trim()) {
      c.innerHTML = '';
      if (wrap) wrap.classList.remove('has-syntax');
      return;
    }
    var modo = typeof obtenerModo === 'function' ? obtenerModo() : obtenerModo;
    var html = highlightCodeTokens(val, modo);
    c.innerHTML = html + (val.endsWith('\n') ? ' ' : '');
    if (wrap && html) {
      wrap.classList.add('has-syntax');
      wrap.classList.remove('force-plain');
    }
    sincronizarScroll();
  }

  t._actualizarSintaxis = actualizar;
  t.addEventListener('input', actualizar);
  t.addEventListener('paste', function(){
    requestAnimationFrame(actualizar);
    setTimeout(actualizar, 30);
  });
  t.addEventListener('change', actualizar);
  t.addEventListener('scroll', sincronizarScroll);
  t.addEventListener('keyup', sincronizarScroll);
  t.addEventListener('keydown', function(e) {
    if (e.key === 'Tab' && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      var sStart = t.selectionStart, sEnd = t.selectionEnd;
      var val = t.value;
      t.value = val.substring(0, sStart) + '  ' + val.substring(sEnd);
      t.selectionStart = t.selectionEnd = sStart + 2;
      actualizar();
      t.dispatchEvent(new Event('input'));
    }
  });

  if (t.value) actualizar();
}

var toastT;
function toast(msg){
  var t = $('toast'); t.textContent = msg || 'Copiado'; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(function(){ t.classList.remove('show'); }, 1500);
}
function copiar(texto, msg){
  var fin = function(){ toast(msg || 'Copiado'); };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(texto).then(fin, function(){ copiarViejo(texto); fin(); });
  } else { copiarViejo(texto); fin(); }
}
function copiarViejo(texto){
  var ta = document.createElement('textarea'); ta.value = texto; document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } catch (e) {} document.body.removeChild(ta);
}

/* ======================================================================
   JSON: se valida con JSON.parse y se formatea con un lector propio que
   conserva los números y textos EXACTAMENTE como vienen (sin redondear).
   ====================================================================== */
function parseJsonRaw(s){
  var i = 0;
  function ws(){ while (i < s.length && (s[i] === ' ' || s[i] === '\t' || s[i] === '\n' || s[i] === '\r')) i++; }
  function cad(){
    var ini = i; i++;
    while (s[i] !== '"') { if (s[i] === '\\') i++; i++; }
    i++;
    return s.slice(ini, i);
  }
  function val(){
    ws();
    var c = s[i];
    if (c === '{') {
      i++; var props = []; ws();
      if (s[i] === '}') { i++; return { t: 'obj', props: props }; }
      for (;;) {
        ws(); var k = cad(); ws(); i++; var v = val(); props.push({ k: k, v: v }); ws();
        if (s[i] === ',') { i++; continue; }
        i++; break;
      }
      return { t: 'obj', props: props };
    }
    if (c === '[') {
      i++; var items = []; ws();
      if (s[i] === ']') { i++; return { t: 'arr', items: items }; }
      for (;;) {
        items.push(val()); ws();
        if (s[i] === ',') { i++; continue; }
        i++; break;
      }
      return { t: 'arr', items: items };
    }
    if (c === '"') return { t: 'str', raw: cad() };
    var ini = i;
    while (i < s.length && ',]} \t\n\r'.indexOf(s[i]) === -1) i++;
    var raw = s.slice(ini, i);
    return { t: raw === 'true' || raw === 'false' ? 'bool' : (raw === 'null' ? 'null' : 'num'), raw: raw };
  }
  return val();
}

function tokVal(n){
  return { t: n.raw, c: n.t === 'str' ? 'js' : (n.t === 'num' ? 'jn' : (n.t === 'bool' ? 'jb' : 'jl')) };
}

function emitJson(n, depth, keyRaw, coma, out, bIdx){
  var pre = keyRaw !== null ? [{ t: keyRaw, c: 'jk' }, { t: ': ', c: 'pn' }] : [];
  var com = coma ? [{ t: ',', c: 'pn' }] : [];
  var bTag = bIdx !== undefined ? bIdx : 0;
  if (n.t === 'obj' || n.t === 'arr') {
    var abre = n.t === 'obj' ? '{' : '[', cierra = n.t === 'obj' ? '}' : ']';
    var hijos = n.t === 'obj' ? n.props : n.items;
    if (!hijos.length) { out.push({ ind: depth, toks: pre.concat([{ t: abre + cierra, c: 'pn' }], com), bloqueId: bTag }); return; }
    out.push({ ind: depth, toks: pre.concat([{ t: abre, c: 'pn' }]), bloqueId: bTag });
    for (var j = 0; j < hijos.length; j++) {
      var ult = j === hijos.length - 1;
      if (n.t === 'obj') emitJson(hijos[j].v, depth + 1, hijos[j].k, !ult, out, bTag);
      else emitJson(hijos[j], depth + 1, null, !ult, out, bTag);
    }
    out.push({ ind: depth, toks: [{ t: cierra, c: 'pn' }].concat(com), bloqueId: bTag });
  } else {
    out.push({ ind: depth, toks: pre.concat([tokVal(n)], com), bloqueId: bTag });
  }
}

function serJson(n){
  if (n.t === 'obj') return '{' + n.props.map(function(p){ return p.k + ':' + serJson(p.v); }).join(',') + '}';
  if (n.t === 'arr') return '[' + n.items.map(serJson).join(',') + ']';
  return n.raw;
}

function contarJson(n){
  if (n.t === 'obj') { var c = 1; n.props.forEach(function(p){ c += contarJson(p.v); }); return c; }
  if (n.t === 'arr') { var d = 1; n.items.forEach(function(x){ d += contarJson(x); }); return d; }
  return 1;
}

function posALineaCol(txt, pos){
  var antes = txt.slice(0, pos);
  var linea = antes.split('\n').length;
  var col = pos - antes.lastIndexOf('\n');
  return { linea: linea, col: col };
}

function errorJson(e, txt){
  var msg = String(e.message || e);
  var linea = null, col = null, m;
  if ((m = msg.match(/line (\d+) column (\d+)/i))) { linea = +m[1]; col = +m[2]; }
  else if ((m = msg.match(/position (\d+)/i))) { var p = posALineaCol(txt, +m[1]); linea = p.linea; col = p.col; }
  return { mensaje: msg, linea: linea, col: col };
}

/* ----------------------------------------------------------------------
   Si el texto NO es un único JSON (logs con prefijo tipo «appResponse:{…}»,
   varios JSON uno por línea, líneas de texto/SQL mezcladas), se lee línea
   por línea: cada línea con JSON se formatea y las demás se muestran tal cual.
   ---------------------------------------------------------------------- */
function jsonEnLinea(t){
  var rx = /[\[{]/g, m, intentos = 0;
  while ((m = rx.exec(t)) !== null && intentos++ < 8) {
    var pre = t.slice(0, m.index);
    if (pre.indexOf('"') !== -1) return null;                 // es parte de un JSON roto, no un prefijo
    if (pre.trim() && !/[:=>]\s*$/.test(pre)) continue;       // el prefijo debe terminar en  :  =  o  >
    var etq = pre.replace(/[\s:=>]+$/, '').trim(), cand = t.slice(m.index);
    try { JSON.parse(cand); return { etiqueta: etq, json: cand }; } catch (e) {}
    var fin = Math.max(cand.lastIndexOf('}'), cand.lastIndexOf(']'));
    if (fin > 0) { var c2 = cand.slice(0, fin + 1); try { JSON.parse(c2); return { etiqueta: etq, json: c2 }; } catch (e2) {} }
  }
  return null;
}

function xmlEnLinea(t){
  var idx = t.indexOf('<');
  if (idx === -1) return null;
  var fin = t.lastIndexOf('>');
  if (fin <= idx) return null;
  var cand = t.slice(idx, fin + 1).trim();
  if (!/^<\??[a-zA-Z_][\w:\.-]*/.test(cand)) return null;
  var doc = parsearXmlFragmento(cand);
  if (doc) {
    var pre = t.slice(0, idx).trim();
    var etq = pre.replace(/[\s:=>]+$/, '').trim();
    return { etiqueta: etq, xml: cand, doc: doc };
  }
  return null;
}

function sqlEnLinea(t){
  var rx = /\b(SELECT\s+[\s\S]+?\bFROM\b|INSERT\s+INTO\b[\s\S]+?\bVALUES\b|UPDATE\s+[\s\S]+?\bSET\b|DELETE\s+FROM\b|WITH\s+[\w\s,]+?\bAS\s*\(|CREATE\s+TABLE\b|ALTER\s+TABLE\b|EXEC\s+\w+|CALL\s+\w+)/i;
  var m = t.match(rx);
  if (!m) return null;
  var idx = m.index;
  var pre = t.slice(0, idx).trim();
  if (pre.indexOf('"') !== -1 && !/[:=>]\s*$/.test(pre)) return null;
  var etq = pre.replace(/[\s:=>]+$/, '').trim();
  var sql = t.slice(idx).trim();
  return { etiqueta: etq, sql: sql };
}

function emitSql(sqlStr, depth, out, bIdx){
  var formatted = sqlStr;
  if (typeof SqlFormatter !== 'undefined' && SqlFormatter && SqlFormatter.format) {
    try {
      var res = SqlFormatter.format(sqlStr);
      if (res && res.text) formatted = res.text;
    } catch(e){}
  }
  var kwRegex = /\b(SELECT|FROM|WHERE|AND|OR|NOT|IN|IS|NULL|LIKE|ILIKE|BETWEEN|AS|ON|JOIN|INNER|LEFT|RIGHT|FULL|OUTER|CROSS|NATURAL|USING|GROUP\s+BY|ORDER\s+BY|HAVING|LIMIT|OFFSET|UNION\s+ALL|UNION|INTERSECT|EXCEPT|DISTINCT|INSERT\s+INTO|INSERT|INTO|VALUES|UPDATE|SET|DELETE|RETURNING|WITH\s+RECURSIVE|WITH|CASE|WHEN|THEN|ELSE|END|ASC|DESC|NULLS|EXISTS|ANY|SOME|CREATE\s+TABLE|ALTER\s+TABLE|DROP\s+TABLE|CREATE|ALTER|DROP|TABLE|INDEX|EXEC|CALL)\b/gi;

  formatted.split('\n').forEach(function(l){
    var toks = [];
    var lineTrim = l.replace(/\s+$/, '');
    var tokenRx = /('([^'\\]|\\.)*'|--[^\n]*|\b\d+(?:\.\d+)?\b|\b[A-Za-z_][\w$]*\b|[(),;=<>!+*\/%])/g;
    var lastIdx = 0, m;
    while ((m = tokenRx.exec(lineTrim)) !== null) {
      if (m.index > lastIdx) {
        toks.push({ t: lineTrim.slice(lastIdx, m.index), c: null });
      }
      var tVal = m[0];
      if (tVal.charAt(0) === "'") toks.push({ t: tVal, c: 'js' });
      else if (tVal.indexOf('--') === 0) toks.push({ t: tVal, c: 'cm' });
      else if (/^\d/.test(tVal)) toks.push({ t: tVal, c: 'jn' });
      else if (kwRegex.test(tVal)) toks.push({ t: tVal, c: 'tg' });
      else toks.push({ t: tVal, c: 'tx' });
      lastIdx = m.index + tVal.length;
    }
    if (lastIdx < lineTrim.length) {
      toks.push({ t: lineTrim.slice(lastIdx), c: null });
    }
    out.push({ ind: depth, toks: toks.length ? toks : [{ t: ' ', c: null }], bloqueId: bIdx, tipo: 'sql' });
  });
}

function analizarLineas(txt){
  var bloques = [], nJson = 0, nXml = 0, nSql = 0, nIgnorados = 0;
  txt.split(/\r?\n/).forEach(function(l, i){
    var t = l.trim(); if (!t) return;
    var rJson = jsonEnLinea(t);
    if (rJson) {
      nJson++;
      bloques.push({ tipo: 'json', linea: i + 1, etiqueta: rJson.etiqueta, modelo: parseJsonRaw(rJson.json), raw: rJson.json });
      return;
    }
    var rXml = xmlEnLinea(t);
    if (rXml) {
      nXml++;
      bloques.push({ tipo: 'xml', linea: i + 1, etiqueta: rXml.etiqueta, doc: rXml.doc, raw: rXml.xml });
      return;
    }
    var rSql = sqlEnLinea(t);
    if (rSql) {
      nSql++;
      bloques.push({ tipo: 'sql', linea: i + 1, etiqueta: rSql.etiqueta, sql: rSql.sql, raw: rSql.sql });
      return;
    }
    // Si no es JSON, ni XML, ni SQL: se descarta el texto o ruido de log
    nIgnorados++;
  });

  if (!bloques.length) return null;

  var lineas = [], uno = bloques.length === 1;
  function titulo(b){
    var tNom = b.tipo === 'json' ? 'JSON' : (b.tipo === 'xml' ? 'XML' : 'SQL');
    return 'Línea ' + b.linea + (b.etiqueta ? ' · ' + b.etiqueta : ' · ' + tNom);
  }

  var listaBloques = [];
  if (uno) {
    var b0 = bloques[0];
    b0.id = 0;
    b0.inicio = 0;
    b0.titulo = titulo(b0);
    if (b0.tipo === 'json') emitJson(b0.modelo, 0, null, false, lineas, 0);
    else if (b0.tipo === 'xml') emitXmlDoc(b0.doc, b0.raw, 0, lineas);
    else emitSql(b0.sql, 0, lineas, 0);
    b0.fin = lineas.length - 1;
    for (var k = 0; k < lineas.length; k++) lineas[k].bloqueId = 0;
    listaBloques.push(b0);
  } else {
    bloques.forEach(function(b, bIdx){
      var ini = lineas.length;
      lineas.push({ ind: 0, toks: [{ t: '// ' + titulo(b), c: 'cm' }], bloqueId: bIdx });
      if (b.tipo === 'json') emitJson(b.modelo, 0, null, false, lineas, bIdx);
      else if (b.tipo === 'xml') {
        var startXml = lineas.length;
        emitXmlDoc(b.doc, b.raw, 0, lineas);
        for (var x = startXml; x < lineas.length; x++) lineas[x].bloqueId = bIdx;
      } else {
        emitSql(b.sql, 0, lineas, bIdx);
      }
      var fin = lineas.length - 1;
      for (var k = ini; k <= fin; k++) lineas[k].bloqueId = bIdx;
      b.id = bIdx;
      b.inicio = ini;
      b.fin = fin;
      b.titulo = titulo(b);
      listaBloques.push(b);
    });
  }

  var modelo = {
    t: 'obj',
    props: bloques.map(function(b){
      return {
        k: JSON.stringify(titulo(b)),
        v: b.tipo === 'json' ? b.modelo : { t: 'str', raw: JSON.stringify(b.raw) }
      };
    })
  };

  var resumenPartes = [];
  if (nJson) resumenPartes.push(fmtNum(nJson) + ' JSON');
  if (nSql) resumenPartes.push(fmtNum(nSql) + ' SQL');
  if (nXml) resumenPartes.push(fmtNum(nXml) + ' XML');

  var aviso = 'Se formatearon ' + fmtNum(bloques.length) + ' bloques estructurados (' + resumenPartes.join(', ') + ')' +
              (nIgnorados ? ' y se eliminaron ' + fmtNum(nIgnorados) + ' líneas de ruido/logs sin formato.' : '.');

  return {
    ok: true,
    tipo: 'json',
    lineas: lineas,
    modelo: modelo,
    bloques: listaBloques,
    aviso: aviso,
    resumen: fmtNum(bloques.length) + ' bloques (' + resumenPartes.join(', ') + ')' + (nIgnorados ? ' · ' + fmtNum(nIgnorados) + ' líneas de ruido descartadas' : ''),
    minificar: function(){
      return bloques.map(function(b){
        if (b.tipo === 'json') return serJson(b.modelo);
        if (b.tipo === 'xml') return b.raw.replace(/>\s+</g, '><').trim();
        return b.sql.replace(/\s+/g, ' ').trim();
      }).join('\n');
    },
    ext: uno ? (bloques[0].tipo === 'json' ? 'json' : (bloques[0].tipo === 'xml' ? 'xml' : 'sql')) : 'txt',
    texto: txt
  };
}

function analizarJson(txt, aviso){
  var val;
  try { val = JSON.parse(txt); }
  catch (e) { var alt = analizarLineas(txt); if (alt) return alt; return { ok: false, tipo: 'json', error: errorJson(e, txt), texto: txt }; }

  if (typeof val === 'string' && /^\s*[\[{<]/.test(val)) {
    var interno = val.trim();
    if (interno[0] === '<') {
      var rx = analizarXml(val, 'Era un XML escrito como texto entre comillas: se quitaron las comillas y los escapes.');
      if (rx.ok) return rx;
    } else {
      try { JSON.parse(interno); return analizarJson(interno, 'Era un JSON escrito como texto entre comillas: se quitaron las comillas y los escapes.'); } catch (e2) {}
    }
  }

  var modelo = parseJsonRaw(txt);
  var lineas = [];
  var listaBloques = [];
  if (modelo.t === 'arr' && modelo.items.length > 1) {
    lineas.push({ ind: 0, toks: [{ t: '[', c: 'pn' }], bloqueId: 0 });
    modelo.items.forEach(function(item, idx){
      var ini = lineas.length;
      var ult = idx === modelo.items.length - 1;
      emitJson(item, 1, null, !ult, lineas, idx);
      var fin = lineas.length - 1;
      for (var k = ini; k <= fin; k++) lineas[k].bloqueId = idx;
      listaBloques.push({ id: idx, titulo: 'Elemento [' + idx + ']', inicio: ini, fin: fin, modelo: item, tipo: 'json' });
    });
    lineas.push({ ind: 0, toks: [{ t: ']', c: 'pn' }], bloqueId: modelo.items.length - 1 });
  } else if (modelo.t === 'obj' && modelo.props.length > 1) {
    lineas.push({ ind: 0, toks: [{ t: '{', c: 'pn' }], bloqueId: 0 });
    modelo.props.forEach(function(prop, idx){
      var ini = lineas.length;
      var ult = idx === modelo.props.length - 1;
      emitJson(prop.v, 1, prop.k, !ult, lineas, idx);
      var fin = lineas.length - 1;
      for (var k = ini; k <= fin; k++) lineas[k].bloqueId = idx;
      var claveClean = prop.k;
      try { claveClean = JSON.parse(prop.k); } catch(e){}
      listaBloques.push({ id: idx, titulo: claveClean, inicio: ini, fin: fin, modelo: prop.v, tipo: 'json' });
    });
    lineas.push({ ind: 0, toks: [{ t: '}', c: 'pn' }], bloqueId: modelo.props.length - 1 });
  } else {
    emitJson(modelo, 0, null, false, lineas, 0);
    var fin = lineas.length - 1;
    for (var k = 0; k <= fin; k++) lineas[k].bloqueId = 0;
    listaBloques.push({ id: 0, titulo: 'Documento JSON', inicio: 0, fin: fin, modelo: modelo, tipo: 'json' });
  }
  var resumen = modelo.t === 'obj' ? 'Objeto · ' + fmtNum(modelo.props.length) + ' claves'
              : (modelo.t === 'arr' ? 'Lista · ' + fmtNum(modelo.items.length) + ' elementos' : 'Valor simple');
  return { ok: true, tipo: 'json', lineas: lineas, modelo: modelo, bloques: listaBloques, aviso: aviso || null,
           resumen: resumen + ' · ' + fmtNum(contarJson(modelo)) + ' valores',
           minificar: function(){ return serJson(modelo); }, ext: 'json', texto: txt };
}

/* ======================================================================
   XML: se lee con el DOMParser del navegador (valida) y se formatea con
   sangría; el XML que viene dentro de un CDATA también se formatea.
   ====================================================================== */
function tokensAbre(el, vacio){
  var toks = [{ t: '<', c: 'pn' }, { t: el.nodeName, c: 'tg' }];
  var at = el.attributes;
  for (var i = 0; i < at.length; i++) {
    toks.push({ t: ' ', c: null }, { t: at[i].name, c: 'an' }, { t: '="', c: 'pn' }, { t: escAttr(at[i].value), c: 'av' }, { t: '"', c: 'pn' });
  }
  toks.push({ t: vacio ? '/>' : '>', c: 'pn' });
  return toks;
}
function tokensCierra(el){ return [{ t: '</', c: 'pn' }, { t: el.nodeName, c: 'tg' }, { t: '>', c: 'pn' }]; }

function parsearXmlFragmento(str){
  try {
    var d = new DOMParser().parseFromString(str, 'application/xml');
    if (d.getElementsByTagName('parsererror').length) return null;
    return d;
  } catch (e) { return null; }
}

function emitXmlDoc(doc, txt, depth, out){
  var m = txt.match(/^\s*<\?xml[^?]*\?>/);
  if (m) out.push({ ind: depth, toks: [{ t: m[0].trim(), c: 'pi' }] });
  var hijos = doc.childNodes;
  for (var i = 0; i < hijos.length; i++) emitXmlNodo(hijos[i], depth, out, 0);
}

function emitXmlNodo(n, depth, out, nivelCdata){
  var t = n.nodeType;
  if (t === 1) {
    var hijos = [];
    for (var i = 0; i < n.childNodes.length; i++) {
      var h = n.childNodes[i];
      if (h.nodeType === 3 && !h.data.trim()) continue;
      hijos.push(h);
    }
    if (!hijos.length) { out.push({ ind: depth, toks: tokensAbre(n, true) }); return; }
    if (hijos.length === 1 && (hijos[0].nodeType === 3 || hijos[0].nodeType === 4)) {
      var u = hijos[0];
      var dato = u.nodeType === 3 ? u.data.trim() : u.data;
      var anidado = u.nodeType === 4 && dato.trim().charAt(0) === '<' && nivelCdata < 4;
      if (dato.indexOf('\n') === -1 && !anidado) {
        var toks = tokensAbre(n, false);
        if (u.nodeType === 3) toks.push({ t: esc(dato), c: 'tx' });
        else toks.push({ t: '<![CDATA[', c: 'pn' }, { t: dato, c: 'cd' }, { t: ']]>', c: 'pn' });
        toks = toks.concat(tokensCierra(n));
        out.push({ ind: depth, toks: toks });
        return;
      }
    }
    out.push({ ind: depth, toks: tokensAbre(n, false) });
    for (var j = 0; j < hijos.length; j++) emitXmlNodo(hijos[j], depth + 1, out, nivelCdata);
    out.push({ ind: depth, toks: tokensCierra(n) });
    return;
  }
  if (t === 3) {
    n.data.trim().split('\n').forEach(function(l){ out.push({ ind: depth, txt: true, toks: [{ t: esc(l.trim()), c: 'tx' }] }); });
    return;
  }
  if (t === 4) {
    var data = n.data;
    var tr = data.trim();
    if (tr.charAt(0) === '<' && nivelCdata < 4) {
      var d2 = parsearXmlFragmento(tr);
      if (d2) {
        out.push({ ind: depth, toks: [{ t: '<![CDATA[', c: 'pn' }] });
        emitXmlDoc(d2, tr, depth + 1, out);
        out.push({ ind: depth, toks: [{ t: ']]>', c: 'pn' }] });
        return;
      }
    }
    var ls = data.split('\n');
    if (ls.length === 1) { out.push({ ind: depth, toks: [{ t: '<![CDATA[', c: 'pn' }, { t: data, c: 'cd' }, { t: ']]>', c: 'pn' }] }); return; }
    out.push({ ind: depth, toks: [{ t: '<![CDATA[', c: 'pn' }] });
    ls.forEach(function(l){ out.push({ ind: depth + 1, txt: true, toks: [{ t: l.replace(/\s+$/, ''), c: 'cd' }] }); });
    out.push({ ind: depth, toks: [{ t: ']]>', c: 'pn' }] });
    return;
  }
  if (t === 8) {
    var cs = n.data.split('\n');
    if (cs.length === 1) out.push({ ind: depth, toks: [{ t: '<!--' + n.data + '-->', c: 'cm' }] });
    else {
      out.push({ ind: depth, toks: [{ t: '<!--', c: 'cm' }] });
      cs.forEach(function(l){ out.push({ ind: depth + 1, toks: [{ t: l.trim(), c: 'cm' }] }); });
      out.push({ ind: depth, toks: [{ t: '-->', c: 'cm' }] });
    }
    return;
  }
  if (t === 7) { out.push({ ind: depth, toks: [{ t: '<?' + n.target + (n.data ? ' ' + n.data : '') + '?>', c: 'pi' }] }); return; }
  if (t === 10) { out.push({ ind: depth, toks: [{ t: '<!DOCTYPE ' + n.name + '>', c: 'pi' }] }); }
}

function errorXml(msg, txt){
  var mensaje = msg.replace(/\s+/g, ' ').trim();
  var linea = null, col = null, m;
  if ((m = msg.match(/error on line (\d+) at column (\d+):\s*([\s\S]*?)(?:Below is a rendering|$)/i))) {
    linea = +m[1]; col = +m[2]; mensaje = m[3].replace(/\s+/g, ' ').trim();
  } else if ((m = msg.match(/XML Parsing Error:\s*([^\n]+)[\s\S]*?Line Number (\d+), Column (\d+)/i))) {
    mensaje = m[1].trim(); linea = +m[2]; col = +m[3];
  } else if ((m = msg.match(/line (\d+)[^\d]+(\d+)/i))) { linea = +m[1]; col = +m[2]; }
  if (mensaje.length > 300) mensaje = mensaje.slice(0, 300) + '…';
  return { mensaje: mensaje, linea: linea, col: col };
}

function analizarXml(txt, aviso, reparado){
  var doc;
  try {
    doc = new DOMParser().parseFromString(txt, 'application/xml');
  } catch (e) {
    return { ok: false, tipo: 'xml', error: errorXml(String(e.message || e), txt), texto: txt };
  }
  var pe = doc.getElementsByTagName('parsererror')[0];
  if (pe) {
    // Algunos XML (p. ej. facturas/notas DIAN) traen un xmlns con espacios en su dirección,
    // como xmlns:schemaLocation="urn:... http://...xsd". El navegador lo rechaza por ser una URI
    // inválida aunque el resto del XML esté bien. Se reintenta cambiando esos espacios por %20.
    if (!reparado) {
      var rep = txt.replace(/(xmlns(?::[\w.\-]+)?\s*=\s*")([^"]*)(")/g, function(m, a, v, c){
        return /\s/.test(v) ? a + v.trim().replace(/\s+/g, '%20') + c : m;
      });
      if (rep !== txt) {
        var r2 = analizarXml(rep, 'Un namespace (xmlns) tenía espacios en su dirección y el navegador no lo acepta; se muestra con «%20» en lugar del espacio. El resto del XML no se modificó.', true);
        if (r2.ok) return r2;
      }
    }
    return { ok: false, tipo: 'xml', error: errorXml(pe.textContent || '', txt), texto: txt };
  }

  var lineas = [];
  emitXmlDoc(doc, txt, 0, lineas);
  for (var k = 0; k < lineas.length; k++) lineas[k].bloqueId = 0;
  var raiz = doc.documentElement ? doc.documentElement.nodeName : 'xml';
  var listaBloques = [{ id: 0, titulo: '<' + raiz + '>', inicio: 0, fin: lineas.length - 1, tipo: 'xml' }];
  var total = doc.getElementsByTagName('*').length;
  return { ok: true, tipo: 'xml', lineas: lineas, doc: doc, bloques: listaBloques, aviso: aviso || null,
           resumen: 'Raíz: <' + raiz + '> · ' + fmtNum(total) + ' elemento' + (total === 1 ? '' : 's'),
           minificar: function(){
             var s = '', prevTxt = false;
             lineas.forEach(function(l){
               var linea = l.toks.map(function(x){ return x.t; }).join('');
               if (l.txt && prevTxt) s += ' ';
               s += linea; prevTxt = !!l.txt;
             });
             return s;
           }, ext: 'xml', texto: txt };
}

function analizar(txt, modo){
  var t = txt.replace(/^\uFEFF/, '').trim();
  if (!t) return null;
  var tipo = modo;
  if (tipo === 'auto') tipo = t.charAt(0) === '<' ? 'xml' : 'json';
  var r = tipo === 'xml' ? analizarXml(t) : analizarJson(t);
  r.tam = txt.length;
  return r;
}

/* ======================================================================
   Dibujo del resultado
   ====================================================================== */
function textoLinea(l){ return l.toks.map(function(x){ return x.t; }).join(''); }
function textoFormateado(){
  return estado.lineas.map(function(l){ return new Array(l.ind + 1).join('  ') + textoLinea(l); }).join('\n');
}

function tokensAHtml(tokens, intervalos){
  var out = '', pos = 0, k = 0;
  tokens.forEach(function(tk){
    var ini = pos, fin = pos + tk.t.length, cursor = ini, html = '';
    while (cursor < fin) {
      while (k < intervalos.length && intervalos[k][1] <= cursor) k++;
      var iv = intervalos[k];
      if (!iv || iv[0] >= fin) { html += escapeHtml(tk.t.slice(cursor - ini)); cursor = fin; }
      else if (iv[0] > cursor) { html += escapeHtml(tk.t.slice(cursor - ini, iv[0] - ini)); cursor = iv[0]; }
      else { var hasta = Math.min(iv[1], fin); html += '<mark>' + escapeHtml(tk.t.slice(cursor - ini, hasta - ini)) + '</mark>'; cursor = hasta; }
    }
    out += tk.c ? '<span class="tk-' + tk.c + '">' + html + '</span>' : html;
    pos = fin;
  });
  return out;
}

function intervalos(texto, regex){
  var res = [];
  if (!regex) return res;
  regex.lastIndex = 0;
  var m;
  while ((m = regex.exec(texto)) !== null) {
    if (m[0] === '') { regex.lastIndex++; continue; }
    res.push([m.index, m.index + m[0].length]);
  }
  return res;
}

function htmlLinea(i){
  var l = estado.lineas[i];
  var bId = l.bloqueId;
  var b = (bId !== undefined && estado.bloquesMap) ? estado.bloquesMap[bId] : null;
  var tieneMatch = b && b.coincidencias > 0;
  var hayBusqueda = !!(estado.regex && estado.query);

  var bannerHtml = '';
  var esPrimerLineaVis = false;
  if (hayBusqueda && tieneMatch) {
    if (estado.vis) {
      var p = estado.vis.indexOf(i);
      esPrimerLineaVis = (p === 0 || estado.lineas[estado.vis[p - 1]].bloqueId !== bId);
    } else {
      esPrimerLineaVis = (i === b.inicio);
    }
  }

  if (esPrimerLineaVis) {
    var bTipo = b.tipo ? b.tipo.toUpperCase() : 'BLOQUE';
    bannerHtml = '<div class="json-block-banner" data-bid="' + b.id + '">' +
      '<span class="jbb-pill">⚡ ' + bTipo + ' COINCIDENTE</span>' +
      '<span class="jbb-title">' + escapeHtml(b.titulo || (bTipo + ' #' + (b.id + 1))) + '</span>' +
      '<span class="jbb-count">' + fmtNum(b.coincidencias) + (b.coincidencias === 1 ? ' coincidencia' : ' coincidencias') + '</span>' +
      '<button type="button" class="jbb-copy" data-bcopy="' + b.id + '" title="Copiar este ' + bTipo + ' formateado">📋 Copiar este ' + bTipo + '</button>' +
    '</div>';
  }

  var extraCls = '';
  if (hayBusqueda) {
    if (tieneMatch) {
      extraCls += ' json-block-matched';
      if (i === b.inicio) extraCls += ' json-block-first';
      if (i === b.fin) extraCls += ' json-block-last';
    } else if (!estado.vis) {
      extraCls += ' json-block-dimmed';
    }
  }

  var toks = l.toks;
  var indent = new Array(l.ind + 1).join('  ');
  var recorte = 0;
  var largo = 0;
  toks.forEach(function(x){ largo += x.t.length; });
  if (largo > MAX_LINEA && !estado.expandidas[i]) {
    var acum = 0, nuevos = [];
    for (var j = 0; j < toks.length; j++) {
      if (acum + toks[j].t.length <= MAX_LINEA) { nuevos.push(toks[j]); acum += toks[j].t.length; }
      else { nuevos.push({ t: toks[j].t.slice(0, MAX_LINEA - acum), c: toks[j].c }); acum = MAX_LINEA; break; }
    }
    recorte = largo - MAX_LINEA;
    toks = nuevos;
  }
  var texto = toks.map(function(x){ return x.t; }).join('');
  var cuerpo = escapeHtml(indent) + (tokensAHtml(toks, intervalos(texto, estado.regex)) || '&nbsp;');
  if (recorte) cuerpo += ' <a class="ver-mas" href="#" data-ver="' + i + '">… +' + fmtNum(recorte) + ' caracteres · mostrar línea completa</a>';
  return bannerHtml + '<div class="code-line' + extraCls + '" data-i="' + i + '"><span class="ln">' + (i + 1) + '</span><span class="code-text">' + cuerpo + '</span></div>';
}

function agregarLineas(n){
  var cont = $('vista-codigo');
  var vis = estado && estado.vis;
  var total = !estado ? 0 : (vis ? vis.length : estado.lineas.length);
  if (!estado || estado.hasta >= total) return;
  var viejo = cont.querySelector('.mas-lineas');
  if (viejo) viejo.remove();
  var fin = Math.min(total, estado.hasta + n);
  var html = '';
  for (var p = estado.hasta; p < fin; p++) html += htmlLinea(vis ? vis[p] : p);
  estado.hasta = fin;
  if (fin < total) {
    html += '<div class="mas-lineas">Mostrando ' + fmtNum(fin) + ' de ' + fmtNum(total) +
            ' líneas — sigue bajando para cargar más · <a href="#" data-todo="1">cargar todo</a></div>';
  }
  cont.insertAdjacentHTML('beforeend', html);
}

function dibujarCodigo(){
  var cont = $('vista-codigo');
  cont.innerHTML = '';
  estado.hasta = 0;
  contarCoincidencias();

  var bloquesConMatch = estado.bloques ? estado.bloques.filter(function(b){ return b.coincidencias > 0; }) : [];

  if (estado.regex && estado.query) {
    if (estado.modoFiltro === 'json') {
      var visLineas = [];
      var lineasAgregadas = {};
      bloquesConMatch.forEach(function(b){
        for (var k = b.inicio; k <= b.fin; k++) {
          if (!lineasAgregadas[k]) {
            visLineas.push(k);
            lineasAgregadas[k] = true;
          }
        }
      });
      estado.vis = visLineas;
      $('bCopiarFiltro').style.display = '';
      $('bCopiarFiltro').textContent = 'Copiar JSONs filtrados (' + fmtNum(bloquesConMatch.length) + ')';
    } else if (estado.modoFiltro === 'lineas') {
      estado.vis = estado.coinc;
      $('bCopiarFiltro').style.display = '';
      $('bCopiarFiltro').textContent = 'Copiar líneas filtradas';
    } else {
      estado.vis = null;
      $('bCopiarFiltro').style.display = 'none';
    }
  } else {
    estado.vis = null;
    $('bCopiarFiltro').style.display = 'none';
  }

  if (estado.vis && !estado.vis.length) {
    var msg = (estado.modoFiltro === 'json')
      ? 'Ningún JSON contiene «' + escapeHtml(estado.query) + '».'
      : 'Ninguna línea contiene «' + escapeHtml(estado.query) + '».';
    cont.innerHTML = '<div class="mas-lineas">' + msg + '</div>';
  }

  agregarLineas(LOTE);
  if (estado.coinc.length) irACoincidencia(0, true);
}

function contarCoincidencias(){
  estado.coinc = []; estado.idx = -1;
  if (estado.bloques) {
    estado.bloques.forEach(function(b){ b.coincidencias = 0; });
  }
  var cnt = $('cnt');
  if (!estado.regex || !estado.query) { cnt.textContent = ''; return; }
  var total = 0;
  for (var i = 0; i < estado.lineas.length; i++) {
    var t = textoLinea(estado.lineas[i]);
    if (t.length < estado.query.length) continue;
    var r = estado.regex; r.lastIndex = 0; var m, c = 0;
    while ((m = r.exec(t)) !== null) { c++; if (m[0] === '') r.lastIndex++; }
    if (c) {
      estado.coinc.push(i);
      total += c;
      var bId = estado.lineas[i].bloqueId;
      if (bId !== undefined && estado.bloquesMap && estado.bloquesMap[bId]) {
        estado.bloquesMap[bId].coincidencias += c;
      }
    }
  }

  var bloquesConMatch = estado.bloques ? estado.bloques.filter(function(b){ return b.coincidencias > 0; }) : [];

  if (!total) {
    cnt.textContent = 'Sin resultados';
    return;
  }

  if (estado.modoFiltro === 'json') {
    cnt.textContent = fmtNum(total) + (total === 1 ? ' resultado' : ' resultados') +
      ' en ' + fmtNum(bloquesConMatch.length) + (bloquesConMatch.length === 1 ? ' bloque' : ' bloques');
  } else if (estado.modoFiltro === 'lineas') {
    cnt.textContent = fmtNum(total) + (total === 1 ? ' resultado' : ' resultados') +
      ' en ' + fmtNum(estado.coinc.length) + (estado.coinc.length === 1 ? ' línea' : ' líneas');
  } else {
    cnt.textContent = fmtNum(total) + (total === 1 ? ' resultado' : ' resultados') +
      (bloquesConMatch.length ? ' · ' + fmtNum(bloquesConMatch.length) + (bloquesConMatch.length === 1 ? ' bloque' : ' bloques') : '');
  }
}

function irACoincidencia(dir, inicial){
  if (!estado || !estado.coinc || !estado.coinc.length) return;
  estado.idx = inicial ? 0 : (estado.idx + dir + estado.coinc.length) % estado.coinc.length;
  var linea = estado.coinc[estado.idx];
  var cont = $('vista-codigo');
  var pos = estado.vis ? estado.vis.indexOf(linea) : linea;
  if (pos === -1 && estado.vis) return;
  if (pos >= estado.hasta) {
    if (pos - estado.hasta > 250) {
      cont.innerHTML = '';
      estado.hasta = Math.max(0, pos - 20);
      agregarLineas(LOTE);
    } else {
      agregarLineas(pos - estado.hasta + LOTE);
    }
  }
  Array.prototype.forEach.call(cont.querySelectorAll('.cur-line'), function(e){ e.classList.remove('cur-line'); });
  var el = cont.querySelector('[data-i="' + linea + '"]');
  if (el) {
    el.classList.add('cur-line');
    el.scrollIntoView({ block: 'center' });
  }

  var cnt = $('cnt');
  if (cnt && estado.coinc.length) {
    var bId = estado.lineas[linea].bloqueId;
    var bloquesConMatch = estado.bloques ? estado.bloques.filter(function(b){ return b.coincidencias > 0; }) : [];
    var bIdx = -1;
    for (var bi = 0; bi < bloquesConMatch.length; bi++) {
      if (bloquesConMatch[bi].id === bId) { bIdx = bi + 1; break; }
    }
    var infoBloque = (bIdx > 0 && bloquesConMatch.length > 1) ? ' (Bloque ' + bIdx + ' de ' + bloquesConMatch.length + ')' : '';
    cnt.textContent = (estado.idx + 1) + ' / ' + fmtNum(estado.coinc.length) + infoBloque;
  }
}

function irABloque(dir){
  if (!estado || !estado.coinc || !estado.coinc.length) return;
  var bloquesConMatch = estado.bloques ? estado.bloques.filter(function(b){ return b.coincidencias > 0; }) : [];
  if (bloquesConMatch.length <= 1) { irACoincidencia(dir); return; }
  var curLinea = estado.coinc[Math.max(0, estado.idx)];
  var curBId = estado.lineas[curLinea].bloqueId;
  var curBIdx = 0;
  for (var i = 0; i < bloquesConMatch.length; i++) {
    if (bloquesConMatch[i].id === curBId) { curBIdx = i; break; }
  }
  var sigBIdx = (curBIdx + dir + bloquesConMatch.length) % bloquesConMatch.length;
  var targetB = bloquesConMatch[sigBIdx];
  for (var c = 0; c < estado.coinc.length; c++) {
    var lIdx = estado.coinc[c];
    if (lIdx >= targetB.inicio && lIdx <= targetB.fin) {
      estado.idx = c;
      irACoincidencia(0);
      return;
    }
  }
}

function copiarBloque(bid){
  if (!estado || !estado.bloquesMap) return;
  var b = estado.bloquesMap[bid];
  if (!b) return;
  var start = b.inicio;
  if (start < b.fin && estado.lineas[start].toks && estado.lineas[start].toks[0] && estado.lineas[start].toks[0].c === 'cm') {
    start++;
  }
  var txt = '';
  for (var k = start; k <= b.fin; k++) {
    var l = estado.lineas[k];
    txt += new Array(l.ind + 1).join('  ') + textoLinea(l) + '\n';
  }
  var tNom = b.tipo ? b.tipo.toUpperCase() : 'Bloque';
  copiar(txt.trim(), tNom + ' (' + (b.titulo || 'bloque') + ') copiado');
}

/* ---------------------------- Árbol ---------------------------- */
function itemsJson(n, ruta){
  var res = [];
  if (n.t === 'obj') {
    n.props.forEach(function(p){
      var clave; try { clave = JSON.parse(p.k); } catch (e) { clave = p.k; }
      var r = ruta + (/^[A-Za-z_$][\w$]*$/.test(clave) ? '.' + clave : '["' + clave.replace(/"/g, '\\"') + '"]');
      res.push(itemJson(n === null ? null : p.v, p.k, r));
    });
  } else if (n.t === 'arr') {
    n.items.forEach(function(x, i){ res.push(itemJson(x, null, ruta + '[' + i + ']')); });
  }
  return res;
}
function itemJson(n, keyRaw, ruta){
  var pre = keyRaw !== null ? '<span class="tk-jk">' + escapeHtml(keyRaw) + '</span><span class="tk-pn">: </span>' : '';
  var etiqueta, hijos = null, cuenta = '';
  if (n.t === 'obj') { etiqueta = pre + '<span class="tk-pn">{…}</span>'; cuenta = fmtNum(n.props.length) + (n.props.length === 1 ? ' clave' : ' claves'); if (n.props.length) hijos = function(){ return itemsJson(n, ruta); }; }
  else if (n.t === 'arr') { etiqueta = pre + '<span class="tk-pn">[…]</span>'; cuenta = fmtNum(n.items.length) + (n.items.length === 1 ? ' elemento' : ' elementos'); if (n.items.length) hijos = function(){ return itemsJson(n, ruta); }; }
  else { var v = tokVal(n); var raw = v.t.length > 400 ? v.t.slice(0, 400) + '…' : v.t; etiqueta = pre + '<span class="tk-' + v.c + '">' + escapeHtml(raw) + '</span>'; }
  return { etiqueta: etiqueta, cuenta: cuenta, hijos: hijos, ruta: ruta, valor: (n.t === 'obj' || n.t === 'arr') ? serJson(n) : n.raw };
}

function rutaXml(el){
  var partes = [];
  var n = el;
  while (n && n.nodeType === 1) {
    var idx = 1, total = 0;
    var p = n.parentNode;
    if (p) {
      for (var i = 0; i < p.childNodes.length; i++) {
        var h = p.childNodes[i];
        if (h.nodeType === 1 && h.nodeName === n.nodeName) { total++; if (h === n) idx = total; }
      }
    }
    partes.unshift(n.nodeName + (total > 1 ? '[' + idx + ']' : ''));
    n = p;
  }
  return '/' + partes.join('/');
}

function itemXml(n){
  var t = n.nodeType;
  if (t === 1) {
    var kids = [];
    for (var i = 0; i < n.childNodes.length; i++) {
      var h = n.childNodes[i];
      if (h.nodeType === 3 && !h.data.trim()) continue;
      kids.push(h);
    }
    var etq = tokensAbre(n, kids.length === 0).map(function(x){
      var tx = (x.c === 'av' && x.t.length > 200) ? x.t.slice(0, 200) + '…' : x.t;
      return x.c ? '<span class="tk-' + x.c + '">' + escapeHtml(tx) + '</span>' : escapeHtml(tx);
    }).join('');
    var unico = kids.length === 1 && (kids[0].nodeType === 3 || kids[0].nodeType === 4) ? kids[0] : null;
    var valor = unico ? (unico.nodeType === 3 ? unico.data.trim() : unico.data) : '';
    var ruta = rutaXml(n);
    if (unico) {
      var corto = valor.length > 300 ? valor.slice(0, 300) + '…' : valor;
      return { etiqueta: etq.replace(/<span class="tk-pn">&gt;<\/span>$/, '') + '<span class="tk-pn">&gt;</span><span class="tk-tx">' + escapeHtml(esc(corto)) + '</span><span class="tk-pn">&lt;/</span><span class="tk-tg">' + escapeHtml(n.nodeName) + '</span><span class="tk-pn">&gt;</span>', cuenta: '', hijos: null, ruta: ruta, valor: valor };
    }
    return { etiqueta: etq, cuenta: kids.length ? fmtNum(kids.length) + (kids.length === 1 ? ' hijo' : ' hijos') : '', ruta: ruta,
             hijos: kids.length ? function(){ return kids.map(itemXml); } : null, valor: kids.map(function(k){ return k.nodeType === 3 ? k.data.trim() : ''; }).join(' ').trim() };
  }
  if (t === 3) return { etiqueta: '<span class="tk-tx">' + escapeHtml(esc(n.data.trim())) + '</span>', cuenta: '', hijos: null, ruta: '', valor: n.data.trim() };
  if (t === 4) return { etiqueta: '<span class="tk-pn">&lt;![CDATA[</span><span class="tk-cd">' + escapeHtml(n.data.length > 300 ? n.data.slice(0, 300) + '…' : n.data) + '</span><span class="tk-pn">]]&gt;</span>', cuenta: '', hijos: null, ruta: '', valor: n.data };
  if (t === 8) return { etiqueta: '<span class="tk-cm">' + escapeHtml('<!--' + n.data + '-->') + '</span>', cuenta: '', hijos: null, ruta: '', valor: n.data };
  if (t === 7) return { etiqueta: '<span class="tk-pi">' + escapeHtml('<?' + n.target + ' ' + n.data + '?>') + '</span>', cuenta: '', hijos: null, ruta: '', valor: n.data };
  return { etiqueta: '', cuenta: '', hijos: null, ruta: '', valor: '' };
}

var seleccionado = null;
var nodosDibujados = 0;

function crearNodoArbol(item, padreRuta){
  var nodo = document.createElement('div');
  nodo.className = 'tn ' + (item.hijos ? 'hijos' : 'hoja');
  var fila = document.createElement('div');
  fila.className = 'tr';
  fila.innerHTML = '<span class="tg">▶</span><span class="et">' + item.etiqueta + '</span>' + (item.cuenta ? '<span class="nn">' + item.cuenta + '</span>' : '');
  var cont = document.createElement('div');
  cont.className = 'tc';
  nodo.appendChild(fila); nodo.appendChild(cont);
  nodo._item = item;
  nodosDibujados++;

  fila.addEventListener('click', function(){
    if (seleccionado) seleccionado.classList.remove('sel');
    seleccionado = fila; fila.classList.add('sel');
    mostrarRuta(item, padreRuta);
    if (item.hijos) alternarNodo(nodo);
  });
  return nodo;
}

function llenarHijos(nodo, desde){
  var item = nodo._item;
  var cont = nodo.querySelector(':scope > .tc');
  if (!nodo._hijos) nodo._hijos = item.hijos();
  var lista = nodo._hijos;
  var mas = cont.querySelector(':scope > .masbtn');
  if (mas) mas.remove();
  var fin = Math.min(lista.length, desde + 300);
  for (var i = desde; i < fin; i++) cont.appendChild(crearNodoArbol(lista[i], item.ruta));
  nodo._dibujados = fin;
  if (fin < lista.length) {
    var b = document.createElement('div');
    b.className = 'masbtn';
    b.textContent = '… mostrar más (' + fmtNum(lista.length - fin) + ' restantes)';
    b.addEventListener('click', function(ev){ ev.stopPropagation(); llenarHijos(nodo, nodo._dibujados); });
    cont.appendChild(b);
  }
}

function alternarNodo(nodo, forzar){
  var abrir = forzar === undefined ? !nodo.classList.contains('open') : forzar;
  if (abrir && !nodo._dibujados && nodo._item.hijos) llenarHijos(nodo, 0);
  nodo.classList.toggle('open', abrir);
}

function expandirTodo(nodo, tope){
  if (!nodo._item.hijos) return;
  alternarNodo(nodo, true);
  var hs = nodo.querySelectorAll(':scope > .tc > .tn');
  for (var i = 0; i < hs.length; i++) {
    if (nodosDibujados > tope) return;
    expandirTodo(hs[i], tope);
  }
}

function mostrarRuta(item, padre){
  var pb = $('pathbar');
  pb.classList.add('on');
  $('pathTxt').textContent = item.ruta || padre || '';
  pb._item = item;
}

function dibujarArbol(){
  var cont = $('vista-arbol');
  cont.innerHTML = '';
  seleccionado = null; nodosDibujados = 0;
  $('pathbar').classList.remove('on');
  var raiz;
  if (estado.tipo === 'json') raiz = itemJson(estado.modelo, null, '$');
  else raiz = itemXml(estado.doc.documentElement);
  var nodo = crearNodoArbol(raiz, '');
  cont.appendChild(nodo);
  if (raiz.hijos) alternarNodo(nodo, true);
}

function mostrarVista(v){
  vistaSel = v;
  Array.prototype.forEach.call($('segVista').querySelectorAll('button'), function(b){ b.classList.toggle('active', b.dataset.vista === v); });
  $('vista-codigo').style.display = v === 'codigo' ? '' : 'none';
  $('vista-arbol').style.display = v === 'arbol' ? 'block' : 'none';
  $('busqCodigo').style.display = v === 'codigo' ? '' : 'none';
  $('ctrlArbol').style.display = v === 'arbol' ? '' : 'none';
  if (!estado || !estado.ok) return;
  if (v === 'arbol' && !estado.arbolListo) { dibujarArbol(); estado.arbolListo = true; }
  if (v !== 'arbol') $('pathbar').classList.remove('on');
}

/* ---------------------------- Estado general ---------------------------- */
function chip(txt, cls){ return '<span class="chip ' + (cls || '') + '">' + escapeHtml(txt) + '</span>'; }

function contextoError(txt, linea){
  var ls = txt.split('\n');
  var ini = Math.max(1, linea - 2), fin = Math.min(ls.length, linea + 2);
  var html = '';
  for (var i = ini; i <= fin; i++) {
    var t = ls[i - 1]; if (t.length > 300) t = t.slice(0, 300) + '…';
    html += '<span class="l' + (i === linea ? ' bad' : '') + '"><span class="n">' + i + '</span>' + escapeHtml(t) + '</span>';
  }
  return html;
}

function procesar(){
  var txt = entrada.value;
  if (entrada && entrada._actualizarSintaxis) entrada._actualizarSintaxis();
  estado = null;
  var r = analizar(txt, modoSel);
  $('chipVacio').style.display = r ? 'none' : '';
  $('salida').classList.toggle('on', !!r);
  if (!r) return;

  var st = $('status');
  var tipoTxt = r.tipo === 'json' ? 'JSON' : 'XML';
  var errbox = $('errbox'), aviso = $('aviso');

  if (!r.ok) {
    st.innerHTML = chip('✖ ' + tipoTxt + ' con errores', 'bad') + chip(fmtTam(r.tam), 'info');
    aviso.style.display = 'none';
    var e = r.error;
    var ubic = e.linea ? 'Línea ' + fmtNum(e.linea) + (e.col ? ', columna ' + fmtNum(e.col) : '') : 'No se pudo ubicar la línea';
    errbox.style.display = 'block';
    errbox.innerHTML = '<div class="t">' + escapeHtml(ubic) + '</div><div class="m">' + escapeHtml(e.mensaje) + '</div>' +
      (e.linea ? '<pre>' + contextoError(r.texto, e.linea) + '</pre><button type="button" class="secondary" id="bIrError">Ir al error en la caja</button>' : '') +
      (modoSel === 'auto' ? '<div class="hint">Detectado automáticamente como ' + tipoTxt + '. Si es otro formato, cámbialo arriba (Auto / JSON / XML).</div>' : '');
    $('resultado').style.display = 'none';
    var bi = $('bIrError');
    if (bi) bi.addEventListener('click', function(){ irAlError(e); });
    return;
  }

  errbox.style.display = 'none';
  $('resultado').style.display = '';
  st.innerHTML = chip('✔ ' + tipoTxt + ' válido', 'ok') + chip(r.resumen) + chip(fmtNum(r.lineas.length) + ' líneas formateadas', 'info') + chip(fmtTam(r.tam), 'info');
  if (r.aviso) { aviso.style.display = 'block'; aviso.textContent = r.aviso; } else aviso.style.display = 'none';

  r.regex = null; r.query = ''; r.expandidas = {}; r.hasta = 0; r.coinc = []; r.idx = -1; r.arbolListo = false;
  r.bloques = r.bloques || [];
  r.bloquesMap = {};
  r.bloques.forEach(function(b){ r.bloquesMap[b.id] = b; b.coincidencias = 0; });
  var fj = $('filtroJson'), sc = $('soloCoinc');
  r.modoFiltro = (fj && fj.checked) ? 'json' : ((sc && sc.checked) ? 'lineas' : 'todo');
  r.vis = null;
  estado = r;
  $('buscar').value = '';
  $('cnt').textContent = '';
  dibujarCodigo();
  mostrarVista(vistaSel);
}

function irAlError(e){
  var ls = entrada.value.split('\n');
  var off = 0;
  for (var i = 0; i < e.linea - 1 && i < ls.length; i++) off += ls[i].length + 1;
  var largo = (ls[e.linea - 1] || '').length;
  entrada.focus();
  entrada.setSelectionRange(off, off + largo);
  var alto = parseFloat(getComputedStyle(entrada).lineHeight) || 19.5;
  entrada.scrollTop = Math.max(0, (e.linea - 4) * alto);
}

/* ---------------------------- Archivos ---------------------------- */
function decodificar(buf){
  var u8 = new Uint8Array(buf);
  if (u8.length >= 2 && u8[0] === 0xFF && u8[1] === 0xFE) return new TextDecoder('utf-16le').decode(u8.subarray(2));
  if (u8.length >= 2 && u8[0] === 0xFE && u8[1] === 0xFF) return new TextDecoder('utf-16be').decode(u8.subarray(2));
  if (u8.length >= 3 && u8[0] === 0xEF && u8[1] === 0xBB && u8[2] === 0xBF) return new TextDecoder('utf-8').decode(u8.subarray(3));
  try { return new TextDecoder('utf-8', { fatal: true }).decode(u8); }
  catch (e) {
    var cab = new TextDecoder('latin1').decode(u8.subarray(0, 300));
    var m = cab.match(/encoding=["']([\w\-]+)["']/i);
    if (m) { try { return new TextDecoder(m[1]).decode(u8); } catch (e2) {} }
    return new TextDecoder('windows-1252').decode(u8);
  }
}

function abrirArchivo(file){
  if (!file) return;
  var fr = new FileReader();
  fr.onload = function(){
    entrada.value = decodificar(fr.result);
    var n = file.name.toLowerCase();
    if (/\.json$/.test(n)) fijarModo('json'); else if (/\.(xml|xsd|xsl|xslt|svg|config|csproj|wsdl)$/.test(n)) fijarModo('xml'); else fijarModo('auto');
    procesar();
    toast('Archivo cargado: ' + file.name);
  };
  fr.onerror = function(){ toast('No se pudo leer el archivo'); };
  fr.readAsArrayBuffer(file);
}

function fijarModo(m){
  modoSel = m;
  Array.prototype.forEach.call($('seg').querySelectorAll('button'), function(b){ b.classList.toggle('active', b.dataset.modo === m); });
  if (entrada && entrada._actualizarSintaxis) entrada._actualizarSintaxis();
}

