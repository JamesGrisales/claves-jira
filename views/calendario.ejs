  // Eliminar un turno de disponibilidad individual
  window.eliminarTurnoDisp = function(id, nombre) {
    if (!id) return;
    var nombreTxt = nombre || 'este turno';
    if (!confirm('¿Estás seguro de que deseas eliminar la disponibilidad de: ' + nombreTxt + '?')) {
      return;
    }
    fetch('/api/disponibilidad/' + id + '/eliminar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    }).then(function(r) {
      return r.json();
    }).then(function(res) {
      if (res && res.ok) {
        cargarDisponibilidad(function() {
          renderTablaRol();
          renderGrid();
        });
      } else {
        alert('Error al eliminar: ' + (res && res.error ? res.error : 'Desconocido'));
      }
    }).catch(function(err) {
      alert('Error de conexión: ' + err.message);
    });
  };

  function renderTablaRol() {
    var tbody = $('tbodyRolDisponibilidad');
    if (!tbody) return;
    tbody.innerHTML = '';
    var hoyStr = ymd(new Date());

    var filtro = ($('filtroRolDisp') && $('filtroRolDisp').value || '').trim().toLowerCase();
    var lista = (turnosDisponibilidad || []).filter(function(t) {
      if (!filtro) return true;
      var str = (t.usuario + ' ' + (t.cedula || '') + ' ' + (t.celular || '') + ' ' + t.inicio + ' ' + t.fin).toLowerCase();
      return str.indexOf(filtro) !== -1;
    });

    var conteoEl = $('rolDispConteo');
    if (conteoEl) {
      conteoEl.textContent = lista.length + ' turno' + (lista.length === 1 ? '' : 's') + ' programado' + (lista.length === 1 ? '' : 's');
    }

    if (lista.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:24px; color:var(--muted); font-size:13.5px;">No hay turnos registrados que coincidan con la búsqueda.</td></tr>';
      return;
    }

    lista.forEach(function(t) {
      var tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--panel-edge)';
      tr.style.transition = 'background 0.15s ease';

      var esHoy = hoyStr >= t.inicio && hoyStr <= t.fin;
      var esPasado = hoyStr > t.fin;
      var esProximo = hoyStr < t.inicio;
      var esJames = /james|grisales/i.test(t.usuario || '');

      if (esHoy) {
        tr.style.background = 'rgba(245, 158, 11, 0.12)';
      }

      // Estado Badge
      var estadoHtml = '';
      if (esHoy) {
        estadoHtml = '<span style="background:#f59e0b; color:#000; font-size:11.5px; font-weight:900; padding:4px 10px; border-radius:12px; display:inline-flex; align-items:center; gap:4px; box-shadow:0 0 12px rgba(245,158,11,0.4);">⚡ ACTIVO HOY' + (esJames ? ' (Tu Guardia)' : '') + '</span>';
      } else if (esProximo) {
        estadoHtml = '<span style="background:rgba(2,132,199,0.2); color:#38bdf8; border:1px solid rgba(2,132,199,0.45); font-size:11.5px; font-weight:800; padding:3px 9px; border-radius:12px;">⏳ PRÓXIMO</span>';
      } else {
        estadoHtml = '<span style="background:rgba(148,163,184,0.14); color:#94a3b8; font-size:11px; font-weight:700; padding:3px 8px; border-radius:12px;">⚪ Cumplido</span>';
      }

      // Cédula Pill
      var cedulaHtml = t.cedula ? '<span class="ced-badge">' + t.cedula + '</span>' : '<span style="color:var(--muted);">---</span>';

      // Celular Link
      var celularHtml = t.celular ? '<a href="tel:' + t.celular + '" class="cel-link" title="Llamar a ' + t.usuario + '">📞 ' + t.celular + '</a>' : '<span style="color:var(--muted);">---</span>';

      // Técnico Box
      var tecHtml = '';
      if (esJames) {
        tecHtml = '<div style="display:flex; align-items:center; gap:8px;"><span style="background:rgba(245,158,11,0.25); color:#f59e0b; border:1px solid rgba(245,158,11,0.6); padding:2px 7px; border-radius:999px; font-size:12px; font-weight:900;">⚡</span> <strong style="font-size:13.5px; color:#f59e0b;">' + t.usuario + '</strong> <span style="background:#f59e0b; color:#000; font-size:10px; font-weight:900; padding:1px 6px; border-radius:4px;">TÚ</span></div>';
      } else {
        tecHtml = '<div style="display:flex; align-items:center; gap:8px;"><span style="background:rgba(2,132,199,0.2); color:#38bdf8; border:1px solid rgba(2,132,199,0.4); padding:2px 7px; border-radius:999px; font-size:12px;">🛡️</span> <span style="font-size:13.5px; font-weight:700; color:var(--text);">' + t.usuario + '</span></div>';
      }

      // Fechas Box
      var pIni = t.inicio.split('-'), pFin = t.fin.split('-');
      var fPretty = pIni[2] + '/' + pIni[1] + '/' + pIni[0] + ' ➔ ' + pFin[2] + '/' + pFin[1] + '/' + pFin[0];
      var fechasHtml = '<div style="font-weight:700; font-size:12.5px; color:var(--text);">' + fPretty + '</div>';

      // Mes Box
      var mesHtml = '<span style="background:rgba(255,255,255,0.06); border:1px solid var(--panel-edge); font-size:11px; font-weight:800; padding:2px 8px; border-radius:6px; color:var(--muted);">' + (t.mes || 'OCTUBRE') + '</span>';

      // Acciones Box: Botón Eliminar
      var safeNombre = (t.usuario || '').replace(/'/g, "\'");
      var accionesHtml = '<button type="button" class="btn-eliminar-disp" onclick="eliminarTurnoDisp(' + t.id + ', \'' + safeNombre + '\')" title="Eliminar este turno de disponibilidad">🗑️ Eliminar</button>';

      tr.innerHTML = '<td style="padding:10px 14px;">' + cedulaHtml + '</td>' +
                     '<td style="padding:10px 14px;">' + celularHtml + '</td>' +
                     '<td style="padding:10px 14px;">' + tecHtml + '</td>' +
                     '<td style="padding:10px 14px;">' + fechasHtml + '</td>' +
                     '<td style="padding:10px 14px; text-align:center;">' + mesHtml + '</td>' +
                     '<td style="padding:10px 14px; text-align:center;">' + estadoHtml + '</td>' +
                     '<td style="padding:10px 14px; text-align:center;">' + accionesHtml + '</td>';

      tbody.appendChild(tr);
    });
  }

  // Filtrado reactivo en tiempo real
  $('filtroRolDisp') && ($('filtroRolDisp').oninput = renderTablaRol);

  // Limpiar turnos dummy sin contacto
  $('btnLimpiarTurnosDummy') && ($('btnLimpiarTurnosDummy').onclick = function() {
    if (!confirm('¿Deseas eliminar los turnos antiguos que no tengan cédula ni celular registrado?')) return;
    fetch('/api/disponibilidad/limpiar-antiguos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    }).then(function(r){ return r.json(); }).then(function(res) {
      if (res && res.ok) {
        alert(res.mensaje || 'Turnos sin contacto eliminados.');
        cargarDisponibilidad(function() {
          renderTablaRol();
          renderGrid();
        });
      }
    }).catch(function(err){
      alert('Error: ' + err.message);
    });
  });

  $('btnAbrirRolDisponibilidad') && ($('btnAbrirRolDisponibilidad').onclick = abrirModalRol);
  $('btnBannerVerRol') && ($('btnBannerVerRol').onclick = abrirModalRol);
  $('btnCerrarRolDisp') && ($('btnCerrarRolDisp').onclick = cerrarModalRol);
  $('btnCerrarRolDisp2') && ($('btnCerrarRolDisp2').onclick = cerrarModalRol);
  $('modalRolDisponibilidadBack') && ($('modalRolDisponibilidadBack').onclick = function(e){
    if (e.target === $('modalRolDisponibilidadBack')) cerrarModalRol();
  });

  // Guardar nuevo turno
  var btnGuardarRol = $('btnGuardarNuevoRol');
  if (btnGuardarRol) {
    btnGuardarRol.onclick = function() {
      var cedula = ($('nuevoRolCedula').value || '').trim();
      var celular = ($('nuevoRolCelular').value || '').trim();
      var usuario = ($('nuevoRolUsuario').value || '').trim();
      var inicio = ($('nuevoRolInicio').value || '').trim();
      var fin = ($('nuevoRolFin').value || '').trim();
      var msgBox = $('rolMsg');

      if (!usuario || !inicio || !fin) {
        msgBox.style.display = 'block';
        msgBox.style.color = '#ef4444';
        msgBox.textContent = 'Por favor completa el nombre y las fechas de inicio y fin.';
        return;
      }

      api('/api/disponibilidad/guardar-rol', {
        rol: [{ cedula: cedula, celular: celular, usuario: usuario, inicio: inicio, fin: fin, mes: 'OCTUBRE', notas: 'Rol Oficial' }]
      }).then(function(res){
        if (res && res.ok) {
          msgBox.style.display = 'block';
          msgBox.style.color = '#10b981';
          msgBox.textContent = '✔ Turno guardado exitosamente.';
          $('nuevoRolCedula').value = '';
          $('nuevoRolCelular').value = '';
          $('nuevoRolUsuario').value = '';
          $('nuevoRolInicio').value = '';
          $('nuevoRolFin').value = '';
          cargarDisponibilidad(function(){
            renderTablaRol();
            renderGrid();
          });
          setTimeout(function(){ msgBox.style.display = 'none'; }, 2500);
        } else {
          msgBox.style.display = 'block';
          msgBox.style.color = '#ef4444';
          msgBox.textContent = 'Error guardando turno: ' + (res.error || 'Desconocido');
        }
      }).catch(function(err){
        msgBox.style.display = 'block';
        msgBox.style.color = '#ef4444';
        msgBox.textContent = 'Error: ' + err.message;
      });
    };
  }

  // Si la URL viene con ?verRol=1 abrir modal automáticamente
  if (window.location.search.indexOf('verRol=1') !== -1) {
    setTimeout(abrirModalRol, 400);
  }

  cargarDisponibilidad(function(){ renderGrid(); });
  cargar();
  cargarProximos();
  actualizarStatsFinde();
})();
</script>
