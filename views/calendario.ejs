  /* ----- FILTROS DE PRÓXIMOS EVENTOS ----- */
  var filtroTipoActivo = 'todos';
  document.querySelectorAll('#filtrosProximos button').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('#filtrosProximos button').forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');
      filtroTipoActivo = this.dataset.tipo;
      aplicarFiltroProximos();
    });
  });

  function aplicarFiltroProximos() {
    var items = document.querySelectorAll('#proximos .prox');
    items.forEach(function(it){
      if (filtroTipoActivo === 'todos') {
        it.style.display = '';
      } else {
        var dot = it.querySelector('.dot');
        it.style.display = (dot && dot.classList.contains(filtroTipoActivo)) ? '' : 'none';
      }
    });
  }

  function cargarProximos(){
    api('/calendario/api/proximos').then(function(res){
      var box = $('proximos'); box.textContent = '';
      var lista = Array.isArray(res) ? res : (res && Array.isArray(res.eventos) ? res.eventos : []);
      if (!lista || lista.length === 0) {
        box.innerHTML = '<div style="color:var(--muted); font-size:12px; padding:8px;">No hay eventos en los próximos 30 días.</div>';
        return;
      }
      lista.forEach(function(ev){
        var d = el('div', 'prox');
        var head = el('div', 'prox-head');
        var dotWrap = el('div');
        dotWrap.style.display = 'flex';
        dotWrap.style.alignItems = 'center';
        dotWrap.style.gap = '6px';
        dotWrap.appendChild(el('span', 'dot ' + ev.tipo));
        dotWrap.appendChild(el('span', 'prox-tit', (ev.serie_id ? '🔄 ' : '') + ev.titulo));
        head.appendChild(dotWrap);

        var badge = el('span', '', ev.todo_el_dia ? 'Todo el día' : hora12(ev.hora));
        badge.style.fontSize = '11px'; badge.style.color = 'var(--muted)';
        head.appendChild(badge);
        d.appendChild(head);

        var p = ev.fecha.split('-');
        var fechaStr = +p[2] + ' ' + MESES[+p[1] - 1];
        var foot = el('div', '', fechaStr);
        foot.style.fontSize = '11px'; foot.style.color = 'var(--muted)'; foot.style.marginTop = '2px';
        d.appendChild(foot);

        d.addEventListener('click', function(){ abrir(ev); });
        box.appendChild(d);
      });
      aplicarFiltroProximos();
    }).catch(function(e){ console.error('Error cargando próximos:', e); });
  }

  /* ----- FORMULARIO NUEVO / EDITAR EVENTO ----- */
  function sincronizarTodoDia(){
    var checked = $('fTodo').checked;
    $('fHora').disabled = checked;
    $('fHora').style.opacity = checked ? '0.4' : '1';
  }
  function sincronizarRepetir(){
    var v = $('fRep').value;
    $('repOpc').hidden = (v === 'no');
    $('repDias').hidden = (v !== 'semanal');
    if (v !== 'no' && !$('fHasta').value && $('fFecha').value) {
      var p = $('fFecha').value.split('-'), d = new Date(+p[0], +p[1] - 1 + 3, +p[2]);
      $('fHasta').value = ymd(d);
    }
  }
  function marcarDias(dSem){
    document.querySelectorAll('.dsem').forEach(function(c){
      c.checked = (+c.value === dSem);
    });
  }
  function mostrarError(msg){ $('evErr').textContent = msg || ''; }

  function abrir(ev, fecha){
    editandoId = ev ? ev.id : null;
    $('evTitulo').textContent = ev ? 'Editar evento' : 'Nuevo evento';
    $('fTitulo').value = ev ? ev.titulo : '';
    $('fTipo').value = ev ? ev.tipo : 'reunion';
    $('fAvisar').value = ev ? String(ev.avisar_min) : '0';
    $('fFecha').value = ev ? ev.fecha : (fecha || ymd(new Date()));
    $('fHora').value = ev && !ev.todo_el_dia ? ev.hora : '09:00';
    $('fTodo').checked = ev ? !!ev.todo_el_dia : false;
    $('fDesc').value = ev ? (ev.descripcion || '') : '';

    if (ev) {
      $('evEditActions').style.display = 'block';
      $('btnEliminar').style.display = 'inline-flex';
      $('btnSerie').style.display = ev.serie_id ? 'inline-flex' : 'none';
      $('btnSerieFinde').style.display = ev.serie_id ? 'inline-flex' : 'none';
      $('btnGuardar').textContent = 'Guardar cambios';
    } else {
      $('evEditActions').style.display = 'none';
      $('btnEliminar').style.display = 'none';
      $('btnSerie').style.display = 'none';
      $('btnSerieFinde').style.display = 'none';
      $('btnGuardar').textContent = 'Crear evento';
    }

    $('repBox').hidden = !!ev;
    $('fRep').value = 'no'; $('fHasta').value = ''; marcarDias(-1);
    sincronizarRepetir();
    sincronizarTodoDia(); mostrarError('');
    $('evBack').classList.add('open');
    setTimeout(function(){ $('fTitulo').focus(); }, 30);
  }

  function cerrar(){ $('evBack').classList.remove('open'); }
  $('btnNuevo').addEventListener('click', function(){ abrir(null); });
  $('btnCancelar').addEventListener('click', cerrar);
  $('evBack').addEventListener('mousedown', function(e){ if (e.target === $('evBack')) cerrar(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') { cerrar(); cerrarDiaModal(); cerrarLimpieza(); } });
  $('fTodo').addEventListener('change', sincronizarTodoDia);
  $('fRep').addEventListener('change', sincronizarRepetir);
  $('fFecha').addEventListener('change', function(){
    if ($('fRep').value === 'semanal' && this.value) marcarDias(diaSemana(this.value));
  });
  $('fTitulo').addEventListener('keydown', function(e){ if (e.key === 'Enter') $('btnGuardar').click(); });

  $('btnGuardar').addEventListener('click', function(){
    var cuerpo = {
      titulo: $('fTitulo').value, tipo: $('fTipo').value, avisar_min: $('fAvisar').value,
      fecha: $('fFecha').value, hora: $('fHora').value, todo_el_dia: $('fTodo').checked,
      descripcion: $('fDesc').value
    };
    if (!editandoId && $('fRep').value !== 'no') {
      cuerpo.repetir = $('fRep').value;
      cuerpo.hasta = $('fHasta').value;
      cuerpo.dias = Array.prototype.map.call(document.querySelectorAll('.dsem:checked'), function(c){ return c.value; });
      if (!cuerpo.hasta) return mostrarError('Elige hasta qué fecha se repite.');
      if (cuerpo.repetir === 'semanal' && !cuerpo.dias.length) return mostrarError('Marca al menos un día de la semana.');
    }
    if (!cuerpo.titulo.trim()) return mostrarError('Escribe un título para el evento.');
    if (!cuerpo.fecha) return mostrarError('Elige una fecha.');
    if (!cuerpo.todo_el_dia && !cuerpo.hora) return mostrarError('Elige una hora.');

    var url = editandoId ? '/calendario/api/' + editandoId + '/actualizar' : '/calendario/api/agregar';
    var btn = $('btnGuardar'); btn.disabled = true;
    api(url, { body: cuerpo }).then(function(r){
      cerrar();
      var p = cuerpo.fecha.split('-'); anio = +p[0]; mes = +p[1] - 1;
      cargar(); cargarProximos();
      actualizarStatsFinde();
    }).catch(function(err){ mostrarError(err.message); })
      .then(function(){ btn.disabled = false; });
  });

