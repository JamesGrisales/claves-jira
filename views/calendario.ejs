  /* ----- NOTIFICADOR TOAST ELEGANTE ----- */
  var toastTimeout = null;
  function mostrarToastOutlook(titulo, mensaje) {
    var toast = $('outlookSyncToast');
    if (!toast) return;
    $('toastSyncTitle').textContent = titulo || '¡Outlook Sincronizado!';
    $('toastSyncMsg').textContent = mensaje || 'Se actualizaron tus reuniones y citas correctamente.';
    toast.style.display = 'block';
    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(function() {
      toast.style.display = 'none';
    }, 4500);
