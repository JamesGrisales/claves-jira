  /* ----- BOTÓN DE SINCRONIZACIÓN CON OUTLOOK DESKTOP ----- */
  $('btnSyncOutlook').addEventListener('click', function() {
    var btn = this;
    if (btn.classList.contains('loading')) return;

    btn.classList.add('loading');
    btn.classList.remove('success');
    var txtSpan = btn.querySelector('.sync-txt');
    var iconSpan = btn.querySelector('.sync-icon');
    var origTxt = txtSpan.textContent;
    txtSpan.textContent = 'Sincronizando con Outlook...';
    iconSpan.textContent = '⏳';

    api('/calendario/api/sincronizar-outlook', { method: 'POST' }).then(function(res) {
      btn.classList.remove('loading');
      if (res.error) {
        txtSpan.textContent = origTxt;
        iconSpan.textContent = '🔄';
        alert('Aviso de Outlook: ' + res.error);
        return;
      }

      // Estado de éxito en el botón
      btn.classList.add('success');
      txtSpan.textContent = '¡Sincronizado!';
      iconSpan.textContent = '✔';

      var total = res.total || 0;
      var nuevos = res.insertados || 0;
      var msg = total + ' reuniones examinadas: ' + nuevos + ' nuevas y ' + (res.actualizados || 0) + ' actualizadas.';
      mostrarToastOutlook('✔ ¡Outlook Sincronizado con Éxito!', msg);

      cargar();
      cargarProximos();
      actualizarStatsFinde();

      setTimeout(function() {
        btn.classList.remove('success');
        txtSpan.textContent = origTxt;
        iconSpan.textContent = '🔄';
      }, 4000);
    }).catch(function(err) {
      btn.classList.remove('loading');
      txtSpan.textContent = origTxt;
      iconSpan.textContent = '🔄';
      alert('Error al sincronizar con Outlook: ' + err.message);
    });
  });

