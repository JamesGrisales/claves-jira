    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
      <span style="font-size:12px; color:var(--muted);">
        💡 Puedes eliminar cualquier turno con el botón <strong>🗑️ Eliminar</strong> si te equivocas.
      </span>
      <button type="button" class="secondary" id="btnCerrarRolDisp2" style="padding:7px 18px; font-weight:700;">
        Cerrar
      </button>
    </div>
  </div>
</div>

<!-- MODAL DE LIMPIEZA Y BORRADO MASIVO -->
<div class="ev-backdrop" id="modalLimpiezaBack">
  <div class="ev-modal" style="width:min(580px, 98%);" role="dialog" aria-modal="true" aria-labelledby="limpiezaTitulo">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <h3 id="limpiezaTitulo" style="margin:0; font-size:18px; color:var(--text); display:flex; align-items:center; gap:8px;">
        <span>🧹</span> <span>Gestión y Borrado Masivo de Eventos</span>
      </h3>
      <button type="button" class="iconbtn" id="btnCerrarLimpieza" style="background:none; border:none; font-size:18px; color:var(--muted); cursor:pointer;">✕</button>
    </div>
    <p style="font-size:13px; color:var(--muted); margin-bottom:16px;">
      Herramientas para purgar eventos masivos no deseados o limpiar repeticiones en fines de semana de forma segura.
    </p>

    <!-- Tarjeta 1: Eliminar Fines de Semana (Sábados y Domingos) -->
    <div class="batch-card" style="border-color:rgba(239,68,68,0.35); background:rgba(239,68,68,0.04);">
      <h4 style="color:#ef4444;">
        <span>🗓️</span> <span>Eliminar eventos de Fines de Semana (Sáb y Dom)</span>
      </h4>
      <p>
        Elimina todos los eventos programados en sábados o domingos. Ideal para limpiar series que se crearon erróneamente en fines de semana, conservando intactos los días hábiles (lunes a viernes).
      </p>
      <div class="batch-actions">
        <select id="selAmbitoFinde" style="padding:6px 10px; font-size:12.5px; border-radius:8px; background:var(--panel); border:1px solid var(--panel-edge); color:var(--text);">
          <option value="todo">En todo el calendario (histórico completo)</option>
          <option value="mes">Solo en el mes visible actualmente</option>
        </select>
        <button type="button" class="danger" id="btnEjecutarBorradoFinde" style="padding:7px 14px; font-size:12.5px; font-weight:700;">
          🗑️ Eliminar eventos de fin de semana
        </button>
      </div>
    </div>

    <!-- Tarjeta 2: Purgar por Categoría -->
    <div class="batch-card">
      <h4>
        <span>🏷️</span> <span>Eliminar eventos por Categoría</span>
      </h4>
      <p>
        Elimina de forma masiva todos los eventos de una categoría específica en el mes visible actualmente.
      </p>
      <div class="batch-actions">
        <select id="selTipoBatch" style="padding:6px 10px; font-size:12.5px; border-radius:8px; background:var(--panel); border:1px solid var(--panel-edge); color:var(--text);">
          <option value="recordatorio">Solo Recordatorios (🟢)</option>
          <option value="especial">Solo Fechas Especiales (🟠)</option>
          <option value="reunion">Solo Reuniones (🔵)</option>
        </select>
        <button type="button" class="secondary" id="btnEjecutarBorradoTipo" style="padding:7px 14px; font-size:12.5px; font-weight:700;">
          Eliminar de este mes
        </button>
      </div>
    </div>

    <div id="batchMsg" style="display:none; padding:10px 14px; border-radius:10px; font-size:13px; font-weight:700; margin-top:12px;"></div>

    <div style="display:flex; justify-content:flex-end; margin-top:16px;">
      <button type="button" class="secondary" id="btnVolverLimpieza">Cerrar</button>
    </div>
  </div>
</div>


<!-- MODAL / DRAWER INSPECTOR PARA GESTIONAR EVENTOS DE UN DÍA ESPECÍFICO -->
<div class="ev-backdrop" id="modalDiaBack">
  <div class="ev-modal" style="width:min(520px, 98%);" role="dialog" aria-modal="true">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <div>
        <h3 id="diaModalTitulo" style="margin:0; font-size:17px; color:var(--text);">Eventos del Día</h3>
        <span id="diaModalSub" style="font-size:12px; color:var(--muted); font-weight:600;"></span>
      </div>
      <button type="button" class="iconbtn" id="btnCerrarDiaModal" style="background:none; border:none; font-size:18px; color:var(--muted); cursor:pointer;">✕</button>
    </div>

    <div id="diaModalLista" class="day-events-list"></div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px; gap:8px; flex-wrap:wrap;">
      <button type="button" class="danger btn-sm" id="btnEliminarTodosDelDia" style="font-weight:700;">🗑️ Borrar todos los de este día</button>
      <div style="display:flex; gap:8px;">
        <button type="button" class="secondary btn-sm" id="btnAgregarEnDia">+ Agregar evento</button>
        <button type="button" class="secondary btn-sm" id="btnCerrarDiaModal2">Listo</button>
      </div>
    </div>
  </div>
</div>


<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };
  var MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  var DIAS = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
  var DIAS_COMPLETOS = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
  var hoy = new Date();
  var anio = hoy.getFullYear(), mes = hoy.getMonth();
  var eventos = [];
  var editandoId = null;
  var diaInspectorFecha = null;
  var diaInspectorEventos = [];

  var turnosDisponibilidad = [];
  function cargarDisponibilidad(cb) {
    api('/api/disponibilidad/estado').then(function(res) {
      if (res && res.ok) {
        turnosDisponibilidad = res.turnos || [];
        var banner = $('bannerSemanaDisponibilidad');
        if (banner) {
          if (res.enDisponibilidad && res.turno) {
            banner.style.display = 'flex';
            var pIni = res.turno.inicio.split('-'), pFin = res.turno.fin.split('-');
            var mesesNom = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
            var descTxt = 'Del ' + (+pIni[2]) + ' de ' + mesesNom[+pIni[1]-1] + ' al ' + (+pFin[2]) + ' de ' + mesesNom[+pFin[1]-1] + ' de ' + pFin[0] + ' · Tienes asignado el turno de soporte de guardia.';
            $('bannerDispDesc').textContent = descTxt;
          } else {
            banner.style.display = 'none';
          }
        }
      }
      if (cb) cb();
    }).catch(function(e) { if (cb) cb(); });
  }


  /* ----- CÁLCULO DE FESTIVOS DE COLOMBIA (Ley Emiliani) ----- */
  function pascua(y) {
    var a = y % 19, b = Math.floor(y / 100), c = y % 100;
    var d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25);
    var g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;
    var i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7;
    var m = Math.floor((a + 11 * h + 22 * l) / 451);
    var mesP = Math.floor((h + l - 7 * m + 114) / 31) - 1;
    var diaP = ((h + l - 7 * m + 114) % 31) + 1;
    return new Date(y, mesP, diaP);
  }
  function proximoLunes(d) {
    var copia = new Date(d.getTime());
    var diaSem = copia.getDay();
    if (diaSem === 1) return copia;
    var faltan = (diaSem === 0) ? 1 : (8 - diaSem);
    copia.setDate(copia.getDate() + faltan);
    return copia;
  }
  function sumarDias(d, n) {
    var copia = new Date(d.getTime());
    copia.setDate(copia.getDate() + n);
    return copia;
  }
  function obtenerFestivosColombia(y) {
    var p = pascua(y);
    var f = [
      { f: new Date(y, 0, 1), nombre: 'Año Nuevo' },
      { f: proximoLunes(new Date(y, 0, 6)), nombre: 'Día de los Reyes Magos' },
      { f: proximoLunes(new Date(y, 2, 19)), nombre: 'Día de San José' },
      { f: sumarDias(p, -3), nombre: 'Jueves Santo' },
      { f: sumarDias(p, -2), nombre: 'Viernes Santo' },
      { f: new Date(y, 4, 1), nombre: 'Día del Trabajo' },
      { f: proximoLunes(sumarDias(p, 40)), nombre: 'Ascensión del Señor' },
      { f: proximoLunes(sumarDias(p, 60)), nombre: 'Corpus Christi' },
      { f: proximoLunes(sumarDias(p, 68)), nombre: 'Sagrado Corazón de Jesús' },
      { f: proximoLunes(new Date(y, 5, 29)), nombre: 'San Pedro y San Pablo' },
      { f: new Date(y, 6, 20), nombre: 'Día de la Independencia' },
      { f: new Date(y, 7, 7), nombre: 'Batalla de Boyacá' },
      { f: proximoLunes(new Date(y, 7, 15)), nombre: 'Asunción de la Virgen' },
      { f: proximoLunes(new Date(y, 9, 12)), nombre: 'Día de la Raza' },
      { f: proximoLunes(new Date(y, 10, 1)), nombre: 'Todos los Santos' },
      { f: proximoLunes(new Date(y, 10, 11)), nombre: 'Independencia de Cartagena' },
      { f: new Date(y, 11, 8), nombre: 'Inmaculada Concepción' },
      { f: new Date(y, 11, 25), nombre: 'Navidad' }
    ];
    var mapa = {};
    f.forEach(function(item) { mapa[ymd(item.f)] = item; });
    return mapa;
  }
  var festivosCache = {};
  function getFestivosDelAnio(y) {
    if (!festivosCache[y]) festivosCache[y] = obtenerFestivosColombia(y);
    return festivosCache[y];
  }
  function esFestivo(fechaStr) {
    var p = fechaStr.split('-');
    var map = getFestivosDelAnio(+p[0]);
    return map[fechaStr] || null;
  }

  /* ----- HELPERS DE FECHA Y TEXTO ----- */
  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function ymd(d){ return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
  function diaSemana(fechaStr){
    var p = fechaStr.split('-');
    return new Date(+p[0], +p[1] - 1, +p[2]).getDay();
  }
  function hora12(hhmm){
    if (!hhmm) return '';
    var p = hhmm.split(':'), h = +p[0], m = p[1] || '00';
    var suf = h >= 12 ? 'p. m.' : 'a. m.';
    h = h % 12; if (h === 0) h = 12;
    return h + ':' + m + ' ' + suf;
  }
  function el(tag, cls, txt){
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (txt !== undefined) e.textContent = txt;
    return e;
  }

  function api(url, opt){
    opt = opt || {};
    var headers = Object.assign({ 'Content-Type': 'application/json' }, opt.headers || {});
    var init = { method: opt.method || (opt.body ? 'POST' : 'GET'), headers: headers };
    if (opt.body) init.body = JSON.stringify(opt.body);
    return fetch(url, init).then(function(r){
      return r.json().then(function(d){
        if (!r.ok || d.ok === false) throw new Error(d.error || ('Error HTTP ' + r.status));
        return d;
      });
    });
  }

  /* ----- GESTOR DE TEMA / DISEÑO (MENÚ VISUAL ELEGANTE) ----- */
  var temasConfig = {
    'bento':   { nombre: 'Bento Executive', icon: '🍱' },
    'slate':   { nombre: 'Linear & Slate Pro', icon: '💻' },
    'aurora':  { nombre: 'Aurora Glassmorphism', icon: '🌌' },
    'fintech': { nombre: 'Emerald FinTech', icon: '📊' },
    'cyber':   { nombre: 'Cyberpunk Tactical', icon: '⚡' },
    'clasico': { nombre: 'Clásico Bóveda', icon: '🏛️' }
  };

  function aplicarTema(tema) {
    var validos = ['bento', 'slate', 'aurora', 'fintech', 'cyber', 'clasico'];
    if (validos.indexOf(tema) === -1) tema = 'bento';
    $('calAppRoot').setAttribute('data-cal-theme', tema);
    if ($('selTemaCal')) $('selTemaCal').value = tema;
    localStorage.setItem('cal_selected_theme', tema);

    // Actualizar disparador visual con icono y nombre elegante
    var conf = temasConfig[tema] || temasConfig['bento'];
    if ($('themeActiveOrb')) $('themeActiveOrb').textContent = conf.icon;
    if ($('themeActiveName')) $('themeActiveName').textContent = conf.nombre;

    // Actualizar checkmark de selección activa en el menú
    document.querySelectorAll('.theme-opt').forEach(function(btn) {
      if (btn.getAttribute('data-theme') === tema) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  // Toggle del menú desplegable interactivo
  var btnTrig = $('btnThemeTrigger');
  var menuEl = $('calThemeMenu');
  if (btnTrig && menuEl) {
    btnTrig.onclick = function(e) {
      e.stopPropagation();
      var abierto = menuEl.style.display === 'flex';
      menuEl.style.display = abierto ? 'none' : 'flex';
      btnTrig.classList.toggle('open', !abierto);
      btnTrig.setAttribute('aria-expanded', !abierto);
    };

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#calThemeDropdown')) {
        menuEl.style.display = 'none';
        btnTrig.classList.remove('open');
        btnTrig.setAttribute('aria-expanded', 'false');
      }
    });

    document.querySelectorAll('.theme-opt').forEach(function(btn) {
      btn.onclick = function(e) {
        e.stopPropagation();
        var t = this.getAttribute('data-theme');
        aplicarTema(t);
        menuEl.style.display = 'none';
        btnTrig.classList.remove('open');
        btnTrig.setAttribute('aria-expanded', 'false');
      };
    });
  }

  var temaGuardado = localStorage.getItem('cal_selected_theme') || 'bento';
  aplicarTema(temaGuardado);

  /* ----- ACTUALIZAR ESTADÍSTICAS EN VIVO DE FINES DE SEMANA ----- */
  function actualizarStatsFinde() {
    api('/calendario/api/stats-fines-de-semana').then(function(res) {
      if (!res.stats) return;
      var w = res.stats.weekend || 0;
      var tot = res.stats.total || 0;
      var l = res.stats.weekday || 0;
      $('badgeFindeCount').textContent = w;
      $('kpiWeekend').textContent = w;
      $('kpiTotal').textContent = tot;
      $('kpiWeekday').textContent = l;
      if (w === 0) {
        $('badgeFindeCount').style.background = '#10b981';
        $('kpiCardWeekend').style.borderColor = 'rgba(16,185,129,0.3)';
      } else {
        $('badgeFindeCount').style.background = '#ef4444';
        $('kpiCardWeekend').style.borderColor = 'rgba(239,68,68,0.35)';
      }
    }).catch(function(e) { console.error('Error stats:', e); });
  }

  /* ----- RANGO DEL MES Y GRID ----- */
  function rango(){
    var primerDia = new Date(anio, mes, 1);
    var dia1 = (primerDia.getDay() + 6) % 7; // Lun=0 .. Dom=6
    var inicio = new Date(anio, mes, 1 - dia1);
    var fin = new Date(inicio);
    fin.setDate(fin.getDate() + 41);
    return { inicio: inicio, fin: fin };
  }

  function renderGrid(){
    $('mesTitulo').textContent = MESES[mes] + ' ' + anio;
    var g = $('grid'); g.textContent = '';

    // Encabezados de días
    DIAS.forEach(function(d, idx){
      var isFinde = (idx === 5 || idx === 6);
      g.appendChild(el('div', 'cal-head' + (isFinde ? ' finde-head' : ''), d));
    });

    var r = rango(), hoyStr = ymd(new Date());
    var porDia = {};
    var evList = Array.isArray(eventos) ? eventos : (eventos && Array.isArray(eventos.eventos) ? eventos.eventos : []);
    evList.forEach(function(e){ if (e && e.fecha) (porDia[e.fecha] = porDia[e.fecha] || []).push(e); });

    for (var i = 0; i < 42; i++) {
      var d = new Date(r.inicio); d.setDate(r.inicio.getDate() + i);
      var f = ymd(d);
      var festivo = esFestivo(f);
      var dow = d.getDay(); // 0 = Dom, 6 = Sáb
      var isFinde = (dow === 0 || dow === 6);

      // Verificar si este día cae dentro de un turno de disponibilidad
      var turnoDisp = turnosDisponibilidad.find(function(t){ return f >= t.inicio && f <= t.fin; });
      var esMiTurno = turnoDisp && /james|grisales/i.test(turnoDisp.usuario || '');

      var cCls = 'cal-day' + (d.getMonth() !== mes ? ' otro' : '') + (f === hoyStr ? ' hoy' : '');
      if (isFinde) cCls += ' fin-semana';
      if (festivo) cCls += ' festivo';
      if (turnoDisp) {
        cCls += esMiTurno ? ' en-disponibilidad-semana' : ' en-disponibilidad-equipo';
      }

      var c = el('div', cCls);
      c.dataset.fecha = f;

      var head = el('div', 'cal-day-head');
      head.appendChild(el('span', 'num', d.getDate()));
      if (turnoDisp) {
        if (esMiTurno) {
          var dispBadge = el('span', 'badge-dia-disp', '⚡ MI DISP');
          dispBadge.title = 'Tu guardia activa: James Grisales · Cel: ' + (turnoDisp.celular || '3042497379');
          head.appendChild(dispBadge);
        } else {
          var eqBadge = el('span', 'badge-dia-disp-equipo', '🛡️ DISP');
          eqBadge.title = 'Guardia: ' + turnoDisp.usuario + (turnoDisp.celular ? ' · Cel: ' + turnoDisp.celular : '');
          head.appendChild(eqBadge);
        }
      }
      if (festivo) {
        c.title = '🇨🇴 Festivo en Colombia: ' + festivo.nombre;
        var badge = el('span', 'festivo-badge');
        badge.textContent = '🎉';
        badge.title = 'Festivo: ' + festivo.nombre;
        head.appendChild(badge);
      } else if (isFinde) {
        var fBadge = el('span', '', dow === 6 ? 'Sáb' : 'Dom');
        fBadge.style.fontSize = '9.5px';
        fBadge.style.color = '#ef4444';
        fBadge.style.fontWeight = '800';
        head.appendChild(fBadge);
      }
      c.appendChild(head);

      if (festivo) {
        var fChip = el('div', 'chip festivo');
        fChip.title = '🎉 Festivo en Colombia: ' + festivo.nombre;
        fChip.appendChild(el('span', 'festivo-chip-ico', '🎉 '));
        fChip.appendChild(el('span', 'festivo-chip-txt', festivo.nombre));
        c.appendChild(fChip);
      }

      var lista = porDia[f] || [];
      var maxEv = festivo ? 2 : 3;
      lista.slice(0, maxEv).forEach(function(e){
        var b = el('button', 'chip ' + e.tipo);
        b.type = 'button'; b.dataset.id = e.id;
        if (e.es_outlook) b.classList.add('outlook-chip');
        var orgTxt = e.organizador ? ' · Organiza: ' + e.organizador : '';
        b.title = (e.es_outlook ? '[Reunión Outlook] ' : '') + e.titulo + (e.todo_el_dia ? '' : ' · ' + hora12(e.hora)) + orgTxt + (e.serie_id ? ' (Serie recurrente)' : '');
        if (!e.todo_el_dia) b.appendChild(el('span', 'h', hora12(e.hora).replace(' a. m.', 'a').replace(' p. m.', 'p')));
        var prefix = e.es_outlook ? '📧 ' : (e.serie_id ? '🔄 ' : '');
        b.appendChild(document.createTextNode(prefix + e.titulo));
        c.appendChild(b);
      });

      if (lista.length > maxEv) {
        var masEl = el('div', 'mas', '+' + (lista.length - maxEv) + ' más');
        masEl.title = 'Ver todos los ' + lista.length + ' eventos de este día';
        c.appendChild(masEl);
      }

      g.appendChild(c);
    }
  }

  function cargar(){
    var r = rango();
    api('/calendario/api/eventos?desde=' + ymd(r.inicio) + '&hasta=' + ymd(r.fin)).then(function(res){
      eventos = Array.isArray(res) ? res : (res && Array.isArray(res.eventos) ? res.eventos : []);
      renderGrid();
      actualizarStatsFinde();
    }).catch(function(err){
      console.error('Error cargando calendario:', err);
    });
  }

  /* ----- INTERACCIÓN CON CELDAS Y EVENTOS DEL DÍA ----- */
  $('grid').addEventListener('click', function(e){
    var chip = e.target.closest('.chip');
    if (chip) {
      if (chip.classList.contains('festivo')) {
        var dFest = chip.closest('.cal-day');
        if (dFest) abrir(null, dFest.dataset.fecha);
        return;
      }
      e.stopPropagation();
      var ev = eventos.filter(function(x){ return String(x.id) === chip.dataset.id; })[0];
      if (ev) abrir(ev);
      return;
    }

    var dia = e.target.closest('.cal-day');
    if (!dia) return;
    var f = dia.dataset.fecha;
    var evsDia = eventos.filter(function(x){ return x.fecha === f; });

    // Si tiene eventos o se dio clic en "+X más", abrir el inspector del día
    if (evsDia.length > 0 || e.target.closest('.mas')) {
      abrirDiaModal(f, evsDia);
    } else {
      abrir(null, f);
    }
  });

  /* ----- INSPECTOR DE DÍA MODAL (modalDiaBack) ----- */
  function abrirDiaModal(fecha, evs) {
    diaInspectorFecha = fecha;
    diaInspectorEventos = evs || [];
    var p = fecha.split('-');
    var fechaObj = new Date(+p[0], +p[1] - 1, +p[2]);
    var nombreDia = DIAS_COMPLETOS[fechaObj.getDay()];
    var esFinde = (fechaObj.getDay() === 0 || fechaObj.getDay() === 6);

    $('diaModalTitulo').textContent = nombreDia + ', ' + +p[2] + ' de ' + MESES[+p[1] - 1] + ' de ' + p[0];
    $('diaModalSub').textContent = (esFinde ? '⚠️ Fin de semana · ' : '') + evs.length + ' evento(s) programado(s)';
    $('btnEliminarTodosDelDia').hidden = (evs.length === 0);

    var listaEl = $('diaModalLista');
    listaEl.textContent = '';

    if (evs.length === 0) {
      listaEl.innerHTML = '<div style="text-align:center; padding:16px; color:var(--muted); font-size:13px;">No hay eventos en este día.</div>';
    } else {
      evs.forEach(function(ev) {
        var item = el('div', 'day-ev-item');
        var info = el('div', 'day-ev-info');
        var dot = el('span', 'dot ' + ev.tipo);
        var timeTxt = ev.todo_el_dia ? 'Todo el día' : hora12(ev.hora);
        var titBox = el('div');
