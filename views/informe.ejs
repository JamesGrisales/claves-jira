        <!-- COL 2: FIRMA INSTITUCIONAL JAIVANÁ -->
        <div style="background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:12px; padding:12px 14px; display:flex; flex-direction:column; justify-content:space-between;">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <div style="color:var(--muted); font-size:11px; text-transform:uppercase; font-weight:700; letter-spacing:0.5px;">Firma del Correo (Outlook):</div>
              <span style="font-size:11px; color:var(--muted);">Banner Oficial</span>
            </div>
            <div style="font-weight:700; color:var(--text); font-size:13.5px;" id="firmanteNombre">James Grisales</div>
            <div style="color:var(--muted); font-size:11.5px; margin-bottom:8px;">Analista de Soporte</div>
          </div>
          <div style="border-radius:6px; overflow:hidden; border:1px solid rgba(255,255,255,0.1); background:#333; box-shadow:0 2px 8px rgba(0,0,0,0.25);">
