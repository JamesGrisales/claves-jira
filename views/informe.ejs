/* ---------- Envío de Informe por Correo (Outlook) ---------- */
(function(){
  var KEY_SMTP = 'boveda_informe_smtp';
  var KEY_CONTACTS_PARA = 'boveda_informe_to';
  var KEY_CONTACTS_CC = 'boveda_informe_cc';

  var mCorreo = $('modalCorreo');
  var bAbrir = $('btnAbrirModalCorreo');
  var bCerrar = $('btnCerrarModalCorreo');
  var bCancelar = $('btnCancelarEmail');
  var bEnviar = $('btnEnviarEmail');

  var tabRedactar = $('tabBtnRedactar');
  var tabConfig = $('tabBtnConfig');
  var pRedactar = $('panelRedactar');
  var pConfig = $('panelConfig');
  var bIrAConfig = $('btnIrAConfig');

  var chipsPara = $('chipsPara'), inputPara = $('inputPara');
  var chipsCc = $('chipsCc'), inputCc = $('inputCc');
  var txtAsunto = $('emailAsunto');
  var txtMensaje = $('emailMensaje');
  var txtErr = $('emailErr');
  var adjNombre = $('emailAdjuntoNombre');
  var firmanteEl = $('firmanteNombre');

  var smtpUser = $('smtpUser'), smtpPass = $('smtpPass'), smtpHost = $('smtpHost'), smtpPort = $('smtpPort'), smtpFromName = $('smtpFromName');
  var btnProbarSmtp = $('btnProbarSmtp'), btnGuardarSmtp = $('btnGuardarSmtp'), smtpStatus = $('smtpStatus');

  var listaPara = [];
  var listaCc = [];

  function cargarSmtpLocal(){
    try {
      var cfg = JSON.parse(localStorage.getItem(KEY_SMTP) || '{}');
      if (smtpUser) smtpUser.value = cfg.user || 'jgrisales@jaivana.co';
      if (smtpPass && cfg.pass) smtpPass.value = cfg.pass;
      if (smtpHost) smtpHost.value = cfg.host || 'smtp.office365.com';
      if (smtpPort) smtpPort.value = cfg.port || '587';
      if (smtpFromName) smtpFromName.value = cfg.fromName || 'James Grisales';
    } catch(e){
      if (smtpUser) smtpUser.value = 'jgrisales@jaivana.co';
    }
  }

  function guardarSmtpLocal(){
    var cfg = {
      user: smtpUser ? smtpUser.value.trim() : 'jgrisales@jaivana.co',
      pass: smtpPass ? smtpPass.value.trim() : '',
      host: smtpHost ? (smtpHost.value.trim() || 'smtp.office365.com') : 'smtp.office365.com',
      port: smtpPort ? (smtpPort.value.trim() || '587') : '587',
      fromName: smtpFromName ? (smtpFromName.value.trim() || 'James Grisales') : 'James Grisales'
    };
    try { localStorage.setItem(KEY_SMTP, JSON.stringify(cfg)); } catch(e){}
    return cfg;
  }

  function getSmtpConfig(){
    try {
      return JSON.parse(localStorage.getItem(KEY_SMTP) || '{}');
    } catch(e){ return {}; }
  }

  function switchTab(aConfig){
    if (aConfig) {
      if (tabConfig) tabConfig.classList.add('active');
      if (tabRedactar) tabRedactar.classList.remove('active');
      if (pConfig) pConfig.style.display = 'flex';
      if (pRedactar) pRedactar.style.display = 'none';
      if (btnIrAConfig) btnIrAConfig.textContent = '← Volver a Redactar';
    } else {
      if (tabRedactar) tabRedactar.classList.add('active');
      if (tabConfig) tabConfig.classList.remove('active');
      if (pRedactar) pRedactar.style.display = 'flex';
      if (pConfig) pConfig.style.display = 'none';
      if (btnIrAConfig) btnIrAConfig.textContent = '⚙ Cuenta';
    }
  }

  if (tabRedactar) tabRedactar.addEventListener('click', function(){ switchTab(false); });
  if (tabConfig) tabConfig.addEventListener('click', function(){ switchTab(true); });
  if (btnIrAConfig) {
    btnIrAConfig.addEventListener('click', function(){
      var enConfig = tabConfig && tabConfig.classList.contains('active');
      switchTab(!enConfig);
    });
  }

  function renderChips(tipo){
    var cont = tipo === 'para' ? chipsPara : chipsCc;
    var arr = tipo === 'para' ? listaPara : listaCc;
    if (!cont) return;
    cont.innerHTML = '';
    arr.forEach(function(email, idx){
      var chip = document.createElement('span'); chip.className = 'em-chip';
      chip.textContent = email;
      var del = document.createElement('button'); del.type = 'button'; del.className = 'em-chip-del'; del.textContent = '✕';
      del.title = 'Quitar';
      del.addEventListener('click', function(e){
        e.stopPropagation();
        arr.splice(idx, 1);
        renderChips(tipo);
        guardarContactos();
      });
      chip.appendChild(del);
      cont.appendChild(chip);
    });
  }

  function agregarEmail(tipo, email){
    email = (email || '').trim().toLowerCase();
    if (!email) return;
    var arr = tipo === 'para' ? listaPara : listaCc;
    if (!arr.includes(email)) {
      arr.push(email);
      renderChips(tipo);
      guardarContactos();
    }
  }

  function setupInputChips(input, tipo){
    if (!input) return;
    input.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ',' || e.key === 'Tab') {
        var v = input.value.replace(/,/g, '').trim();
        if (v) {
          e.preventDefault();
          agregarEmail(tipo, v);
          input.value = '';
        }
      } else if (e.key === 'Backspace' && !input.value) {
        var arr = tipo === 'para' ? listaPara : listaCc;
        if (arr.length) {
          arr.pop();
          renderChips(tipo);
          guardarContactos();
        }
      }
    });
    input.addEventListener('blur', function(){
      var v = input.value.replace(/,/g, '').trim();
      if (v) {
        agregarEmail(tipo, v);
        input.value = '';
      }
    });
  }

  setupInputChips(inputPara, 'para');
  setupInputChips(inputCc, 'cc');

  // Botones de contactos frecuentes
  document.querySelectorAll('.em-quick-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var destino = this.dataset.addTo;
      var email = this.dataset.email;
      agregarEmail(destino, email);
    });
  });

  function guardarContactos(){
    try {
      localStorage.setItem(KEY_CONTACTS_PARA, JSON.stringify(listaPara));
      localStorage.setItem(KEY_CONTACTS_CC, JSON.stringify(listaCc));
    } catch(e){}
  }

  function cargarContactos(){
    try {
      var p = JSON.parse(localStorage.getItem(KEY_CONTACTS_PARA) || 'null');
      var c = JSON.parse(localStorage.getItem(KEY_CONTACTS_CC) || 'null');
      if (Array.isArray(p) && p.length) listaPara = p;
      else listaPara = ['jose.caracas@jaivana.co', 'william.arboleda@jaivana.co', 'natalia.velasquez@jaivana.co'];
      
      if (Array.isArray(c) && c.length) listaCc = c;
      else listaCc = ['juan.mejia@jaivana.co', 'julio.molina@jaivana.co'];
    } catch(e){
      listaPara = ['jose.caracas@jaivana.co', 'william.arboleda@jaivana.co', 'natalia.velasquez@jaivana.co'];
      listaCc = ['juan.mejia@jaivana.co', 'julio.molina@jaivana.co'];
    }
    renderChips('para');
    renderChips('cc');
  }

  function abrirModalCorreo(){
    cargarSmtpLocal();
    cargarContactos();
    switchTab(false);

    var f = $('fecha').value || hoy();
    txtAsunto.value = 'INFORME FACTURACION ELECTRONICA';
    txtMensaje.value = 'Cordial saludo,\n\nAdjunto el informe de documentos electrónicos correspondiente a las empresas.';
    adjNombre.textContent = 'INFORME_DOCUMENTOS_ELECTRONICOS_' + f + '.pdf';
    var tec = $('tecnico').value.trim() || 'James Grisales';
    firmanteEl.textContent = tec;

    txtErr.style.display = 'none';
    txtErr.textContent = '';
    mCorreo.style.display = 'flex';
  }

  function cerrarModalCorreo(){
    mCorreo.style.display = 'none';
  }

  if (bAbrir) bAbrir.addEventListener('click', abrirModalCorreo);
  if (bCerrar) bCerrar.addEventListener('click', cerrarModalCorreo);
  if (bCancelar) bCancelar.addEventListener('click', cerrarModalCorreo);
  if (mCorreo) {
    mCorreo.addEventListener('click', function(e){ if (e.target === mCorreo) cerrarModalCorreo(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && mCorreo.style.display === 'flex') cerrarModalCorreo(); });
  }

  // Guardar SMTP
  if (btnGuardarSmtp) {
    btnGuardarSmtp.addEventListener('click', function(){
      guardarSmtpLocal();
      smtpStatus.textContent = '✓ Configuración guardada';
      smtpStatus.style.color = 'var(--accent)';
      setTimeout(function(){ smtpStatus.textContent = ''; }, 3000);
      toast('Configuración de Outlook guardada');
    });
  }

  // Probar Conexión (Outlook de Escritorio + SMTP)
  if (btnProbarSmtp) {
    btnProbarSmtp.addEventListener('click', async function(){
      var cfg = guardarSmtpLocal();
      btnProbarSmtp.disabled = true;
      smtpStatus.textContent = 'Verificando Outlook…';
      smtpStatus.style.color = 'var(--muted)';
      try {
        var r = await fetch('/informe/probar-smtp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cfg)
        });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Error de conexión');
        
        if (d.advertencia || d.tenantPolicy) {
          smtpStatus.textContent = 'ℹ ' + d.mensaje;
          smtpStatus.style.color = '#38bdf8';
          toast('Outlook de escritorio activo y listo');
        } else {
          smtpStatus.textContent = '✓ ' + (d.mensaje || 'Conexión con Outlook exitosa');
          smtpStatus.style.color = 'var(--ok)';
          toast('Outlook verificado con éxito');
        }
      } catch(err) {
        smtpStatus.textContent = '✕ ' + err.message;
        smtpStatus.style.color = 'var(--danger)';
      } finally {
        btnProbarSmtp.disabled = false;
      }
    });
  }

  // Enviar Informe
  if (bEnviar) {
    bEnviar.addEventListener('click', async function(){
      txtErr.style.display = 'none';
      txtErr.textContent = '';

      // Validar destinatarios
      if (!listaPara.length && inputPara.value.trim()) {
        agregarEmail('para', inputPara.value.trim());
        inputPara.value = '';
      }
      if (!listaPara.length) {
        txtErr.style.display = 'block';
        txtErr.textContent = 'Debes añadir al menos un correo destinatario en "Para".';
        switchTab(false);
        inputPara.focus();
        return;
      }

      var cfg = getSmtpConfig();
      var payload = {
        to: listaPara,
        cc: listaCc,
        asunto: txtAsunto.value.trim() || 'INFORME FACTURACION ELECTRONICA',
        mensaje: txtMensaje.value.trim(),
        reporte: leer(),
        smtp: cfg
      };

      bEnviar.disabled = true;
      bEnviar.textContent = 'Enviando correo…';
      try {
        var res = await fetch('/informe/enviar-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok) {
          if (data.needConfig) {
            switchTab(true);
            throw new Error(data.error || 'Configura tus credenciales de Outlook');
          }
          throw new Error(data.error || 'No se pudo enviar el correo');
        }

        cerrarModalCorreo();
        toast('🚀 ¡Informe enviado con éxito desde jgrisales@jaivana.co!');
      } catch(err) {
        txtErr.style.display = 'block';
        txtErr.textContent = err.message;
      } finally {
        bEnviar.disabled = false;
        bEnviar.textContent = '🚀 Enviar directo desde la App';
      }
    });
  }

  // Abrir directamente en la aplicación instalada de Outlook con el PDF ya adjunto
  var bAbrirApp = $('btnAbrirOutlookApp');
  if (bAbrirApp) {
    bAbrirApp.addEventListener('click', async function(){
      txtErr.style.display = 'none';
      txtErr.textContent = '';

      if (!listaPara.length && inputPara.value.trim()) {
        agregarEmail('para', inputPara.value.trim());
        inputPara.value = '';
      }
      if (!listaPara.length) {
        txtErr.style.display = 'block';
        txtErr.textContent = 'Debes añadir al menos un correo destinatario en "Para".';
        switchTab(false);
        inputPara.focus();
        return;
      }

      var payload = {
        to: listaPara,
        cc: listaCc,
        asunto: txtAsunto.value.trim() || 'INFORME FACTURACION ELECTRONICA',
        mensaje: txtMensaje.value.trim(),
        reporte: leer()
      };

      bAbrirApp.disabled = true;
      bAbrirApp.textContent = 'Preparando Outlook…';
      try {
        var res = await fetch('/informe/abrir-outlook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) {
          var data = await res.json();
          throw new Error(data.error || 'No se pudo preparar el correo');
        }
        var blob = await res.blob();
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'INFORME_OUTLOOK_' + ($('fecha').value || hoy()) + '.eml';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        setTimeout(function(){ URL.revokeObjectURL(a.href); }, 2000);

        cerrarModalCorreo();
        toast('✉ Abriendo en tu aplicación de Outlook…');
      } catch(err) {
        txtErr.style.display = 'block';
        txtErr.textContent = err.message;
      } finally {
        bAbrirApp.disabled = false;
        bAbrirApp.textContent = '🚀 Abrir en Outlook (con PDF adjunto)';
      }
    });
  }

  // Abrir en Outlook Web
  var bOutlookWeb = $('btnOutlookWeb');
  if (bOutlookWeb) {
    bOutlookWeb.addEventListener('click', function(){
      if (!listaPara.length && inputPara.value.trim()) {
        agregarEmail('para', inputPara.value.trim());
        inputPara.value = '';
      }
      var toStr = listaPara.join(';');
      var ccStr = listaCc.join(';');
      var sub = encodeURIComponent(txtAsunto.value.trim() || 'INFORME FACTURACION ELECTRONICA');
      var body = encodeURIComponent(txtMensaje.value.trim() + '\n\nJames Grisales\nAnalista de Soporte\nJaivaná');
      var url = 'https://outlook.office.com/mail/deeplink/compose?to=' + encodeURIComponent(toStr) + '&cc=' + encodeURIComponent(ccStr) + '&subject=' + sub + '&body=' + body;
      window.open(url, '_blank');
      // También descargar el PDF para adjuntarlo fácilmente si usa la web
      $('btnDescargar').click();
      toast('Abriendo Outlook Web (el PDF se descargó para adjuntar)');
    });
  }
})();

/* ---------- arranque ---------- */
var inicial = ejemplo();
try {
  var g = JSON.parse(localStorage.getItem(KEY) || 'null');
  if (g && typeof g === 'object') {
    inicial = Object.assign(inicial, g);
    // si el borrador es de otro día, la fecha y la hora vuelven a ser las de hoy
    if (g.fecha !== hoy()) { inicial.fecha = hoy(); inicial.hora = ahora(); }
    if (!Array.isArray(inicial.filas)) inicial.filas = ejemplo().filas;
  }
} catch (e) {}
pintar(inicial);
estadoLista();
if (errorLista || !EMPRESAS.length) refrescarEmpresas(true);
vistaPrevia();

})();
</script>
