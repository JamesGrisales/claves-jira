/* ---------- filas de la tabla ---------- */
function crearFila(datos){
  var f = document.createElement('div'); f.className = 'fila';
  var ph = ['Empresa', '0', '0', '0', 'Observación'];
  for (var i = 0; i < 5; i++) {
    var inp = document.createElement('input');
    inp.type = 'text'; inp.maxLength = 120; inp.placeholder = ph[i]; inp.value = datos[i] || '';
    inp.setAttribute('data-c', i);
    if (i >= 1 && i <= 3) inp.className = 'num';
    if (i === 0) {
      inp.classList.add('emp'); inp.autocomplete = 'off'; inp.placeholder = 'Elige o escribe…';
      var caja = document.createElement('div'); caja.className = 'combo';
      var chev = document.createElement('button');
      chev.type = 'button'; chev.className = 'chev'; chev.tabIndex = -1; chev.textContent = '▼'; chev.title = 'Ver empresas';
      chev.addEventListener('mousedown', function(ev){
        ev.preventDefault();
        var el = this.parentNode.querySelector('input');
        if (panel.style.display === 'block' && comboInput === el) cerrarCombo();
        else { el.focus(); abrirCombo(el, false); }
      });
      caja.appendChild(inp); caja.appendChild(chev); f.appendChild(caja);
    } else {
      f.appendChild(inp);
    }
  }
  var x = document.createElement('button');
  x.type = 'button'; x.className = 'secondary x'; x.textContent = '✕'; x.title = 'Quitar esta fila';
  x.addEventListener('click', function(){ f.remove(); cambio(); });
  f.appendChild(x);
  return f;
}
function pintarFilas(filas){
  var cont = $('filas'); cont.innerHTML = '';
  (filas || []).forEach(function(r){ cont.appendChild(crearFila(r)); });
}

/* ---------- leer / pintar el formulario ---------- */
function leer(){
  var filas = [].map.call($('filas').children, function(f){
    return [].map.call(f.querySelectorAll('input'), function(i){ return i.value; });
  });
  return {
    titulo: $('titulo').value, tecnico: $('tecnico').value,
    fecha: $('fecha').value, hora: $('hora').value, horaFormato: $('horaFormato').value,
    filas: filas,
    observaciones: $('observaciones').value,
    ticket: $('ticket').value, numeroTicket: $('numeroTicket').value,
    resumen: {
      empresas: $('r_empresas').value, aceptados: $('r_aceptados').value, pendientes: $('r_pendientes').value,
      escalados: $('r_escalados').value, tickets: $('r_tickets').value
    },
    auto: { empresas: $('a_empresas').checked, aceptados: $('a_aceptados').checked }
  };
