<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .top .acciones{ display:flex; gap:8px; flex-wrap:wrap; }
  .top .acciones button{ padding:9px 15px; font-size:13.5px; }

  .inf-grid{ display:grid; grid-template-columns:minmax(380px, 560px) minmax(0, 1fr); gap:18px; align-items:start; }
  @media (max-width: 1000px){ .inf-grid{ grid-template-columns:1fr; } }

  .bloque{ padding:16px 18px; margin-bottom:14px; }
  .bloque h2{ font-size:14px; margin:0 0 12px; display:flex; align-items:center; gap:8px; }
  .bloque h2 .n{ display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:var(--accent-soft); color:var(--accent-dark); font-size:12px; font-weight:800; }

  .campo{ display:flex; flex-direction:column; gap:5px; margin-bottom:10px; min-width:0; }
  .campo > span{ font-size:11px; font-weight:700; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .campo input, .campo select, .fila input, .fila select{
    background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans);
    font-size:13.5px; padding:8px 10px; border-radius:8px; outline:none; width:100%; min-width:0; box-sizing:border-box;
  }
  .campo textarea{ background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13.5px; line-height:1.45;
    padding:9px 10px; border-radius:8px; outline:none; width:100%; min-height:96px; resize:vertical; box-sizing:border-box; }
  .campo textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .obs-pie{ display:flex; justify-content:space-between; gap:10px; font-size:12px; color:var(--muted); margin-top:-2px; }
  .campo input:focus, .campo select:focus, .fila input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .dos{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .con-btn{ display:flex; gap:6px; }
  .con-btn button{ padding:0 10px; font-size:12px; white-space:nowrap; }

  .cab{ display:grid; grid-template-columns:1.3fr 60px 60px 60px 1.1fr 30px; gap:6px; font-size:10.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.03em; margin-bottom:5px; padding:0 2px; }
  .fila{ display:grid; grid-template-columns:1.3fr 60px 60px 60px 1.1fr 30px; gap:6px; margin-bottom:6px; align-items:center; }
  .fila input{ padding:7px 8px; font-size:13px; }
  .fila input.num{ text-align:center; padding-left:2px; padding-right:2px; }
  .fila .x{ padding:0; height:30px; width:30px; font-size:14px; line-height:1; }
  .agregar{ margin-top:6px; padding:8px 13px; font-size:13px; }


  .combo{ position:relative; min-width:0; }
  .fila .combo input{ padding-right:22px; }
  .fila .combo .chev{ position:absolute; right:2px; top:2px; bottom:2px; width:20px; height:auto; padding:0; border:none; border-radius:6px;
    background:transparent; color:var(--muted); box-shadow:none; font-size:10px; line-height:1; transform:none; filter:none; }
  .fila .combo .chev:hover{ background:var(--accent-soft); color:var(--accent-dark); transform:none; box-shadow:none; filter:none; }
  #combo{ position:fixed; z-index:60; display:none; background:var(--panel); border:1px solid var(--panel-edge); border-radius:10px;
    box-shadow:0 10px 30px rgba(0,0,0,.22); max-height:260px; overflow:auto; padding:4px; font-size:13px; }
  #combo .enc{ padding:5px 10px 3px; font-size:10.5px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.03em; }
  #combo .opt{ padding:7px 10px; border-radius:7px; cursor:pointer; display:flex; justify-content:space-between; gap:10px; color:var(--text); }
  #combo .opt:hover, #combo .opt.act{ background:var(--accent-soft); color:var(--accent-dark); }
  #combo .opt.sel{ font-weight:700; }
  #combo .opt.usada{ color:var(--muted); }
  #combo .opt small{ font-size:11px; flex-shrink:0; opacity:.85; }
  #combo .vacio{ padding:9px 10px; color:var(--muted); font-size:12.5px; }
  .fila .combo .chev{ display:none; }
  #filas.con-lista .combo .chev{ display:block; }
  .botones-emp{ display:flex; gap:8px; flex-wrap:wrap; margin-top:6px; }
  .botones-emp .agregar{ margin-top:0; }
  .modal{ position:fixed; inset:0; z-index:70; display:none; align-items:center; justify-content:center; padding:16px; background:rgba(8,12,22,.55); }
  .modal-box{ width:min(520px, 100%); max-height:88vh; display:flex; flex-direction:column; gap:10px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:14px; padding:16px 18px; box-shadow:0 20px 50px rgba(0,0,0,.35); }
  .modal-box h3{ margin:0; font-size:15px; }
  .modal-box input[type=text]{ width:100%; box-sizing:border-box; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13.5px; padding:8px 10px; border-radius:8px; outline:none; }
  .modal-box input[type=text]:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .pk-tools{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .pk-tools button{ padding:6px 11px; font-size:12.5px; }
  .pk-tools .cnt{ margin-left:auto; font-size:12px; color:var(--muted); }
  .pk-list{ overflow:auto; min-height:120px; max-height:48vh; border:1px solid var(--panel-edge); border-radius:10px; padding:4px; }
  .pk-item{ display:flex; align-items:center; gap:9px; padding:7px 9px; border-radius:7px; cursor:pointer; font-size:13px; margin:0; text-transform:none; letter-spacing:0; font-weight:500; color:var(--text); }
  .pk-item:hover{ background:var(--accent-soft); }
  .pk-item input{ width:auto; margin:0; accent-color:var(--accent); }
  .pk-item.usada{ color:var(--muted); cursor:default; }
  .pk-item.usada:hover{ background:transparent; }
  .pk-item small{ margin-left:auto; font-size:11px; }
  .pk-vacio{ padding:14px; text-align:center; color:var(--muted); font-size:12.5px; }
  .pk-foot{ display:flex; gap:8px; justify-content:flex-end; }
  .pk-foot button{ padding:8px 14px; font-size:13px; }
  .ayuda-emp{ font-size:12px; color:var(--muted); margin:8px 0 0; }
  .ayuda-emp.mal{ color:var(--danger); font-weight:600; }
  .auto{ display:flex; align-items:center; gap:7px; margin-top:2px; font-size:12px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; }
  .auto input{ width:auto !important; padding:0 !important; margin:0; accent-color:var(--accent); cursor:pointer; }
  .campo input[readonly]{ background:var(--accent-soft); border-color:var(--accent); color:var(--accent-dark); font-weight:700; cursor:default; }
  .auto-info{ font-size:12px; color:var(--muted); margin:-2px 0 12px; line-height:1.45; }
  .auto-info.ok{ color:var(--accent-dark); }
  .auto-info.viejo{ color:#8a5300; font-weight:600; }
  :root[data-theme="dark"] .auto-info.viejo{ color:#ffc46b; }
  .auto-info a{ color:var(--accent-dark); font-weight:700; }
  .estado{ font-size:12.5px; color:var(--muted); min-height:18px; margin:0 0 8px; }
  .estado.mal{ color:var(--danger); font-weight:600; }
  .vista{ position:sticky; top:10px; }
  .vista iframe{ width:100%; height:calc(100vh - 150px); min-height:560px; border:1px solid var(--panel-edge); border-radius:10px; background:#e9edf3; }
  .nota{ font-size:12px; color:var(--muted); margin-top:8px; }
  .nota a{ color:var(--accent-dark); font-weight:600; }

  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:50; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  /* Estilos del modal de correo Outlook - Ampliado y Espacioso */
  #modalCorreo .modal-box {
    width: min(940px, 96vw) !important;
    max-width: 940px !important;
    max-height: 94vh !important;
  }
  .em-tabs { display:flex; gap:8px; border-bottom:1px solid var(--panel-edge); padding-bottom:8px; margin-bottom:12px; }
  .em-tab-btn { background:transparent; border:none; box-shadow:none; color:var(--muted); font-size:13.5px; font-weight:700; padding:8px 18px; border-bottom:2px solid transparent; border-radius:0; cursor:pointer; transition:all .15s ease; }
  .em-tab-btn.active { color:var(--accent); border-bottom-color:var(--accent); }
  .em-chip-box { display:flex; flex-wrap:wrap; gap:6px; align-items:center; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:10px; padding:7px 10px; min-height:46px; }
  .em-chip-box:focus-within { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .em-chips { display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
  .em-chip { display:inline-flex; align-items:center; gap:6px; background:var(--accent-soft); color:var(--accent-dark); border:1px solid var(--accent); padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; }
  .em-chip-del { background:none; border:none; padding:0; cursor:pointer; font-size:13px; color:var(--accent-dark); opacity:.75; display:inline-flex; line-height:1; }
  .em-chip-del:hover { opacity:1; }
  .em-chip-box input { flex:1; min-width:160px; border:none !important; background:transparent !important; padding:5px 8px !important; outline:none !important; box-shadow:none !important; color:var(--text); font-size:13.5px; font-family:var(--sans); }
  .em-quick-btn { background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--muted); border-radius:999px; font-size:11.5px; font-weight:600; padding:3px 10px; cursor:pointer; box-shadow:none; transform:none; transition:all .15s ease; }
  .em-quick-btn:hover { background:var(--accent-soft); color:var(--accent-dark); border-color:var(--accent); transform:none; }
  @media (max-width: 760px) {
    .em-bottom-grid { grid-template-columns: 1fr !important; }
  }
</style>

<div>
  <div class="top">
    <h1>Informe diario</h1>
    <div class="acciones" style="display:flex; align-items:center; gap:8px;">
      <button type="button" class="secondary" id="btnEjemplo" title="Vuelve a los datos del informe de ejemplo">Restablecer</button>
      <button type="button" id="btnDescargar">⬇ Descargar PDF</button>
      <button type="button" class="secondary" id="btnAbrirModalCorreo" style="font-weight:700; border-color:var(--accent); background:var(--accent-soft); color:var(--accent-dark); display:inline-flex; align-items:center; gap:6px;">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        ✉ Enviar por Correo
      </button>
      <span class="db-orb db-orb-pg" title="Conexión de datos en PostgreSQL">🐘</span>
    </div>
  </div>
  <p class="sub" style="margin-bottom:0;">Formato diario de reporte de envío de documentos electrónicos. Cambia la fecha, la hora y los demás campos; la vista previa es el PDF real y se descarga idéntica al formato del Word.</p>
</div>

<div class="inf-grid">
  <div>
    <div class="card bloque">
      <h2>Datos del reporte</h2>
      <label class="campo"><span>Título</span><input type="text" id="titulo" maxlength="200"></label>
      <label class="campo"><span>Técnico responsable</span><input type="text" id="tecnico" maxlength="120"></label>
      <div class="dos">
        <label class="campo"><span>Fecha del reporte</span>
          <div class="con-btn"><input type="date" id="fecha"><button type="button" class="secondary" id="btnHoy" title="Poner la fecha y la hora actuales">Ahora</button></div>
        </label>
        <label class="campo"><span>Hora</span><input type="time" id="hora"></label>
      </div>
      <label class="campo"><span>Cómo se escribe la hora</span>
        <select id="horaFormato">
          <option value="word">17:40pm (igual que el Word)</option>
          <option value="12h">5:40 pm</option>
          <option value="24h">17:40</option>
        </select>
      </label>
    </div>

    <div class="card bloque">
      <h2><span class="n">1</span> Detalles por empresa</h2>
      <div class="cab"><span>Empresa</span><span>Envia.</span><span>Pend.</span><span>Rech.</span><span>Observaciones</span><span></span></div>
      <div id="filas"></div>
      <div class="botones-emp">
        <button type="button" class="secondary agregar" id="btnAgregar">+ Agregar empresa</button>
        <button type="button" class="secondary agregar" id="btnPicker" title="Marca varias empresas de la lista y se agregan de una vez">☰ Elegir varias de la lista</button>
      </div>
      <p class="ayuda-emp" id="ayudaEmp"></p>
    </div>

    <div class="card bloque">
      <h2>Observaciones</h2>
      <div class="campo">
        <textarea id="observaciones" maxlength="3000" placeholder="Escribe aquí cualquier observación adicional del día…"></textarea>
        <div class="obs-pie"><span>Sale en el PDF debajo de la tabla. Si lo dejas vacío, no aparece.</span><span id="obsCnt">0 / 3000</span></div>
      </div>
    </div>

    <div class="card bloque">
      <h2><span class="n">2</span> ¿Se generó ticket en mesa de ayuda?</h2>
      <div class="dos">
        <label class="campo"><span>Respuesta</span>
          <select id="ticket"><option value="Si">Si</option><option value="No">No</option></select>
        </label>
        <label class="campo"><span>Número del ticket</span><input type="text" id="numeroTicket" maxlength="60"></label>
      </div>
    </div>

    <div class="card bloque">
      <h2><span class="n">3</span> Resumen diario</h2>
      <div class="campo"><span>Total de empresas revisadas</span>
        <input type="text" id="r_empresas" maxlength="40">
        <label class="auto"><input type="checkbox" id="a_empresas" checked> Automático (desde Aceptados)</label>
      </div>
      <div class="campo"><span>Total de documentos aceptadas</span>
        <input type="text" id="r_aceptados" maxlength="40">
        <label class="auto"><input type="checkbox" id="a_aceptados" checked> Automático (desde Aceptados)</label>
        <button type="button" class="secondary" id="btnTraer" style="margin-top:6px;padding:5px 11px;font-size:12px;" title="Vuelve a traer los totales de la pestaña Aceptados">↻ Traer ahora</button>
      </div>
      <p class="auto-info" id="autoInfo"></p>
      <label class="campo"><span>Total de documentos pendientes</span><input type="text" id="r_pendientes" maxlength="40"></label>
      <label class="campo"><span>Total de casos escalados a infraestructura</span><input type="text" id="r_escalados" maxlength="40"></label>
      <label class="campo"><span>Tickets generados para automatización</span><input type="text" id="r_tickets" maxlength="40"></label>
    </div>
  </div>

  <div class="vista">
    <p class="estado" id="estado">Generando vista previa…</p>
    <iframe id="marco" title="Vista previa del informe en PDF"></iframe>
    <p class="nota">Si tu navegador no muestra la vista previa (pasa en algunos celulares), usa <a href="#" id="abrirNueva">abrir en una pestaña nueva</a> o descarga el PDF.</p>
  </div>
</div>

<script type="application/json" id="empresas-data"><%- JSON.stringify({ empresas: (typeof empresas !== 'undefined' ? empresas : []), error: !!(typeof empresasError !== 'undefined' && empresasError) }).replace(/</g, '\\u003c') %></script>
<div class="modal" id="picker" role="dialog" aria-modal="true" aria-label="Elegir empresas">
  <div class="modal-box">
    <h3>Elegir empresas de la lista</h3>
    <input type="text" id="pkBuscar" placeholder="Buscar empresa…" autocomplete="off">
    <div class="pk-tools">
      <button type="button" class="secondary" id="pkTodas">Marcar las visibles</button>
      <button type="button" class="secondary" id="pkNinguna">Quitar marcas</button>
      <span class="cnt" id="pkCnt"></span>
    </div>
    <div class="pk-list" id="pkList"></div>
    <div class="pk-foot">
      <button type="button" class="secondary" id="pkCancelar">Cancelar</button>
      <button type="button" id="pkAgregar">Agregar</button>
    </div>
  </div>
</div>

<!-- Modal Enviar Informe por Correo (Outlook) -->
<div class="modal" id="modalCorreo" role="dialog" aria-modal="true" aria-label="Enviar informe por correo">
  <div class="modal-box" style="width:min(900px, 96vw); max-height:94vh; padding:22px 28px; gap:14px; box-shadow:0 24px 60px rgba(0,0,0,0.5); border-radius:16px;">
    <!-- Header del Modal -->
    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--panel-edge); padding-bottom:12px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:22px; color:var(--accent);">✉</span>
        <div>
          <h3 style="margin:0; font-size:18px; font-weight:700; color:var(--text); letter-spacing:-0.01em;">Enviar informe por correo (Outlook)</h3>
          <span style="font-size:12px; color:var(--muted);">Envío corporativo directo con PDF adjunto y firma institucional de Jaivaná</span>
        </div>
      </div>
      <button type="button" class="iconbtn" id="btnCerrarModalCorreo" style="padding:0; width:32px; height:32px; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:8px; font-size:15px; cursor:pointer; color:var(--muted); display:inline-flex; align-items:center; justify-content:center;" title="Cerrar">✕</button>
    </div>

    <!-- Pestañas del Modal -->
    <div class="em-tabs">
      <button type="button" class="em-tab-btn active" id="tabBtnRedactar">✉ Redactar Correo</button>
      <button type="button" class="em-tab-btn" id="tabBtnConfig">⚙ Cuenta y Configuración</button>
    </div>

    <!-- Panel 1: Redactar -->
    <div id="panelRedactar" style="display:flex; flex-direction:column; gap:14px; overflow-y:auto; padding-right:4px;">
      <!-- PARA -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
          <label style="margin:0; font-size:12.5px; font-weight:700; color:var(--text); letter-spacing:.02em;">PARA (Destinatarios):</label>
          <span style="font-size:11.5px; color:var(--muted);">Presiona Enter o coma para añadir</span>
        </div>
        <div class="em-chip-box" id="boxPara">
          <div class="em-chips" id="chipsPara"></div>
          <input type="email" id="inputPara" placeholder="Escribe un correo o selecciona de los frecuentes..." autocomplete="off">
        </div>
        <!-- Contactos frecuentes PARA -->
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:6px;">
          <span style="font-size:11.5px; color:var(--muted); font-weight:600;">Sugeridos:</span>
          <button type="button" class="em-quick-btn" data-add-to="para" data-email="jose.caracas@jaivana.co" data-name="José Yoani Caracas Delgado">+ José Yoani Caracas</button>
          <button type="button" class="em-quick-btn" data-add-to="para" data-email="william.arboleda@jaivana.co" data-name="William Arboleda">+ William Arboleda</button>
          <button type="button" class="em-quick-btn" data-add-to="para" data-email="natalia.velasquez@jaivana.co" data-name="Natalia Velasquez">+ Natalia Velasquez</button>
        </div>
      </div>

      <!-- CC -->
      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
          <label style="margin:0; font-size:12.5px; font-weight:700; color:var(--text); letter-spacing:.02em;">CC (Con copia):</label>
          <span style="font-size:11.5px; color:var(--muted);">Opcional</span>
        </div>
        <div class="em-chip-box" id="boxCc">
          <div class="em-chips" id="chipsCc"></div>
          <input type="email" id="inputCc" placeholder="Escribe un correo en copia..." autocomplete="off">
        </div>
        <!-- Contactos frecuentes CC -->
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:6px;">
          <span style="font-size:11.5px; color:var(--muted); font-weight:600;">Sugeridos:</span>
          <button type="button" class="em-quick-btn" data-add-to="cc" data-email="juan.mejia@jaivana.co" data-name="Juan Carlos Mejia">+ Juan Carlos Mejía</button>
          <button type="button" class="em-quick-btn" data-add-to="cc" data-email="julio.molina@jaivana.co" data-name="Julio Molina">+ Julio Molina</button>
        </div>
      </div>

      <!-- ASUNTO -->
      <div>
        <label style="margin:0 0 5px; font-size:12.5px; font-weight:700; color:var(--text); display:block;">ASUNTO:</label>
        <input type="text" id="emailAsunto" value="INFORME FACTURACION ELECTRONICA" placeholder="Asunto del correo…" style="width:100%; font-size:13.5px; font-weight:600; padding:9px 12px; border-radius:10px;">
      </div>

      <!-- MENSAJE -->
      <div>
        <label style="margin:0 0 5px; font-size:12.5px; font-weight:700; color:var(--text); display:block;">MENSAJE:</label>
        <textarea id="emailMensaje" style="width:100%; min-height:100px; font-family:var(--sans); font-size:13.5px; line-height:1.5; padding:10px 12px; border-radius:10px; resize:vertical;"></textarea>
      </div>

      <!-- FILA DE ADJUNTO Y FIRMA INSTITUCIONAL (DISTRIBUCIÓN EN 2 COLUMNAS) -->
      <div class="em-bottom-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:2px;">
        <!-- COL 1: ADJUNTO AUTOMÁTICO -->
