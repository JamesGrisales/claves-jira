        <button type="button" class="secondary" id="btnCancelarEmail" style="padding:8px 16px;">Cancelar</button>
        <button type="button" id="btnEnviarEmail" style="font-weight:700; background:linear-gradient(135deg, #0284c7, #0369a1); color:#fff; border:none; box-shadow:0 4px 16px rgba(2,132,199,0.45); padding:10px 22px; font-size:14px; border-radius:10px; cursor:pointer;" title="Envía el correo directamente desde tu cuenta jgrisales@jaivana.co sin pedir contraseñas">🚀 Enviar directo desde la App</button>
      </div>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
(function(){
'use strict';

var $ = function(id){ return document.getElementById(id); };
var KEY = 'boveda-informe-v1';

function pad(n){ return (n < 10 ? '0' : '') + n; }
function hoy(){ var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
function ahora(){ var d = new Date(); return pad(d.getHours()) + ':' + pad(d.getMinutes()); }

function ejemplo(){
  return {
    titulo: 'FORMATO DIARIO DE REPORTE DE ENVÍO DE DOCUMENTOS ELECTRÓNICOS',
    tecnico: 'John James Grisales',
    fecha: hoy(), hora: ahora(), horaFormato: 'word',
    filas: [
      ['AUTOSERVICIO LA PRIMAVERA', '102', '0', '0', 'FIRMA ELECTRONICA'],
      ['UNOA SUPIA', '1', '0', '0', 'FECHA'],
      ['INSERCOM', '34', '0', '0', 'SERVICIO'],
      ['', '', '', '', ''],
      ['', '', '', '', '']
    ],
    observaciones: '',
    ticket: 'Si', numeroTicket: '',
    resumen: { empresas: '46', aceptados: '9599', pendientes: '0', escalados: '0', tickets: '0' },
    auto: { empresas: true, aceptados: true }
  };
}

var toastT;
function toast(msg){
  var t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(function(){ t.classList.remove('show'); }, 1800);
}

var EMPRESAS = [], errorLista = false;
try { var inicialData = JSON.parse($('empresas-data').textContent) || {}; EMPRESAS = inicialData.empresas || []; errorLista = !!inicialData.error; } catch (e) { EMPRESAS = []; }

/* ---------- desplegable de empresas (buscador + lista) ---------- */
function norm(t){ return String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim(); }
var panel = document.createElement('div'); panel.id = 'combo'; document.body.appendChild(panel);
var comboInput = null, comboFiltrar = false, activo = -1, visibles = [], sinAbrir = false;

function usadasEnTabla(excluir){
  var u = {};
  [].forEach.call($('filas').querySelectorAll('input.emp'), function(i){ if (i !== excluir && norm(i.value)) u[norm(i.value)] = 1; });
  return u;
}
function posicionarCombo(){
  if (!comboInput) return;
  var r = comboInput.getBoundingClientRect(), ancho = Math.max(r.width, 280);
  var left = Math.max(8, Math.min(r.left, window.innerWidth - ancho - 8));
  panel.style.width = ancho + 'px'; panel.style.left = left + 'px';
  var alto = panel.offsetHeight, top = r.bottom + 4;
  if (top + alto > window.innerHeight - 8 && r.top - alto - 4 > 8) top = r.top - alto - 4;
  panel.style.top = top + 'px';
}
function marcarActivo(){
  var ops = panel.querySelectorAll('.opt');
  for (var i = 0; i < ops.length; i++) ops[i].classList.toggle('act', i === activo);
  if (activo >= 0 && ops[activo]) ops[activo].scrollIntoView({ block: 'nearest' });
}
function abrirCombo(inp, filtrar){
  refrescarEmpresas();
  if (!EMPRESAS.length) return;
  comboInput = inp; comboFiltrar = filtrar;
  var q = filtrar ? norm(inp.value) : '', actual = norm(inp.value), usadas = usadasEnTabla(inp);
  visibles = EMPRESAS.filter(function(e){ return !q || norm(e).indexOf(q) >= 0; });
  panel.innerHTML = '';
  if (!visibles.length) {
    panel.innerHTML = '<div class="vacio">Sin coincidencias: se usará lo que escribiste.</div>';
  } else {
    var enc = document.createElement('div'); enc.className = 'enc';
    enc.textContent = q ? visibles.length + ' de ' + EMPRESAS.length + ' empresas' : EMPRESAS.length + ' empresas';
    panel.appendChild(enc);
    visibles.forEach(function(e){
      var d = document.createElement('div');
      var ya = usadas[norm(e)];
      d.className = 'opt' + (ya ? ' usada' : '') + (norm(e) === actual ? ' sel' : '');
      var t = document.createElement('span'); t.textContent = e; d.appendChild(t);
      if (ya) { var sm = document.createElement('small'); sm.textContent = '✓ ya está'; d.appendChild(sm); }
      d.addEventListener('mousedown', function(ev){ ev.preventDefault(); elegirEmpresa(e); });
      panel.appendChild(d);
    });
  }
  activo = -1;
  panel.style.display = 'block'; posicionarCombo();
  var sel = panel.querySelector('.opt.sel'); if (sel) sel.scrollIntoView({ block: 'nearest' });
}
function cerrarCombo(){ panel.style.display = 'none'; comboInput = null; activo = -1; }
function elegirEmpresa(nombre){
  var inp = comboInput; if (!inp) return;
  inp.value = nombre;
  sinAbrir = true; inp.dispatchEvent(new Event('input', { bubbles: true })); sinAbrir = false;
  cerrarCombo();
  var sig = inp.closest('.fila').querySelector('input[data-c="1"]');
  if (sig) { sig.focus(); sig.select(); }
}

$('filas').addEventListener('focusin', function(e){ if (e.target.classList.contains('emp')) abrirCombo(e.target, false); });
$('filas').addEventListener('input', function(e){ if (e.target.classList.contains('emp') && !sinAbrir) abrirCombo(e.target, true); });
$('filas').addEventListener('focusout', function(e){ if (e.target.classList.contains('emp')) setTimeout(function(){ if (comboInput === e.target) cerrarCombo(); }, 120); });
$('filas').addEventListener('keydown', function(e){
  if (!e.target.classList.contains('emp')) return;
  var abierto = panel.style.display === 'block';
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    e.preventDefault();
    if (!abierto) { abrirCombo(e.target, false); return; }
    var n = visibles.length; if (!n) return;
    activo = e.key === 'ArrowDown' ? Math.min(n - 1, activo + 1) : Math.max(0, activo - 1);
    marcarActivo();
  } else if (e.key === 'Enter' && abierto && activo >= 0 && visibles[activo]) {
    e.preventDefault(); elegirEmpresa(visibles[activo]);
  } else if (e.key === 'Escape' && abierto) { e.preventDefault(); cerrarCombo(); }
  else if (e.key === 'Tab') cerrarCombo();
});
window.addEventListener('resize', posicionarCombo);
window.addEventListener('scroll', function(e){ if (e.target !== panel && panel.style.display === 'block') cerrarCombo(); }, true);

/* ---------- totales automáticos desde la pestaña Aceptados ---------- */
var KEY_ACEPT = 'boveda-aceptados-resumen';
var resumenMemoria = null;   // respaldo si el navegador no deja guardar (almacenamiento lleno o bloqueado)
function leerAceptados(){
  var r = null;
  try { r = JSON.parse(localStorage.getItem(KEY_ACEPT) || 'null'); } catch (e) { r = null; }
  if (!r || typeof r !== 'object') r = null;
  if (resumenMemoria && (!r || (resumenMemoria.actualizado || 0) > (r.actualizado || 0))) return resumenMemoria;
  return r;
}
function hace(ms){
  var min = Math.max(0, Math.round((Date.now() - ms) / 60000));
  if (min < 1) return 'hace un momento';
  if (min < 60) return 'hace ' + min + ' min';
  var h = Math.floor(min / 60);
  if (h < 48) return 'hace ' + h + ' h';
  return 'hace ' + Math.floor(h / 24) + ' días';
}
function aplicarAuto(){
  var r = leerAceptados(), info = $('autoInfo'), reactivado = false;
  // Si pegaste datos nuevos en Aceptados, «Automático» se vuelve a marcar solo
  // (antes, si lo habías desmarcado alguna vez, se quedaba sin llenar para siempre)
  if (r && r.pegado) {
    var visto = null; try { visto = localStorage.getItem('boveda-informe-visto'); } catch (e) {}
    if (String(r.pegado) !== visto) {
      ['empresas', 'aceptados'].forEach(function(k){ if (!$('a_' + k).checked) { $('a_' + k).checked = true; reactivado = true; } });
      try { localStorage.setItem('boveda-informe-visto', String(r.pegado)); } catch (e) {}
    }
  }
  ['empresas', 'aceptados'].forEach(function(k){
    var cb = $('a_' + k), inp = $('r_' + k);
    cb.disabled = !r;
    if (r && cb.checked) { inp.value = String(r[k]); inp.readOnly = true; }
    else inp.readOnly = false;
  });
  if (!r) {
    info.className = 'auto-info';
    info.innerHTML = 'Todavía no hay datos en <a href="/aceptados">Aceptados</a>. Pega allí la tabla del dashboard y estos dos campos se llenan solos; mientras tanto puedes escribirlos.';
    return;
  }
  var viejo = Date.now() - (r.pegado || 0) > 864e5;
  info.className = 'auto-info ' + (viejo ? 'viejo' : 'ok');
  info.innerHTML = 'Desde <a href="/aceptados">Aceptados</a>: <strong>' + r.empresas + '</strong> empresas · <strong>' +
    Number(r.aceptados).toLocaleString('es-CO') + '</strong> ' + String(r.columna || 'aceptados').toLowerCase().replace(/[<>&]/g, '') +
    ' · pegado ' + hace(r.pegado || Date.now()) + (viejo ? ' ⚠ parecen datos de otro día: vuelve a pegar la tabla en Aceptados.' : '.');
  if (reactivado) { try { cambio(); } catch (e) {} }
}
// El resumen también vive en el servidor: se trae si es más nuevo que el de este navegador
function sincronizarServidor(){
  try {
    fetch('/api/kv/aceptados-resumen', { credentials: 'same-origin' })
      .then(function(x){ return x.ok ? x.json() : null; })
      .then(function(d){
        if (!d || !d.v) return;
        var loc = leerAceptados();
        if (!loc || (d.v.actualizado || 0) > (loc.actualizado || 0)) {
          resumenMemoria = d.v;
          try { localStorage.setItem(KEY_ACEPT, JSON.stringify(d.v)); } catch (e) {}
          refrescarAuto();
        }
        if (typeof alTraer === 'function') alTraer('servidor');
      }).catch(function(){ if (typeof alTraer === 'function') alTraer('error'); });
  } catch (e) {}
}
// Botón «Traer ahora»: vuelve a marcar Automático, trae lo último y dice qué encontró
var alTraer = null;
function traerAhora(){
  var info = $('autoInfo');
  info.className = 'auto-info'; info.textContent = 'Buscando lo último que pegaste en Aceptados…';
  ['empresas', 'aceptados'].forEach(function(k){ $('a_' + k).checked = true; });
  alTraer = function(origen){
    alTraer = null;
    var r = leerAceptados();
    if (!r) {
      info.className = 'auto-info viejo';
      info.innerHTML = origen === 'error'
        ? 'No pude consultar el servidor. Revisa que la bóveda esté corriendo y vuelve a intentar.'
        : 'Aceptados todavía no ha enviado datos. Ve a <a href="/aceptados">Aceptados</a>, pega la tabla y vuelve aquí.';
      return;
    }
    refrescarAuto(); cambio();
  };
  aplicarAuto();
  sincronizarServidor();
  setTimeout(function(){ if (alTraer) { var f = alTraer; f('timeout'); } }, 4000);
}
function refrescarAuto(){
  var antes = $('r_empresas').value + '|' + $('r_aceptados').value;
  aplicarAuto();
  if (antes !== $('r_empresas').value + '|' + $('r_aceptados').value) cambio();
}

/* ---------- la lista se mantiene al día con la tabla de empresas ---------- */
var ultimaCarga = Date.now(), cargando = null;
function estadoLista(){
  $('filas').classList.toggle('con-lista', EMPRESAS.length > 0);
  var a = $('ayudaEmp');
  if (EMPRESAS.length) {
    a.className = 'ayuda-emp';
    a.textContent = 'Elige entre las ' + EMPRESAS.length + ' empresas de la bóveda o escribe para buscar. Si agregas una nueva en Empresas, aparece aquí sola. También puedes escribir una que no esté en la lista.';
  } else if (errorLista) {
    a.className = 'ayuda-emp mal';
    a.textContent = 'No se pudo leer la tabla de empresas: escribe los nombres a mano.';
  } else {
    a.className = 'ayuda-emp';
    a.textContent = 'Todavía no hay empresas en la bóveda. Agrégalas en Empresas y aparecerán aquí.';
  }
  $('btnPicker').disabled = !EMPRESAS.length;
}
function refrescarEmpresas(forzar){
  if (cargando) return cargando;
  if (!forzar && Date.now() - ultimaCarga < 4000) return Promise.resolve(false);
  cargando = fetch('/informe/empresas', { credentials: 'same-origin', cache: 'no-store' }).then(function(r){
    if (!r.ok) throw new Error('http');
    return r.json();
  }).then(function(j){
    if (!Array.isArray(j.empresas)) throw new Error('formato');
    ultimaCarga = Date.now(); errorLista = false;
    var distinta = JSON.stringify(j.empresas) !== JSON.stringify(EMPRESAS);
    EMPRESAS = j.empresas; estadoLista();
    if (distinta) {
      if (comboInput && panel.style.display === 'block') abrirCombo(comboInput, comboFiltrar);
      else if (document.activeElement && document.activeElement.classList && document.activeElement.classList.contains('emp') && panel.style.display !== 'block') abrirCombo(document.activeElement, false);
      if ($('picker').style.display === 'flex') pintarPicker();
    }
    return distinta;
  }).catch(function(){ ultimaCarga = Date.now(); if (!EMPRESAS.length) { errorLista = true; estadoLista(); } return false; })
    .then(function(v){ cargando = null; return v; });
  return cargando;
}
window.addEventListener('focus', function(){ refrescarEmpresas(); });
document.addEventListener('visibilitychange', function(){ if (!document.hidden) refrescarEmpresas(); });

/* ---------- elegir varias empresas de la lista ---------- */
var seleccion = {};
function pintarPicker(){
  var q = norm($('pkBuscar').value), usadas = usadasEnTabla(null), lista = $('pkList');
  lista.innerHTML = '';
  var visiblesPk = EMPRESAS.filter(function(e){ return !q || norm(e).indexOf(q) >= 0; });
  visiblesPk.forEach(function(e){
    var ya = usadas[norm(e)];
    var lb = document.createElement('label'); lb.className = 'pk-item' + (ya ? ' usada' : '');
    var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = !!ya || !!seleccion[e]; cb.disabled = !!ya; cb._nombre = e;
    var t = document.createElement('span'); t.textContent = e;
    lb.appendChild(cb); lb.appendChild(t);
    if (ya) { var sm = document.createElement('small'); sm.textContent = '✓ ya está en la tabla'; lb.appendChild(sm); }
    lista.appendChild(lb);
  });
  if (!visiblesPk.length) lista.innerHTML = '<div class="pk-vacio">Ninguna empresa coincide con la búsqueda.</div>';
  contarPicker();
}
function contarPicker(){
  var usadas = usadasEnTabla(null), n = 0;
  for (var k in seleccion) if (seleccion[k] && !usadas[norm(k)]) n++;
  $('pkCnt').textContent = n + (n === 1 ? ' marcada' : ' marcadas');
  $('pkAgregar').textContent = n ? 'Agregar ' + n : 'Agregar';
  $('pkAgregar').disabled = !n;
}
function abrirPicker(){
  if (!EMPRESAS.length) { toast('Todavía no hay empresas en la lista'); return; }
  seleccion = {}; $('pkBuscar').value = ''; pintarPicker();
  $('picker').style.display = 'flex'; $('pkBuscar').focus();
  refrescarEmpresas(true);
}
function cerrarPicker(){ $('picker').style.display = 'none'; }
$('btnPicker').addEventListener('click', abrirPicker);
$('pkCancelar').addEventListener('click', cerrarPicker);
$('picker').addEventListener('mousedown', function(e){ if (e.target === this) cerrarPicker(); });
