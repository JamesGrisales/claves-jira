        <span>Contraseña o Contraseña de Aplicación <em style="font-size:11px; font-weight:normal; color:var(--muted);">(Opcional en tu equipo)</em></span>
        <input type="password" id="smtpPass" placeholder="••••••••••••••••">
      </label>
      <div style="display:grid; grid-template-columns:2fr 1fr; gap:10px;">
        <label class="campo">
          <span>Servidor SMTP</span>
          <input type="text" id="smtpHost" value="smtp.office365.com">
