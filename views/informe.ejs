<style>
  .top{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:6px; }
  .top h1{ margin:0; }
  .top .acciones{ display:flex; gap:8px; flex-wrap:wrap; }
  .top .acciones button{ padding:9px 15px; font-size:13.5px; }

  .inf-grid{ display:grid; grid-template-columns:minmax(400px, 580px) minmax(0, 1fr); gap:20px; align-items:stretch; }
  @media (max-width: 1000px){ .inf-grid{ grid-template-columns:1fr; } }

  .bloque{ padding:16px 18px; margin-bottom:14px; }
  .bloque h2{ font-size:14px; margin:0 0 12px; display:flex; align-items:center; gap:8px; }
  .bloque h2 .n{ display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:var(--accent-soft); color:var(--accent-dark); font-size:12px; font-weight:800; }

  .campo{ display:flex; flex-direction:column; gap:5px; margin-bottom:10px; min-width:0; }
  .campo > span{ font-size:11px; font-weight:700; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .campo input, .campo select, .fila input, .fila select{
    background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans);
    font-size:13.5px; padding:8px 10px; border-radius:8px; outline:none; width:100%; min-width:0; box-sizing:border-box;
  }
  .campo textarea{ background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13.5px; line-height:1.45;
    padding:9px 10px; border-radius:8px; outline:none; width:100%; min-height:96px; resize:vertical; box-sizing:border-box; }
  .campo textarea:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .obs-pie{ display:flex; justify-content:space-between; gap:10px; font-size:12px; color:var(--muted); margin-top:-2px; }
  .campo input:focus, .campo select:focus, .fila input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .dos{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .con-btn{ display:flex; gap:6px; }
  .con-btn button{ padding:0 10px; font-size:12px; white-space:nowrap; }

  .cab{ display:grid; grid-template-columns:1.3fr 60px 60px 60px 1.1fr 30px; gap:6px; font-size:10.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.03em; margin-bottom:5px; padding:0 2px; }
  .fila{ display:grid; grid-template-columns:1.3fr 60px 60px 60px 1.1fr 30px; gap:6px; margin-bottom:6px; align-items:center; }
  .fila input{ padding:7px 8px; font-size:13px; }
  .fila input.num{ text-align:center; padding-left:2px; padding-right:2px; }
  .fila .x{ padding:0; height:30px; width:30px; font-size:14px; line-height:1; }
  .agregar{ margin-top:6px; padding:8px 13px; font-size:13px; }


  .combo{ position:relative; min-width:0; }
  .fila .combo input{ padding-right:22px; }
  .fila .combo .chev{ position:absolute; right:2px; top:2px; bottom:2px; width:20px; height:auto; padding:0; border:none; border-radius:6px;
    background:transparent; color:var(--muted); box-shadow:none; font-size:10px; line-height:1; transform:none; filter:none; }
  .fila .combo .chev:hover{ background:var(--accent-soft); color:var(--accent-dark); transform:none; box-shadow:none; filter:none; }
  #combo{ position:fixed; z-index:60; display:none; background:var(--panel); border:1px solid var(--panel-edge); border-radius:10px;
    box-shadow:0 10px 30px rgba(0,0,0,.22); max-height:260px; overflow:auto; padding:4px; font-size:13px; }
  #combo .enc{ padding:5px 10px 3px; font-size:10.5px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.03em; }
  #combo .opt{ padding:7px 10px; border-radius:7px; cursor:pointer; display:flex; justify-content:space-between; gap:10px; color:var(--text); }
  #combo .opt:hover, #combo .opt.act{ background:var(--accent-soft); color:var(--accent-dark); }
  #combo .opt.sel{ font-weight:700; }
  #combo .opt.usada{ color:var(--muted); }
  #combo .opt small{ font-size:11px; flex-shrink:0; opacity:.85; }
  #combo .vacio{ padding:9px 10px; color:var(--muted); font-size:12.5px; }
  .fila .combo .chev{ display:none; }
  #filas.con-lista .combo .chev{ display:block; }
  .botones-emp{ display:flex; gap:8px; flex-wrap:wrap; margin-top:6px; }
  .botones-emp .agregar{ margin-top:0; }
  .modal{ position:fixed; inset:0; z-index:100000 !important; display:none; align-items:center; justify-content:center; padding:20px 16px; background:rgba(3,7,18,.82); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
  .modal-box{ position:relative; z-index:100001 !important; width:min(520px, 100%); max-height:88vh; display:flex; flex-direction:column; gap:10px; background:var(--panel); border:1px solid var(--panel-edge); border-radius:14px; padding:16px 18px; box-shadow:0 24px 60px rgba(0,0,0,.6); }
  .modal-box h3{ margin:0; font-size:15px; }
  .modal-box input[type=text]{ width:100%; box-sizing:border-box; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13.5px; padding:8px 10px; border-radius:8px; outline:none; }
  .modal-box input[type=text]:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .pk-tools{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .pk-tools button{ padding:6px 11px; font-size:12.5px; }
  .pk-tools .cnt{ margin-left:auto; font-size:12px; color:var(--muted); }
  .pk-list{ overflow:auto; min-height:120px; max-height:48vh; border:1px solid var(--panel-edge); border-radius:10px; padding:4px; }
  .pk-item{ display:flex; align-items:center; gap:9px; padding:7px 9px; border-radius:7px; cursor:pointer; font-size:13px; margin:0; text-transform:none; letter-spacing:0; font-weight:500; color:var(--text); }
  .pk-item:hover{ background:var(--accent-soft); }
  .pk-item input{ width:auto; margin:0; accent-color:var(--accent); }
  .pk-item.usada{ color:var(--muted); cursor:default; }
  .pk-item.usada:hover{ background:transparent; }
  .pk-item small{ margin-left:auto; font-size:11px; }
  .pk-vacio{ padding:14px; text-align:center; color:var(--muted); font-size:12.5px; }
  .pk-foot{ display:flex; gap:8px; justify-content:flex-end; }
  .pk-foot button{ padding:8px 14px; font-size:13px; }
  .ayuda-emp{ font-size:12px; color:var(--muted); margin:8px 0 0; }
  .ayuda-emp.mal{ color:var(--danger); font-weight:600; }
  .auto{ display:flex; align-items:center; gap:7px; margin-top:2px; font-size:12px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; cursor:pointer; }
  .auto input{ width:auto !important; padding:0 !important; margin:0; accent-color:var(--accent); cursor:pointer; }
  .campo input[readonly]{ background:var(--accent-soft); border-color:var(--accent); color:var(--accent-dark); font-weight:700; cursor:default; }
  .auto-info{ font-size:12px; color:var(--muted); margin:-2px 0 12px; line-height:1.45; }
  .auto-info.ok{ color:var(--accent-dark); }
  .auto-info.viejo{ color:#8a5300; font-weight:600; }
  :root[data-theme="dark"] .auto-info.viejo{ color:#ffc46b; }
  .auto-info a{ color:var(--accent-dark); font-weight:700; }
  .estado{ font-size:12.5px; color:var(--muted); min-height:18px; margin:0 0 8px; }
  .estado.mal{ color:var(--danger); font-weight:600; }
  .vista{ display:flex; flex-direction:column; height:100%; min-height:calc(100vh - 120px); position:relative; }
  .vista iframe{ width:100%; flex:1 1 auto; height:100%; min-height:calc(100vh - 130px); border:1px solid var(--panel-edge); border-radius:12px; background:#e9edf3; box-shadow:0 4px 20px rgba(0,0,0,.45); }
  .nota{ font-size:12px; color:var(--muted); margin-top:8px; }
  .nota a{ color:var(--accent-dark); font-weight:600; }

  .toast{ position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(10px) scale(.96); background:linear-gradient(135deg, var(--accent), var(--accent-dark)); color:#fff; font-size:13px; font-weight:600; padding:9px 18px; border-radius:8px; opacity:0; pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:50; }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

  /* Estilos del modal de correo Outlook - Ampliado y Espacioso */
  #modalCorreo {
    z-index: 100000 !important;
  }
  #modalCorreo .modal-box {
    position: relative;
    z-index: 100001 !important;
    width: min(940px, 96vw) !important;
    max-width: 940px !important;
    max-height: 92vh !important;
    margin: auto;
  }
  #modalConfirmacionEnvio {
    z-index: 100002 !important;
  }
  #modalConfirmacionEnvio .modal-box {
    position: relative;
    z-index: 100003 !important;
  }
  .em-tabs { display:flex; gap:8px; border-bottom:1px solid var(--panel-edge); padding-bottom:8px; margin-bottom:12px; }
  .em-tab-btn { background:transparent; border:none; box-shadow:none; color:var(--muted); font-size:13.5px; font-weight:700; padding:8px 18px; border-bottom:2px solid transparent; border-radius:0; cursor:pointer; transition:all .15s ease; }
  .em-tab-btn.active { color:var(--accent); border-bottom-color:var(--accent); }
  .em-chip-box { display:flex; flex-wrap:wrap; gap:6px; align-items:center; background:var(--panel-alt); border:1px solid var(--panel-edge); border-radius:10px; padding:7px 10px; min-height:46px; }
  .em-chip-box:focus-within { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .em-chips { display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
  .em-chip { display:inline-flex; align-items:center; gap:6px; background:var(--accent-soft); color:var(--accent-dark); border:1px solid var(--accent); padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600; }
  .em-chip-del { background:none; border:none; padding:0; cursor:pointer; font-size:13px; color:var(--accent-dark); opacity:.75; display:inline-flex; line-height:1; }
  .em-chip-del:hover { opacity:1; }
  .em-chip-box input { flex:1; min-width:160px; border:none !important; background:transparent !important; padding:5px 8px !important; outline:none !important; box-shadow:none !important; color:var(--text); font-size:13.5px; font-family:var(--sans); }
  .em-quick-btn { background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--muted); border-radius:999px; font-size:11.5px; font-weight:600; padding:3px 10px; cursor:pointer; box-shadow:none; transform:none; transition:all .15s ease; }
  .em-quick-btn:hover { background:var(--accent-soft); color:var(--accent-dark); border-color:var(--accent); transform:none; }
  @media (max-width: 760px) {
    .em-bottom-grid { grid-template-columns: 1fr !important; }
  }

  /* =====================================================================
     TABS SUPERIORES: INFORME DIARIO & CONCILIACIÓN DE ACEPTADOS
     ===================================================================== */
  .inf-tabs-nav {
    display: flex; gap: 10px; padding: 6px;
    background: var(--panel-alt); border: 1px solid var(--panel-edge); border-radius: 16px;
    margin-bottom: 20px; flex-wrap: wrap;
  }
  .inf-tab-btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 12px;
    border: 1px solid transparent; background: transparent; color: var(--muted);
    font-weight: 700; font-size: 13.5px; cursor: pointer; transition: all .2s var(--ease); box-shadow: none;
  }
  .inf-tab-btn:hover { color: var(--text); background: rgba(255,255,255,.05); transform: none; box-shadow: none; }
  .inf-tab-btn.active {
    background: var(--panel); color: var(--text); border-color: var(--accent);
    box-shadow: 0 0 16px -2px rgba(var(--accent-rgb), .35), 0 4px 12px rgba(0,0,0,.25);
  }
  .inf-tab-btn svg { stroke: currentColor; flex-shrink: 0; transition: transform .2s var(--spring); }
  .inf-tab-btn.active svg { stroke: var(--accent); transform: scale(1.1); }
  .inf-tab-pill {
    font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;
    background: rgba(var(--accent-rgb), .12); color: var(--accent); border: 1px solid rgba(var(--accent-rgb), .28);
    letter-spacing: .02em;
  }
  .inf-panel { animation: fadeIn .25s ease; }

  /* Stepper de flujo de trabajo diario */
  .inf-workflow-guide {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--panel-alt);
    border: 1px solid var(--panel-edge);
    border-radius: 14px;
    padding: 10px 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .inf-wf-step {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
    transition: all .18s ease;
    padding: 6px 12px;
    border-radius: 10px;
  }
  .inf-wf-step:hover {
    color: var(--text);
    background: rgba(255,255,255,0.05);
    transform: translateY(-1px);
  }
  .inf-wf-step.active {
    color: var(--accent-dark);
    font-weight: 700;
  }
  :root[data-theme="dark"] .inf-wf-step.active { color: var(--accent); }
  .inf-wf-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    font-size: 11.5px;
    font-weight: 800;
    color: var(--muted);
    transition: all .18s ease;
  }
  .inf-wf-step.active .inf-wf-num {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.5);
  }
  .inf-wf-sep {
    color: var(--panel-edge);
    font-size: 14px;
    user-select: none;
    opacity: 0.7;
  }

  /* Barra compacta de datos de Jaivaná */
  .bar-compacta-aceptados {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--panel-alt);
    border: 1px solid var(--panel-edge);
    border-radius: 10px;
    padding: 10px 14px;
    margin-top: 8px;
    animation: fadeIn .2s ease;
  }

  /* Badge de sincronización */
  .badge-sync-aceptados {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.28);
    animation: fadeIn .3s ease;
  }
  :root[data-theme="dark"] .badge-sync-aceptados {
    color: #34d399;
    background: rgba(16, 185, 129, 0.18);
  }

  /* Estilos específicos de Aceptados integrados */
  .a-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:6px; }
  .a-head strong { font-size:12px; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  #entradaAceptados {
    width:100%; height:130px; resize:vertical; background:var(--panel-alt); border:1px solid var(--panel-edge);
    color:var(--text); font-family:var(--mono); font-size:12px; line-height:1.45; padding:10px 12px; border-radius:10px; outline:none;
    white-space:pre; overflow:auto;
  }
  #entradaAceptados:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
  .a-hint { font-size:12px; color:var(--muted); margin-top:8px; }
  .a-err { font-size:13px; color:var(--danger); background:var(--danger-soft); border-radius:8px; padding:8px 12px; margin-top:10px; }
  .a-map { margin:16px 0 0; padding:12px 14px; border:1px solid var(--accent); border-radius:12px; background:var(--accent-soft); }
  .a-map > span { display:block; font-size:13px; color:var(--text); margin-bottom:8px; }
  .a-map-b { display:flex; gap:8px; flex-wrap:wrap; }
  .a-map-b button { display:flex; flex-direction:column; align-items:flex-start; gap:1px; padding:8px 14px; font-size:12px; font-weight:600; background:var(--panel); color:var(--text); border:2px solid var(--panel-edge); box-shadow:none; min-width:130px; text-align:left; cursor:pointer; }
  .a-map-b button b { font-size:17px; font-variant-numeric:tabular-nums; }
  .a-map-b button.on { border-color:var(--accent); background:var(--accent); color:#fff; }
  .a-map-b small { font-size:10.5px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.03em; }
  .a-map-b button.on small { color:#fff; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin:16px 0; }
  .kpi { background:var(--panel); border:1px solid var(--panel-edge); border-radius:12px; padding:14px 16px; box-shadow:var(--shadow); }
  .kpi .l { font-size:11px; font-weight:700; color:var(--muted); letter-spacing:.03em; text-transform:uppercase; }
  .kpi .v { font-size:26px; font-weight:800; margin-top:4px; letter-spacing:-.01em; }
  .kpi .s { font-size:12px; color:var(--muted); margin-top:3px; min-height:16px; }
  .kpi.main { border-color:var(--accent); background:linear-gradient(135deg, var(--accent-soft), var(--panel)); }
  .kpi.main .v { color:var(--accent-dark); font-size:32px; }
  .up { color:#137333; font-weight:700; } .down { color:var(--danger); font-weight:700; }
  .bad { color:var(--danger); font-weight:700; } .warnc { color:#8a5300; font-weight:700; }
  :root[data-theme="dark"] .up { color:#6fdc8c; } :root[data-theme="dark"] .warnc { color:#ffc46b; }
  .a-tools { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .a-tools input[type=text] { flex:1; min-width:180px; font-family:var(--sans); font-size:14px; background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); padding:8px 12px; border-radius:8px; }
  .a-tools label { display:flex; align-items:center; gap:6px; margin:0; font-size:12.5px; font-weight:600; color:var(--muted); text-transform:none; letter-spacing:0; }
  .a-tools select { background:var(--panel-alt); border:1px solid var(--panel-edge); color:var(--text); font-family:var(--sans); font-size:13px; padding:7px 10px; border-radius:8px; height:36px; }
  .a-tools button { padding:8px 13px; font-size:13px; }
  .btn-transfer-informe {
    background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-weight: 700;
    border: none; padding: 8px 18px; border-radius: 8px; cursor: pointer; display: inline-flex;
    align-items: center; gap: 6px; box-shadow: 0 4px 14px rgba(2,132,199,0.4); transition: all .15s ease;
  }
  .btn-transfer-informe:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(2,132,199,0.55); filter: brightness(1.1); }
  .a-wrap { overflow:auto; border:1px solid var(--panel-edge); border-radius:12px; max-height:62vh; background:var(--panel); }
  .a-t { width:100%; border-collapse:collapse; font-size:13px; }
  .a-t th { position:sticky; top:0; z-index:1; background:var(--panel-alt); text-align:left; font-size:11px; letter-spacing:.03em; text-transform:uppercase; color:var(--muted); padding:8px 10px; border-bottom:1px solid var(--panel-edge); white-space:nowrap; cursor:pointer; user-select:none; }
  .a-t th.n, .a-t td.n { text-align:right; font-variant-numeric:tabular-nums; }
  .a-t th input { width:92px; background:transparent; border:1px dashed transparent; color:inherit; font:inherit; text-transform:inherit; letter-spacing:inherit; padding:2px 4px; border-radius:5px; text-align:right; cursor:text; }
  .a-t th input:hover, .a-t th input:focus { border-color:var(--accent); background:var(--panel); outline:none; }
  .a-t td { padding:7px 10px; border-bottom:1px solid var(--panel-edge); white-space:nowrap; }
  .a-t td.nm { font-weight:600; white-space:normal; min-width:180px; }
  .a-t td.z { color:var(--muted); }
  .a-t tbody tr:hover td { background:var(--accent-soft); }
  .a-t tfoot td { position:sticky; bottom:0; background:var(--panel-alt); font-weight:800; border-top:2px solid var(--panel-edge); border-bottom:none; }
  .a-b { display:inline-block; font-size:11.5px; font-weight:700; padding:2px 8px; border-radius:999px; margin-left:6px; }
  .a-b.v { color:var(--danger); background:var(--danger-soft); }
  .a-b.p { color:#8a5300; background:#fff4e0; }
  :root[data-theme="dark"] .a-b.p { color:#ffc46b; background:#3a2c12; }
  .ver { font-family:var(--mono); font-size:11.5px; color:var(--muted); }

</style>

<div>
  <div x-data="informeAlpineApp('<%= typeof defaultTab !== "undefined" ? defaultTab : "" %>')">
  <!-- Barra superior con pestañas de navegación: Informe & Aceptados -->
  <div class="inf-tabs-nav" role="tablist">
