/* ---------- filas de la tabla ---------- */
function crearFila(datos){
  var f = document.createElement('div'); f.className = 'fila';
  var ph = ['Empresa', '0', '0', '0', 'Observación'];
  for (var i = 0; i < 5; i++) {
    var inp = document.createElement('input');
    inp.type = 'text'; inp.maxLength = 120; inp.placeholder = ph[i]; inp.value = datos[i] || '';
    inp.setAttribute('data-c', i);
    if (i >= 1 && i <= 3) inp.className = 'num';
    if (i === 0) {
      inp.classList.add('emp'); inp.autocomplete = 'off'; inp.placeholder = 'Elige o escribe…';
      var caja = document.createElement('div'); caja.className = 'combo';
      var chev = document.createElement('button');
      chev.type = 'button'; chev.className = 'chev'; chev.tabIndex = -1; chev.textContent = '▼'; chev.title = 'Ver empresas';
      chev.addEventListener('mousedown', function(ev){
        ev.preventDefault();
        var el = this.parentNode.querySelector('input');
        if (panel.style.display === 'block' && comboInput === el) cerrarCombo();
        else { el.focus(); abrirCombo(el, false); }
      });
      caja.appendChild(inp); caja.appendChild(chev); f.appendChild(caja);
    } else {
      f.appendChild(inp);
    }
  }
  var x = document.createElement('button');
  x.type = 'button'; x.className = 'secondary x'; x.textContent = '✕'; x.title = 'Quitar esta fila';
  x.addEventListener('click', function(){ f.remove(); cambio(); });
  f.appendChild(x);
  return f;
}
function pintarFilas(filas){
  var cont = $('filas'); cont.innerHTML = '';
  (filas || []).forEach(function(r){ cont.appendChild(crearFila(r)); });
}

/* ---------- leer / pintar el formulario ---------- */
function leer(){
  var filas = [].map.call($('filas').children, function(f){
    return [].map.call(f.querySelectorAll('input'), function(i){ return i.value; });
  });
  return {
    titulo: $('titulo').value, tecnico: $('tecnico').value,
    fecha: $('fecha').value, hora: $('hora').value, horaFormato: $('horaFormato').value,
    filas: filas,
    observaciones: $('observaciones').value,
    ticket: $('ticket').value, numeroTicket: $('numeroTicket').value,
    resumen: {
      empresas: $('r_empresas').value, aceptados: $('r_aceptados').value, pendientes: $('r_pendientes').value,
      escalados: $('r_escalados').value, tickets: $('r_tickets').value
    },
    auto: { empresas: $('a_empresas').checked, aceptados: $('a_aceptados').checked }
  };
}
function pintar(d){
  $('titulo').value = d.titulo; $('tecnico').value = d.tecnico;
  $('fecha').value = d.fecha; $('hora').value = d.hora; $('horaFormato').value = d.horaFormato || 'word';
  pintarFilas(d.filas);
  $('observaciones').value = d.observaciones || ''; contarObs();
  $('ticket').value = d.ticket === 'No' ? 'No' : 'Si'; $('numeroTicket').value = d.numeroTicket || '';
  var r = d.resumen || {};
  $('r_empresas').value = r.empresas || ''; $('r_aceptados').value = r.aceptados || '';
  $('r_pendientes').value = r.pendientes || ''; $('r_escalados').value = r.escalados || ''; $('r_tickets').value = r.tickets || '';
  var au = d.auto || {};
  $('a_empresas').checked = au.empresas !== false; $('a_aceptados').checked = au.aceptados !== false;
  aplicarAuto();
}

function contarObs(){ $('obsCnt').textContent = $('observaciones').value.length + ' / 3000'; }
function guardar(){ try { localStorage.setItem(KEY, JSON.stringify(leer())); } catch (e) {} }

/* ---------- vista previa (es el PDF real) ---------- */
var ctrl = null, urlActual = null, temporizador;
function estado(msg, mal){ var e = $('estado'); e.textContent = msg || ''; e.className = 'estado' + (mal ? ' mal' : ''); }

function pedirPdf(descargar, senal){
  return fetch('/informe/pdf' + (descargar ? '?descargar=1' : ''), {
    method: 'POST', credentials: 'same-origin', signal: senal,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(leer())
  }).then(function(r){
    var tipo = r.headers.get('content-type') || '';
    if (!r.ok || tipo.indexOf('pdf') < 0) throw new Error('No se pudo generar el PDF. Si tu sesión venció, recarga la página.');
    return r.blob();
  });
}

function vistaPrevia(){
  if (ctrl) ctrl.abort();
  ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
  estado('Actualizando vista previa…');
  pedirPdf(false, ctrl ? ctrl.signal : undefined).then(function(blob){
    if (urlActual) URL.revokeObjectURL(urlActual);
    urlActual = URL.createObjectURL(blob);
    $('marco').src = urlActual + '#toolbar=0&navpanes=0&view=FitH';
    estado('');
  }).catch(function(e){ if (e && e.name === 'AbortError') return; estado(e.message || 'Error al generar el PDF', true); });
}

function cambio(){ guardar(); clearTimeout(temporizador); temporizador = setTimeout(vistaPrevia, 600); }

